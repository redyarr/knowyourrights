                    <i class="fas fa-comments text-blue-500 text-xl mr-3"></i>
                    <h3 class="text-2xl font-bold text-gray-800">Client Feedback</h3>
                  </div>
                  <div id="feedback-list" class="space-y-0">
                    <!-- Feedback will be loaded here by JavaScript -->
                    <div id="feedback-spinner" class="flex justify-center items-center py-8">
                      <i class="fas fa-spinner fa-spin text-blue-500 text-3xl"></i>
                      <p class="ml-3 text-gray-500 italic">Loading feedback...</p>
                    </div>
                  </div>
                  <div class="mt-8 bg-gray-50 p-6 rounded-lg shadow-inner">
                    <h4 class="text-xl font-bold text-gray-800 mb-3">Summary</h4>
                    <div class="flex justify-between items-center">
                      <p class="text-lg font-semibold text-gray-700">Average Rating: <span id="average-rating"
                          class="text-blue-600 font-bold">N/A</span></p>
                      <p class="text-md text-gray-600">Total Reviews: <span id="total-reviews"
                          class="font-semibold">0</span></p>
                    </div>
                  </div>
                </div>

                <script>
                  document.addEventListener('DOMContentLoaded', async () => {
                    const lawyerId = '<%= profile.id %>'; // This is the User ID of the lawyer
                    const feedbackList = document.getElementById('feedback-list');
                    const averageRatingEl = document.getElementById('average-rating');
                    const totalReviewsEl = document.getElementById('total-reviews');
                    const feedbackSpinner = document.getElementById('feedback-spinner');

                    if (!lawyerId || !feedbackList || !feedbackSpinner) {
                      console.error('Required DOM elements for feedback not found.');
                      if (feedbackList) feedbackList.innerHTML = '<p class="text-red-500">Client-side error: Could not initialize feedback section.</p>';
                      if (feedbackSpinner) feedbackSpinner.style.display = 'none';
                      return;
                    }

                    try {
                      const response = await fetch(`/feedback/lawyer/${lawyerId}`);
                      if (feedbackSpinner) feedbackSpinner.style.display = 'none'; // Hide spinner once response is received

                      if (!response.ok) {
                        let errorText = '';
                        try {
                          errorText = await response.text(); // Attempt to get more error details
                        } catch (e) {
                          // If response.text() fails, use a generic message
                          errorText = 'Could not retrieve detailed error from server.';
                        }
                        feedbackList.innerHTML = `<p class="text-red-500 text-center py-4 font-semibold">Could not load feedback. Server responded with ${response.status}.</p><p class="text-gray-600 text-xs text-center">${errorText || ''}</p>`;
                        console.error('Failed to fetch feedback:', response.status, response.statusText, errorText);
                        return;
                      }
                      const data = await response.json();

                      averageRatingEl.textContent = data.averageRating > 0 ? `${data.averageRating} / 5` : 'No ratings yet';
                      totalReviewsEl.textContent = data.totalReviews;

                      if (data.feedback && data.feedback.length > 0) {
                        feedbackList.innerHTML = ''; // Clear loading/error message
                        data.feedback.forEach(fb => {
                          const reviewerName = fb.User && fb.User.firstName && fb.User.lastName ? `${fb.User.firstName} ${fb.User.lastName}` : 'Anonymous User';
                          const feedbackElement = `
                <div class="border border-gray-200 p-6 rounded-xl bg-white shadow-lg hover:shadow-xl transition-shadow duration-300 ease-in-out mb-4">
                  <div class="flex items-center justify-between mb-3">
                    <strong class="text-indigo-600 text-lg font-semibold">${reviewerName}</strong>
                    <div class="text-yellow-400 flex items-center space-x-1">
                      ${[...Array(5)].map((_, i) => `<i class="fas fa-star ${i < fb.rating ? 'text-yellow-400' : 'text-gray-300'} text-md"></i>`).join('')}
                    </div>
                  </div>
                  <p class="text-gray-500 italic text-xs mb-3">Reviewed on: ${new Date(fb.created_at).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
                  <p class="text-gray-700 text-md leading-relaxed">${fb.review || 'No comment provided.'}</p>
                </div>
              `;
                          feedbackList.insertAdjacentHTML('beforeend', feedbackElement);
                        });
                      } else {
                        feedbackList.innerHTML = '<p class="text-gray-500 italic text-center py-6">This lawyer has not received any feedback yet.</p>';
                      }
                    } catch (error) {
                      if (feedbackSpinner) feedbackSpinner.style.display = 'none';
                      feedbackList.innerHTML = '<p class="text-red-600 font-semibold text-center py-4">An unexpected error occurred while loading feedback. Please check the browser console for more details.</p>';
                      console.error('Error fetching or processing feedback:', error);
                    }
                  });
                </script>
                <% } %>

<script>
  async function uploadProfileImage(input) {
    if (input.files && input.files[0]) {
      const file = input.files[0];
      
      // Validate file type
      if (!file.type.startsWith('image/')) {
        alert('Please select an image file.');
        return;
      }
      
      // Validate file size (5MB limit)
      if (file.size > 5 * 1024 * 1024) {
        alert('File size must be less than 5MB.');
        return;
      }
      
      const formData = new FormData();
      formData.append('profileImage', file);
      
      try {
        // Show loading state
        const profileImg = document.getElementById('profileImage');
        const originalSrc = profileImg.src;
        
        const response = await fetch('/in/upload-profile-image', {
          method: 'POST',
          body: formData
        });
        
        const result = await response.json();
        
        if (result.success) {
          // Update the profile image
          profileImg.src = result.imagePath;
          alert('Profile image updated successfully!');
        } else {
          alert('Failed to upload image: ' + (result.error || 'Unknown error'));
          profileImg.src = originalSrc;
        }
      } catch (error) {
        console.error('Error uploading profile image:', error);
        alert('Failed to upload image. Please try again.');
      }
    }
  }
</script>
