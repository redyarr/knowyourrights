<div class="min-h-screen bg-gray-50 py-8">
    <div class="max-w-4xl mx-auto px-4">
        <div class="bg-white rounded-lg shadow-sm border border-gray-200">
            <!-- Notifications header -->
            <div class="p-6 border-b border-gray-200">
                <div class="flex items-center">
                    <div class="w-10 h-10 bg-blue-600 rounded-lg flex items-center justify-center mr-3">
                        <i class="fas fa-bell text-white"></i>
                    </div>
                    <h1 class="text-2xl font-bold text-gray-900">Notifications</h1>
                </div>
            </div>

            <!-- Notifications list -->
            <div class="divide-y divide-gray-200">
                <% if (notifications.length === 0) { %>
                    <div class="p-12 text-center">
                        <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
                            <i class="fas fa-bell text-gray-400 text-xl"></i>
                        </div>
                        <h3 class="text-lg font-semibold text-gray-900 mb-2">No Notifications</h3>
                        <p class="text-gray-600">You're all caught up! Check back later for new notifications.</p>
                    </div>
                <% } else { %>
                    <% notifications.forEach(notification => { %>
                        <div class="p-4 <%= !notification.isRead ? 'bg-blue-50 border-l-4 border-blue-500' : '' %> hover:bg-gray-50 transition-colors">
                            <div class="flex items-start space-x-3">
                                <div class="flex-shrink-0">
                                    <div class="w-10 h-10 <%= !notification.isRead ? 'bg-blue-100' : 'bg-gray-100' %> rounded-full flex items-center justify-center">
                                        <i class="fas fa-bell <%= !notification.isRead ? 'text-blue-600' : 'text-gray-500' %>"></i>
                                    </div>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <h4 class="font-semibold text-gray-900 mb-1">
                                        <%= notification.notification.title %>
                                    </h4>
                                    <p class="text-gray-700 mb-2">
                                        <%= notification.notification.message %>
                                    </p>
                                    <p class="text-sm text-gray-500">
                                        <%= new Date(notification.createdAt).toLocaleDateString() %>
                                    </p>
                                </div>
                                <% if (!notification.isRead) { %>
                                    <form method="POST" action="/notifications/mark-read" class="flex-shrink-0">
                                        <input type="hidden" name="notificationId" value="<%= notification.notificationId %>">
                                        <button type="submit" class="text-blue-600 hover:text-blue-800 p-1 rounded transition-colors" title="Mark as read">
                                            <i class="fas fa-check text-sm"></i>
                                        </button>
                                    </form>
                                <% } %>
                            </div>
                        </div>
                    <% }) %>
                <% } %>
            </div>
        </div>
    </div>
</div>