<nav class="bg-white border-b border-gray-200 fixed w-full top-0 z-50">
  <div class="max-w-7xl mx-auto px-4">
    <div class="flex justify-between h-16 items-center">

      <!-- Left nav -->
      <div class="flex items-center">
        <a href="/" class="flex items-center text-blue-700 font-bold text-xl">
          <i class="fab fa-linkedin mr-2"></i> LegalNet
        </a>
        <div class="ml-4 relative">
          <span class="absolute inset-y-0 left-0 pl-3 flex items-center">
            <i class="fas fa-search text-gray-400"></i>
          </span>
          <input type="text" placeholder="Search"
            class="pl-10 pr-4 py-2 rounded-full border border-gray-300 focus:outline-none focus:ring-1 focus:ring-blue-500">
        </div>
      </div>

      <!-- Center nav -->
      <% if (locals.loggedInUserId) { %>
        <div class="hidden md:flex space-x-8">
          <a href="/"
            class="flex flex-col items-center text-gray-500 hover:text-gray-900 text-sm <%= (path === '/' || path === '/blog') ? 'font-bold text-blue-700' : '' %>">
            <i class="fas fa-home text-xl"></i>
            <span>Home</span>
          </a>
          <a href="/user/network"
            class="flex flex-col items-center text-gray-500 hover:text-gray-900 text-sm <%= path.includes('/user/network') ? 'font-bold text-blue-700' : '' %>">
            <i class="fas fa-user-friends text-xl"></i>
            <span>My Network</span>
          </a>
          <a href="/user/<%= locals.loggedInUserId %>/jobs"
            class="flex flex-col items-center text-gray-500 hover:text-gray-900 text-sm <%= path.includes('/jobs') ? 'font-bold text-blue-700' : '' %>">
            <i class="fas fa-briefcase text-xl"></i>
            <span>Jobs</span>
          </a>
          <a href="/user/<%= locals.loggedInUserId %>/messages"
            class="relative flex flex-col items-center text-gray-500 hover:text-gray-900 text-sm <%= path.includes('/messages') ? 'font-bold text-blue-700' : '' %>">
            <i class="fas fa-comment-dots text-xl"></i>
            <span>Messaging</span>
            <% if (locals.unreadMessageCount> 0) { %>
              <span
                class="absolute top-0 right-0 bg-red-500 text-white text-xs w-4 h-4 rounded-full flex items-center justify-center">
                <%= locals.unreadMessageCount %>
              </span>
              <% } %>
          </a>
          <a href="/user/<%= locals.loggedInUserId %>/notifications"
            class="relative flex flex-col items-center text-gray-500 hover:text-gray-900 text-sm <%= path.includes('/notifications') ? 'font-bold text-blue-700' : '' %>">
            <i class="fas fa-bell text-xl"></i>
            <span>Notifications</span>
            <% if (locals.unreadNotificationCount> 0) { %>
              <span
                class="absolute top-0 right-0 bg-red-500 text-white text-xs w-4 h-4 rounded-full flex items-center justify-center">
                <%= locals.unreadNotificationCount %>
              </span>
              <% } %>
          </a>
        </div>
        <% } %>

          <!-- Right nav -->
          <div class="flex items-center space-x-4">
            <% if (locals.loggedInUserId) { %>
              <div class="relative group">
                <button id="profileButton" class="flex items-center text-gray-500 hover:text-gray-900 focus:outline-none">
                  <img src="https://ui-avatars.com/api/?background=random" alt="Profile" class="h-8 w-8 rounded-full">
                  <span class="ml-2 text-sm">Me <i class="fas fa-caret-down ml-1"></i></span>
                </button>
                <div id="profileMenu"
                  class="absolute right-0 mt-2 w-64 bg-white border border-gray-200 rounded-lg shadow-lg hidden z-50">
                  <div class="p-4 border-b">
                    <div class="flex items-center space-x-3">
                      <img src="https://ui-avatars.com/api/?background=random" alt="Profile"
                        class="h-16 w-16 rounded-full">
                      <div>
                        <h4 class="font-semibold text-gray-800">
                          <%= user.firstName %>
                            <%= user.lastName %>
                        </h4>
                        <p class="text-sm text-gray-600">
                          <%= user.role==='lawyer' ? 'Lawyer' : 'Member' %>
                        </p>
                      </div>
                    </div>
                    <a href="/user/<%= locals.loggedInUserId %>"
                      class="block mt-2 px-4 py-2 text-sm text-blue-600 text-center hover:bg-blue-50 rounded-md">View
                      Profile</a>
                  </div>
                  <div class="py-2">
                    <a href="/settings" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">Settings &
                      Privacy</a>
                    <a href="/help" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">Help Center</a>
                    <a href="/user/logout" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">Sign Out</a>
                  </div>
                </div>
              </div>
              <% } else { %>
                <a href="/user/login" class="text-gray-700 hover:text-gray-900 px-3 py-2">Sign in</a>
                <a href="/user/register"
                  class="ml-4 px-4 py-2 rounded-full text-blue-700 hover:bg-blue-50 border border-blue-700">Join now</a>
                <% } %>
          </div>
    </div>
  </div>
</nav>
<script>
  document.getElementById('profileButton').addEventListener('click', function() {
    var menu = document.getElementById('profileMenu');
    menu.classList.toggle('hidden');
  });
</script>