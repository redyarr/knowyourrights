                                <div class="relative">
                                    <img src="<%= postPhoto.photo.photoPath %>" alt="Post Image" class="post-image object-cover rounded-lg">
                                </div>
                            <% } %>
                                        <% }); %>
                                    </div>
                                <% } %>
                            </div>
                        <% } %>
                        
                        <!-- Post Stats -->
