                            <div class="relative">
                                <img src="<%= postPhoto.photo.photoPath %>" alt="Post Image" class="post-image object-contain rounded-lg">
                            </div>
                        <% } %>
                                    <% }); %>
                                <% } else { %>
                                    <div class="grid grid-cols-2 gap-2 px-4">
