<% // Define reaction icons for use in grouping and popup 
 let reactionTypes={ like: '👍' , love: '❤️' , haha: '😂' , wow: '😮' , sad: '😢' , angry: '😠' };
%>
<style>
  .modal-hidden {
    display: none !important;
  }
  
  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateX(-50%) translateY(20px) scale(0.8);
    }
    to {
      opacity: 1;
      transform: translateX(-50%) translateY(0) scale(1);
    }
  }
  
  @keyframes reactionBounce {
    0% { transform: scale(1) rotate(0deg); }
    25% { transform: scale(1.2) rotate(-5deg); }
    50% { transform: scale(1.1) rotate(5deg); }
    75% { transform: scale(1.15) rotate(-2deg); }
    100% { transform: scale(1) rotate(0deg); }
  }
  
  @keyframes floatUp {
    0% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
    100% {
      opacity: 0;
      transform: translateY(-100px) scale(2) rotate(360deg);
    }
  }
  
  @keyframes pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.05); }
  }
  
  @keyframes shimmer {
    0% { background-position: -200% 0; }
    100% { background-position: 200% 0; }
  }
  
  .reaction-popup {
    animation: slideUp 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  
  .reaction-btn:hover {
    animation: reactionBounce 0.6s ease-in-out;
  }
  
  .like-button:active {
    animation: pulse 0.3s ease-in-out;
  }
  
  .floating-reaction {
    animation: floatUp 1s ease-out forwards;
  }
  
  .shimmer-effect {
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
    background-size: 200% 100%;
    animation: shimmer 1.5s infinite;
  }
  
  .reaction-stats {
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  
  .reaction-icon {
    transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  
  .notification-enter {
    animation: slideInRight 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  
  @keyframes slideInRight {
    from {
      transform: translateX(100%) scale(0.8);
      opacity: 0;
    }
    to {
      transform: translateX(0) scale(1);
      opacity: 1;
    }
  }
  
  /* Enhanced Mobile responsive styles for feed */
  @media (max-width: 768px) {
    .grid.grid-cols-1.lg\:grid-cols-12 {
      display: block !important;
      grid-template-columns: none !important;
    }
    
    .lg\:col-span-3 {
      display: none;
    }
    
    .lg\:col-span-6 {
      width: 100%;
    }
    
    .max-w-7xl {
      padding-left: 0.5rem;
      padding-right: 0.5rem;
    }
    
    .rounded-3xl {
      border-radius: 1rem;
    }
    
    .p-8 {
      padding: 1rem;
    }
    
    .p-6 {
      padding: 0.75rem;
    }
    
    .space-y-8 > * + * {
      margin-top: 1rem;
    }
    
    .mb-10 {
      margin-bottom: 1rem;
    }
    
    /* Post content adjustments */
    .text-2xl {
      font-size: 1.25rem;
    }
    
    .text-xl {
      font-size: 1.125rem;
    }
    
    /* Image adjustments */
    .w-full.h-auto {
      max-height: 300px;
      object-fit: cover;
    }
    
    /* Button adjustments */
    .flex.items-center.space-x-4 {
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    
    /* Modal adjustments for mobile */
    .fixed.inset-0 .bg-white {
      margin: 1rem;
      max-height: calc(100vh - 2rem);
      overflow-y: auto;
    }
  }
  
  @media (max-width: 480px) {
    .py-8 {
      padding-top: 1rem;
      padding-bottom: 1rem;
    }
    
    .gap-8 {
      gap: 1rem;
    }
    
    .text-lg {
      font-size: 1rem;
    }
    
    .px-4 {
      padding-left: 0.5rem;
      padding-right: 0.5rem;
    }
  }
</style>
    <div class="max-w-6xl mx-auto px-4 py-6">
        <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
            <!-- Left Sidebar -->
            <div class="lg:col-span-1 space-y-4">
                <% if (locals.loggedInUserId) { %>
                    <!-- Profile Card -->
                    <div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
                        <!-- Cover Photo -->
                        <div class="h-16 bg-gradient-to-r from-blue-600 to-blue-700"></div>
                        <div class="px-4 pb-4">
                            <div class="relative -mt-8 mb-4">
                                <img src="<%= locals.user && locals.user.profilePicture ? locals.user.profilePicture : 'https://ui-avatars.com/api/?name=' + encodeURIComponent(locals.user ? (locals.user.firstName + ' ' + locals.user.lastName) : 'User') + '&size=64&background=3b82f6&color=ffffff' %>" alt="Profile" class="w-16 h-16 rounded-full border-4 border-white object-cover">
                            </div>
                            <h3 class="font-semibold text-gray-900 text-sm mb-1"><%= locals.user ? (locals.user.firstName + ' ' + locals.user.lastName) : 'User' %></h3>
                            <p class="text-xs text-gray-500 mb-3"><%= locals.user ? locals.user.headline || 'Professional' : '' %></p>
                            <a href="/profile/<%= locals.loggedInUserId %>" class="text-blue-600 hover:text-blue-700 text-xs font-semibold">View profile</a>
                        </div>
                        <div class="border-t border-gray-200 px-4 py-3">
                            <div class="flex justify-between text-xs text-gray-600">
                                <span>Profile viewers</span>
                                <span class="text-blue-600 font-semibold">12</span>
                            </div>
                            <div class="flex justify-between text-xs text-gray-600 mt-2">
                                <span>Post impressions</span>
                                <span class="text-blue-600 font-semibold">1,204</span>
                            </div>
                        </div>
                        <div class="border-t border-gray-200 px-4 py-3">
                            <a href="/premium" class="flex items-center text-xs text-gray-600 hover:text-gray-900">
                                <i class="fas fa-crown text-yellow-500 mr-2"></i>
                                Try Premium for free
                            </a>
                        </div>
                    </div>
                <% } %>
                <!-- Recent Activity -->
                <div class="bg-white rounded-lg border border-gray-200">
                    <div class="px-4 py-3 border-b border-gray-200">
                        <h3 class="font-semibold text-gray-900 text-sm">Recent</h3>
                    </div>
                    <div class="px-4 py-2">
                        <a href="/groups/family-law" class="flex items-center py-2 text-xs text-gray-600 hover:text-gray-900">
                            <i class="fas fa-users mr-3 text-gray-400"></i>
                            Family Law Group
                        </a>
                        <a href="/groups/employment" class="flex items-center py-2 text-xs text-gray-600 hover:text-gray-900">
                            <i class="fas fa-users mr-3 text-gray-400"></i>
                            Employment Rights
                        </a>
                        <a href="/groups/consumer" class="flex items-center py-2 text-xs text-gray-600 hover:text-gray-900">
                            <i class="fas fa-users mr-3 text-gray-400"></i>
                            Consumer Protection
                        </a>
                    </div>
                    <div class="px-4 py-3 border-t border-gray-200">
                        <h3 class="font-semibold text-gray-900 text-sm mb-2">Groups</h3>
                        <a href="/groups" class="flex items-center py-2 text-xs text-gray-600 hover:text-gray-900">
                            <i class="fas fa-users mr-3 text-gray-400"></i>
                            Legal Professionals
                        </a>
                        <a href="/groups" class="flex items-center py-2 text-xs text-gray-600 hover:text-gray-900">
                            <i class="fas fa-users mr-3 text-gray-400"></i>
                            Know Your Rights
                        </a>
                        <div class="mt-3">
                            <a href="/groups" class="text-xs text-gray-500 hover:text-blue-600">Show all (5)</a>
                        </div>
                    </div>
                    <div class="px-4 py-3 border-t border-gray-200">
                        <h3 class="font-semibold text-gray-900 text-sm mb-2">Followed Hashtags</h3>
                        <a href="/hashtag/legaladvice" class="flex items-center py-2 text-xs text-gray-600 hover:text-gray-900">
                            <span class="mr-3">#</span>
                            legaladvice
                        </a>
                        <a href="/hashtag/knowyourrights" class="flex items-center py-2 text-xs text-gray-600 hover:text-gray-900">
                            <span class="mr-3">#</span>
                            knowyourrights
                        </a>
                    </div>
                    <div class="px-4 py-3 border-t border-gray-200">
                        <a href="/discover" class="text-xs text-gray-500 hover:text-blue-600">Discover more</a>
                    </div>
                </div>
            </div>

            <!-- Main Content -->
            <div class="lg:col-span-2 space-y-4">
                <% if (locals.loggedInUserId && locals.userRole === 'lawyer') { %>
                    <!-- Post Creation Box for Lawyers -->
                    <div class="bg-white rounded-lg border border-gray-200 p-4">
                        <div class="flex items-center space-x-3">
                            <img src="<%= locals.user && locals.user.profilePicture ? locals.user.profilePicture : 'https://ui-avatars.com/api/?name=' + encodeURIComponent(locals.user ? (locals.user.firstName + ' ' + locals.user.lastName) : 'User') + '&size=48&background=3b82f6&color=ffffff' %>" alt="Profile" class="w-12 h-12 rounded-full object-cover">
                            <button onclick="togglePostModal()" class="flex-1 border border-gray-300 rounded-full px-4 py-3 text-left text-gray-500 hover:bg-gray-50 transition-colors duration-200">Share legal insights...</button>
                        </div>
                        <div class="flex items-center justify-between mt-4 pt-3 border-t border-gray-200">
                            <button class="flex items-center space-x-2 text-gray-600 hover:bg-gray-100 px-3 py-2 rounded-lg transition-colors duration-200">
                                <i class="fas fa-image text-blue-600"></i>
                                <span class="text-sm font-medium">Photo</span>
                            </button>
                            <button class="flex items-center space-x-2 text-gray-600 hover:bg-gray-100 px-3 py-2 rounded-lg transition-colors duration-200">
                                <i class="fas fa-video text-green-600"></i>
                                <span class="text-sm font-medium">Video</span>
                            </button>
                            <button class="flex items-center space-x-2 text-gray-600 hover:bg-gray-100 px-3 py-2 rounded-lg transition-colors duration-200">
                                <i class="fas fa-file-alt text-red-600"></i>
                                <span class="text-sm font-medium">Document</span>
                            </button>
                            <button class="flex items-center space-x-2 text-gray-600 hover:bg-gray-100 px-3 py-2 rounded-lg transition-colors duration-200">
                                <i class="fas fa-calendar text-orange-600"></i>
                                <span class="text-sm font-medium">Event</span>
                            </button>
                        </div>
                    </div>
                <% } %>
                
                <% if (locals.loggedInUserId && locals.userRole !== 'lawyer') { %>
                    <!-- Quick Actions for Non-Lawyers -->
                    <div class="bg-white rounded-lg border border-gray-200 p-4">
                        <div class="grid grid-cols-3 gap-3">
                            <a href="/search" class="flex flex-col items-center p-3 bg-gray-50 rounded-lg hover:bg-blue-50 transition-all duration-200 group">
                                <i class="fas fa-search text-blue-600 text-lg mb-2 group-hover:scale-110 transition-transform"></i>
                                <span class="text-xs text-gray-700 font-medium text-center">Find Lawyers</span>
                                </a>
                                
                            <a href="/mynetwork" class="flex flex-col items-center p-3 bg-gray-50 rounded-lg hover:bg-green-50 transition-all duration-200 group">
                                <i class="fas fa-users text-green-600 text-lg mb-2 group-hover:scale-110 transition-transform"></i>
                                <span class="text-xs text-gray-700 font-medium text-center">Network</span>
                            </a>
                            
                            <a href="/jobs" class="flex flex-col items-center p-3 bg-gray-50 rounded-lg hover:bg-purple-50 transition-all duration-200 group">
                                <i class="fas fa-briefcase text-purple-600 text-lg mb-2 group-hover:scale-110 transition-transform"></i>
                                <span class="text-xs text-gray-700 font-medium text-center">Jobs</span>
                            </a>
                        </div>
                    </div>
                <% } %>
                
                <% if (posts && posts.length > 0) { %>
                    <% posts.forEach(post => { let groupedReactions = {}; if (post.reacts && post.reacts.length > 0) { post.reacts.forEach(r => { groupedReactions[r.reaction] = (groupedReactions[r.reaction] || 0) + 1; }); } %>
                    <div id="post-<%= post.id %>" class="bg-white rounded-lg border border-gray-200 mb-4 hover:shadow-md transition-shadow duration-200">
                        <!-- Post Header -->
                        <div class="p-4">
                            <div class="flex items-start justify-between">
                                <div class="flex items-start space-x-3">
                                    <a href="/in/<%= post.user ? post.user.id : '#' %>" class="flex-shrink-0">
                                        <img src="<%= post.user && post.user.profilePicture ? post.user.profilePicture : 'https://ui-avatars.com/api/?name=' + encodeURIComponent(post.user ? (post.user.firstName + ' ' + post.user.lastName) : 'User') + '&size=48&background=0D47A1&color=fff' %>" alt="Profile" class="w-12 h-12 rounded-full object-cover">
                                    </a>
                                    <div class="flex-1 min-w-0">
                                        <div class="flex items-center space-x-2">
                                            <a href="/in/<%= post.user ? post.user.id : '#' %>" class="font-semibold text-gray-900 hover:text-blue-600 hover:underline text-sm">
                                                <%= post.user ? post.user.firstName : '' %> <%= post.user ? post.user.lastName : '' %>
                                            </a>
                                            <% if (post.user && post.user.role==='lawyer' && post.user.lawyer) { %>
                                                <% 
                                                    let rankBadge = 'Training Lawyer';
                                                    let rankIcon = 'fas fa-graduation-cap';
                                                    let rankColor = 'text-blue-600';
                                                    
                                                    if (post.user.lawyer.verificationStatus === 'approved') {
                                                        rankBadge = 'Verified Lawyer';
                                                        rankIcon = 'fas fa-certificate';
                                                        rankColor = 'text-green-600';
                                                    } else if (post.user.lawyer.verificationStatus === 'pending') {
                                                        rankBadge = 'Pending Verification';
                                                        rankIcon = 'fas fa-clock';
                                                        rankColor = 'text-yellow-600';
                                                    } else if (post.user.lawyer.verificationStatus === 'rejected') {
                                                        rankBadge = 'Verification Rejected';
                                                        rankIcon = 'fas fa-times-circle';
                                                        rankColor = 'text-red-600';
                                                    }
                                                %>
                                                <span class="inline-flex items-center text-xs <%= rankColor %>">
                                                    <i class="<%= rankIcon %> mr-1"></i>
                                                    <%= rankBadge %>
                                                </span>
                                            <% } %>
                                        </div>
                                        <div class="flex items-center text-xs text-gray-500 mt-1">
                                            <% if (post.user && post.user.role==='lawyer' && post.user.lawyer) { %>
                                                <span class="font-medium"><%= post.user.lawyer.lawFirm %></span>
                                                <span class="mx-1">•</span>
                                            <% } %>
                                            <time><%= new Date(post.createdAt).toLocaleDateString() %></time>
                                            <span class="mx-1">•</span>
                                            <div class="flex items-center">
                                                <i class="fas fa-globe-americas mr-1"></i>
                                                <span>Public</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <% if (locals.loggedInUserId && (post.userId === locals.loggedInUserId || post.authorId === locals.loggedInUserId)) { %>
                                    <div class="flex items-center space-x-1">
                                        <button class="p-2 text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded-full transition-colors edit-post-btn" title="Edit Post" data-post-id="<%= post.id %>" data-title="<%- post.title.replace(/&/g, '&amp;').replace(/\"/g, '&quot;') %>" data-content="<%- post.content.replace(/&/g, '&amp;').replace(/\"/g, '&quot;') %>">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536M9 13l6.586-6.586a2 2 0 112.828 2.828L11.828 15.828a2 2 0 01-2.828 0L9 13zm0 0V21h8"></path>
                                            </svg>
                                        </button>
                                        <button class="p-2 text-gray-400 hover:text-red-500 hover:bg-gray-100 rounded-full transition-colors delete-post-btn" title="Delete Post" data-post-id="<%= post.id %>">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                            </svg>
                                        </button>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                        
                        <!-- Post Content -->
                        <div class="px-4">
                            <% if (post.title && post.title.trim()) { %>
                                <h2 class="text-gray-900 font-medium text-base mb-3 leading-snug"><%= post.title %></h2>
                            <% } %>
                            <div class="text-gray-700 text-sm leading-relaxed mb-3">
                                <p><%= post.content.length > 300 ? post.content.substring(0, 300) + '...' : post.content %></p>
                                <% if (post.content.length > 300) { %>
                                    <button class="text-blue-600 hover:text-blue-800 font-medium mt-2 text-sm">...see more</button>
                                <% } %>
                            </div>
                        </div>
                        
                        <!-- Post Images -->
                        <% if (post.post_photos && post.post_photos.length > 0) { %>
                            <div class="mb-3">
                                <% if (post.post_photos.length === 1) { %>
                                    <% post.post_photos.forEach(postPhoto => { %>
                                        <% if (postPhoto.photo && postPhoto.photo.photoPath) { %>
                                            <div class="relative">
                                                <img src="<%= postPhoto.photo.photoPath.startsWith('/') ? postPhoto.photo.photoPath : '/' + postPhoto.photo.photoPath %>" alt="Post Image" class="w-full h-auto object-cover rounded-lg" style="max-height: 500px;">
                                            </div>
                                        <% } %>
                                    <% }); %>
                                <% } else { %>
                                    <div class="grid grid-cols-2 gap-2 px-4">
                                        <% post.post_photos.forEach(postPhoto => { %>
                                            <% if (postPhoto.photo && postPhoto.photo.photoPath) { %>
                                                <div class="relative">
                                                    <img src="<%= postPhoto.photo.photoPath.startsWith('/') ? postPhoto.photo.photoPath : '/' + postPhoto.photo.photoPath %>" alt="Post Image" class="w-full h-48 object-cover rounded-lg">
                                                </div>
                                            <% } %>
                                        <% }); %>
                                    </div>
                                <% } %>
                            </div>
                        <% } %>
                        
                        <!-- Post Stats -->
                        <div class="px-4 py-2">
                            <div class="flex items-center justify-between text-sm text-gray-500">
                                <div class="flex items-center space-x-4">
                                    <% if (post.reacts && post.reacts.length > 0) { %>
                                        <button class="flex items-center space-x-2 hover:text-blue-600 transition-colors" id="reactionStats-<%= post.id %>">
                                            <div class="flex -space-x-1">
                                                <% Object.keys(groupedReactions).slice(0, 3).forEach(key => { %>
                                                    <span class="text-sm bg-white rounded-full border border-gray-200 w-6 h-6 flex items-center justify-center shadow-sm"><%= reactionTypes[key] %></span>
                                                <% }); %>
                                            </div>
                                            <span class="reaction-count font-medium"><%= post.reacts.length %></span>
                                        </button>
                                    <% } else { %>
                                        <div class="hidden flex items-center space-x-2" id="reactionStats-<%= post.id %>">
                                            <div class="flex -space-x-1" id="reactionIcons-<%= post.id %>"></div>
                                            <span class="reaction-count font-medium">0</span>
                                        </div>
                                    <% } %>
                                </div>
                                <button class="hover:text-blue-600 transition-colors font-medium" onclick="toggleComments(<%= post.id %>)">
                                    <span class="comment-count"><%= post.comments ? post.comments.length : 0 %> comments</span>
                                </button>
                            </div>
                        </div>
                        
                        <!-- Post Actions -->
                        <div class="px-4 py-3 border-t border-gray-100">
                            <div class="flex items-center justify-around">
                                <div class="relative">
                                    <button class="flex items-center space-x-2 text-gray-600 hover:bg-gray-100 px-6 py-2 rounded-lg transition-colors like-button" onclick="toggleReactionPopup(<%= post.id %>, this)">
                                        <i class="far fa-thumbs-up text-lg"></i>
                                        <span class="text-sm font-medium">Like</span>
                                    </button>
                                    <div id="reactionPopup-<%= post.id %>" class="hidden absolute bg-white rounded-lg shadow-lg border border-gray-200 p-2 z-40 reaction-popup" style="bottom: 100%; left: 50%; transform: translateX(-50%); margin-bottom: 8px;">
                                        <div class="flex space-x-1">
                                            <% Object.entries(reactionTypes).forEach(([key, emoji]) => { %>
                                                <button onclick="submitReaction(<%= post.id %>, '<%= key %>', this)" class="reaction-btn text-xl hover:scale-110 transition-transform p-1 rounded" title="<%= key.charAt(0).toUpperCase() + key.slice(1) %>" data-reaction="<%= key %>">
                                                    <%= emoji %>
                                                </button>
                                            <% }); %>
                                        </div>
                                        <div class="absolute top-full left-1/2 transform -translate-x-1/2 w-0 h-0 border-l-4 border-l-transparent border-r-4 border-r-transparent border-t-4 border-t-gray-200"></div>
                                    </div>
                                </div>
                                <button class="flex items-center space-x-2 text-gray-600 hover:bg-gray-100 px-6 py-2 rounded-lg transition-colors" onclick="toggleCommentForm(<%= post.id %>)">
                                    <i class="far fa-comment text-lg"></i>
                                    <span class="text-sm font-medium">Comment</span>
                                </button>
                                <% if (locals.loggedInUserId) { %>
                                    <button class="flex items-center space-x-2 text-gray-600 hover:bg-gray-100 px-6 py-2 rounded-lg transition-colors" onclick="sharePost(<%= post.id %>)">
                                        <i class="fas fa-share text-lg"></i>
                                        <span class="text-sm font-medium">Share</span>
                                    </button>
                                <% } else { %>
                                    <button class="flex items-center space-x-2 text-gray-400 px-6 py-2 rounded-lg cursor-not-allowed" disabled>
                                        <i class="far fa-share text-lg"></i>
                                        <span class="text-sm font-medium">Share</span>
                                    </button>
                                <% } %>
                            </div>
                            <div class="px-4 py-2 border-t border-gray-200 mt-3">
                                <% if (post.comments && post.comments.length > 0) { %>
                                    <button id="showCommentsBtn-<%= post.id %>" class="text-sm text-blue-600 hover:text-blue-800 mb-3" onclick="toggleComments(<%= post.id %>)">Show Comments (<%= post.comments.length %>)</button>
                                    <div id="commentsList-<%= post.id %>" class="space-y-3 hidden">
                                        <% const initialComments = post.comments.slice(0, 4); const hasMoreComments = post.comments.length > 4; %>
                                        <% initialComments.forEach(comment => { %>
                                            <div class="px-3 py-3 border-t border-gray-100 comment-item" data-comment-id="<%= comment.id %>">
                                                <div class="flex items-start space-x-3">
                                                    <a href="/in/<%= comment.user ? comment.user.id : '#' %>" class="flex-shrink-0">
