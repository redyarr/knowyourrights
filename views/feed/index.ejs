    }
  }

  /* Main content area */
  .main-feed {
    max-width: 600px;
    margin: 0 auto;
    width: 100%;
  }

  /* Post cards */
  .post-card {
    background: white;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    border: 1px solid #e5e7eb;
    margin-bottom: 1.5rem;
