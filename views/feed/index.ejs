                                        <span class="text-xs sm:text-sm font-medium hidden xs:inline">Share</span>
                                    </button>
                                <% } else { %>
                                    <button class="flex items-center space-x-1 sm:space-x-2 text-gray-400 px-2 sm:px-6 py-2 rounded-lg cursor-not-allowed" disabled>
                                        <i class="far fa-share text-lg"></i>
                                        <span class="text-xs sm:text-sm font-medium hidden xs:inline">Share</span>
                                    </button>
                                <% } %>
                            </div>
                            <div class="px-4 py-2 border-t border-gray-200 mt-3">
