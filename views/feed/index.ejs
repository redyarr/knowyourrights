<% // Define reaction icons for use in grouping and popup 
 let reactionTypes={ like: '👍' , love: '❤️' , haha: '😂' , wow: '😮' , sad: '😢' , angry: '😠' };
%>
    <div class="max-w-7xl mx-auto px-4">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-5">
            <!-- Left Sidebar -->
            <div class="lg:col-span-3">
                <!-- Profile Card -->
                <% if (locals.loggedInUserId) { %>
                    <div class="bg-white rounded-lg shadow mb-4">
                        <div class="p-4 text-center">
                            <img src="https://media.licdn.com/dms/image/v2/D4D03AQF9FvdZ1W1_9g/profile-displayphoto-shrink_400_400/profile-displayphoto-shrink_400_400/0/1712227644410?e=1746662400&v=beta&t=h_guvHTPpOuEEWiAAnuGwQLiaaMLVRgSJGwzP79vRlU"
                                alt="Profile" class="mx-auto rounded-full mb-3"
                                style="width: 80px; height: 80px; object-fit: cover;">
                            <h5 class="font-semibold mb-1">Your Profile</h5>
                            <p class="text-sm text-gray-500 mb-3">View your profile</p>
                            <a href="/in"
                                class="block bg-blue-500 text-white py-1 rounded text-sm">View
                                Profile</a>
                        </div>
                    </div>
                    <% } %>

                        <!-- Topics Card -->
                        <div class="bg-white rounded-lg shadow mb-4">
                            <div class="border-b px-4 py-2">
                                <h6 class="font-semibold text-gray-700">Recent Topics</h6>
                            </div>
                            <div class="p-4">
                                <ul class="space-y-2">
                                    <li><a href="#" class="text-blue-600 hover:underline text-sm">Corporate Law</a></li>
                                    <li><a href="#" class="text-blue-600 hover:underline text-sm">Family Law</a></li>
                                    <li><a href="#" class="text-blue-600 hover:underline text-sm">Criminal Defense</a>
                                    </li>
                                    <li><a href="#" class="text-blue-600 hover:underline text-sm">Intellectual
                                            Property</a></li>
                                    <li><a href="#" class="text-blue-600 hover:underline text-sm">Immigration Law</a>
                                    </li>
                                </ul>
                            </div>
                        </div>
            </div>

            <!-- Main Content -->
            <div class="lg:col-span-6">
                 <!-- Post Creator -->
    <% if (locals.loggedInUserId) { %>
        <div class="bg-white rounded-lg shadow mb-4">
            <div class="p-4">
                <div class="flex items-center space-x-3">
                    <img src="https://media.licdn.com/dms/image/v2/D4D03AQF9FvdZ1W1_9g/profile-displayphoto-shrink_400_400/profile-displayphoto-shrink_400_400/0/1712227644410?e=1746662400&v=beta&t=h_guvHTPpOuEEWiAAnuGwQLiaaMLVRgSJGwzP79vRlU"
                        alt="Profile" class="rounded-full"
                        style="width: 40px; height: 40px; object-fit: cover;">
                    <button onclick="togglePostModal()"
                        class="flex-1 border border-gray-300 rounded-full px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">
                        Start a post
                    </button>
                </div>
            </div>
        </div>
    <% } %>

                        <!-- Posts -->
                        <% if (posts && posts.length> 0) { %>
                            <% posts.forEach(post=> {
                                // Group reactions by type for display
                                let groupedReactions = {};
                                if (post.reacts && post.reacts.length > 0) {
                                post.reacts.forEach(r => {
                                groupedReactions[r.reaction] = (groupedReactions[r.reaction] || 0) + 1;
                                });
                                }
                                %>
                                <div class="bg-white rounded-lg shadow mb-4">
                                    <div class="p-4">
                                        <!-- Post Header -->
                                        <div class="flex items-center mb-3">
                                            <img src="https://ui-avatars.com/api/?background=random" alt="Profile"
                                                class="rounded-full mr-3"
                                                style="width: 48px; height: 48px; object-fit: cover;">
                                            <div>
                                                <h6 class="font-semibold text-gray-800">
                                                    <%= post.user.dataValues.first_name %>
                                                        <%= post.user.dataValues.last_name %>
                                                            <% if (post.user.role==='lawyer' && post.user.lawyer) { %>
                                                                <span class="text-sm text-gray-500">• Lawyer at <%=
                                                                        post.user.lawyer.lawFirm %></span>
                                                                <% } %>
                                                </h6>
                                                <p class="text-xs text-gray-500">
                                                    <%= new Date(post.createdAt).toLocaleDateString() %>
                                                </p>
                                            </div>
                                        </div>
                                        <!-- Post Content -->
                                        <h5 class="font-bold text-gray-800 mb-2">
                                            <%= post.title %>
                                        </h5>
                                        <p class="text-gray-700 mb-3">
                                            <%= post.content.length> 150 ? post.content.substring(0, 150) + '...' :
                                                post.content %>
                                        </p>
                                        <% if (post.image) { %>
                                            <img src="<%= post.image %>" alt="<%= post.title %>"
                                                class="w-full rounded mb-3">
                                            <% } %>
                                                <!-- Post Stats -->
                                                <div
                                                    class="flex justify-between items-center text-sm text-gray-500 border-t pt-2 mb-2">
                                                    <div class="flex items-center">
                                                        <% if (post.reacts && post.reacts.length> 0) { %>
                                                            <div class="flex items-center mr-2">
                                                                <% Object.keys(groupedReactions).forEach(key=> { %>
                                                                    <span class="mr-1 text-lg">
                                                                        <%= reactionTypes[key] %>
                                                                    </span>
                                                                    <% }); %>
                                                                        <span class="ml-1">
                                                                            <%= post.reacts.length %>
                                                                        </span>
                                                            </div>
                                                            <% } %>
                                                    </div>
                                                    <span>
                                                        <%= post.comments ? post.comments.length : 0 %> comments
                                                    </span>
                                                </div>
                                                <!-- Post Actions -->
                                                <div class="flex justify-around border-t pt-2">
                                                    <button
                                                        class="flex items-center space-x-1 text-gray-600 hover:text-blue-600">
                                                        <i class="far fa-thumbs-up"></i>
                                                        <span>Like</span>
                                                    </button>
                                                    <button
                                                        class="flex items-center space-x-1 text-gray-600 hover:text-blue-600">
                                                        <i class="far fa-comment"></i>
                                                        <span>Comment</span>
                                                    </button>
                                                    <button
                                                        class="flex items-center space-x-1 text-gray-600 hover:text-blue-600">
                                                        <i class="far fa-share-square"></i>
                                                        <span>Share</span>
                                                    </button>
                                                </div>

                                                <div class="px-4 py-2 border-t border-gray-200 mt-3">
                                                    <!-- Comments List -->
                                                    <div class="space-y-3">
                                                        <% if (post.comments && post.comments.length> 0) { %>
                                                            <% post.comments.forEach(comment=> { %>
                                                                <div class="flex items-start space-x-3">
                                                                    <img src="https://ui-avatars.com/api/?name=<%= comment.user ? comment.user.firstName + ' ' + comment.user.lastName : 'User' %>"
                                                                        alt="Commenter" class="rounded-full"
                                                                        style="width: 32px; height: 32px; object-fit: cover;">
                                                                    <div>
                                                                        <div class="bg-gray-100 rounded-lg px-3 py-2">
                                                                            <p class="text-sm text-gray-800">
                                                                                <%= comment.content %>
                                                                            </p>
                                                                        </div>
                                                                        <div class="mt-1 text-xs text-gray-500">
                                                                            <span>
                                                                                <%= new
                                                                                    Date(comment.createdAt).toLocaleDateString()
                                                                                    %>
                                                                            </span>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <% }); %>
                                                                    <% } %>
                                                    </div>

                                                    <!-- Add Comment & React Input -->
                                                    <% if (locals.loggedInUserId) { %>
                                                        <div class="mt-3 flex items-center space-x-3 border-t pt-3">
                                                            <img src="https://ui-avatars.com/api/?background=random"
                                                                alt="Your avatar" class="rounded-full"
                                                                style="width: 32px; height: 32px; object-fit: cover;">
                                                            <form action="/post/<%= post.id %>/comment" method="POST"
                                                                class="flex-1">
                                                                <input type="text" name="content"
                                                                    placeholder="Add a comment"
                                                                    class="w-full border border-gray-300 rounded-full px-3 py-1 text-sm focus:outline-none focus:ring-1 focus:ring-blue-500">
                                                            </form>
                                                            <!-- React Button with Reaction Popup -->
                                                            <div class="relative">
                                                                <button type="button"
                                                                    class="text-gray-500 hover:text-blue-500 focus:outline-none"
                                                                    onclick="toggleReactionPopup(<%= post.id %>)">
                                                                    <i class="far fa-thumbs-up"></i>
                                                                </button>
                                                                <!-- Reaction Popup -->
                                                                <div id="reactionPopup-<%= post.id %>"
                                                                    class="hidden absolute bottom-full mb-2 left-0 bg-white border border-gray-200 rounded-lg shadow-lg p-2 flex space-x-2">
                                                                    <% Object.keys(reactionTypes).forEach(rt=> { %>
                                                                        <button type="button"
                                                                            onclick="submitReaction(<%= post.id %>, '<%= rt %>')"
                                                                            class="text-xl">
                                                                            <%= reactionTypes[rt] %>
                                                                        </button>
                                                                        <% }); %>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <% } %>
                                                </div>
                                    </div>
                                </div>
                                <% }); %>
                                    <% } else { %>
                                        <div class="bg-white rounded-lg shadow mb-4">
                                            <div class="p-4">
                                                <div class="bg-blue-100 text-blue-700 rounded p-3 text-center text-sm">
                                                    No posts found. <% if (locals.loggedInUserId) { %>
                                                        <a href="/blog/create" class="text-blue-600 underline">Create
                                                            one</a>
                                                        <% } %>
                                                </div>
                                            </div>
                                        </div>
                                        <% } %>
            </div>

            <!-- Modal for Creating a Post -->
<div id="postModal" class="fixed inset-0 bg-black bg-opacity-50 hidden flex items-center justify-center z-50">
    <div class="bg-white rounded-lg shadow-lg w-96 p-6 relative">
        <button onclick="togglePostModal()" class="absolute top-2 right-2 text-gray-500 hover:text-gray-700">
            &times;
        </button>
        <h3 class="text-lg font-semibold mb-4">Create a Post</h3>
        <form action="/in/<%=user.id%>/create-post" method="POST" >
            <div class="mb-4">
                <label for="title" class="block text-sm font-medium text-gray-700">Title</label>
                <input type="text" name="title" id="title" required
                    class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-1 focus:ring-blue-500">
            </div>
            <div class="mb-4">
                <label for="content" class="block text-sm font-medium text-gray-700">Content</label>
                <textarea name="content" id="content" rows="4" required
                    class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-1 focus:ring-blue-500"></textarea>
            </div>
          
            <button type="submit"
                class="w-full bg-blue-500 text-white py-2 rounded-lg hover:bg-blue-600 focus:outline-none">
                Post
            </button>
        </form>
    </div>
</div>

            <!-- Right Sidebar -->
            <div class="lg:col-span-3">
                <!-- Trending Card -->
                <div class="bg-white rounded-lg shadow mb-4">
                    <div class="border-b px-4 py-2">
                        <h6 class="font-semibold text-gray-700">Trending Legal News</h6>
                    </div>
                    <div class="p-4">
                        <ul class="space-y-3 text-sm">
                            <li>
                                <a href="#" class="text-blue-600 hover:underline block">Supreme Court Rules on Major
                                    Case</a>
                                <p class="text-gray-500">1,234 readers</p>
                            </li>
                            <li>
                                <a href="#" class="text-blue-600 hover:underline block">New Legislation Impacts
                                    Corporate Law</a>
                                <p class="text-gray-500">987 readers</p>
                            </li>
                            <li>
                                <a href="#" class="text-blue-600 hover:underline block">Legal Tech Innovations in
                                    2025</a>
                                <p class="text-gray-500">756 readers</p>
                            </li>
                        </ul>
                    </div>
                </div>

                <!-- Suggested Connections -->
                <div class="bg-white rounded-lg shadow">
                    <div class="border-b px-4 py-2">
                        <h6 class="font-semibold text-gray-700">People You May Know</h6>
                    </div>
                    <div class="p-4">
                        <ul class="space-y-3 text-sm">
                            <li class="flex items-center">
                                <img src="https://media.licdn.com/dms/image/v2/D4D22AQFzLvoUlYQU2A/feedshare-shrink_800/B4DZVbmswmHAAg-/0/1740998628391?e=1743638400&v=beta&t=DSsihuRaXlkPJLt65Xh2U2z8-Ro5TUdp_JHGUzBq36Y"
                                    alt="Profile" class="rounded-full mr-3"
                                    style="width: 40px; height: 40px; object-fit: cover;">
                                <div class="flex-1">
                                    <h6 class="font-semibold">Jane Smith</h6>
                                    <p class="text-gray-500">Corporate Lawyer</p>
                                </div>
                                <button
                                    class="text-blue-600 border border-blue-600 rounded px-2 py-1 text-xs">Connect</button>
                            </li>
                            <li class="flex items-center">
                                <img src="something.jpg" alt="Profile" class="rounded-full mr-3"
                                    style="width: 40px; height: 40px; object-fit: cover;">
                                <div class="flex-1">
                                    <h6 class="font-semibold">John Doe</h6>
                                    <p class="text-gray-500">Criminal Defense Attorney</p>
                                </div>
                                <button
                                    class="text-blue-600 border border-blue-600 rounded px-2 py-1 text-xs">Connect</button>
                            </li>
                            <li class="flex items-center">
                                <img src="something.jpg" alt="Profile" class="rounded-full mr-3"
                                    style="width: 40px; height: 40px; object-fit: cover;">
                                <div class="flex-1">
                                    <h6 class="font-semibold">Sarah Johnson</h6>
                                    <p class="text-gray-500">Family Law Specialist</p>
                                </div>
                                <button
                                    class="text-blue-600 border border-blue-600 rounded px-2 py-1 text-xs">Connect</button>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Inline JavaScript for Reaction Popup -->
    <script>
        function toggleReactionPopup(postId) {
            const popup = document.getElementById(`reactionPopup-${postId}`);
            if (popup) {
                popup.classList.toggle('hidden');
            }
        }
        function submitReaction(postId, reaction) {
            // Create a dynamic form submission for the reaction
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = `/post/${postId}/react`;
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'reaction';
            input.value = reaction;
            form.appendChild(input);
            document.body.appendChild(form);
            form.submit();
        }

        function togglePostModal() {
        const modal = document.getElementById('postModal');
        modal.classList.toggle('hidden');
        document.body.classList.toggle('overflow-hidden'); // Prevent scrolling when modal is open
    }
    </script>