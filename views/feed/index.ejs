    <!-- Inline JavaScript for Reaction Popup -->
    <script>
        function toggleReactionPopup(postId, buttonElement) {
            const popup = document.getElementById(`reactionPopup-${postId}`);
            
            // Close all other popups first
            document.querySelectorAll('.reaction-popup').forEach(p => {
                if (p.id !== `reactionPopup-${postId}`) {
                    p.classList.add('hidden');
                }
            });
            
            if (popup) {
                if (popup.classList.contains('hidden')) {
                    // Show with animation
                    popup.classList.remove('hidden');
                    popup.style.transform = 'translateX(-50%) scale(0.8)';
                    popup.style.opacity = '0';
                    
                    setTimeout(() => {
                        popup.style.transform = 'translateX(-50%) scale(1)';
                        popup.style.opacity = '1';
                        popup.style.transition = 'all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1)';
                    }, 10);
                    
                    // Add entrance animation to reaction buttons
                    const reactionBtns = popup.querySelectorAll('.reaction-btn');
                    reactionBtns.forEach((btn, index) => {
                        btn.style.transform = 'scale(0) rotate(180deg)';
                        setTimeout(() => {
                            btn.style.transform = 'scale(1) rotate(0deg)';
                            btn.style.transition = 'all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1)';
                        }, index * 50);
                    });
                } else {
                    // Hide with animation
                    popup.style.transform = 'translateX(-50%) scale(0.8)';
                    popup.style.opacity = '0';
                    setTimeout(() => {
                        popup.classList.add('hidden');
                        popup.style.transform = 'translateX(-50%) scale(1)';
                        popup.style.opacity = '1';
                    }, 200);
                }
            }
            
            // Close popup when clicking outside
            setTimeout(() => {
                document.addEventListener('click', function closePopup(e) {
                    if (!popup.contains(e.target) && !buttonElement.contains(e.target)) {
                        popup.classList.add('hidden');
                        document.removeEventListener('click', closePopup);
                    }
                });
            }, 100);
        }
        function submitReaction(postId, reaction, reactionButtonElement) {
            const likeButton = reactionButtonElement.closest('.flex.justify-around').querySelector('.like-button');
            const popup = document.getElementById(`reactionPopup-${postId}`);
            
            // Immediate visual feedback
            reactionButtonElement.style.transform = 'scale(1.3) rotate(15deg)';
            reactionButtonElement.style.filter = 'brightness(1.2)';
            
            // Create floating reaction animation
            const floatingReaction = document.createElement('div');
            floatingReaction.innerHTML = reactionButtonElement.querySelector('span').textContent;
            floatingReaction.className = 'fixed text-4xl pointer-events-none z-50 animate-ping';
            floatingReaction.style.left = reactionButtonElement.getBoundingClientRect().left + 'px';
            floatingReaction.style.top = reactionButtonElement.getBoundingClientRect().top + 'px';
            document.body.appendChild(floatingReaction);
            
            // Animate floating reaction
            setTimeout(() => {
                floatingReaction.style.transform = 'translateY(-100px) scale(2)';
                floatingReaction.style.opacity = '0';
                floatingReaction.style.transition = 'all 1s ease-out';
            }, 100);
            
            setTimeout(() => {
                if (document.body.contains(floatingReaction)) {
                    document.body.removeChild(floatingReaction);
                }
            }, 1100);
            
            fetch(`/post/${postId}/react`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ reaction: reaction })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Update the like button with enhanced animation
                    if (likeButton) {
                        const icon = likeButton.querySelector('i');
                        const span = likeButton.querySelector('span');
                        if (icon && span) {
                            // Add reaction emoji to button
                            const reactionEmoji = reactionTypes[reaction] || '👍';
                            span.innerHTML = `${reactionEmoji} ${reaction.charAt(0).toUpperCase() + reaction.slice(1)}`;
                            icon.className = 'fas fa-thumbs-up text-lg group-hover:animate-bounce';
                            
                            // Add active state styling
                            likeButton.classList.add('text-blue-600', 'bg-blue-50');
                            likeButton.classList.remove('text-gray-600');
                        }
                    }
                    
                    // Update reaction display with animation
                    updateReactionDisplay(postId, data.reactions, data.userReaction);
                    
                    // Hide popup with animation
                    if (popup) {
                        popup.style.transform = 'translateX(-50%) scale(0.8)';
                        popup.style.opacity = '0';
                        setTimeout(() => {
                            popup.classList.add('hidden');
                            popup.style.transform = 'translateX(-50%) scale(1)';
                            popup.style.opacity = '1';
                        }, 200);
                    }
                    
                    // Enhanced visual feedback
                    setTimeout(() => {
                        reactionButtonElement.style.transform = 'scale(1)';
                        reactionButtonElement.style.filter = 'brightness(1)';
                    }, 300);
                    
                    // Show success notification with reaction emoji
                    showNotification(`${reactionTypes[reaction]} Reaction added!`, 'success');
                    
                    // Add ripple effect to like button
                    createRippleEffect(likeButton);
                    
                } else {
                    // Reset visual state on error
                    setTimeout(() => {
                        reactionButtonElement.style.transform = 'scale(1)';
                        reactionButtonElement.style.filter = 'brightness(1)';
                    }, 300);
                    
                    console.error('Failed to submit reaction:', data.message);
                    showNotification('Failed to react: ' + data.message, 'error');
                }
            })
            .catch(error => {
                // Reset visual state on error
                setTimeout(() => {
                    reactionButtonElement.style.transform = 'scale(1)';
                    reactionButtonElement.style.filter = 'brightness(1)';
                }, 300);
                
                console.error('Error submitting reaction:', error);
                showNotification('Error reacting to post.', 'error');
            });
        }

        window.updateReactionDisplay = function(postId, reactions, userReaction) {
            const reactionStats = document.getElementById(`reactionStats-${postId}`);
            const reactionIcons = document.getElementById(`reactionIcons-${postId}`);
            const reactionCount = reactionStats ? reactionStats.querySelector('.reaction-count') : null;
            const likeButton = document.querySelector(`#post-${postId} .like-button`);
            
            // Update like button based on user's reaction
            if (likeButton) {
                const icon = likeButton.querySelector('i');
                const span = likeButton.querySelector('span');
                if (icon && span) {
                    if (userReaction) {
                        // User has reacted - show their reaction
                        const reactionEmoji = getReactionEmoji(userReaction);
                        span.innerHTML = `${reactionEmoji} ${userReaction.charAt(0).toUpperCase() + userReaction.slice(1)}`;
                        icon.className = 'fas fa-thumbs-up text-lg group-hover:animate-bounce';
                        likeButton.classList.add('text-blue-600', 'bg-blue-50');
                        likeButton.classList.remove('text-gray-600');
                    } else {
                        // User has not reacted - show default state
                        span.textContent = 'Like';
                        icon.className = 'far fa-thumbs-up text-lg group-hover:animate-bounce';
                        likeButton.classList.remove('text-blue-600', 'bg-blue-50');
                        likeButton.classList.add('text-gray-600');
                    }
                }
            }
            
            if (reactions && reactions.length > 0) {
                if (reactionStats) {
                    reactionStats.classList.remove('hidden');
                    // Add bounce animation to stats
                    reactionStats.style.transform = 'scale(1.1)';
                    setTimeout(() => {
                        reactionStats.style.transform = 'scale(1)';
                        reactionStats.style.transition = 'transform 0.3s ease-out';
                    }, 200);
                }
                
                if (reactionCount) {
                    // Animate count change
                    reactionCount.style.transform = 'scale(1.3)';
                    reactionCount.style.color = '#3B82F6';
                    reactionCount.textContent = reactions.length;
                    setTimeout(() => {
                        reactionCount.style.transform = 'scale(1)';
                        reactionCount.style.color = '';
                        reactionCount.style.transition = 'all 0.3s ease-out';
                    }, 300);
                }
                
                // Update reaction icons with staggered animation
                if (reactionIcons) {
                    const oldIcons = reactionIcons.querySelectorAll('span');
                    oldIcons.forEach((icon, index) => {
                        setTimeout(() => {
                            icon.style.transform = 'scale(0) rotate(180deg)';
                            icon.style.opacity = '0';
                        }, index * 50);
                    });
                    
                    setTimeout(() => {
                        reactionIcons.innerHTML = '';
                        const uniqueReactions = [...new Set(reactions.map(r => r.reaction || r.reactionType))];
                        const reactionCounts = {};
                        reactions.forEach(r => {
                            const type = r.reaction || r.reactionType;
                            reactionCounts[type] = (reactionCounts[type] || 0) + 1;
                        });
                        
                        uniqueReactions.slice(0, 3).forEach((type, index) => {
                            const emoji = getReactionEmoji(type);
                            const count = reactionCounts[type];
                            const iconElement = document.createElement('span');
                            iconElement.className = 'inline-flex items-center text-lg bg-white rounded-full p-2 shadow-lg border border-gray-200 hover:shadow-xl transition-all duration-300 transform hover:scale-110 relative group';
                            iconElement.innerHTML = `
                                ${emoji}
                                <span class="absolute -top-2 -right-2 bg-blue-500 text-white text-xs rounded-full w-5 h-5 flex items-center justify-center font-bold">${count}</span>
                                <div class="absolute -bottom-8 left-1/2 transform -translate-x-1/2 bg-gray-800 text-white text-xs px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity duration-300 whitespace-nowrap">${type.charAt(0).toUpperCase() + type.slice(1)}: ${count}</div>
                            `;
                            iconElement.style.transform = 'scale(0) rotate(-180deg)';
                            iconElement.style.opacity = '0';
                            reactionIcons.appendChild(iconElement);
                            
                            setTimeout(() => {
                                iconElement.style.transform = 'scale(1) rotate(0deg)';
                                iconElement.style.opacity = '1';
                                iconElement.style.transition = 'all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1)';
                            }, index * 100 + 200);
                        });
                    }, 200);
                }
            } else {
                if (reactionStats) {
                    reactionStats.style.transform = 'scale(0.8)';
                    reactionStats.style.opacity = '0';
                    setTimeout(() => {
                        reactionStats.classList.add('hidden');
                        reactionStats.style.transform = 'scale(1)';
                        reactionStats.style.opacity = '1';
                    }, 300);
                }
                
                // Reset like button to default state when no reactions
                if (likeButton && !userReaction) {
                    const span = likeButton.querySelector('span');
                    if (span) {
                        span.innerHTML = `<i class="far fa-thumbs-up text-lg group-hover:animate-bounce"></i> Like`;
                        likeButton.classList.remove('text-blue-600', 'bg-blue-50');
                        likeButton.classList.add('text-gray-600');
                    }
                }
            }
        }

        function getReactionEmoji(type) {
            const emojis = {
                'like': '👍',
                'love': '❤️',
                'haha': '😂',
                'laugh': '😂',
                'wow': '😮',
                'sad': '😢',
                'angry': '😠'
            };
            return emojis[type] || '👍';
        }

        function createRippleEffect(element) {
            const ripple = document.createElement('div');
            const rect = element.getBoundingClientRect();
            const size = Math.max(rect.width, rect.height);
            
            ripple.style.width = ripple.style.height = size + 'px';
            ripple.style.left = (rect.width / 2 - size / 2) + 'px';
            ripple.style.top = (rect.height / 2 - size / 2) + 'px';
            ripple.className = 'absolute rounded-full bg-blue-400 opacity-30 animate-ping pointer-events-none';
            
            element.style.position = 'relative';
            element.style.overflow = 'hidden';
            element.appendChild(ripple);
            
            setTimeout(() => {
                if (element.contains(ripple)) {
                    element.removeChild(ripple);
                }
            }, 600);
        }
        
        function showNotification(message, type = 'info') {
            const notification = document.createElement('div');
            notification.className = `fixed top-4 right-4 z-40 px-6 py-4 rounded-2xl shadow-2xl transform transition-all duration-500 translate-x-full backdrop-blur-lg border border-white/20`;
            
            const colors = {
                success: 'bg-gradient-to-r from-green-500 to-emerald-500 text-white',
                error: 'bg-gradient-to-r from-red-500 to-pink-500 text-white',
                warning: 'bg-gradient-to-r from-yellow-500 to-orange-500 text-white',
                info: 'bg-gradient-to-r from-blue-500 to-indigo-500 text-white'
            };
            
            const icons = {
                success: '✅',
                error: '❌',
                warning: '⚠️',
                info: 'ℹ️'
            };
            
            notification.className += ` ${colors[type] || colors.info}`;
            notification.innerHTML = `
                <div class="flex items-center space-x-3">
                    <span class="text-xl">${icons[type] || icons.info}</span>
                    <span class="font-semibold">${message}</span>
                </div>
            `;
            
            document.body.appendChild(notification);
            
            setTimeout(() => {
                notification.style.transform = 'translateX(0) scale(1.05)';
            }, 100);
            
            setTimeout(() => {
                notification.style.transform = 'translateX(0) scale(1)';
            }, 200);
            
            setTimeout(() => {
                notification.style.transform = 'translateX(100%) scale(0.8)';
                setTimeout(() => {
                    if (document.body.contains(notification)) {
                        document.body.removeChild(notification);
                    }
                }, 500);
            }, 3000);
        }

        function togglePostModal() {
        const modal = document.getElementById('postModal');
        modal.classList.toggle('hidden');
        document.body.classList.toggle('overflow-hidden'); // Prevent scrolling when modal is open
        
        // Reset form when opening modal
        if (!modal.classList.contains('hidden')) {
            const form = modal.querySelector('form');
            if (form) form.reset();
        }
    }
    </script>
