<% // Define reaction icons for use in grouping and popup 
 let reactionTypes={ like: '👍' , love: '❤️' , haha: '😂' , wow: '😮' , sad: '😢' , angry: '😠' };
%>
<style>
  .modal-hidden {
    display: none !important;
  }
</style>
    <div class="max-w-7xl mx-auto px-4 py-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
            <!-- Left Sidebar -->
            <div class="lg:col-span-3 space-y-8">
                <% if (locals.loggedInUserId) { %>
                    <div class="bg-gradient-to-br from-blue-50 to-blue-100 shadow-2xl rounded-3xl overflow-hidden">
                        <div class="p-6 text-center">
                            <img src="https://media.licdn.com/dms/image/v2/D4D03AQF9FvdZ1W1_9g/profile-displayphoto-shrink_400_400/profile-displayphoto-shrink_400_400/0/1712227644410?e=1746662400&v=beta&t=h_guvHTPpOuEEWiAAnuGwQLiaaMLVRgSJGwzP79vRlU" alt="Profile" class="mx-auto rounded-full mb-3 shadow-lg border-4 border-white" style="width: 90px; height: 90px; object-fit: cover;">
                            <h5 class="font-bold text-xl text-gray-900 mb-1">Your Profile</h5>
                            <p class="text-sm text-blue-700 mb-3">View your profile</p>
                            <a href="/in" class="inline-block bg-blue-600 text-white px-6 py-2 rounded-full shadow hover:bg-blue-700 transition">View Profile</a>
                        </div>
                    </div>
                <% } %>
                <div class="bg-white rounded-2xl shadow-lg">
                    <div class="border-b px-6 py-4">
                        <h6 class="font-semibold text-blue-700 text-lg">Recent Topics</h6>
                    </div>
                    <div class="p-6">
                        <ul class="space-y-3">
                            <li><a href="#" class="text-blue-600 hover:underline text-md">Corporate Law</a></li>
                            <li><a href="#" class="text-blue-600 hover:underline text-md">Family Law</a></li>
                            <li><a href="#" class="text-blue-600 hover:underline text-md">Criminal Defense</a></li>
                            <li><a href="#" class="text-blue-600 hover:underline text-md">Intellectual Property</a></li>
                            <li><a href="#" class="text-blue-600 hover:underline text-md">Immigration Law</a></li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Main Content -->
            <div class="lg:col-span-6 space-y-8">
                <% if (locals.loggedInUserId) { %>
                    <div class="bg-white rounded-2xl shadow-lg mb-4">
                        <div class="p-6 flex items-center space-x-4">
                            <img src="https://media.licdn.com/dms/image/v2/D4D03AQF9FvdZ1W1_9g/profile-displayphoto-shrink_400_400/profile-displayphoto-shrink_400_400/0/1712227644410?e=1746662400&v=beta&t=h_guvHTPpOuEEWiAAnuGwQLiaaMLVRgSJGwzP79vRlU" alt="Profile" class="rounded-full shadow border-2 border-white" style="width: 48px; height: 48px; object-fit: cover;">
                            <button onclick="togglePostModal()" class="flex-1 border border-blue-200 rounded-full px-6 py-3 text-md text-gray-700 bg-blue-50 hover:bg-blue-100 shadow">Start a post</button>
                        </div>
                    </div>
                <% } %>
                <% if (posts && posts.length > 0) { %>
                    <% posts.forEach(post => { let groupedReactions = {}; if (post.reacts && post.reacts.length > 0) { post.reacts.forEach(r => { groupedReactions[r.reaction] = (groupedReactions[r.reaction] || 0) + 1; }); } %>
                    <div id="post-<%= post.id %>" class="bg-white rounded-2xl shadow-lg mb-8 overflow-hidden">
                        <div class="p-6">
                            <!-- Post Header -->
                            <div class="flex items-center mb-4">
                                <img src="https://ui-avatars.com/api/?background=random" alt="Profile" class="rounded-full mr-4 shadow" style="width: 56px; height: 56px; object-fit: cover;">
                                <div class="flex-1">
                                    <h6 class="font-bold text-lg text-gray-900">
                                        <%= post.user ? (post.user.first_name || post.user.firstName || '') : '' %> <%= post.user ? (post.user.last_name || post.user.lastName || '') : '' %>
                                        <% if (post.user && post.user.role==='lawyer' && post.user.lawyer) { %>
                                            <span class="text-sm text-blue-600 font-medium">• Lawyer at <%= post.user.lawyer.lawFirm %></span>
                                        <% } %>
                                    </h6>
                                    <p class="text-xs text-gray-500"><%= new Date(post.createdAt).toLocaleDateString() %></p>
                                </div>
                                <% if (locals.loggedInUserId && (post.userId === locals.loggedInUserId || post.authorId === locals.loggedInUserId)) { %>
                                    <div class="ml-2 flex space-x-3 items-center">
                                        <button class="p-1.5 text-gray-500 hover:text-blue-500 transition-all duration-200 ease-in-out edit-post-btn" title="Edit Post" data-post-id="<%= post.id %>" data-title="<%- post.title.replace(/&/g, '&amp;').replace(/\"/g, '&quot;') %>" data-content="<%- post.content.replace(/&/g, '&amp;').replace(/\"/g, '&quot;') %>">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536M9 13l6.586-6.586a2 2 0 112.828 2.828L11.828 15.828a2 2 0 01-2.828 0L9 13zm0 0V21h8" /></svg>
                                        </button>
                                        <button class="p-1.5 text-gray-500 hover:text-red-500 transition-all duration-200 ease-in-out delete-post-btn" title="Delete Post" data-post-id="<%= post.id %>">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                        </button>
                                    </div>
                                <% } %>
                            </div>
                            <!-- Post Content -->
                            <div class="flex items-center w-full">
                                <div class="flex-1">
                                    <h5 class="font-semibold text-xl text-blue-800 mb-2"><%= post.title %></h5>
                                    <p class="text-gray-700 mb-3"><%= post.content.length > 150 ? post.content.substring(0, 150) + '...' : post.content %></p>
                                    <% if (post.post_photos && post.post_photos.length > 0) { %>\n    <% post.post_photos.forEach(postPhoto => { %>\n        <% if (postPhoto.photo && postPhoto.photo.photoPath) { %>\n            <img src="<%= postPhoto.photo.photoPath.startsWith('/') ? postPhoto.photo.photoPath : '/' + postPhoto.photo.photoPath %>" alt="Post Image" class="w-full h-auto object-contain md:object-cover">\n        <% } %>\n    <% }); %>\n<% } %>
                                </div>
                            </div>
                            <!-- Post Stats -->
                            <div class="flex justify-between items-center text-sm text-gray-500 border-t pt-3 mb-2">
                                <div class="flex items-center">
                                    <% if (post.reacts && post.reacts.length > 0) { %>
                                        <div class="flex items-center mr-2">
                                            <% Object.keys(groupedReactions).forEach(key => { %>
                                                <span class="mr-1 text-lg"><%= reactionTypes[key] %></span>
                                            <% }); %>
                                            <span class="ml-1"><%= post.reacts.length %></span>
                                        </div>
                                    <% } %>
                                </div>
                                <span class="comment-count"><%= post.comments ? post.comments.length : 0 %> comments</span>
                            </div>
                            <!-- Post Actions -->
                            <div class="flex justify-around border-t pt-3 relative">
                                <button class="flex items-center space-x-2 text-gray-600 hover:text-blue-600 font-medium" onclick="toggleReactionPopup(<%= post.id %>)">
                                    <i class="far fa-thumbs-up"></i><span>Like</span>
                                </button>
                                <div id="reactionPopup-<%= post.id %>" class="hidden absolute bg-white rounded-lg shadow-lg p-2 z-10" style="bottom: 100%; left: 0;">
                                    <div class="flex space-x-2">
                                        <% Object.entries(reactionTypes).forEach(([key, emoji]) => { %>
                                            <button onclick="submitReaction(<%= post.id %>, '<%= key %>')" class="text-2xl hover:scale-125 transition-transform"><%= emoji %></button>
                                        <% }); %>
                                    </div>
                                </div>
                                <button class="flex items-center space-x-2 text-gray-600 hover:text-blue-600 font-medium" onclick="toggleCommentForm(<%= post.id %>)">
                                    <i class="far fa-comment"></i><span>Comment</span>
                                </button>
                                <button class="flex items-center space-x-2 text-gray-600 hover:text-blue-600 font-medium">
                                    <i class="far fa-share-square"></i><span>Share</span>
                                </button>
                            </div>
                            <div class="px-4 py-2 border-t border-gray-200 mt-3">
                                <% if (post.comments && post.comments.length > 0) { %>
                                    <button id="showCommentsBtn-<%= post.id %>" class="text-sm text-blue-600 hover:text-blue-800 mb-3" onclick="toggleComments(<%= post.id %>)">Show Comments (<%= post.comments.length %>)</button>
                                    <div id="commentsList-<%= post.id %>" class="space-y-3 hidden">
                                        <% const initialComments = post.comments.slice(0, 4); const hasMoreComments = post.comments.length > 4; %>
                                        <% initialComments.forEach(comment => { %>
                                            <div class="flex items-start space-x-3">
                                                <img src="https://ui-avatars.com/api/?name=<%= comment.user ? comment.user.firstName + ' ' + comment.user.lastName : 'User' %>" alt="Commenter" class="rounded-full shadow" style="width: 32px; height: 32px; object-fit: cover;">
                                                <div>
                                                    <div class="bg-blue-50 rounded-lg px-3 py-2 relative">
                                                        <div class="pr-16">
                                                            <p class="text-sm text-gray-800 break-words whitespace-normal" style="word-wrap: break-word; max-width: 100%; overflow-wrap: break-word;"><%= comment.content.replace(/(.{50})/g, "$1\n") %></p>
                                                        </div>
                                                        <% if (locals.loggedInUserId && comment.userId === locals.loggedInUserId) { %>
                                                            <div class="absolute right-2 top-2">
                                                                <span class="flex space-x-1 items-center">
                                                                    <button class="p-1 text-gray-500 hover:text-blue-500 transition-all duration-200 ease-in-out edit-comment-inline-btn" title="Edit Comment" data-comment-id="<%= comment.id %>" data-content="<%- comment.content.replace(/&/g, '&amp;').replace(/\"/g, '&quot;') %>">
                                                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536M9 13l6.586-6.586a2 2 0 112.828 2.828L11.828 15.828a2 2 0 01-2.828 0L9 13zm0 0V21h8" /></svg>
                                                                    </button>
                                                                    <button class="p-1 text-gray-500 hover:text-red-500 transition-all duration-200 ease-in-out delete-comment-btn" title="Delete Comment" data-comment-id="<%= comment.id %>" data-post-id="<%= post.id %>">
                                                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                                                    </button>
                                                                </span>
                                                            </div>
                                                        <% } %>
                                                    </div>
                                                    <div class="mt-1 text-xs text-gray-500"><span><%= new Date(comment.createdAt).toLocaleDateString() %></span></div>
                                                </div>
                                            </div>
                                        <% }); %>
                                        <% if (hasMoreComments) { %>
                                            <div id="showMoreComments-<%= post.id %>" class="text-center">
                                                <button class="text-sm text-blue-600 hover:text-blue-800" onclick="showMoreComments(<%= post.id %>)">Show More Comments</button>
                                            </div>
                                            <div id="additionalComments-<%= post.id %>" class="hidden space-y-3">
                                                <% post.comments.slice(4).forEach(comment => { %>
                                                    <div class="flex items-start space-x-3">
                                                        <img src="https://ui-avatars.com/api/?name=<%= comment.user ? comment.user.firstName + ' ' + comment.user.lastName : 'User' %>" alt="Commenter" class="rounded-full shadow" style="width: 32px; height: 32px; object-fit: cover;">
                                                        <div>
                                                            <div class="bg-blue-50 rounded-lg px-3 py-2 relative">
                                                                <div class="pr-16">
                                                                    <p class="text-sm text-gray-800 break-words whitespace-normal" style="word-wrap: break-word; max-width: 100%; overflow-wrap: break-word;"><%= comment.content.replace(/(.{50})/g, "$1\n") %></p>
                                                                </div>
                                                                <% if (locals.loggedInUserId && comment.userId === locals.loggedInUserId) { %>
                                                                    <div class="absolute right-2 top-2">
                                                                        <span class="flex space-x-1 items-center">
                                                                            <button class="p-1 text-gray-500 hover:text-blue-500 transition-all duration-200 ease-in-out edit-comment-inline-btn" title="Edit Comment" data-comment-id="<%= comment.id %>" data-content="<%- comment.content.replace(/&/g, '&amp;').replace(/\"/g, '&quot;') %>">
                                                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536M9 13l6.586-6.586a2 2 0 112.828 2.828L11.828 15.828a2 2 0 01-2.828 0L9 13zm0 0V21h8" /></svg>
                                                                            </button>
                                                                            <button class="p-1 text-gray-500 hover:text-red-500 transition-all duration-200 ease-in-out delete-comment-btn" title="Delete Comment" data-comment-id="<%= comment.id %>" data-post-id="<%= post.id %>">
                                                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                                                            </button>
                                                                        </span>
                                                                    </div>
                                                                <% } %>
                                                            </div>
                                                            <div class="mt-1 text-xs text-gray-500"><span><%= new Date(comment.createdAt).toLocaleDateString() %></span></div>
                                                        </div>
                                                    </div>
                                                <% }); %>
                                            </div>
                                        <% } %>
                                    </div>
                                <% } %>
                                <% if (locals.loggedInUserId) { %>
                                    <div id="commentForm-<%= post.id %>" class="mt-3 flex items-center space-x-3 border-t pt-3 hidden">
                                        <img src="https://ui-avatars.com/api/?background=random" alt="Your avatar" class="rounded-full shadow" style="width: 32px; height: 32px; object-fit: cover;">
                                        <form class="flex-1" onsubmit="event.preventDefault(); submitComment(this, <%= post.id %>);">
                                            <input type="text" name="content" placeholder="Add a comment" class="w-full border border-blue-200 rounded-full px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-blue-500">
                                        </form>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </div>
                    <% }); %>
                <% } else { %>
                    <div class="bg-white rounded-2xl shadow-lg mb-8">
                        <div class="p-8">
                            <div class="bg-blue-100 text-blue-700 rounded-xl p-6 text-center text-lg font-medium">
                                No posts found. <% if (locals.loggedInUserId) { %><a href="/blog/create" class="text-blue-600 underline">Create one</a><% } %>
                            </div>
                        </div>
                    </div>
                <% } %>
                <!-- Modal for Creating a Post -->
                <div id="postModal" class="fixed inset-0 bg-black bg-opacity-50 hidden flex items-center justify-center z-50">
                    <div class="bg-white rounded-2xl shadow-2xl w-96 p-8 relative">
                        <button onclick="togglePostModal()" class="absolute top-2 right-2 text-gray-500 hover:text-gray-700 text-2xl">&times;</button>
                        <h3 class="text-2xl font-bold mb-6 text-blue-700">Create a Post</h3>
                        <form action="/in/<%= typeof user !== 'undefined' && user ? user.id : '' %>/create-post" method="POST" enctype="multipart/form-data">
                            <div class="mb-5">
                                <label for="title" class="block text-md font-medium text-gray-700 mb-1">Title</label>
                                <input type="text" name="title" id="title" required class="w-full border border-blue-200 rounded-lg px-4 py-2 focus:outline-none focus:ring-1 focus:ring-blue-500">
                            </div>
                            <div class="mb-5">
                                <label for="content" class="block text-md font-medium text-gray-700 mb-1">Content</label>
                                <textarea name="content" id="content" rows="4" required class="w-full border border-blue-200 rounded-lg px-4 py-2 focus:outline-none focus:ring-1 focus:ring-blue-500"></textarea>
                            </div>
                            <div class="mb-5">
                                <label for="image" class="block text-md font-medium text-gray-700 mb-1">Image (optional)</label>
                                <input type="file" name="image" id="image" accept="image/*" class="w-full border border-blue-200 rounded-lg px-4 py-2 focus:outline-none focus:ring-1 focus:ring-blue-500">
                            </div>
                            <button type="submit" class="w-full bg-blue-600 text-white py-3 rounded-lg hover:bg-blue-700 focus:outline-none font-semibold">Post</button>
                        </form>
                    </div>
                </div>
                <!-- Right Sidebar -->
                <div class="lg:col-span-3 space-y-8">
                    <div class="bg-white rounded-2xl shadow-lg">
                        <div class="border-b px-6 py-4">
                            <h6 class="font-semibold text-blue-700 text-lg">Trending Legal News</h6>
                        </div>
                        <div class="p-6">
                            <ul class="space-y-4 text-md">
                                <li><a href="#" class="text-blue-600 hover:underline block">Supreme Court Rules on Major Case</a><p class="text-gray-500">1,234 readers</p></li>
                                <li><a href="#" class="text-blue-600 hover:underline block">New Legislation Impacts Corporate Law</a><p class="text-gray-500">987 readers</p></li>
                                <li><a href="#" class="text-blue-600 hover:underline block">Legal Tech Innovations in 2025</a><p class="text-gray-500">756 readers</p></li>
                            </ul>
                        </div>
                    </div>
                    <div class="bg-white rounded-2xl shadow-lg">
                        <div class="border-b px-6 py-4">
                            <h6 class="font-semibold text-blue-700 text-lg">Connect with Lawyers</h6>
                        </div>
                        <div class="p-6">
                            <ul class="space-y-4 text-md" id="suggestedLawyers">
                                <li class="text-center text-gray-500 py-2">Loading suggestions...</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Inline JavaScript for Reaction Popup -->
    <script>
        function toggleReactionPopup(postId) {
            const popup = document.getElementById(`reactionPopup-${postId}`);
            if (popup) {
                popup.classList.toggle('hidden');
            }
        }
        function submitReaction(postId, reaction) {
            // Create a dynamic form submission for the reaction
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = `/post/${postId}/react`;
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'reaction';
            input.value = reaction;
            form.appendChild(input);
            document.body.appendChild(form);
            form.submit();
        }

        function togglePostModal() {
        const modal = document.getElementById('postModal');
        modal.classList.toggle('hidden');
        document.body.classList.toggle('overflow-hidden'); // Prevent scrolling when modal is open
        
        // Reset form when opening modal
        if (!modal.classList.contains('hidden')) {
            const form = modal.querySelector('form');
            if (form) form.reset();
        }
    }
    </script>
    <script src="/js/feed.js"></script>

    <!-- Font Awesome CDN for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <script>
    // Fetch suggested lawyers when the page loads
    document.addEventListener('DOMContentLoaded', function() {
        fetchSuggestedLawyers();
        
        // Function to fetch suggested lawyers
        function fetchSuggestedLawyers() {
            fetch('/mynetwork/suggested-lawyers')
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Network response was not ok');
                    }
                    return response.json();
                })
                .then(data => {
                    displaySuggestedLawyers(data.lawyers);
                })
                .catch(error => {
                    console.error('Error fetching suggested lawyers:', error);
                    document.getElementById('suggestedLawyers').innerHTML = 
                        '<li class="text-center text-gray-500 py-2">Failed to load suggestions</li>';
                });
        }
        
        // Function to display suggested lawyers
        function displaySuggestedLawyers(lawyers) {
            const container = document.getElementById('suggestedLawyers');
            
            if (!lawyers || lawyers.length === 0) {
                container.innerHTML = '<li class="text-center text-gray-500 py-2">No suggestions available</li>';
                return;
            }
            
            let html = '';
            lawyers.forEach(lawyer => {
                const imageSrc = lawyer.ProfileImage && lawyer.ProfileImage.imagePath ?
                    lawyer.ProfileImage.imagePath :
                    `https://ui-avatars.com/api/?name=${lawyer.firstName}+${lawyer.lastName}`;
                    
                html += `
                <li class="flex items-center">
                    <img src="${imageSrc}" alt="${lawyer.firstName}'s Profile" class="rounded-full mr-3"
                        style="width: 40px; height: 40px; object-fit: cover;">
                    <div class="flex-1">
                        <h6 class="font-semibold">${lawyer.firstName} ${lawyer.lastName}</h6>
                        <p class="text-gray-500">${lawyer.Lawyer ? lawyer.Lawyer.lawFirm : 'Lawyer'}</p>
                    </div>
                    <button class="connect-btn text-blue-600 border border-blue-600 rounded px-2 py-1 text-xs"
                        data-user-id="${lawyer.id}">Connect</button>
                </li>`;
            });
            
            container.innerHTML = html;
            
            // Add event listeners to connect buttons
            document.querySelectorAll('.connect-btn').forEach(button => {
                button.addEventListener('click', function() {
                    const userId = this.getAttribute('data-user-id');
                    sendConnectionRequest(userId, this);
                });
            });
        }
        
        // Function to send connection request
        function sendConnectionRequest(userId, button) {
            button.disabled = true;
            button.textContent = 'Sending...';
            
            fetch(`/mynetwork/connect/${userId}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    button.textContent = 'Request Sent';
                    button.classList.remove('text-blue-600', 'border-blue-600');
                    button.classList.add('text-gray-400', 'border-gray-400');
                } else {
                    button.textContent = 'Connect';
                    button.disabled = false;
                    alert(data.message);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                button.textContent = 'Connect';
                button.disabled = false;
                alert('An error occurred. Please try again.');
            });
        }
    });
    </script>
<!-- Delete Confirmation Modal -->
<div id="deleteConfirmModal" class="fixed inset-0 z-60 flex items-center justify-center bg-black bg-opacity-40 hidden">
  <div class="bg-white rounded-xl shadow-lg p-8 max-w-sm w-full text-center">
    <h3 class="text-lg font-semibold mb-4 text-gray-800">Are you sure you want to delete?</h3>
    <div class="flex justify-center space-x-4 mt-6">
      <button onclick="confirmDelete()" class="px-6 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition">Delete</button>
      <button onclick="hideDeleteModal()" class="px-6 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition">Cancel</button>
    </div>
  </div>
</div>

<!-- Edit Post Modal -->
<div id="editPostModal" class="fixed inset-0 bg-black bg-opacity-50 hidden flex items-center justify-center z-50">
    <div class="bg-white rounded-2xl shadow-2xl w-96 p-8 relative">
        <button onclick="toggleEditPostModal()" class="absolute top-2 right-2 text-gray-500 hover:text-gray-700 text-2xl">&times;</button>
        <h3 class="text-2xl font-bold mb-6 text-blue-700">Edit Post</h3>
        <form id="editPostForm">
            <input type="hidden" name="postId" id="editPostId">
            <div class="mb-5">
                <label for="editTitle" class="block text-md font-medium text-gray-700 mb-1">Title</label>
                <input type="text" name="title" id="editTitle" required class="w-full border border-blue-200 rounded-lg px-4 py-2 focus:outline-none focus:ring-1 focus:ring-blue-500">
            </div>
            <div class="mb-5">
                <label for="editContent" class="block text-md font-medium text-gray-700 mb-1">Content</label>
                <textarea name="content" id="editContent" rows="4" required class="w-full border border-blue-200 rounded-lg px-4 py-2 focus:outline-none focus:ring-1 focus:ring-blue-500"></textarea>
            </div>
            <button type="submit" class="w-full bg-blue-600 text-white py-3 rounded-lg hover:bg-blue-700 focus:outline-none font-semibold">Save Changes</button>
        </form>
    </div>
</div>
<!-- Edit Comment Modal -->
<div id="editCommentModal" class="fixed inset-0 bg-black bg-opacity-50 hidden flex items-center justify-center z-50">
    <div class="bg-white rounded-2xl shadow-2xl w-96 p-8 relative">
        <button onclick="toggleEditCommentModal()" class="absolute top-2 right-2 text-gray-500 hover:text-gray-700 text-2xl">&times;</button>
        <h3 class="text-2xl font-bold mb-6 text-blue-700">Edit Comment</h3>
        <form id="editCommentForm">
            <input type="hidden" name="commentId" id="editCommentId">
            <div class="mb-5">
                <label for="editCommentContent" class="block text-md font-medium text-gray-700 mb-1">Content</label>
                <textarea name="content" id="editCommentContent" rows="3" required class="w-full border border-blue-200 rounded-lg px-4 py-2 focus:outline-none focus:ring-1 focus:ring-blue-500"></textarea>
            </div>
            <button type="submit" class="w-full bg-blue-600 text-white py-3 rounded-lg hover:bg-blue-700 focus:outline-none font-semibold">Save Changes</button>
        </form>
    </div>



</div>
