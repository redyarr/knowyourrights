<div class="verification-status-container">
    <div class="status-card rejected">
        <div class="status-icon">
            <i class="fas fa-times-circle"></i>
        </div>
        <div class="status-content">
            <h1>Verification Rejected</h1>
            <p class="status-message">
                Unfortunately, your lawyer verification application has been rejected. 
                Please review the feedback below and resubmit with the necessary corrections.
            </p>
            
            <div class="rejection-details">
                <h3>Rejection Reason:</h3>
                <div class="rejection-reason">
                    <%= rejectionReason %>
                </div>
            </div>
            
            <div class="verification-details">
                <h3>Your Submitted Information:</h3>
                <div class="detail-grid">
                    <div class="detail-item">
                        <label>Law Firm:</label>
                        <span><%= lawyer.lawFirm || 'Independent Practice' %></span>
                    </div>
                    <div class="detail-item">
                        <label>Badge Number:</label>
                        <span><%= lawyer.badgeNumber %></span>
                    </div>
                    <div class="detail-item">
                        <label>Badge Issue Date:</label>
                        <span><%= new Date(lawyer.badgeIssueDate).toLocaleDateString() %></span>
                    </div>
                    <div class="detail-item">
                        <label>Issuing Authority:</label>
                        <span><%= lawyer.badgeIssuingAuthority.charAt(0).toUpperCase() + lawyer.badgeIssuingAuthority.slice(1) %></span>
                    </div>
                    <% if (lawyer.legalAreas) { %>
                    <div class="detail-item full-width">
                        <label>Legal Areas:</label>
                        <div class="legal-areas">
                            <% lawyer.legalAreas.split(',').forEach(area => { %>
                                <span class="area-tag"><%= area.trim() %></span>
                            <% }); %>
                        </div>
                    </div>
                    <% } %>
                </div>
            </div>
            
            <div class="action-buttons">
                <a href="/in/<%= user.id %>/edit" class="btn btn-primary">
                    <i class="fas fa-edit"></i> Update Information
                </a>
                <a href="/in/<%= user.id %>" class="btn btn-secondary">
                    <i class="fas fa-user"></i> View Profile
                </a>
                <a href="/feed" class="btn btn-outline">
                    <i class="fas fa-home"></i> Go to Feed
                </a>
            </div>
            
            <div class="info-box">
                <h4>Next Steps:</h4>
                <ul>
                    <li>Review the rejection reason carefully</li>
                    <li>Update your profile information to address the concerns</li>
                    <li>Ensure all documents and information are accurate and complete</li>
                    <li>Resubmit your verification application</li>
                    <li>Contact support if you need assistance: <a href="mailto:support@knowyourrights.com">support@knowyourrights.com</a></li>
                </ul>
            </div>
            
            <div class="resubmit-info">
                <p><strong>Note:</strong> You can update your information and resubmit for verification at any time. 
                Our team will review your updated application within 2-3 business days.</p>
            </div>
        </div>
    </div>
</div>

<style>
.verification-status-container {
    max-width: 800px;
    margin: 50px auto;
    padding: 20px;
}

.status-card {
    background: white;
    border-radius: 12px;
    box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    overflow: hidden;
    text-align: center;
}

.status-card.rejected {
    border-top: 5px solid #e74c3c;
}

.status-icon {
    background: linear-gradient(135deg, #e74c3c, #c0392b);
    color: white;
    padding: 30px;
    font-size: 3em;
}

.status-content {
    padding: 40px;
}

.status-content h1 {
    color: #2c3e50;
    margin: 0 0 15px 0;
    font-size: 2.2em;
}

.status-message {
    font-size: 1.1em;
    color: #7f8c8d;
    margin-bottom: 30px;
    line-height: 1.6;
}

.rejection-details {
    background: #fdf2f2;
    border: 1px solid #fadbd8;
    border-radius: 8px;
    padding: 20px;
    margin: 30px 0;
    text-align: left;
}

.rejection-details h3 {
    color: #e74c3c;
    margin: 0 0 15px 0;
    text-align: center;
}

.rejection-reason {
    background: white;
    padding: 15px;
    border-radius: 4px;
    border-left: 4px solid #e74c3c;
    color: #2c3e50;
    line-height: 1.6;
}

.verification-details {
    background: #f8f9fa;
    border-radius: 8px;
    padding: 25px;
    margin: 30px 0;
    text-align: left;
}

.verification-details h3 {
    color: #2c3e50;
    margin: 0 0 20px 0;
    text-align: center;
}

.detail-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
}

.detail-item {
    display: flex;
    align-items: center;
}

.detail-item.full-width {
    grid-column: 1 / -1;
    flex-direction: column;
    align-items: flex-start;
}

.detail-item label {
    font-weight: 600;
    color: #34495e;
    min-width: 120px;
    margin-right: 10px;
}

.detail-item.full-width label {
    margin-bottom: 8px;
}

.legal-areas {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}

.area-tag {
    background: #3498db;
    color: white;
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 0.8em;
}

.action-buttons {
    display: flex;
    gap: 15px;
    justify-content: center;
    margin: 30px 0;
    flex-wrap: wrap;
}

.btn {
    display: inline-flex;
    align-items: center;
    padding: 12px 24px;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.3s ease;
}

.btn i {
    margin-right: 8px;
}

.btn-primary {
    background: #e74c3c;
    color: white;
}

.btn-primary:hover {
    background: #c0392b;
}

.btn-secondary {
    background: #95a5a6;
    color: white;
}

.btn-secondary:hover {
    background: #7f8c8d;
}

.btn-outline {
    background: transparent;
    color: #3498db;
    border: 1px solid #3498db;
}

.btn-outline:hover {
    background: #3498db;
    color: white;
}

.info-box {
    background: #fff3cd;
    border: 1px solid #ffeaa7;
    border-radius: 8px;
    padding: 20px;
    text-align: left;
    margin: 30px 0;
}

.info-box h4 {
    color: #856404;
    margin: 0 0 15px 0;
}

.info-box ul {
    margin: 0;
    padding-left: 20px;
    color: #856404;
}

.info-box li {
    margin-bottom: 8px;
    line-height: 1.5;
}

.info-box a {
    color: #856404;
    text-decoration: underline;
}

.info-box a:hover {
