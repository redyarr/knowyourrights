<div class="lawyer-details-container">
    <div class="details-header">
        <a href="/admin/dashboard" class="back-btn">
            <i class="fas fa-arrow-left"></i> Back to Dashboard
        </a>
        <h1>Lawyer Verification Review</h1>
    </div>

    <div class="lawyer-profile">
        <div class="profile-section">
            <div class="profile-header">
                <div class="profile-avatar">
                    <% if (lawyer.user.profilePicture) { %>
                        <img src="<%= lawyer.user.profilePicture %>" alt="<%= lawyer.user.firstName %> <%= lawyer.user.lastName %>">
                    <% } else { %>
                        <div class="avatar-placeholder">
                            <%= lawyer.user.firstName.charAt(0) %><%= lawyer.user.lastName.charAt(0) %>
                        </div>
                    <% } %>
                </div>
                <div class="profile-info">
                    <h2><%= lawyer.user.firstName %> <%= lawyer.user.lastName %></h2>
                    <p class="email"><%= lawyer.user.email %></p>
                    <p class="join-date">Joined: <%= new Date(lawyer.user.createdAt).toLocaleDateString() %></p>
                    <div class="status-badge status-<%= lawyer.verificationStatus %>">
                        <%= lawyer.verificationStatus.charAt(0).toUpperCase() + lawyer.verificationStatus.slice(1) %>
                    </div>
                </div>
            </div>
        </div>

        <div class="verification-details">
            <div class="details-grid">
                <div class="detail-card">
                    <h3>Professional Information</h3>
                    <div class="detail-item">
                        <label>Law Firm:</label>
                        <span><%= lawyer.lawFirm || 'Independent Practice' %></span>
                    </div>
                    <div class="detail-item">
                        <label>Badge Number:</label>
                        <span><%= lawyer.badgeNumber %></span>
                    </div>
                    <div class="detail-item">
                        <label>Badge Issue Date:</label>
                        <span><%= new Date(lawyer.badgeIssueDate).toLocaleDateString() %></span>
                    </div>
                    <div class="detail-item">
                        <label>Issuing Authority:</label>
                        <span class="authority-badge authority-<%= lawyer.badgeIssuingAuthority %>">
                            <%= lawyer.badgeIssuingAuthority.charAt(0).toUpperCase() + lawyer.badgeIssuingAuthority.slice(1) %>
                        </span>
                    </div>
                </div>

                <div class="detail-card">
                    <h3>Legal Specialization</h3>
                    <div class="detail-item full-width">
                        <label>Areas of Practice:</label>
                        <div class="legal-areas">
                            <% if (lawyer.legalAreas) { %>
                                <% lawyer.legalAreas.split(',').forEach(area => { %>
                                    <span class="area-tag"><%= area.trim() %></span>
                                <% }); %>
                            <% } else { %>
                                <span class="no-data">Not specified</span>
                            <% } %>
                        </div>
                    </div>
                </div>

                <% if (lawyer.summary) { %>
                <div class="detail-card full-width">
                    <h3>Professional Summary</h3>
                    <div class="summary-content">
                        <%= lawyer.summary %>
                    </div>
                </div>
                <% } %>

                <% if (lawyer.verificationStatus === 'rejected' && lawyer.rejectionReason) { %>
                <div class="detail-card full-width rejection-reason">
                    <h3>Previous Rejection Reason</h3>
                    <div class="rejection-content">
                        <%= lawyer.rejectionReason %>
                    </div>
                    <p class="rejection-date">
                        Rejected on: <%= new Date(lawyer.verificationDate).toLocaleDateString() %>
                    </p>
                </div>
                <% } %>
            </div>
        </div>

        <% if (lawyer.verificationStatus === 'pending') { %>
        <div class="verification-actions">
            <div class="action-buttons">
                <button class="btn btn-success" onclick="approveLawyer(<%= lawyer.id %>)">
                    <i class="fas fa-check"></i> Approve Lawyer
                </button>
                <button class="btn btn-danger" onclick="showRejectModal(<%= lawyer.id %>)">
                    <i class="fas fa-times"></i> Reject Application
                </button>
            </div>
        </div>
        <% } %>
    </div>
</div>

<!-- Rejection Modal -->
<div id="rejectModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h3>Reject Lawyer Application</h3>
            <span class="close" onclick="closeRejectModal()">&times;</span>
        </div>
        <div class="modal-body">
            <p>Please provide a reason for rejecting this lawyer's application:</p>
            <textarea id="rejectionReason" placeholder="Enter rejection reason..." rows="4"></textarea>
        </div>
        <div class="modal-footer">
            <button class="btn btn-secondary" onclick="closeRejectModal()">Cancel</button>
            <button class="btn btn-danger" onclick="confirmReject()">Reject Application</button>
        </div>
    </div>
</div>

<script>
let currentLawyerId = null;

function approveLawyer(lawyerId) {
    // Show loading state
    const approveBtn = document.querySelector(`button[onclick="approveLawyer(${lawyerId})"]`);
    const originalText = approveBtn.innerHTML;
    approveBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Approving...';
    approveBtn.disabled = true;

    fetch(`/admin/lawyers/${lawyerId}/approve`, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json'
        }
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            approveBtn.innerHTML = '<i class="fas fa-check"></i> Approved!';
            approveBtn.className = 'btn btn-success';
            
            // Show success message and redirect immediately
            showNotification('Lawyer approved successfully!', 'success');
            window.location.href = '/admin/dashboard';
        } else {
            // Reset button on error
            approveBtn.innerHTML = originalText;
            approveBtn.disabled = false;
            showNotification(data.message || 'Error approving lawyer', 'error');
        }
    })
    .catch(error => {
        console.error('Error:', error);
        // Reset button on error
        approveBtn.innerHTML = originalText;
        approveBtn.disabled = false;
        showNotification('Error approving lawyer', 'error');
    });
}

function showRejectModal(lawyerId) {
    currentLawyerId = lawyerId;
    document.getElementById('rejectModal').style.display = 'block';
    document.getElementById('rejectionReason').value = '';
}

function closeRejectModal() {
    document.getElementById('rejectModal').style.display = 'none';
    currentLawyerId = null;
}

function confirmReject() {
    const reason = document.getElementById('rejectionReason').value.trim();
    
    if (!reason) {
        showNotification('Please provide a rejection reason', 'error');
        return;
    }

    // Show loading state
    const rejectBtn = document.querySelector('.modal-footer .btn-danger');
    const originalText = rejectBtn.innerHTML;
    rejectBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Rejecting...';
    rejectBtn.disabled = true;

    fetch(`/admin/lawyers/${currentLawyerId}/reject`, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json'
        },
        body: JSON.stringify({ reason: reason })
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            rejectBtn.innerHTML = '<i class="fas fa-check"></i> Rejected!';
            showNotification('Lawyer application rejected', 'success');
            closeRejectModal();
            window.location.href = '/admin/dashboard';
        } else {
            // Reset button on error
            rejectBtn.innerHTML = originalText;
            rejectBtn.disabled = false;
            showNotification(data.message || 'Error rejecting lawyer', 'error');
        }
    })
    .catch(error => {
        console.error('Error:', error);
        // Reset button on error
        rejectBtn.innerHTML = originalText;
        rejectBtn.disabled = false;
        showNotification('Error rejecting lawyer', 'error');
    });
}

// Close modal when clicking outside
window.onclick = function(event) {
    const modal = document.getElementById('rejectModal');
    if (event.target === modal) {
        closeRejectModal();
    }
}

// Custom notification system
function showNotification(message, type = 'info') {
    // Remove existing notifications
    const existingNotifications = document.querySelectorAll('.custom-notification');
    existingNotifications.forEach(notification => notification.remove());

    // Create notification element
    const notification = document.createElement('div');
    notification.className = `custom-notification notification-${type}`;
    notification.innerHTML = `
        <div class="notification-content">
            <i class="fas ${type === 'success' ? 'fa-check-circle' : type === 'error' ? 'fa-exclamation-circle' : 'fa-info-circle'}"></i>
            <span>${message}</span>
        </div>
        <button class="notification-close" onclick="this.parentElement.remove()">
            <i class="fas fa-times"></i>
        </button>
    `;

    // Add to page
    document.body.appendChild(notification);

    // Auto remove after 4 seconds
    setTimeout(() => {
        if (notification.parentElement) {
            notification.style.opacity = '0';
            notification.style.transform = 'translateX(100%)';
            setTimeout(() => notification.remove(), 300);
        }
    }, 4000);

    // Trigger animation
    setTimeout(() => {
        notification.style.opacity = '1';
        notification.style.transform = 'translateX(0)';
    }, 100);
}
</script>

