<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

<div class="max-w-5xl mx-auto p-6">
  <div class="mb-6">
    <a href="/admin/dashboard" class="inline-flex items-center text-blue-600 hover:underline">
      <i class="fas fa-arrow-left mr-2"></i>Back to Dashboard
    </a>
    <h1 class="text-2xl font-bold mt-2">Lawyer Verification Review</h1>
    <p class="text-gray-600">Review and manage lawyer verification applications</p>
  </div>

  <div class="bg-white shadow-md rounded-xl p-6 space-y-6">
    <div class="flex items-center space-x-6">
      <% if (lawyer.user.profilePicture) { %>
        <img src="<%= lawyer.user.profilePicture %>" alt="<%= lawyer.user.firstName %> <%= lawyer.user.lastName %>" class="w-20 h-20 rounded-full object-cover">
      <% } else { %>
        <div class="w-20 h-20 rounded-full bg-gray-300 flex items-center justify-center text-xl font-bold">
          <%= lawyer.user.firstName.charAt(0) %><%= lawyer.user.lastName.charAt(0) %>
        </div>
      <% } %>
      <div>
        <h2 class="text-xl font-semibold"><%= lawyer.user.firstName %> <%= lawyer.user.lastName %></h2>
        <p class="text-gray-600"><%= lawyer.user.email %></p>
        <p class="text-sm text-gray-500">Joined: <%= new Date(lawyer.user.createdAt).toLocaleDateString() %></p>
        <div class="mt-2 inline-block px-3 py-1 text-sm rounded-full bg-gray-200 text-gray-800 capitalize">
          <%= lawyer.verificationStatus %>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="bg-gray-50 p-4 rounded-lg">
        <h3 class="font-medium text-lg mb-2">Professional Information</h3>
        <div class="space-y-2 text-sm">
          <div><span class="font-semibold">Law Firm:</span> <%= lawyer.lawFirm || 'Independent Practice' %></div>
          <div><span class="font-semibold">Badge Number:</span> <%= lawyer.badgeNumber %></div>
          <div><span class="font-semibold">Badge Issue Date:</span> <%= new Date(lawyer.badgeIssueDate).toLocaleDateString() %></div>
          <div><span class="font-semibold">Issuing Authority:</span> <span class="inline-block bg-gray-200 rounded-full px-2 py-0.5"><%= lawyer.badgeIssuingAuthority %></span></div>
        </div>
      </div>

      <div class="bg-gray-50 p-4 rounded-lg">
        <h3 class="font-medium text-lg mb-2">Legal Specialization</h3>
        <% if (lawyer.legalAreas) { %>
          <div class="flex flex-wrap gap-2">
            <% lawyer.legalAreas.split(',').forEach(area => { %>
              <span class="inline-block bg-blue-100 text-blue-800 px-2 py-0.5 rounded-full text-sm"><%= area.trim() %></span>
            <% }); %>
          </div>
        <% } else { %>
          <span class="text-gray-500">Not specified</span>
        <% } %>
      </div>

      <% if (lawyer.summary) { %>
        <div class="md:col-span-2 bg-gray-50 p-4 rounded-lg">
          <h3 class="font-medium text-lg mb-2">Professional Summary</h3>
          <p class="text-sm text-gray-700"><%= lawyer.summary %></p>
        </div>
      <% } %>

      <% if (lawyer.verificationStatus === 'rejected' && lawyer.rejectionReason) { %>
        <div class="md:col-span-2 bg-red-50 p-4 rounded-lg">
          <h3 class="font-medium text-lg mb-2 text-red-700">Previous Rejection Reason</h3>
          <p class="text-sm text-red-600"><%= lawyer.rejectionReason %></p>
          <p class="text-xs text-red-500 mt-1">Rejected on: <%= new Date(lawyer.verificationDate).toLocaleDateString() %></p>
        </div>
      <% } %>
    </div>

    <% if (lawyer.verificationStatus === 'pending') { %>
      <div class="flex space-x-4">
        <button onclick="approveLawyer(<%= lawyer.id %>)" class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-md flex items-center">
          <i class="fas fa-check mr-2"></i>Approve Lawyer
        </button>
        <button onclick="showRejectModal(<%= lawyer.id %>)" class="bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-md flex items-center">
          <i class="fas fa-times mr-2"></i>Reject Application
        </button>
      </div>
    <% } %>
  </div>
</div>

<!-- Modal -->
<div id="rejectModal" class="fixed inset-0 bg-black bg-opacity-50 flex justify-center items-center hidden">
  <div class="bg-white rounded-lg shadow-lg max-w-md w-full">
    <div class="flex justify-between items-center px-4 py-2 border-b">
      <h3 class="font-semibold">Reject Lawyer Application</h3>
      <button onclick="closeRejectModal()" class="text-gray-600 hover:text-black">&times;</button>
    </div>
    <div class="px-4 py-3">
      <p class="mb-2">Please provide a reason for rejecting this lawyer's application:</p>
      <textarea id="rejectionReason" rows="4" class="w-full border border-gray-300 rounded-lg p-2" placeholder="Enter rejection reason..."></textarea>
    </div>
    <div class="flex justify-end space-x-2 px-4 py-3 border-t">
      <button onclick="closeRejectModal()" class="px-4 py-2 bg-gray-300 rounded hover:bg-gray-400">Cancel</button>
      <button onclick="confirmReject()" class="px-4 py-2 bg-red-600 text-white rounded hover:bg-red-700">Reject Application</button>
    </div>
  </div>
</div>
