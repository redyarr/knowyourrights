<%- include('../layouts/navbar', { path }) %>
<link rel="stylesheet" href="/css/admin.css">

<div class="admin-container">
    <div class="admin-header">
        <h1>Lawyer Verification Management</h1>
        <p>Manage and review lawyer verification applications</p>
    </div>

    <div class="filter-tabs">
        <a href="/admin/lawyers" class="filter-tab <%= !currentStatus ? 'active' : '' %>">All</a>
        <a href="/admin/lawyers?status=pending" class="filter-tab <%= currentStatus === 'pending' ? 'active' : '' %>">Pending</a>
        <a href="/admin/lawyers?status=approved" class="filter-tab <%= currentStatus === 'approved' ? 'active' : '' %>">Approved</a>
        <a href="/admin/lawyers?status=rejected" class="filter-tab <%= currentStatus === 'rejected' ? 'active' : '' %>">Rejected</a>
    </div>

    <div class="lawyers-table">
        <div class="table-header">
            <h2>
                Lawyers 
                <% if (currentStatus) { %>
                    - <%= currentStatus.charAt(0).toUpperCase() + currentStatus.slice(1) %>
                <% } %>
                <span class="count-badge"><%= totalCount %></span>
            </h2>
        </div>
        
        <% if (lawyers.length === 0) { %>
            <div class="empty-state">
                <i class="fas fa-users"></i>
                <h3>No lawyers found</h3>
                <p>There are no lawyers with the selected status.</p>
            </div>
        <% } else { %>
            <table class="table">
                <thead>
                    <tr>
                        <th>Lawyer</th>
                        <th>Email</th>
                        <th>Status</th>
                        <th>Submitted</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% lawyers.forEach(lawyer => { %>
                        <tr>
                            <td>
                                <div class="lawyer-info">
                                    <div class="lawyer-avatar">
                                        <% if (lawyer.user.profilePicture) { %>
                                            <img src="<%= lawyer.user.profilePicture %>" alt="<%= lawyer.user.firstName %> <%= lawyer.user.lastName %>">
                                        <% } else { %>
                                            <div class="avatar-placeholder">
                                                <%= lawyer.user.firstName.charAt(0) %><%= lawyer.user.lastName.charAt(0) %>
                                            </div>
                                        <% } %>
                                    </div>
                                    <div class="lawyer-details">
                                        <h4><%= lawyer.user.firstName %> <%= lawyer.user.lastName %></h4>
                                    </div>
                                </div>
                            </td>
                            <td><%= lawyer.user.email %></td>
                            <td>
                                <span class="status-badge status-<%= lawyer.verificationStatus %>">
                                    <%= lawyer.verificationStatus.charAt(0).toUpperCase() + lawyer.verificationStatus.slice(1) %>
                                </span>
                            </td>
                            <td>
                                <%= new Date(lawyer.createdAt).toLocaleDateString() %>
                            </td>
                            <td>
                                <div class="btn-group">
                                    <a href="/admin/lawyers/<%= lawyer.id %>" class="btn btn-outline-primary">
                                        <i class="fas fa-eye"></i> View
                                    </a>
                                    <% if (lawyer.verificationStatus === 'pending') { %>
                                        <button class="btn btn-outline-success" onclick="approveLawyer(<%= lawyer.id %>)">
                                            <i class="fas fa-check"></i> Approve
                                        </button>
                                        <button class="btn btn-outline-danger" onclick="showRejectModal(<%= lawyer.id %>)">
                                            <i class="fas fa-times"></i> Reject
                                        </button>
                                    <% } %>
                                </div>
                            </td>
                        </tr>
                    <% }); %>
                                </tbody>
                            </table>
            </table>
            
            <!-- Pagination -->
            <% if (totalPages > 1) { %>
                <div class="pagination-container">
                    <div class="pagination">
                        <% if (currentPage > 1) { %>
                            <a class="pagination-btn" href="?page=<%= currentPage - 1 %><%= currentStatus ? '&status=' + currentStatus : '' %>">
                                <i class="fas fa-chevron-left"></i> Previous
                            </a>
                        <% } %>
                        
                        <% for (let i = Math.max(1, currentPage - 2); i <= Math.min(totalPages, currentPage + 2); i++) { %>
                            <a class="pagination-btn <%= i === currentPage ? 'active' : '' %>" href="?page=<%= i %><%= currentStatus ? '&status=' + currentStatus : '' %>">
                                <%= i %>
                            </a>
                        <% } %>
                        
                        <% if (currentPage < totalPages) { %>
                            <a class="pagination-btn" href="?page=<%= currentPage + 1 %><%= currentStatus ? '&status=' + currentStatus : '' %>">
                                Next <i class="fas fa-chevron-right"></i>
                            </a>
                        <% } %>
                    </div>
                </div>
            <% } %>
        <% } %>
    </div>
</div>

<!-- Rejection Modal -->
<div id="rejectModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h3>Reject Lawyer Verification</h3>
            <span class="close" onclick="closeRejectModal()">&times;</span>
        </div>
        <div class="modal-body">
            <p>Please provide a reason for rejecting this lawyer's application:</p>
            <textarea id="rejectionReason" placeholder="Enter rejection reason..." rows="4"></textarea>
        </div>
        <div class="modal-footer">
            <button class="btn btn-secondary" onclick="closeRejectModal()">Cancel</button>
            <button class="btn btn-danger" onclick="confirmReject()">Reject Application</button>
        </div>
    </div>
</div>

<script>
let currentLawyerId = null;

function showRejectModal(lawyerId) {
    currentLawyerId = lawyerId;
    document.getElementById('rejectModal').style.display = 'block';
    document.getElementById('rejectionReason').value = '';
}

function closeRejectModal() {
    document.getElementById('rejectModal').style.display = 'none';
    currentLawyerId = null;
}

function approveLawyer(lawyerId) {
    // Show loading state
    const approveBtn = document.querySelector(`button[onclick="approveLawyer(${lawyerId})"]`);
    const originalText = approveBtn.innerHTML;
    approveBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Approving...';
    approveBtn.disabled = true;

    fetch(`/admin/lawyers/${lawyerId}/approve`, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json'
        }
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            showNotification('Lawyer approved successfully!', 'success');
            setTimeout(() => location.reload(), 1000);
        } else {
            approveBtn.innerHTML = originalText;
            approveBtn.disabled = false;
            showNotification(data.message || 'Error approving lawyer', 'error');
        }
    })
    .catch(error => {
        console.error('Error:', error);
        approveBtn.innerHTML = originalText;
        approveBtn.disabled = false;
        showNotification('An error occurred while approving the lawyer.', 'error');
    });
}

function confirmReject() {
    const reason = document.getElementById('rejectionReason').value.trim();
    if (!reason) {
        showNotification('Please provide a reason for rejection.', 'error');
        return;
    }

    // Show loading state
    const rejectBtn = document.querySelector('.modal-footer .btn-danger');
    const originalText = rejectBtn.innerHTML;
    rejectBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Rejecting...';
    rejectBtn.disabled = true;

    fetch(`/admin/lawyers/${currentLawyerId}/reject`, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json'
        },
        body: JSON.stringify({ reason: reason })
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            showNotification('Lawyer application rejected', 'success');
            closeRejectModal();
            setTimeout(() => location.reload(), 1000);
        } else {
            rejectBtn.innerHTML = originalText;
            rejectBtn.disabled = false;
            showNotification(data.message || 'Error rejecting lawyer', 'error');
        }
    })
    .catch(error => {
        console.error('Error:', error);
        rejectBtn.innerHTML = originalText;
        rejectBtn.disabled = false;
        showNotification('An error occurred while rejecting the lawyer.', 'error');
    });
}

// Close modal when clicking outside
window.onclick = function(event) {
    const modal = document.getElementById('rejectModal');
    if (event.target === modal) {
        closeRejectModal();
    }
}

// Custom notification system
function showNotification(message, type = 'info') {
    // Remove existing notifications
    const existingNotifications = document.querySelectorAll('.toast-notification');
    existingNotifications.forEach(notification => notification.remove());

    // Create notification element
    const notification = document.createElement('div');
    notification.className = `toast-notification toast-${type}`;
    notification.innerHTML = `
        <div class="toast-content">
            <i class="fas ${type === 'success' ? 'fa-check-circle' : type === 'error' ? 'fa-exclamation-circle' : 'fa-info-circle'}"></i>
            <span>${message}</span>
        </div>
        <button class="toast-close" onclick="this.parentElement.remove()">
            <i class="fas fa-times"></i>
        </button>
    `;

    // Add to page
    document.body.appendChild(notification);

    // Auto remove after 4 seconds
    setTimeout(() => {
        if (notification.parentElement) {
            notification.style.opacity = '0';
            notification.style.transform = 'translateX(100%)';
            setTimeout(() => notification.remove(), 300);
        }
    }, 4000);

    // Trigger animation
    setTimeout(() => {
        notification.style.opacity = '1';
        notification.style.transform = 'translateX(0)';
    }, 100);
}
</script>