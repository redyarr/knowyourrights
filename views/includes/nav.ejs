
<link rel="stylesheet" href="/css/nav.css">
<link rel="stylesheet" href="/css/style.css">
<script src="/js/nav.js"></script>

<nav class="navbar">
    <div class="navbar-container">
      <div class="navbar-logo">
        <a href="/">
          <span>Legal</span>Hub
        </a>
      </div>
      
      <div class="navbar-toggle" id="mobile-menu">
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </div>
      
      <ul class="navbar-menu">
        <li class="navbar-item">
          <a href="/" class="navbar-link <%= locals.currentPath === '/' ? 'active' : '' %>">
            <i class="fas fa-home"></i> Home
          </a>
        </li>
        <li class="navbar-item dropdown">
          <a href="#" class="navbar-link dropdown-toggle">
            <i class="fas fa-gavel"></i> Lawyers <i class="fas fa-chevron-down"></i>
          </a>
          <div class="dropdown-menu">
            <a href="/lawyer/lawyers" class="dropdown-item <%= locals.currentPath === '/lawyer/lawyers' ? 'active' : '' %>">Find Lawyers</a>
            <a href="/lawyer/lawyerForm" class="dropdown-item <%= locals.currentPath === '/lawyer/lawyerForm' ? 'active' : '' %>">Lawyer Form</a>
          </div>
        </li>
        <li class="navbar-item dropdown">
          <a href="#" class="navbar-link dropdown-toggle">
            <i class="fas fa-blog"></i> Blog <i class="fas fa-chevron-down"></i>
          </a>
          <div class="dropdown-menu">
            <a href="/blog" class="dropdown-item <%= locals.currentPath === '/blog' ? 'active' : '' %>">All Blogs</a>
            <a href="/blog/form" class="dropdown-item <%= locals.currentPath === '/blog/form' ? 'active' : '' %>">Create Blog</a>
            <a href="/blog/Cat" class="dropdown-item <%= locals.currentPath === '/blog/Cat' ? 'active' : '' %>">Categories</a>
          </div>
        </li>
        <li class="navbar-item dropdown">
          <a href="#" class="navbar-link dropdown-toggle">
            <i class="fas fa-users"></i> Users <i class="fas fa-chevron-down"></i>
          </a>
          <div class="dropdown-menu">
            <a href="/user/users" class="dropdown-item <%= locals.currentPath === '/user/users' ? 'active' : '' %>">All Users</a>
            <% if (locals.loggedInUserId) { %>
              <a href="/user/<%= locals.loggedInUserId %>" class="dropdown-item">My Profile</a>
            <% } %>
          </div>
        </li>
      </ul>
      
      <div class="navbar-auth">
        <% if (locals.loggedInUserId) { %>
          <a href="/user/logout" class="auth-btn logout-btn">
            <i class="fas fa-sign-out-alt"></i> Logout
          </a>
        <% } else { %>
          <a href="/user/login" class="auth-btn login-btn <%= locals.currentPath === '/user/login' ? 'active' : '' %>">
            <i class="fas fa-sign-in-alt"></i> Login
          </a>
          <a href="/user/create" class="auth-btn register-btn <%= locals.currentPath === '/user/create' ? 'active' : '' %>">
            <i class="fas fa-user-plus"></i> Register
          </a>
        <% } %>
      </div>
    </div>
  </nav>