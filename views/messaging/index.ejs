<div class="min-h-screen bg-gradient-to-br from-blue-50 via-indigo-50 to-purple-50 py-8 mt-16">
    <div class="max-w-4xl mx-auto px-4">
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
            <!-- Messages header -->
            <div class="p-4 border-b border-gray-200 bg-white">
                <div class="flex justify-between items-center">
                    <div class="flex items-center">
                        <div class="w-8 h-8 bg-blue-600 rounded-lg flex items-center justify-center mr-3">
                            <i class="fas fa-comments text-white text-sm"></i>
                        </div>
                        <h1 class="text-xl font-semibold text-gray-900">Messaging</h1>
                    </div>
                    <div class="flex space-x-2">
                        <a href="/messaging/search" class="bg-blue-600 hover:bg-blue-700 text-white p-2 rounded-lg transition-colors" title="Find Users">
                            <i class="fas fa-user-plus text-sm"></i>
                        </a>
                        <button class="border border-gray-300 text-gray-700 hover:bg-gray-50 p-2 rounded-lg transition-colors">
                            <i class="fas fa-ellipsis-h text-sm"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Messages search -->
            <div class="p-4 border-b border-gray-200">
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 pl-3 flex items-center">
                        <i class="fas fa-search text-gray-400 text-sm"></i>
                    </span>
                    <input type="text" id="messageSearch" placeholder="Search conversations..."
                        class="w-full pl-10 pr-4 py-2 bg-gray-50 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all">
                </div>
            </div>

            <!-- Messages list -->
            <div class="divide-y divide-gray-200 max-h-[calc(100vh-300px)] overflow-y-auto">
                <% messages.forEach(message=> { %>
                    <a href="/messaging/<%= message.user.id %>" class="block">
                        <div class="message-item p-4 hover:bg-gray-50 cursor-pointer flex items-center space-x-3 transition-colors <%= message.unreadCount > 0 ? 'bg-blue-50 border-l-2 border-blue-500' : '' %>">
                            <div class="relative">
                                <img src="https://ui-avatars.com/api/?name=<%= message.user.firstName %>+<%= message.user.lastName %>&background=0ea5e9&color=ffffff"
                                    alt="Contact" class="w-12 h-12 rounded-full">
                                <% if (message.unreadCount> 0) { %>
                                    <span class="absolute -top-1 -right-1 bg-blue-600 text-white text-xs rounded-full w-5 h-5 flex items-center justify-center font-medium">
                                        <%= message.unreadCount %>
                                    </span>
                                <% } %>
                                <div class="absolute bottom-0 right-0 w-3 h-3 bg-green-500 rounded-full border-2 border-white"></div>
                            </div>
                            <div class="flex-1 min-w-0">
                                <div class="flex justify-between items-baseline mb-1">
                                    <div class="flex items-center space-x-2">
                                        <h4 class="font-medium truncate message-name <%= message.unreadCount > 0 ? 'text-gray-900' : 'text-gray-700' %>">
                                            <%= message.user.firstName %> <%= message.user.lastName %>
                                        </h4>
                                        <% if (message.user && message.user.role === 'lawyer' && message.user.lawyer) { %>
                                            <% 
                                                // Get lawyer rank information
                                                let rankInfo = {
                                                    badge: 'Training',
                                                    color: 'yellow',
                                                    icon: '🎓'
                                                };
                                                
                                                if (message.user.lawyer.verificationStatus === 'approved') {
                                                    rankInfo = {
                                                        badge: 'Verified',
                                                        color: 'green',
                                                        icon: '✓'
                                                    };
                                                } else if (message.user.lawyer.verificationStatus === 'pending') {
                                                    rankInfo = {
                                                        badge: 'Pending',
                                                        color: 'yellow',
                                                        icon: '⏳'
                                                    };
                                                } else if (message.user.lawyer.verificationStatus === 'rejected') {
                                                    rankInfo = {
                                                        badge: 'Rejected',
                                                        color: 'red',
                                                        icon: '✗'
                                                    };
                                                }
                                            %>
                                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-<%= rankInfo.color %>-100 text-<%= rankInfo.color %>-800">
                                                <%= rankInfo.badge %>
                                            </span>
                                        <% } %>
                                    </div>
                                    <span class="text-xs text-gray-500 font-medium">
                                        <%= new Date(message.lastMessage.createdAt).toLocaleDateString() %>
                                    </span>
                                </div>
                                <div class="flex justify-between items-center">
                                    <p class="text-sm truncate message-preview <%= message.unreadCount > 0 ? 'font-medium text-gray-800' : 'text-gray-500' %>">
                                        <%= message.lastMessage.content %>
                                    </p>
                                    <% if (message.unreadCount> 0) { %>
                                        <span class="ml-2 w-2 h-2 bg-blue-600 rounded-full flex-shrink-0"></span>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    </a>
                <% }) %>
            </div>
        </div>
    </div>
</div>

<style>
/* Enhanced responsive styles for messaging page */
@media (max-width: 768px) {
    .max-w-4xl {
        max-width: 100%;
        padding: 0;
    }
    
    .glass-card {
        margin: 0.5rem;
        border-radius: 1rem;
    }
    
    .p-6 {
        padding: 1rem !important;
    }
    
    .p-8 {
        padding: 1.5rem !important;
    }
    
    /* Header adjustments */
    .flex.justify-between.items-center {
        flex-direction: column;
        align-items: flex-start;
        gap: 1rem;
    }
    
    .flex.space-x-2 {
        width: 100%;
        justify-content: flex-end;
    }
    
    .text-2xl {
        font-size: 1.25rem;
    }
    
    /* Message items mobile */
    .message-item {
        padding: 1rem !important;
    }
    
    .flex.items-center.space-x-4 {
        flex-direction: row;
        align-items: flex-start;
        gap: 0.75rem;
    }
    
    .w-14.h-14 {
        width: 2.5rem !important;
        height: 2.5rem !important;
        flex-shrink: 0;
    }
    
    .flex.justify-between.items-baseline {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.25rem;
    }
    
    .flex.items-center.space-x-2 {
        flex-wrap: wrap;
        gap: 0.25rem;
    }
    
    .message-name {
        font-size: 1rem;
    }
    
    .message-preview {
        font-size: 0.875rem;
        line-height: 1.25;
    }
    
    /* Search input mobile */
    .relative input {
        padding-left: 2.5rem;
        font-size: 1rem;
    }
    
    .absolute.inset-y-0.left-0 {
        padding-left: 0.75rem;
    }
    
    /* Scrollable area mobile */
    .max-h-\[calc\(100vh-300px\)\] {
        max-height: calc(100vh - 200px);
    }
}

@media (max-width: 480px) {
    .glass-card {
        margin: 0.25rem;
        border-radius: 0.75rem;
    }
    
    .p-6 {
        padding: 0.75rem !important;
    }
    
    .message-item {
        padding: 0.75rem !important;
    }
    
    .w-14.h-14 {
        width: 2rem !important;
        height: 2rem !important;
    }
    
    .text-2xl {
        font-size: 1.125rem;
    }
    
    .message-name {
        font-size: 0.875rem;
    }
    
    .message-preview {
        font-size: 0.75rem;
    }
    
    .glass-button {
        padding: 0.5rem;
    }
}

/* Tablet adjustments */
@media (min-width: 769px) and (max-width: 1024px) {
    .max-w-4xl {
        max-width: 90%;
    }
    
    .message-item {
        padding: 1.25rem;
    }
    
    .w-14.h-14 {
        width: 3rem !important;
        height: 3rem !important;
    }
}
</style>

<script>
    // Search functionality
    document.getElementById('messageSearch').addEventListener('input', function (e) {
        const searchTerm = e.target.value.toLowerCase();
        const messageItems = document.querySelectorAll('.message-item');

        messageItems.forEach(item => {
            const name = item.querySelector('.message-name').textContent.toLowerCase();
            const preview = item.querySelector('.message-preview').textContent.toLowerCase();

            if (name.includes(searchTerm) || preview.includes(searchTerm)) {
                item.closest('a').style.display = 'block';
            } else {
                item.closest('a').style.display = 'none';
            }
        });
    });
</script>