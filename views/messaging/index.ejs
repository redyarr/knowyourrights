<div class="min-h-screen bg-gradient-to-br from-blue-50 via-indigo-50 to-purple-50 py-8 mt-16">
    <div class="max-w-4xl mx-auto px-4">
        <div class="glass-card bg-white/80 backdrop-blur-lg rounded-2xl shadow-xl border border-white/20 overflow-hidden">
            <!-- Enhanced Messages header -->
            <div class="p-6 border-b border-white/20 bg-gradient-to-r from-blue-600/10 to-indigo-600/10">
                <div class="flex justify-between items-center">
                    <div class="flex items-center">
                        <div class="w-10 h-10 bg-gradient-to-r from-blue-600 to-indigo-600 rounded-xl flex items-center justify-center mr-3 shadow-lg">
                            <i class="fas fa-comments text-white"></i>
                        </div>
                        <h1 class="text-2xl font-bold bg-gradient-to-r from-blue-600 to-indigo-600 bg-clip-text text-transparent">Messages</h1>
                    </div>
                    <div class="flex space-x-2">
                        <a href="/messaging/search" class="glass-button bg-blue-600/90 backdrop-blur-sm text-white p-3 rounded-xl shadow-lg hover:bg-blue-700/90 transition-all duration-300 transform hover:-translate-y-1 border border-white/20" title="Find Users">
                            <i class="fas fa-user-plus"></i>
                        </a>
                        <button class="glass-button bg-gray-600/90 backdrop-blur-sm text-white p-3 rounded-xl shadow-lg hover:bg-gray-700/90 transition-all duration-300 transform hover:-translate-y-1 border border-white/20">
                            <i class="fas fa-ellipsis-h"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Enhanced Messages search -->
            <div class="p-6 border-b border-white/20">
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 pl-4 flex items-center">
                        <i class="fas fa-search text-gray-400"></i>
                    </span>
                    <input type="text" id="messageSearch" placeholder="Search conversations..."
                        class="w-full pl-12 pr-4 py-3 bg-white/50 backdrop-blur-sm border border-white/30 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500/50 focus:border-blue-500/50 transition-all duration-300 shadow-inner">
                </div>
            </div>

            <!-- Enhanced Messages list -->
            <div class="divide-y divide-white/20 max-h-[calc(100vh-300px)] overflow-y-auto custom-scrollbar">
                <% messages.forEach(message=> { %>
                    <a href="/messaging/<%= message.user.id %>" class="block">
                        <div class="message-item p-6 hover:bg-white/30 cursor-pointer flex items-center space-x-4 transition-all duration-300 <%= message.unreadCount > 0 ? 'bg-blue-50/50 border-l-4 border-blue-500' : '' %>">
                            <div class="relative">
                                <img src="https://ui-avatars.com/api/?name=<%= message.user.firstName %>+<%= message.user.lastName %>"
                                    alt="Contact" class="w-14 h-14 rounded-full shadow-lg ring-2 ring-white/50">
                                <% if (message.unreadCount> 0) { %>
                                    <span class="absolute -top-1 -right-1 bg-gradient-to-r from-blue-600 to-indigo-600 text-white text-xs rounded-full w-6 h-6 flex items-center justify-center font-bold shadow-lg">
                                        <%= message.unreadCount %>
                                    </span>
                                <% } %>
                                <div class="absolute bottom-0 right-0 w-4 h-4 bg-green-500 rounded-full border-2 border-white shadow-sm"></div>
                            </div>
                            <div class="flex-1 min-w-0">
                                <div class="flex justify-between items-baseline mb-1">
                                    <div class="flex items-center space-x-2">
                                        <h4 class="font-bold truncate message-name <%= message.unreadCount > 0 ? 'text-gray-900' : 'text-gray-700' %> text-lg">
                                            <%= message.user.firstName %> <%= message.user.lastName %>
                                        </h4>
                                        <% if (message.user && message.user.role === 'lawyer' && message.user.lawyer) { %>
                                            <% 
                                                // Get lawyer rank information
                                                let rankInfo = {
                                                    badge: 'Training',
                                                    color: 'yellow',
                                                    icon: '🎓'
                                                };
                                                
                                                if (message.user.lawyer.verificationStatus === 'approved') {
                                                    rankInfo = {
                                                        badge: 'Verified',
                                                        color: 'green',
                                                        icon: '✓'
                                                    };
                                                } else if (message.user.lawyer.verificationStatus === 'pending') {
                                                    rankInfo = {
                                                        badge: 'Pending',
                                                        color: 'yellow',
                                                        icon: '⏳'
                                                    };
                                                } else if (message.user.lawyer.verificationStatus === 'rejected') {
                                                    rankInfo = {
                                                        badge: 'Rejected',
                                                        color: 'red',
                                                        icon: '✗'
                                                    };
                                                }
                                            %>
                                            <span class="inline-flex items-center px-1.5 py-0.5 rounded-full text-xs font-medium bg-<%= rankInfo.color %>-100 text-<%= rankInfo.color %>-800 border border-<%= rankInfo.color %>-200">
                                                <span class="mr-1"><%= rankInfo.icon %></span>
                                                <%= rankInfo.badge %>
                                            </span>
                                        <% } %>
                                    </div>
                                    <span class="text-xs text-gray-500 font-medium">
                                        <%= new Date(message.lastMessage.createdAt).toLocaleDateString() %>
                                    </span>
                                </div>
                                <div class="flex justify-between items-center">
                                    <p class="text-sm truncate message-preview <%= message.unreadCount > 0 ? 'font-semibold text-gray-800' : 'text-gray-600' %> leading-relaxed">
                                        <%= message.lastMessage.content %>
                                    </p>
                                    <% if (message.unreadCount> 0) { %>
                                        <span class="ml-2 w-3 h-3 bg-gradient-to-r from-blue-600 to-indigo-600 rounded-full flex-shrink-0 animate-pulse"></span>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    </a>
                <% }) %>
            </div>
        </div>
    </div>
</div>

<style>
/* Enhanced responsive styles for messaging page */
@media (max-width: 768px) {
    .max-w-4xl {
        max-width: 100%;
        padding: 0;
    }
    
    .glass-card {
        margin: 0.5rem;
        border-radius: 1rem;
    }
    
    .p-6 {
        padding: 1rem !important;
    }
    
    .p-8 {
        padding: 1.5rem !important;
    }
    
    /* Header adjustments */
    .flex.justify-between.items-center {
        flex-direction: column;
        align-items: flex-start;
        gap: 1rem;
    }
    
    .flex.space-x-2 {
        width: 100%;
        justify-content: flex-end;
    }
    
    .text-2xl {
        font-size: 1.25rem;
    }
    
    /* Message items mobile */
    .message-item {
        padding: 1rem !important;
    }
    
    .flex.items-center.space-x-4 {
        flex-direction: row;
        align-items: flex-start;
        gap: 0.75rem;
    }
    
    .w-14.h-14 {
        width: 2.5rem !important;
        height: 2.5rem !important;
        flex-shrink: 0;
    }
    
    .flex.justify-between.items-baseline {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.25rem;
    }
    
    .flex.items-center.space-x-2 {
        flex-wrap: wrap;
        gap: 0.25rem;
    }
    
    .message-name {
        font-size: 1rem;
    }
    
    .message-preview {
        font-size: 0.875rem;
        line-height: 1.25;
    }
    
    /* Search input mobile */
    .relative input {
        padding-left: 2.5rem;
        font-size: 1rem;
    }
    
    .absolute.inset-y-0.left-0 {
        padding-left: 0.75rem;
    }
    
    /* Scrollable area mobile */
    .max-h-\[calc\(100vh-300px\)\] {
        max-height: calc(100vh - 200px);
    }
}

@media (max-width: 480px) {
    .glass-card {
        margin: 0.25rem;
        border-radius: 0.75rem;
    }
    
    .p-6 {
        padding: 0.75rem !important;
    }
    
    .message-item {
        padding: 0.75rem !important;
    }
    
    .w-14.h-14 {
        width: 2rem !important;
        height: 2rem !important;
    }
    
    .text-2xl {
        font-size: 1.125rem;
    }
    
    .message-name {
        font-size: 0.875rem;
    }
    
    .message-preview {
        font-size: 0.75rem;
    }
    
    .glass-button {
        padding: 0.5rem;
    }
}

/* Tablet adjustments */
@media (min-width: 769px) and (max-width: 1024px) {
    .max-w-4xl {
        max-width: 90%;
    }
    
    .message-item {
        padding: 1.25rem;
    }
    
    .w-14.h-14 {
        width: 3rem !important;
        height: 3rem !important;
    }
}
</style>

<script>
    // Search functionality
    document.getElementById('messageSearch').addEventListener('input', function (e) {
        const searchTerm = e.target.value.toLowerCase();
        const messageItems = document.querySelectorAll('.message-item');

        messageItems.forEach(item => {
            const name = item.querySelector('.message-name').textContent.toLowerCase();
            const preview = item.querySelector('.message-preview').textContent.toLowerCase();

            if (name.includes(searchTerm) || preview.includes(searchTerm)) {
                item.closest('a').style.display = 'block';
            } else {
                item.closest('a').style.display = 'none';
            }
        });
    });
</script>