<div class="container mx-auto px-4 py-6">
    <div class="bg-white rounded-lg shadow">
        <!-- Messages header -->
        <div class="p-4 border-b flex justify-between items-center">
            <h1 class="text-2xl font-bold">Messaging</h1>
            <div class="flex space-x-2">
                <a href="/messaging/search" class="p-2 hover:bg-gray-100 rounded-full" title="Find Users">
                    <i class="fas fa-user-plus text-gray-600"></i>
                </a>
                <button class="p-2 hover:bg-gray-100 rounded-full">
                    <i class="fas fa-ellipsis-h text-gray-600"></i>
                </button>
            </div>
        </div>

        <!-- Messages search -->
        <div class="p-4 border-b">
            <div class="relative">
                <span class="absolute inset-y-0 left-0 pl-3 flex items-center">
                    <i class="fas fa-search text-gray-400"></i>
                </span>
                <input type="text" id="messageSearch" placeholder="Search messages"
                    class="w-full pl-10 pr-4 py-2 border border-gray-300 rounded-full focus:outline-none focus:ring-1 focus:ring-blue-500">
            </div>
        </div>

        <!-- Messages list -->
        <div class="divide-y max-h-[calc(100vh-300px)] overflow-y-auto custom-scrollbar">
            <% messages.forEach(message=> { %>
                <a href="/messaging/<%= message.user.id %>" class="block">
                    <div class="message-item p-4 hover:bg-gray-50 cursor-pointer flex items-center space-x-3 <%= message.unreadCount > 0 ? 'bg-blue-50' : '' %>">
                        <div class="relative">
                            <img src="https://ui-avatars.com/api/?name=<%= message.user.firstName %>+<%= message.user.lastName %>"
                                alt="Contact" class="w-12 h-12 rounded-full">
                            <% if (message.unreadCount> 0) { %>
                                <span class="absolute -top-1 -right-1 bg-blue-600 text-white text-xs rounded-full w-5 h-5 flex items-center justify-center">
                                    <%= message.unreadCount %>
                                </span>
                            <% } %>
                        </div>
                        <div class="flex-1 min-w-0">
                            <div class="flex justify-between items-baseline">
                                <h4 class="font-semibold truncate message-name <%= message.unreadCount > 0 ? 'text-black' : 'text-gray-700' %>">
                                    <%= message.user.firstName %> <%= message.user.lastName %>
                                </h4>
                                <span class="text-xs text-gray-500">
                                    <%= new Date(message.lastMessage.createdAt).toLocaleDateString() %>
                                </span>
                            </div>
                            <div class="flex justify-between items-center">
                                <p class="text-sm truncate message-preview <%= message.unreadCount > 0 ? 'font-semibold text-black' : 'text-gray-600' %>">
                                    <%= message.lastMessage.content %>
                                </p>
                                <% if (message.unreadCount> 0) { %>
                                    <span class="ml-2 w-2 h-2 bg-blue-600 rounded-full flex-shrink-0"></span>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </a>
            <% }) %>
        </div>
    </div>
</div>

<script>
    // Search functionality
    document.getElementById('messageSearch').addEventListener('input', function (e) {
        const searchTerm = e.target.value.toLowerCase();
        const messageItems = document.querySelectorAll('.message-item');

        messageItems.forEach(item => {
            const name = item.querySelector('.message-name').textContent.toLowerCase();
            const preview = item.querySelector('.message-preview').textContent.toLowerCase();

            if (name.includes(searchTerm) || preview.includes(searchTerm)) {
                item.closest('a').style.display = 'block';
            } else {
                item.closest('a').style.display = 'none';
            }
        });
    });
</script>