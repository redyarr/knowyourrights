<div class="fixed top-0 left-0 right-0 bg-white z-50">
  <!-- Header -->
  <div class="flex items-center justify-between p-4 border-b">
    <button onclick="history.back()" class="p-2">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
        <path d="M19 12H5M12 19L5 12L12 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
    
    <h1 class="text-lg font-semibold">Messages</h1>
    
    <button onclick="window.location.href='/messaging/search'" class="p-2">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
        <path d="M12 20H21L16 15L21 10H12M12 4V20" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>
  
  <!-- Inbox Label -->
  <div class="px-4 py-3 bg-gray-50 border-b">
    <h2 class="text-sm font-medium text-gray-600">Inbox</h2>
  </div>
</div>
  
<!-- Messages list -->
<div class="bg-white mt-32">
  <% if (messages.length === 0) { %>
    <div class="p-8 text-center text-gray-500">
      <p>No conversations yet</p>
    </div>
  <% } else { %>
    <% messages.forEach(message => { %>
      <a href="/messaging/<%= message.user.id %>" class="block">
        <div class="flex items-center p-4 border-b border-gray-100 hover:bg-gray-50 transition-colors">
          <img src="https://ui-avatars.com/api/?name=<%= message.user.firstName %>+<%= message.user.lastName %>&background=0ea5e9&color=ffffff"
               alt="<%= message.user.firstName %> <%= message.user.lastName %>" 
               class="w-12 h-12 rounded-full mr-3 flex-shrink-0">
          <div class="flex-1 min-w-0">
            <div class="flex justify-between items-start mb-1">
              <h3 class="font-medium text-gray-900 truncate"><%= message.user.firstName %> <%= message.user.lastName %></h3>
              <span class="text-xs text-gray-500 ml-2 flex-shrink-0">
                <%= new Date(message.lastMessage.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %>
              </span>
            </div>
            <p class="text-sm text-gray-600 truncate"><%= message.lastMessage.content %></p>
          </div>
          <% if (message.unreadCount > 0) { %>
            <div class="w-2 h-2 bg-blue-500 rounded-full ml-3 flex-shrink-0"></div>
          <% } %>
        </div>
      </a>
    <% }) %>
  <% } %>
</div>