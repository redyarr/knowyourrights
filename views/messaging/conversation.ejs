<div class="min-h-screen bg-gradient-to-br from-blue-50 via-indigo-50 to-purple-50 py-8 mt-16">
    <div class="max-w-6xl mx-auto px-4">
        <div class="glass-card bg-white/80 backdrop-blur-lg rounded-2xl shadow-xl border border-white/20 overflow-hidden">
            <div class="grid grid-cols-12 h-[calc(100vh-200px)]">
                <!-- Conversations Sidebar -->
                <div class="col-span-4 bg-white border-r border-gray-200 flex flex-col h-full shadow-sm">
                    <div class="p-6 border-b border-gray-200 bg-white">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center">
                                <div class="w-10 h-10 bg-gradient-to-r from-blue-600 to-indigo-600 rounded-xl flex items-center justify-center mr-3 shadow-lg">
                                    <i class="fas fa-comments text-white"></i>
                                </div>
                                <h2 class="text-xl font-bold text-gray-900">Messages</h2>
                            </div>
                            <a href="/messaging" class="bg-gray-600 hover:bg-gray-700 text-white p-2 rounded-xl shadow-lg transition-all duration-300 transform hover:-translate-y-1" title="Back to Messages">
                                <i class="fas fa-arrow-left"></i>
                            </a>
                        </div>
                    </div>
                    <div class="p-4">
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 pl-4 flex items-center">
                                <i class="fas fa-search text-gray-400"></i>
                            </span>
                            <input type="text" id="messageSearch" placeholder="Search conversations..."
                                class="w-full pl-12 pr-4 py-3 bg-gray-50 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:bg-white placeholder-gray-500 text-sm transition-all duration-200">
                        </div>
                    </div>
            <!-- Conversations List -->
            <div class="flex-1 overflow-y-auto">
                <% if (conversations.length === 0) { %>
                    <div class="p-8 text-center">
                        <div class="w-12 h-12 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-3">
                            <i class="fas fa-comments text-gray-400"></i>
                        </div>
                        <h3 class="text-sm font-medium text-gray-900 mb-1">No conversations</h3>
                        <p class="text-xs text-gray-500">Start messaging to see conversations here</p>
                    </div>
                <% } else { %>
                    <div class="divide-y divide-gray-200">
                        <% conversations.forEach(conv => { %>
                            <a href="/messaging/<%= conv.user.id %>" class="block">
                                <div class="message-item p-4 hover:bg-gray-50 cursor-pointer flex items-center space-x-3 transition-all duration-200 <%= activeConversation == conv.user.id ? 'bg-blue-50 border-r-4 border-blue-500' : '' %> <%= conv.unreadCount > 0 && activeConversation != conv.user.id ? 'bg-blue-50 border-r-4 border-blue-500' : '' %>">
                                    <div class="relative flex-shrink-0">
                                        <img src="https://ui-avatars.com/api/?name=<%= conv.user.firstName %>+<%= conv.user.lastName %>&background=0ea5e9&color=ffffff" 
                                             alt="<%= conv.user.firstName %> <%= conv.user.lastName %>" class="w-12 h-12 rounded-full shadow-sm">
                                        <% if (conv.unreadCount > 0) { %>
                                            <span class="absolute -top-1 -right-1 bg-blue-600 text-white text-xs rounded-full w-5 h-5 flex items-center justify-center font-medium shadow-sm">
                                                <%= conv.unreadCount %>
                                            </span>
                                        <% } %>
                                        <div class="absolute bottom-0 right-0 w-3 h-3 bg-green-500 rounded-full border-2 border-white shadow-sm"></div>
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <div class="flex justify-between items-start mb-1">
                                            <div class="flex items-center space-x-2">
                                                <h4 class="font-semibold text-gray-900 truncate <%= conv.unreadCount > 0 ? 'text-gray-900' : 'text-gray-800' %>">
                                                    <%= conv.user.firstName %> <%= conv.user.lastName %>
                                                </h4>
                                            <% if (conv.user && conv.user.role === 'lawyer' && conv.user.lawyer) { %>
                                                <% 
                                                    // Get lawyer rank information
                                                    let rankInfo = {
                                                        badge: 'Training',
                                                        color: 'yellow',
                                                        icon: '🎓'
                                                    };
                                                    
                                                    if (conv.user.lawyer.verificationStatus === 'approved') {
                                                        rankInfo = {
                                                            badge: 'Verified',
                                                            color: 'green',
                                                            icon: '✓'
                                                        };
                                                    } else if (conv.user.lawyer.verificationStatus === 'pending') {
                                                        rankInfo = {
                                                            badge: 'Pending',
                                                            color: 'yellow',
                                                            icon: '⏳'
                                                        };
                                                    } else if (conv.user.lawyer.verificationStatus === 'rejected') {
                                                        rankInfo = {
                                                            badge: 'Rejected',
                                                            color: 'red',
                                                            icon: '✗'
                                                        };
                                                    }
                                                %>
                                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-<%= rankInfo.color %>-100 text-<%= rankInfo.color %>-800 shadow-sm">
                                                    <span class="mr-1"><%= rankInfo.icon %></span>
                                                    <%= rankInfo.badge %>
                                                </span>
                                            <% } %>
                                        </div>
                                        <span class="text-xs text-gray-500 font-medium flex-shrink-0">
                                            <%= new Date(conv.lastMessage.createdAt).toLocaleDateString() %>
                                        </span>
                                    </div>
                                    <p class="text-sm text-gray-600 truncate <%= conv.unreadCount > 0 ? 'font-medium text-gray-800' : '' %> leading-relaxed">
                                        <%= conv.lastMessage.content %>
                                    </p>
                                </div>
                            </div>
                        </a>
                    <% }) %>
                    </div>
                <% } %>
            </div>
            </div>
            
        <!-- Conversation Content -->
        <div class="col-span-8 flex flex-col h-full bg-white">
            <% if (conversationPartner) { %>
                <!-- Conversation Header -->
                <div class="p-6 border-b border-gray-200 bg-white shadow-sm">
                    <div class="flex items-center justify-between">
                        <a href="/in/<%= conversationPartner.id %>" class="flex items-center space-x-4 hover:opacity-80 transition-all duration-200">
                            <div class="relative">
                                <img src="https://ui-avatars.com/api/?name=<%= conversationPartner.firstName %>+<%= conversationPartner.lastName %>&background=0ea5e9&color=ffffff" 
                                     alt="<%= conversationPartner.firstName %> <%= conversationPartner.lastName %>" class="w-12 h-12 rounded-full shadow-sm">
                                <div class="absolute bottom-0 right-0 w-3 h-3 bg-green-500 rounded-full border-2 border-white shadow-sm"></div>
                            </div>
                            <div>
                                <div class="flex items-center space-x-3 mb-1">
                                    <h3 class="font-bold text-lg text-gray-900"><%= conversationPartner.firstName %> <%= conversationPartner.lastName %></h3>
                                    <% if (conversationPartner && conversationPartner.role === 'lawyer' && conversationPartner.lawyer) { %>
                                        <% 
                                            // Get lawyer rank information
                                            let rankInfo = {
                                                badge: 'Training',
                                                color: 'yellow',
                                                icon: '🎓'
                                            };
                                            
                                            if (conversationPartner.lawyer.verificationStatus === 'approved') {
                                                rankInfo = {
                                                    badge: 'Verified',
                                                    color: 'green',
                                                    icon: '✓'
                                                };
                                            } else if (conversationPartner.lawyer.verificationStatus === 'pending') {
                                                rankInfo = {
                                                    badge: 'Pending',
                                                    color: 'yellow',
                                                    icon: '⏳'
                                                };
                                            } else if (conversationPartner.lawyer.verificationStatus === 'rejected') {
                                                rankInfo = {
                                                    badge: 'Rejected',
                                                    color: 'red',
                                                    icon: '✗'
                                                };
                                            }
                                        %>
                                        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-<%= rankInfo.color %>-100 text-<%= rankInfo.color %>-800 shadow-sm">
                                            <span class="mr-1"><%= rankInfo.icon %></span>
                                            <%= rankInfo.badge %>
                                        </span>
                                     <% } %>
                                 </div>
                                 <p class="text-sm text-green-600 font-medium flex items-center">
                                     <div class="w-2 h-2 bg-green-500 rounded-full mr-2 animate-pulse"></div>
                                     Active now
                                 </p>
                             </div>
                         </a>
                         <div class="flex items-center space-x-3">
                             <% if (conversationPartner && conversationPartner.role === 'lawyer') { %>
                             <button id="giveFeedbackBtn" class="bg-green-600 hover:bg-green-700 text-white font-medium py-2 px-4 rounded-lg shadow-sm transition-all duration-200">
                                    <i class="fas fa-star mr-2"></i>
                                    Give Feedback
                              </button>
                              <% } %>
                              <button class="bg-gray-100 hover:bg-gray-200 text-gray-600 font-medium py-2 px-4 rounded-lg shadow-sm transition-all duration-200">
                                  <i class="fas fa-ellipsis-h"></i>
                              </button>
                          </div>
                      </div>
                  </div>

                  <!-- Messages Container -->
                  <div class="flex-1 p-6 overflow-y-auto bg-gray-50" id="messageContainer">
                      <% if (messages.length === 0) { %>
                          <div class="flex items-center justify-center h-full">
                              <div class="text-center">
                                  <div class="w-16 h-16 bg-gray-200 rounded-full flex items-center justify-center mx-auto mb-4">
                                      <i class="fas fa-comments text-gray-400 text-xl"></i>
                                  </div>
                                  <h3 class="text-lg font-medium text-gray-900 mb-2">No messages yet</h3>
                                  <p class="text-gray-600">Start the conversation by sending a message below.</p>
                              </div>
                          </div>
                      <% } else { %>
                          <% messages.forEach(message => { %>
                              <div class="mb-4 <%= message.senderId == userId ? 'flex justify-end' : 'flex justify-start' %>">
                                  <div class="<%= message.senderId == userId ? 'bg-blue-600 text-white' : 'bg-white text-gray-800 border border-gray-200' %> rounded-2xl px-4 py-3 max-w-xs lg:max-w-md shadow-sm">
                                      <p class="text-sm leading-relaxed"><%= message.content %></p>
                                      <p class="text-xs <%= message.senderId == userId ? 'text-blue-100' : 'text-gray-500' %> text-right mt-2">
                                          <%= new Date(message.createdAt).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %>
                                      </p>
                                  </div>
                              </div>
                          <% }) %>
                      <% } %>
                  </div>

                  <!-- Message Input -->
                  <div class="p-6 border-t border-gray-200 bg-white">
                      <form action="/messaging/<%= conversationPartner.id %>/send" method="POST" class="flex space-x-3" id="messageForm">
                          <div class="flex-1 relative">
                              <input type="text" name="content" placeholder="Type your message..." required id="messageInput"
                                  class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:bg-white transition-all duration-200 text-gray-800 placeholder-gray-500 pr-20">
                              <div class="absolute right-3 top-1/2 transform -translate-y-1/2 flex space-x-2">
                                  <button type="button" class="text-gray-400 hover:text-blue-500 transition-colors duration-200" title="Add emoji">
                                      <i class="fas fa-smile text-sm"></i>
                                  </button>
                                  <button type="button" class="text-gray-400 hover:text-blue-500 transition-colors duration-200" title="Attach file">
                                      <i class="fas fa-paperclip text-sm"></i>
                                  </button>
                              </div>
                          </div>
                          <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white rounded-lg px-4 py-3 shadow-sm transition-all duration-200">
                              <i class="fas fa-paper-plane"></i>
                          </button>
                      </form>
                  </div>
            <% } else { %>
                <div class="flex-1 flex items-center justify-center bg-white">
                    <div class="text-center p-12">
                        <div class="w-20 h-20 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-6">
                            <i class="fas fa-comments text-3xl text-blue-600"></i>
                        </div>
                        <h3 class="text-2xl font-bold text-gray-900 mb-3">Your Messages</h3>
                        <p class="text-gray-600 text-lg mb-6">Select a conversation from the sidebar or start a new one</p>
                        <a href="/messaging/search" class="inline-flex items-center px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg shadow-sm transition-all duration-200">
                            <i class="fas fa-user-plus mr-2"></i>
                            Find Users to Message
                        </a>
                    </div>
                </div>
            <% } %>
            </div>
        </div>
    </div>
</div>

<!-- Feedback Modal -->
<div id="feedbackModal" class="fixed inset-0 bg-black bg-opacity-50 overflow-y-auto h-full w-full flex items-center justify-center" style="display: none;">
    <div class="bg-white p-8 rounded-xl shadow-2xl w-full max-w-md mx-4">
        <div class="flex justify-between items-center mb-6">
            <h3 class="text-2xl font-bold text-gray-900">Give Feedback</h3>
            <button id="closeFeedbackModal" class="text-gray-400 hover:text-gray-600 transition-colors">
                <i class="fas fa-times text-xl"></i>
            </button>
        </div>
        <form id="feedbackForm">
            <input type="hidden" id="feedbackLawyerId" name="lawyerId" value="<%= conversationPartner ? conversationPartner.id : '' %>">
            <input type="hidden" id="feedbackConversationId" name="conversationId" value="<%= activeConversation ? activeConversation : '' %>"> <!-- Assuming activeConversation holds the conversation ID -->
            <div class="mb-6">
                <label for="rating" class="block text-sm font-semibold text-gray-700 mb-3">Rating</label>
                <div class="flex items-center space-x-1" id="starRating">
                    <% for(let i = 1; i <= 5; i++) { %>
                        <i class="far fa-star text-2xl text-yellow-400 cursor-pointer star hover:text-yellow-500 transition-colors" data-value="<%= i %>"></i>
                    <% } %>
                </div>
                <input type="hidden" name="rating" id="feedbackRating" required>
            </div>
            <div class="mb-6">
                <label for="review" class="block text-sm font-semibold text-gray-700 mb-3">Comment (Optional)</label>
                <textarea id="feedbackReview" name="review" rows="4" class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent resize-none"></textarea>
            </div>
            <div class="flex justify-end space-x-3">
                <button type="button" id="cancelFeedback" class="px-6 py-2 text-sm font-medium text-gray-700 bg-gray-100 hover:bg-gray-200 rounded-lg transition-colors">Cancel</button>
                <button type="submit" class="px-6 py-2 text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 rounded-lg transition-colors">Submit Feedback</button>
            </div>
        </form>
    </div>
</div>

<script>
    // Improved function to scroll to bottom of message container
    function scrollToBottom() {
        const messageContainer = document.getElementById('messageContainer');
        if (messageContainer) {
            // Force scroll to absolute bottom
            messageContainer.scrollTop = messageContainer.scrollHeight + 1000;
            console.log('Scrolled to bottom, height:', messageContainer.scrollHeight);
        }
    }
    
    // Function to focus the message input
    function focusMessageInput() {
        const messageInput = document.getElementById('messageInput');
        if (messageInput) {
            messageInput.focus();
            console.log('Message input focused');
        }
    }
    
    // Function to add a message to the UI without page refresh
    function addMessageToUI(content, isSent, timestamp) {
        const messageContainer = document.getElementById('messageContainer');
        if (!messageContainer) return;
        
        const messageDiv = document.createElement('div');
        messageDiv.className = `flex ${isSent ? 'justify-end' : 'justify-start'} mb-4`;
        
        const timeString = new Date(timestamp).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
        
        messageDiv.innerHTML = `
            <div class="max-w-xs lg:max-w-md px-6 py-4 rounded-2xl shadow-lg backdrop-blur-sm border border-white/30 transition-all duration-300 hover:shadow-xl ${
                isSent 
                    ? 'bg-gradient-to-r from-blue-600 to-indigo-600 text-white ml-auto' 
                    : 'bg-white/80 text-gray-800 mr-auto'
            }">
                <p class="text-sm leading-relaxed">${escapeHtml(content)}</p>
                <p class="text-xs mt-2 opacity-70">${timeString}</p>
            </div>
        `;
        
        messageContainer.appendChild(messageDiv);
    }
    
    // Function to escape HTML to prevent XSS
    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }
    
    // Function to update conversation preview in sidebar
    function updateConversationPreview(lastMessage) {
        const currentUrl = window.location.pathname;
        const userId = currentUrl.split('/messaging/')[1];
        if (!userId) return;
        
        const conversationLink = document.querySelector(`a[href="/messaging/${userId}"]`);
        if (conversationLink) {
            const previewElement = conversationLink.querySelector('.message-preview');
            if (previewElement) {
                previewElement.textContent = lastMessage;
                previewElement.classList.add('font-semibold', 'text-gray-800');
            }
            
            // Update timestamp
            const timestampElement = conversationLink.querySelector('.text-xs.text-gray-500');
            if (timestampElement) {
                timestampElement.textContent = new Date().toLocaleDateString();
            }
        }
    }
    
    // Polling function to check for new messages
    let lastMessageId = null;
    let pollingInterval = null;
    
    function startMessagePolling() {
        const currentUrl = window.location.pathname;
        const userId = currentUrl.split('/messaging/')[1];
        if (!userId) return;
        
        // Get the last message ID from the current conversation
        const messages = document.querySelectorAll('#messageContainer > div');
        if (messages.length > 0) {
            // For now, we'll use timestamp as a simple way to track new messages
            lastMessageId = Date.now();
        }
        
        pollingInterval = setInterval(async () => {
            try {
                const conversationId = userId;
                const response = await fetch(`/messaging/${conversationId}/check-new?since=${lastMessageId}`);
                if (response.ok) {
                    const data = await response.json();
                    if (data.newMessages && data.newMessages.length > 0) {
                         // Hide typing indicator if showing
                         hideTypingIndicator();
                         
                         data.newMessages.forEach(message => {
                             addMessageToUI(message.content, false, message.createdAt);
                             lastMessageId = Math.max(lastMessageId, new Date(message.createdAt).getTime());
                         });
                         scrollToBottom();
                         
                         // Update conversation preview with the latest message
                         const latestMessage = data.newMessages[data.newMessages.length - 1];
                         updateConversationPreview(latestMessage.content);
                         
                         // Show notification for new messages (only if page is not focused)
                         if (document.hidden) {
                             showMessageStatus(`${data.newMessages.length} new message${data.newMessages.length > 1 ? 's' : ''}`, 'info');
                         }
                         
                         // Play notification sound (optional)
                         playNotificationSound();
                     }
                }
            } catch (error) {
                console.error('Error checking for new messages:', error);
            }
        }, 3000); // Check every 3 seconds
    }
    
    function stopMessagePolling() {
         if (pollingInterval) {
             clearInterval(pollingInterval);
             pollingInterval = null;
         }
     }
     
     // Function to show message status feedback
     function showMessageStatus(message, type = 'info') {
         const statusDiv = document.createElement('div');
         statusDiv.className = `fixed top-4 right-4 px-4 py-2 rounded-lg shadow-lg z-50 transition-all duration-300 ${
             type === 'success' ? 'bg-green-500 text-white' :
             type === 'error' ? 'bg-red-500 text-white' :
             'bg-blue-500 text-white'
         }`;
         statusDiv.textContent = message;
         
         document.body.appendChild(statusDiv);
         
         // Animate in
         setTimeout(() => {
             statusDiv.style.transform = 'translateX(0)';
             statusDiv.style.opacity = '1';
         }, 100);
         
         // Remove after 3 seconds
         setTimeout(() => {
             statusDiv.style.transform = 'translateX(100%)';
             statusDiv.style.opacity = '0';
             setTimeout(() => {
                 if (statusDiv.parentNode) {
                     statusDiv.parentNode.removeChild(statusDiv);
                 }
             }, 300);
         }, 3000);
     }
     
     // Function to show typing indicator
     function showTypingIndicator() {
         const messageContainer = document.getElementById('messageContainer');
         if (!messageContainer) return;
         
         // Remove existing typing indicator
         const existingIndicator = document.getElementById('typingIndicator');
         if (existingIndicator) {
             existingIndicator.remove();
         }
         
         const typingDiv = document.createElement('div');
         typingDiv.id = 'typingIndicator';
         typingDiv.className = 'flex justify-start mb-4';
         typingDiv.innerHTML = `
             <div class="max-w-xs lg:max-w-md px-6 py-4 rounded-2xl shadow-lg backdrop-blur-sm border border-white/30 bg-white/80 text-gray-800 mr-auto">
                 <div class="flex items-center space-x-1">
                     <div class="flex space-x-1">
                         <div class="w-2 h-2 bg-gray-400 rounded-full animate-bounce"></div>
                         <div class="w-2 h-2 bg-gray-400 rounded-full animate-bounce" style="animation-delay: 0.1s"></div>
                         <div class="w-2 h-2 bg-gray-400 rounded-full animate-bounce" style="animation-delay: 0.2s"></div>
                     </div>
                     <span class="text-xs text-gray-500 ml-2">typing...</span>
                 </div>
             </div>
         `;
         
         messageContainer.appendChild(typingDiv);
         scrollToBottom();
     }
     
     function hideTypingIndicator() {
          const typingIndicator = document.getElementById('typingIndicator');
          if (typingIndicator) {
              typingIndicator.remove();
          }
      }
      
      // Function to play notification sound
      function playNotificationSound() {
          try {
              // Create a subtle notification sound using Web Audio API
              const audioContext = new (window.AudioContext || window.webkitAudioContext)();
              const oscillator = audioContext.createOscillator();
              const gainNode = audioContext.createGain();
              
              oscillator.connect(gainNode);
              gainNode.connect(audioContext.destination);
              
              oscillator.frequency.setValueAtTime(800, audioContext.currentTime);
              oscillator.frequency.setValueAtTime(600, audioContext.currentTime + 0.1);
              
              gainNode.gain.setValueAtTime(0, audioContext.currentTime);
              gainNode.gain.linearRampToValueAtTime(0.1, audioContext.currentTime + 0.01);
              gainNode.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.2);
              
              oscillator.start(audioContext.currentTime);
              oscillator.stop(audioContext.currentTime + 0.2);
          } catch (error) {
              // Fallback: no sound if Web Audio API is not supported
              console.log('Notification sound not available');
          }
      }

    // Scroll on page load with multiple attempts and focus input
    document.addEventListener('DOMContentLoaded', function() {
        // Scroll immediately
        scrollToBottom();
        
        // Schedule multiple scroll attempts with increasing delays
        [100, 300, 500, 1000].forEach(delay => {
            setTimeout(scrollToBottom, delay);
        });
        
        // Focus the message input after a short delay
        setTimeout(focusMessageInput, 300);
        
        // Start polling for new messages if we're in a conversation
        const currentUrl = window.location.pathname;
        if (currentUrl.includes('/messaging/') && currentUrl.split('/messaging/')[1]) {
            setTimeout(startMessagePolling, 1000); // Start polling after 1 second
        }
        
        // Add keyboard shortcuts
        document.addEventListener('keydown', function(e) {
            // Enter key to send message (without Shift)
            if (e.key === 'Enter' && !e.shiftKey) {
                const messageInput = document.getElementById('messageInput');
                if (messageInput && document.activeElement === messageInput) {
                    e.preventDefault();
                    const messageForm = document.getElementById('messageForm');
                    if (messageForm) {
                        messageForm.dispatchEvent(new Event('submit'));
                    }
                }
            }
            
            // Escape key to focus message input
            if (e.key === 'Escape') {
                focusMessageInput();
            }
        });
        
        // Handle message search functionality
        const messageSearch = document.getElementById('messageSearch');
        if (messageSearch) {
            messageSearch.addEventListener('input', (e) => {
                const searchTerm = e.target.value.toLowerCase();
                const conversationLinks = document.querySelectorAll('.col-span-4 .border-r a[href^="/messaging/"]');
                
                conversationLinks.forEach(link => {
                    const nameElement = link.querySelector('h4');
                    const previewElement = link.querySelector('p');
                    
                    if (!nameElement || !previewElement) return;
                    
                    const name = nameElement.textContent.toLowerCase();
                    const preview = previewElement.textContent.toLowerCase();
                    
                    if (name.includes(searchTerm) || preview.includes(searchTerm)) {
                        link.style.display = 'block';
                    } else {
                        link.style.display = 'none';
                    }
                });
            });
        }
        
        // Enhanced AJAX form submission handler
        const messageForm = document.getElementById('messageForm');
        if (messageForm) {
            messageForm.addEventListener('submit', async function(e) {
                e.preventDefault(); // Prevent default form submission
                
                const messageInput = document.getElementById('messageInput');
                const submitButton = messageForm.querySelector('button[type="submit"]');
                const messageContent = messageInput.value.trim();
                
                if (!messageContent) return;
                
                // Disable form during submission
                messageInput.disabled = true;
                submitButton.disabled = true;
                submitButton.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
                
                try {
                    // Construct AJAX URL properly
                    const conversationId = '<%= conversationPartner.id %>';
                    const ajaxUrl = `/messaging/${conversationId}/send-ajax`;
                    const response = await fetch(ajaxUrl, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify({ content: messageContent })
                    });
                    
                    if (response.ok) {
                        const result = await response.json();
                        if (result.success) {
                            // Clear input and add message to UI immediately
                            messageInput.value = '';
                            addMessageToUI(messageContent, true, new Date());
                            scrollToBottom();
                            
                            // Update conversation list preview
                        updateConversationPreview(messageContent);
                        
                        // Show success feedback
                        showMessageStatus('Message sent!', 'success');
                        } else {
                            throw new Error(result.error || 'Failed to send message');
                        }
                    } else {
                        const errorResult = await response.json();
                        throw new Error(errorResult.error || 'Failed to send message');
                    }
                } catch (error) {
                     console.error('Error sending message:', error);
                     showMessageStatus('Failed to send message. Please try again.', 'error');
                 } finally {
                    // Re-enable form
                    messageInput.disabled = false;
                    submitButton.disabled = false;
                    submitButton.innerHTML = '<i class="fas fa-paper-plane"></i>';
                    messageInput.focus();
                }
            });
        }
    });
    
    // Also scroll when all resources are fully loaded and focus input
    window.addEventListener('load', function() {
        scrollToBottom();
        // Try again after a short delay
        setTimeout(scrollToBottom, 200);
        // Focus the message input
        focusMessageInput();
    });
    
    // Handle page visibility changes to pause/resume polling
    document.addEventListener('visibilitychange', function() {
        if (document.hidden) {
            // Page is hidden, stop polling to save resources
            stopMessagePolling();
        } else {
            // Page is visible again, resume polling
            const currentUrl = window.location.pathname;
            if (currentUrl.includes('/messaging/') && currentUrl.split('/messaging/')[1]) {
                startMessagePolling();
            }
        }
    });
    
    // Clean up polling when leaving the page
    window.addEventListener('beforeunload', function() {
        stopMessagePolling();
    });
    
    // Handle navigation away from messaging
    window.addEventListener('popstate', function() {
        stopMessagePolling();
    });
    
    // Check if we just sent a message and need to scroll
    if (localStorage.getItem('messageSent') === 'true') {
        // Clear the flag
        localStorage.removeItem('messageSent');
        // Scroll to bottom with multiple attempts
        scrollToBottom();
        [100, 300, 500].forEach(delay => {
            setTimeout(scrollToBottom, delay);
        });
        // Focus the message input after a short delay
        setTimeout(focusMessageInput, 300);
    }

    // Feedback Modal Logic
    const giveFeedbackBtn = document.getElementById('giveFeedbackBtn');
    const feedbackModal = document.getElementById('feedbackModal');
    const closeFeedbackModalBtn = document.getElementById('closeFeedbackModal');
    const cancelFeedbackBtn = document.getElementById('cancelFeedback');
    const feedbackForm = document.getElementById('feedbackForm');
    const stars = document.querySelectorAll('#starRating .star');
    const feedbackRatingInput = document.getElementById('feedbackRating');

    if (giveFeedbackBtn) {
        giveFeedbackBtn.addEventListener('click', () => {
            if (feedbackModal) feedbackModal.style.display = 'flex';
        });
    }

    if (closeFeedbackModalBtn) {
        closeFeedbackModalBtn.addEventListener('click', () => {
            if (feedbackModal) feedbackModal.style.display = 'none';
        });
    }

    if (cancelFeedbackBtn) {
        cancelFeedbackBtn.addEventListener('click', () => {
            if (feedbackModal) feedbackModal.style.display = 'none';
        });
    }

    // Close modal if clicked outside of it
    if (feedbackModal) {
        feedbackModal.addEventListener('click', (event) => {
            if (event.target === feedbackModal) {
                feedbackModal.style.display = 'none';
            }
        });
    }

    stars.forEach(star => {
        star.addEventListener('click', () => {
            const value = parseInt(star.dataset.value);
            feedbackRatingInput.value = value;
            stars.forEach((s, index) => {
                if (index < value) {
                    s.classList.remove('far');
                    s.classList.add('fas');
                } else {
                    s.classList.remove('fas');
                    s.classList.add('far');
                }
            });
        });
    });

    if (feedbackForm) {
        feedbackForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = new FormData(feedbackForm);
            const data = Object.fromEntries(formData.entries());

            // Ensure lawyerId and conversationId are correctly populated
            // These might need to be dynamically set if the conversationPartner changes without a page reload
            data.lawyerId = document.getElementById('feedbackLawyerId').value;
            data.conversationId = document.getElementById('feedbackConversationId').value;

            if (!data.rating) {
                    notifications.warning('Please select a rating.');
                    return;
                }

            try {
                const response = await fetch('/feedback/submit', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify(data),
                });
                const result = await response.json();
                if (response.ok) {
                    notifications.success(result.message || 'Feedback submitted successfully!');
                    if (feedbackModal) feedbackModal.style.display = 'none';
                    feedbackForm.reset();
                    stars.forEach(s => {
                        s.classList.remove('fas');
                        s.classList.add('far');
                    });
                } else {
                    notifications.error(result.message || 'Failed to submit feedback.');
                }
            } catch (error) {
                console.error('Error submitting feedback:', error);
                notifications.error('An error occurred. Please try again.');
            }
        });
    }
</script>