<div class="max-w-4xl mx-auto">
    <div class="bg-white rounded-lg shadow">
        <div class="grid grid-cols-12 h-[calc(100vh-200px)]">
            <!-- Conversations Sidebar -->
            <div class="col-span-4 border-r">
                <div class="p-4 border-b">
                    <h2 class="text-xl font-bold">Messages</h2>
                </div>
                <div class="p-2">
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-3 flex items-center">
                            <i class="fas fa-search text-gray-400"></i>
                        </span>
                        <input type="text" id="messageSearch" placeholder="Search messages"
                            class="w-full pl-10 pr-4 py-2 border border-gray-300 rounded-full focus:outline-none focus:ring-1 focus:ring-blue-500">
                    </div>
                </div>
                <div class="overflow-y-auto h-[50vh] custom-scrollbar">
                    <% conversations.forEach(conv => { %>
                        <a href="/messaging/<%= conv.user.id %>" 
                           class="block p-3 hover:bg-gray-50 <%= activeConversation == conv.user.id ? 'bg-blue-50' : '' %>">
                            <div class="flex items-center space-x-3">
                                <img src="https://ui-avatars.com/api/?name=<%= conv.user.firstName %>+<%= conv.user.lastName %>" 
                                     alt="<%= conv.user.firstName %>" class="w-12 h-12 rounded-full">
                                <div class="flex-1 min-w-0">
                                    <div class="flex justify-between items-baseline">
                                        <h4 class="font-semibold truncate <%= conv.unreadCount > 0 ? 'text-black' : 'text-gray-700' %>">
                                            <%= conv.user.firstName %> <%= conv.user.lastName %>
                                        </h4>
                                        <span class="text-xs text-gray-500">
                                            <%= new Date(conv.lastMessage.createdAt).toLocaleDateString() %>
                                        </span>
                                    </div>
                                    <p class="text-sm truncate <%= conv.unreadCount > 0 ? 'font-semibold text-black' : 'text-gray-600' %>">
                                        <%= conv.lastMessage.content %>
                                    </p>
                                    <% if (conv.unreadCount > 0) { %>
                                        <span class="inline-block bg-blue-600 text-white text-xs rounded-full px-2 py-0.5 mt-1">
                                            <%= conv.unreadCount %>
                                        </span>
                                    <% } %>
                                </div>
                            </div>
                        </a>
                    <% }) %>
                </div>
            </div>
            
            <!-- Conversation Content -->
            <div class="col-span-8 flex flex-col h-full">
                <% if (conversationPartner) { %>
                    <!-- Conversation Header -->
                    <div class="p-4 border-b flex items-center space-x-3">
                        <img src="https://ui-avatars.com/api/?name=<%= conversationPartner.firstName %>+<%= conversationPartner.lastName %>" 
                             alt="<%= conversationPartner.firstName %>" class="w-10 h-10 rounded-full">
                        <div>
                            <h3 class="font-semibold"><%= conversationPartner.firstName %> <%= conversationPartner.lastName %></h3>
                            <p class="text-xs text-gray-500">Active now</p>
                        </div>
                        <% if (conversationPartner && conversationPartner.role === 'lawyer') { %>
                        <button id="giveFeedbackBtn" class="ml-auto bg-green-500 hover:bg-green-600 text-white font-bold py-2 px-4 rounded">
                            Give Feedback
                        </button>
                        <% } %>
                    </div>
                    
                    <!-- Messages Container with Half Screen Height -->
                    <div class="relative flex-grow overflow-hidden" style="height: 50vh;">
                        <!-- Scrollable Messages Area -->
                        <div class="absolute inset-0 p-4 overflow-y-scroll" id="messageContainer">
                            <% messages.forEach(message => { %>
                                <div class="mb-4 <%= message.senderId == userId ? 'flex justify-end' : 'flex justify-start' %>">
                                    <div class="<%= message.senderId == userId ? 'bg-blue-500 text-white' : 'bg-gray-200 text-gray-800' %> rounded-lg px-4 py-2 max-w-xs lg:max-w-md">
                                        <p><%= message.content %></p>
                                        <p class="text-xs <%= message.senderId == userId ? 'text-blue-100' : 'text-gray-500' %> text-right mt-1">
                                            <%= new Date(message.createdAt).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %>
                                        </p>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                    
                    <!-- Message Input -->
                    <div class="p-4 border-t mt-auto">
                        <form action="/messaging/<%= conversationPartner.id %>/send" method="POST" class="flex space-x-2" id="messageForm">
                            <input type="text" name="content" placeholder="Type a message" required id="messageInput"
                                class="flex-1 border border-gray-300 rounded-full px-4 py-2 focus:outline-none focus:ring-1 focus:ring-blue-500">
                            <button type="submit" class="bg-blue-500 text-white rounded-full p-2 hover:bg-blue-600">
                                <i class="fas fa-paper-plane"></i>
                            </button>
                        </form>
                    </div>
                <% } else { %>
                    <div class="flex-1 flex items-center justify-center">
                        <div class="text-center p-8">
                            <div class="text-5xl text-gray-300 mb-4">
                                <i class="far fa-comments"></i>
                            </div>
                            <h3 class="text-xl font-semibold text-gray-700 mb-2">Your Messages</h3>
                            <p class="text-gray-500">Select a conversation or start a new one</p>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</div>

<!-- Feedback Modal -->
<div id="feedbackModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full flex items-center justify-center" style="display: none;">
    <div class="bg-white p-8 rounded-lg shadow-xl w-full max-w-md mx-auto">
        <div class="flex justify-between items-center mb-4">
            <h3 class="text-2xl font-semibold">Give Feedback</h3>
            <button id="closeFeedbackModal" class="text-gray-700 hover:text-gray-900">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <form id="feedbackForm">
            <input type="hidden" id="feedbackLawyerId" name="lawyerId" value="<%= conversationPartner ? conversationPartner.id : '' %>">
            <input type="hidden" id="feedbackConversationId" name="conversationId" value="<%= activeConversation ? activeConversation : '' %>"> <!-- Assuming activeConversation holds the conversation ID -->
            <div class="mb-4">
                <label for="rating" class="block text-sm font-medium text-gray-700 mb-1">Rating</label>
                <div class="flex items-center" id="starRating">
                    <% for(let i = 1; i <= 5; i++) { %>
                        <i class="far fa-star text-2xl text-yellow-400 cursor-pointer star" data-value="<%= i %>"></i>
                    <% } %>
                </div>
                <input type="hidden" name="rating" id="feedbackRating" required>
            </div>
            <div class="mb-6">
                <label for="review" class="block text-sm font-medium text-gray-700 mb-1">Comment (Optional)</label>
                <textarea id="feedbackReview" name="review" rows="4" class="w-full p-2 border border-gray-300 rounded-md focus:outline-none focus:ring-1 focus:ring-blue-500"></textarea>
            </div>
            <div class="flex justify-end">
                <button type="button" id="cancelFeedback" class="mr-2 px-4 py-2 text-sm font-medium text-gray-700 bg-gray-200 hover:bg-gray-300 rounded-md">Cancel</button>
                <button type="submit" class="px-4 py-2 text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 rounded-md">Submit Feedback</button>
            </div>
        </form>
    </div>
</div>

<script>
    // Improved function to scroll to bottom of message container
    function scrollToBottom() {
        const messageContainer = document.getElementById('messageContainer');
        if (messageContainer) {
            // Force scroll to absolute bottom
            messageContainer.scrollTop = messageContainer.scrollHeight + 1000;
            console.log('Scrolled to bottom, height:', messageContainer.scrollHeight);
        }
    }
    
    // Function to focus the message input
    function focusMessageInput() {
        const messageInput = document.getElementById('messageInput');
        if (messageInput) {
            messageInput.focus();
            console.log('Message input focused');
        }
    }

    // Scroll on page load with multiple attempts and focus input
    document.addEventListener('DOMContentLoaded', function() {
        // Scroll immediately
        scrollToBottom();
        
        // Schedule multiple scroll attempts with increasing delays
        [100, 300, 500, 1000].forEach(delay => {
            setTimeout(scrollToBottom, delay);
        });
        
        // Focus the message input after a short delay
        setTimeout(focusMessageInput, 300);
        
        // Handle message search functionality
        const messageSearch = document.getElementById('messageSearch');
        if (messageSearch) {
            messageSearch.addEventListener('input', (e) => {
                const searchTerm = e.target.value.toLowerCase();
                const conversationLinks = document.querySelectorAll('.col-span-4 .border-r a[href^="/messaging/"]');
                
                conversationLinks.forEach(link => {
                    const nameElement = link.querySelector('h4');
                    const previewElement = link.querySelector('p');
                    
                    if (!nameElement || !previewElement) return;
                    
                    const name = nameElement.textContent.toLowerCase();
                    const preview = previewElement.textContent.toLowerCase();
                    
                    if (name.includes(searchTerm) || preview.includes(searchTerm)) {
                        link.style.display = 'block';
                    } else {
                        link.style.display = 'none';
                    }
                });
            });
        }
        
        // Set up form submission handler
        const messageForm = document.getElementById('messageForm');
        if (messageForm) {
            messageForm.addEventListener('submit', function() {
                // Store a flag in localStorage to indicate a message was just sent
                localStorage.setItem('messageSent', 'true');
                localStorage.setItem('messageTimestamp', Date.now().toString());
                console.log('Message form submitted, flag set');
            });
        }
    });
    
    // Also scroll when all resources are fully loaded and focus input
    window.addEventListener('load', function() {
        scrollToBottom();
        // Try again after a short delay
        setTimeout(scrollToBottom, 200);
        // Focus the message input
        focusMessageInput();
    });
    
    // Check if we just sent a message and need to scroll
    if (localStorage.getItem('messageSent') === 'true') {
        // Clear the flag
        localStorage.removeItem('messageSent');
        // Scroll to bottom with multiple attempts
        scrollToBottom();
        [100, 300, 500].forEach(delay => {
            setTimeout(scrollToBottom, delay);
        });
        // Focus the message input after a short delay
        setTimeout(focusMessageInput, 300);
    }

    // Feedback Modal Logic
    const giveFeedbackBtn = document.getElementById('giveFeedbackBtn');
    const feedbackModal = document.getElementById('feedbackModal');
    const closeFeedbackModalBtn = document.getElementById('closeFeedbackModal');
    const cancelFeedbackBtn = document.getElementById('cancelFeedback');
    const feedbackForm = document.getElementById('feedbackForm');
    const stars = document.querySelectorAll('#starRating .star');
    const feedbackRatingInput = document.getElementById('feedbackRating');

    if (giveFeedbackBtn) {
        giveFeedbackBtn.addEventListener('click', () => {
            if (feedbackModal) feedbackModal.style.display = 'flex';
        });
    }

    if (closeFeedbackModalBtn) {
        closeFeedbackModalBtn.addEventListener('click', () => {
            if (feedbackModal) feedbackModal.style.display = 'none';
        });
    }

    if (cancelFeedbackBtn) {
        cancelFeedbackBtn.addEventListener('click', () => {
            if (feedbackModal) feedbackModal.style.display = 'none';
        });
    }

    // Close modal if clicked outside of it
    if (feedbackModal) {
        feedbackModal.addEventListener('click', (event) => {
            if (event.target === feedbackModal) {
                feedbackModal.style.display = 'none';
            }
        });
    }

    stars.forEach(star => {
        star.addEventListener('click', () => {
            const value = parseInt(star.dataset.value);
            feedbackRatingInput.value = value;
            stars.forEach((s, index) => {
                if (index < value) {
                    s.classList.remove('far');
                    s.classList.add('fas');
                } else {
                    s.classList.remove('fas');
                    s.classList.add('far');
                }
            });
        });
    });

    if (feedbackForm) {
        feedbackForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = new FormData(feedbackForm);
            const data = Object.fromEntries(formData.entries());

            // Ensure lawyerId and conversationId are correctly populated
            // These might need to be dynamically set if the conversationPartner changes without a page reload
            data.lawyerId = document.getElementById('feedbackLawyerId').value;
            data.conversationId = document.getElementById('feedbackConversationId').value;

            if (!data.rating) {
                alert('Please select a rating.');
                return;
            }

            try {
                const response = await fetch('/feedback/submit', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify(data),
                });
                const result = await response.json();
                if (response.ok) {
                    alert(result.message || 'Feedback submitted successfully!');
                    if (feedbackModal) feedbackModal.style.display = 'none';
                    feedbackForm.reset();
                    stars.forEach(s => {
                        s.classList.remove('fas');
                        s.classList.add('far');
                    });
                } else {
                    alert(result.message || 'Failed to submit feedback.');
                }
            } catch (error) {
                console.error('Error submitting feedback:', error);
                alert('An error occurred. Please try again.');
            }
        });
    }
</script>