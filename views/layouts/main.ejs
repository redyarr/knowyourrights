<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= typeof title !=='undefined' ? title : 'LegalNet' %>
  </title>
  <link rel="stylesheet" href="/css/style.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</head>

<body>
  <% // Set the current path for active nav highlighting 
    let path = '';
    if (typeof originalUrl !== 'undefined' && typeof originalUrl === 'string') {
      path = originalUrl;
    } else if (typeof req !== 'undefined') {
      path = req.originalUrl || req.url || '';
    }
  %>

    <%- include('../partials/navbar', { path: path }) %>

      <div class="container mt-4">
        <%- body %>
      </div>

      <%- include('../partials/footer') %>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
        <script src="/js/main.js"></script>
</body>

</html>