<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= typeof title !=='undefined' ? title : 'LegalNet' %>
  </title>
  <link rel="stylesheet" href="/css/style.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</head>

<body>
    <% // Set the current path for active nav highlighting 
    let path = '';
    if (typeof originalUrl !== 'undefined' && typeof originalUrl === 'string') {
      path = originalUrl;
    } else if (typeof req !== 'undefined') {
      path = req.originalUrl || req.url || '';
    }
  %>

    <%- include('../partials/navbar', { path: path }) %>

      <div class="container mt-4">
        <%- body %>
      </div>

      <%- include('../partials/footer') %>

        <!-- LinkedIn-style Messaging Popup -->
        <% if (locals.loggedInUserId) { %>
          <div class="messaging-popup messaging-popup-collapsed" id="messagingPopup">
            <div class="messaging-popup-header" id="messagingPopupHeader">
              <div class="d-flex align-items-center">
                <i class="fas fa-comment-dots me-2"></i>
                <span>Messaging</span>
              </div>
              <div>
                <i class="fas fa-edit me-2"></i>
                <i class="fas fa-chevron-up" id="messagingPopupToggle"></i>
              </div>
            </div>
            <div class="messaging-popup-body">
              <div class="messaging-popup-contacts">
                <!-- This would be populated with recent contacts -->
                <div class="messaging-popup-contact">
                  <img src="https://media.licdn.com/dms/image/v2/D4D03AQFf1-ylWdRSmA/profile-displayphoto-shrink_400_400/profile-displayphoto-shrink_400_400/0/1730536131542?e=1746662400&v=beta&t=xkZtJvNlDZIZ6X-3ZQxbzTDcv_Z5fFgSr1Y7cJGZKvY" alt="Contact" class="messaging-popup-contact-photo">
                  <div class="messaging-popup-contact-info">
                    <div class="messaging-popup-contact-name">Jane Smith</div>
                    <div class="messaging-popup-contact-status">Online</div>
                  </div>
                </div>
                <div class="messaging-popup-contact">
                  <img src="https://media.licdn.com/dms/image/v2/D4D03AQE3Z-yWzw_vJA/profile-displayphoto-shrink_400_400/B4DZR2TJJpHUAg-/0/1737151519033?e=1746662400&v=beta&t=GoX2z9wgCdLQxmuxpZgPf0TT7LDpacM4bHwZt_oMcpA" alt="Contact" class="messaging-popup-contact-photo">
                  <div class="messaging-popup-contact-info">
                    <div class="messaging-popup-contact-name">John Doe</div>
                    <div class="messaging-popup-contact-status">Last seen 2h ago</div>
                  </div>
                </div>
                <div class="messaging-popup-contact">
                  <img src="https://media.licdn.com/dms/image/v2/D4D03AQHZ-bGav5EClA/profile-displayphoto-shrink_400_400/B4DZP9EYnHHcAg-/0/1735117606288?e=1746662400&v=beta&t=v6Kfu8DAqqyfzFszdYLN54ZAFBc8Fckg4myxqGEV0-I" alt="Contact" class="messaging-popup-contact-photo">
                  <div class="messaging-popup-contact-info">
                    <div class="messaging-popup-contact-name">Sarah Johnson</div>
                    <div class="messaging-popup-contact-status">Online</div>
                  </div>
                </div>
                <div class="messaging-popup-contact">
                  <img src="https://media.licdn.com/dms/image/v2/D4D03AQFNmASyBMQboA/profile-displayphoto-shrink_400_400/B4DZRbZ7x9HYAg-/0/1736700313203?e=1746662400&v=beta&t=qfhBlmBJDcKbzGyYfcKH2cCgtIzQzSDvXuGmLKBxY0U" alt="Contact" class="messaging-popup-contact-photo">
                  <div class="messaging-popup-contact-info">
                    <div class="messaging-popup-contact-name">Michael Brown</div>
                    <div class="messaging-popup-contact-status">Last seen yesterday</div>
                  </div>
                </div>
                <div class="messaging-popup-contact">
                  <img src="https://media.licdn.com/dms/image/v2/D4D03AQFc2wKXZPhTkA/profile-displayphoto-shrink_100_100/B4DZVbrzTbG4AU-/0/1740999964826?e=2147483647&v=beta&t=2cw_b3nJDcnPvvyvsHOcyZ6g6lLFhpM_B_cReXn47-c" alt="Contact" class="messaging-popup-contact-photo">
                  <div class="messaging-popup-contact-info">
                    <div class="messaging-popup-contact-name">Emily Davis</div>
                    <div class="messaging-popup-contact-status">Online</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <% } %>

            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
            <script src="/js/main.js"></script>



