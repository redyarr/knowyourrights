<nav class="bg-white border-b border-gray-200 fixed w-full top-0 z-50">
  <div class="max-w-7xl mx-auto px-4">
    <div class="flex justify-between h-16 items-center">

      <!-- Left nav -->
      <div class="flex items-center">
        <a href="/" class="flex items-center text-blue-700 font-bold text-xl">
          <!-- Integrated Grand Law-Focused LegalNet Logo -->
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 120" width="180" height="45" class="mr-2">
            <!-- Rich color scheme -->
            <defs>
              <linearGradient id="goldAccent" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" style="stop-color:#bf9b30;stop-opacity:1" />
                <stop offset="100%" style="stop-color:#f1c232;stop-opacity:1" />
              </linearGradient>
              <linearGradient id="navyBlue" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" style="stop-color:#0c2340;stop-opacity:1" />
                <stop offset="100%" style="stop-color:#1e3a8a;stop-opacity:1" />
              </linearGradient>
            </defs>

            <!-- Classical law column/pillar -->
            <g>
              <!-- Column base -->
              <rect x="40" y="85" width="60" height="10" fill="#0c2340" />

              <!-- Column shaft with classical fluting effect -->
              <rect x="45" y="30" width="50" height="55" fill="#1e3a8a" />
              <rect x="48" y="30" width="2" height="55" fill="#0c2340" opacity="0.3" />
              <rect x="55" y="30" width="2" height="55" fill="#0c2340" opacity="0.3" />
              <rect x="62" y="30" width="2" height="55" fill="#0c2340" opacity="0.3" />
              <rect x="69" y="30" width="2" height="55" fill="#0c2340" opacity="0.3" />
              <rect x="76" y="30" width="2" height="55" fill="#0c2340" opacity="0.3" />
              <rect x="83" y="30" width="2" height="55" fill="#0c2340" opacity="0.3" />

              <!-- Column capital -->
              <path d="M40 30 L45 25 L95 25 L100 30 Z" fill="#0c2340" />
              <rect x="45" y="20" width="50" height="5" fill="#0c2340" />
              <path d="M42 20 L45 15 L95 15 L98 20 Z" fill="#0c2340" />
            </g>

            <!-- Ornate scales of justice -->
            <g>
              <!-- Balance beam with decorative ends -->
              <rect x="35" y="40" width="70" height="4" rx="2" fill="url(#goldAccent)" />
              <circle cx="35" cy="40" r="3" fill="url(#goldAccent)" />
              <circle cx="105" cy="40" r="3" fill="url(#goldAccent)" />

              <!-- Center hanging point -->
              <rect x="68" y="40" width="4" height="15" fill="url(#goldAccent)" />

              <!-- Ornate chains -->
              <path d="M45 40 L45 55" stroke="#bf9b30" stroke-width="2" stroke-dasharray="2,2" />
              <path d="M95 40 L95 55" stroke="#bf9b30" stroke-width="2" stroke-dasharray="2,2" />

              <!-- Scale pans -->
              <ellipse cx="45" cy="60" rx="12" ry="4" fill="url(#goldAccent)" />
              <ellipse cx="95" cy="60" rx="12" ry="4" fill="url(#goldAccent)" />
            </g>

            <!-- Company name with prestigious typography -->
            <g>
              <text x="130" y="65" font-family="'Times New Roman', serif" font-size="42" font-weight="700"
                fill="#0c2340" letter-spacing="2">LEGAL</text>
              <text x="280" y="65" font-family="'Times New Roman', serif" font-size="42" font-weight="700"
                fill="url(#goldAccent)" letter-spacing="2">NET</text>
            </g>
          </svg>
        </a>
        <form id="searchForm" class="ml-4 relative" action="/search" method="GET">
          <span class="absolute inset-y-0 left-0 pl-3 flex items-center">
            <i class="fas fa-search text-gray-400"></i>
          </span>
          <input type="text" name="query" id="searchInput" placeholder="Search users..." autocomplete="off"
            class="pl-10 pr-4 py-2 rounded-full border border-gray-300 focus:outline-none focus:ring-1 focus:ring-blue-500">
          <div id="searchResults"
            class="absolute mt-1 w-full bg-white shadow-lg rounded-md overflow-hidden hidden z-50"></div>
        </form>
      </div>

      <!-- Center nav -->
      <% if (locals.loggedInUserId) { %>
        <div class="hidden md:flex space-x-8">
          <a href="/"
            class="flex flex-col items-center text-gray-500 hover:text-gray-900 text-sm <%= (path === '/' || path === '/blog') ? 'font-bold text-blue-700' : '' %>">
            <i class="fas fa-home text-xl"></i>
            <span>Home</span>
          </a>
          <a href="/mynetwork"
            class="flex flex-col items-center text-gray-500 hover:text-gray-900 text-sm <%= path.includes('/user/network') ? 'font-bold text-blue-700' : '' %>">
            <i class="fas fa-user-friends text-xl"></i>
            <span>My Network</span>
          </a>
          <a href="/jobs"
            class="flex flex-col items-center text-gray-500 hover:text-gray-900 text-sm <%= path.includes('/jobs') ? 'font-bold text-blue-700' : '' %>">
            <i class="fas fa-briefcase text-xl"></i>
            <span>Jobs</span>
          </a>
          <a href="/messaging"
            class="relative flex flex-col items-center text-gray-500 hover:text-gray-900 text-sm <%= path.includes('/messages') ? 'font-bold text-blue-700' : '' %>">
            <i class="fas fa-comment-dots text-xl"></i>
            <span>Messaging</span>
            <% if (locals.unreadMessageCount> 0) { %>
              <span
                class="absolute top-0 right-0 bg-red-500 text-white text-xs w-4 h-4 rounded-full flex items-center justify-center">
                <%= locals.unreadMessageCount %>
              </span>
              <% } %>
          </a>
          <a href="/notifications"
            class="relative flex flex-col items-center text-gray-500 hover:text-gray-900 text-sm <%= path.includes('/notifications') ? 'font-bold text-blue-700' : '' %>">
            <i class="fas fa-bell text-xl"></i>
            <span>Notifications</span>
            <% if (locals.unreadNotificationCount> 0) { %>
              <span
                class="absolute top-0 right-0 bg-red-500 text-white text-xs w-4 h-4 rounded-full flex items-center justify-center">
                <%= locals.unreadNotificationCount %>
              </span>
              <% } %>
          </a>
        </div>
        <% } %>

          <!-- Right nav -->
          <div class="flex items-center space-x-4">
            <% if (locals.loggedInUserId) { %>
              <div class="relative group">
                <button id="profileButton"
                  class="flex items-center text-gray-500 hover:text-gray-900 focus:outline-none">
                  <img src="https://ui-avatars.com/api/?background=random" alt="Profile" class="h-8 w-8 rounded-full">
                  <span class="ml-2 text-sm">Me <i class="fas fa-caret-down ml-1"></i></span>
                </button>
                <div id="profileMenu"
                  class="absolute right-0 mt-2 w-64 bg-white border border-gray-200 rounded-lg shadow-lg hidden z-50">
                  <div class="p-4 border-b">
                    <div class="flex items-center space-x-3">
                      <img src="https://ui-avatars.com/api/?background=random" alt="Profile"
                        class="h-16 w-16 rounded-full">
                      <div>
                        <h4 class="font-semibold text-gray-800">
                          <% if (typeof user !=='undefined' && user) { %>
                            <%= user.firstName %>
                              <%= user.lastName %>
                                <% } else { %>
                                  Guest User
                                  <% } %>
                        </h4>
                        <p class="text-sm text-gray-600">
                          <%= locals.userRole==='admin' ? 'admin' : locals.userRole==='lawyer' ? 'Lawyer' : 'visitor' %>
                        </p>
                      </div>
                    </div>
                    <a href="/in"
                      class="block mt-2 px-4 py-2 text-sm text-blue-600 text-center hover:bg-blue-50 rounded-md">View
                      Profile</a>
                  </div>
                  <div class="py-2">
                    <a href="/settings" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">Settings &
                      Privacy</a>
                    <a href="/help" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">Help Center</a>
                    <form action="/signout" method="POST"
                      class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">
                      <button type="submit">Sign Out</button>
                    </form>
                  </div>
                </div>
              </div>
              <% } else { %>
                <a href="/login" class="text-gray-700 hover:text-gray-900 px-3 py-2">Sign in</a>
                <a href="/register"
                  class="ml-4 px-4 py-2 rounded-full text-blue-700 hover:bg-blue-50 border border-blue-700">Join now</a>
                <% } %>
          </div>
    </div>
  </div>
</nav>
<script>
  document.getElementById('profileButton').addEventListener('click', function () {
    var menu = document.getElementById('profileMenu');
    menu.classList.toggle('hidden');
  });
</script>