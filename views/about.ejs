<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>About Us - Know Your Rights</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        .card {
            transition: all 0.4s ease;
        }
        
        .card:hover {
            transform: translateY(-5px);
        }
    </style>
</head>
<body class="min-h-screen bg-gradient-to-br from-gray-50 to-gray-100">
    <%- include('layouts/navbar') %>
    
    <div class="min-h-screen flex items-center justify-center p-8">
        <div class="flex gap-8 items-center justify-center">
            <!-- First Card - CEO -->
            <div class="card relative bg-white rounded-2xl p-8 w-96 h-[28rem] shadow-xl overflow-visible group">
                <!-- CEO Image - Breaking out of card without frame -->
                 <div class="absolute -top-32 left-1/2 transform -translate-x-1/2 z-10">
                       <img src="https://ik.imagekit.io/redyar/ceo-developer/Adobe%20Express%20-%20file.png?updatedAt=1749341446181" 
                            alt="CEO" 
                            class="w-64 h-64 object-cover object-center
                                   transition-all duration-500 ease-out
                                   group-hover:scale-110 group-hover:-translate-y-3
                                   filter grayscale group-hover:grayscale-0 group-hover:brightness-110
                                   shadow-lg group-hover:shadow-xl">
                   </div>
                
                <!-- Content -->
                 <div class="pt-36 text-center h-full flex flex-col justify-between">
                    <div>
                        <h2 class="text-2xl font-bold text-gray-800 mb-3">Chief Executive Officer</h2>
                        <div class="w-20 h-1 bg-blue-500 mx-auto mb-6"></div>
                    </div>
                    
                    <div class="flex-1 flex items-center">
                        <p class="text-gray-600 leading-relaxed">
                            Visionary leader with 15+ years in legal technology, democratizing access to justice.
                        </p>
                    </div>
                    
                    <div class="opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                        <div class="bg-blue-50 rounded-lg p-4">
                            <span class="text-blue-600 text-sm font-medium">Explore Leadership →</span>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Second Card - CTO -->
            <div class="card relative bg-white rounded-2xl p-8 w-96 h-[28rem] shadow-xl overflow-visible group">
                <!-- CTO Image - Breaking out of card without frame -->
                 <div class="absolute -top-32 left-1/2 transform -translate-x-1/2 z-10">
                       <img src="https://ik.imagekit.io/redyar/tr:w-1920,h-1000,c-at_max_enlarge/ceo-developer/rava1.png?updatedAt=1749343818845" 
                            alt="CTO" 
                            class="w-64 h-64 object-cover object-center
                                   transition-all duration-500 ease-out
                                   group-hover:scale-110 group-hover:-translate-y-3
                                   filter grayscale group-hover:grayscale-0 group-hover:brightness-110
                                   shadow-lg group-hover:shadow-xl">
                   </div>
                
                <!-- Content -->
                 <div class="pt-36 text-center h-full flex flex-col justify-between">
                    <div>
                        <h2 class="text-2xl font-bold text-gray-800 mb-3">Chief Technology Officer</h2>
                        <div class="w-20 h-1 bg-purple-500 mx-auto mb-6"></div>
                    </div>
                    
                    <div class="flex-1 flex items-center">
                        <p class="text-gray-600 leading-relaxed">
                            Innovation expert with deep expertise in AI and blockchain, driving technological advancement.
                        </p>
                    </div>
                    
                    <div class="opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                        <div class="bg-purple-50 rounded-lg p-4">
                            <span class="text-purple-600 text-sm font-medium">View Technology →</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <%- include('layouts/footer') %>
</body>
</html>