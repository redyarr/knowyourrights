<div class="min-h-screen bg-gray-50 py-8">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Header -->
        <div class="bg-white rounded-lg shadow-sm p-6 mb-8">
            <div class="flex items-start space-x-6">
                <img src="https://ui-avatars.com/api/?name=<%= lawyer.firstName %>+<%= lawyer.lastName %>&background=0ea5e9&color=ffffff" 
                     alt="<%= lawyer.firstName %> <%= lawyer.lastName %>" 
                     class="w-20 h-20 rounded-full shadow-sm">
                <div class="flex-1">
                    <h1 class="text-3xl font-bold text-gray-900">
                        Book Consultation with <%= lawyer.firstName %> <%= lawyer.lastName %>
                    </h1>
                    <% if (lawyer.Lawyer) { %>
                        <p class="text-gray-600 mt-2">
                            <%= (lawyer.Lawyer.legalAreas && lawyer.Lawyer.legalAreas.split(',')[0]) || 'General Legal Practice' %> • 
                            <%= lawyer.Lawyer.lawFirm || 'Independent Practice' %>
                        </p>
                        <% if (lawyer.Lawyer.summary) { %>
                            <p class="text-sm text-gray-500 mt-1">
                                <%= lawyer.Lawyer.summary %>
                            </p>
                        <% } %>
                    <% } %>
                    
                    <!-- Rating Display -->
                    <% if (lawyer.Lawyer && lawyer.Lawyer.LawyerFeedbacks && lawyer.Lawyer.LawyerFeedbacks.length > 0) { %>
                        <% 
                        const totalRating = lawyer.Lawyer.LawyerFeedbacks.reduce((sum, feedback) => sum + feedback.rating, 0);
                        const averageRating = totalRating / lawyer.Lawyer.LawyerFeedbacks.length;
                        %>
                        <div class="flex items-center mt-3">
                            <div class="flex items-center">
                                <% for (let i = 1; i <= 5; i++) { %>
                                    <i class="fas fa-star <%= i <= Math.round(averageRating) ? 'text-yellow-400' : 'text-gray-300' %>"></i>
                                <% } %>
                            </div>
                            <span class="ml-2 text-sm text-gray-600">
                                <%= averageRating.toFixed(1) %> (<%= lawyer.Lawyer.LawyerFeedbacks.length %> review<%= lawyer.Lawyer.LawyerFeedbacks.length !== 1 ? 's' : '' %>)
                            </span>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <!-- Booking Form -->
            <div class="lg:col-span-2">
                <div class="bg-white rounded-lg shadow-sm p-6">
                    <h2 class="text-xl font-semibold text-gray-900 mb-6">Schedule Your Consultation</h2>
                    
                    <form id="bookingForm">
                        <input type="hidden" name="lawyerId" value="<%= lawyer.id %>">
                        
                        <!-- Date Selection -->
                        <div class="mb-6">
                            <label class="block text-sm font-medium text-gray-700 mb-2">Select Date</label>
                            <div class="grid grid-cols-7 gap-2 mb-4">
                                <div class="text-center text-sm font-medium text-gray-500 py-2">Sun</div>
                                <div class="text-center text-sm font-medium text-gray-500 py-2">Mon</div>
                                <div class="text-center text-sm font-medium text-gray-500 py-2">Tue</div>
                                <div class="text-center text-sm font-medium text-gray-500 py-2">Wed</div>
                                <div class="text-center text-sm font-medium text-gray-500 py-2">Thu</div>
                                <div class="text-center text-sm font-medium text-gray-500 py-2">Fri</div>
                                <div class="text-center text-sm font-medium text-gray-500 py-2">Sat</div>
                            </div>
                            <div id="dateGrid" class="grid grid-cols-7 gap-2">
                                <!-- Dates will be populated by JavaScript -->
                            </div>
                        </div>

                        <!-- Time Selection -->
                        <div class="mb-6">
                            <label class="block text-sm font-medium text-gray-700 mb-2">Available Times</label>
                            <div id="timeSlots" class="grid grid-cols-3 gap-3">
                                <div class="text-center py-8 text-gray-500 col-span-3">
                                    <i class="fas fa-calendar-alt text-3xl mb-3"></i>
                                    <p>Please select a date to see available times</p>
                                </div>
                            </div>
                        </div>

                        <!-- Consultation Type -->
                        <div class="mb-6">
                            <label class="block text-sm font-medium text-gray-700 mb-2">Consultation Type</label>
                            <select name="consultationType" required class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
                                <option value="">Select consultation type</option>
                                <option value="initial_consultation">Initial Consultation</option>
                                <option value="follow_up">Follow-up Meeting</option>
                                <option value="legal_advice">Legal Advice</option>
                                <option value="document_review">Document Review</option>
                                <option value="court_preparation">Court Preparation</option>
                            </select>
                        </div>

                        <!-- Meeting Type -->
                        <div class="mb-6">
                            <label class="block text-sm font-medium text-gray-700 mb-2">Meeting Preference</label>
                            <div class="grid grid-cols-3 gap-4">
                                <label class="flex items-center p-3 border border-gray-300 rounded-lg cursor-pointer hover:bg-gray-50">
                                    <input type="radio" name="meetingType" value="video_call" class="mr-3" checked>
                                    <div class="text-center">
                                        <i class="fas fa-video text-blue-600 text-xl mb-1"></i>
                                        <div class="text-sm font-medium">Video Call</div>
                                    </div>
                                </label>
                                <label class="flex items-center p-3 border border-gray-300 rounded-lg cursor-pointer hover:bg-gray-50">
                                    <input type="radio" name="meetingType" value="phone_call" class="mr-3">
                                    <div class="text-center">
                                        <i class="fas fa-phone text-green-600 text-xl mb-1"></i>
                                        <div class="text-sm font-medium">Phone Call</div>
                                    </div>
                                </label>
                                <label class="flex items-center p-3 border border-gray-300 rounded-lg cursor-pointer hover:bg-gray-50">
                                    <input type="radio" name="meetingType" value="in_person" class="mr-3">
                                    <div class="text-center">
                                        <i class="fas fa-handshake text-purple-600 text-xl mb-1"></i>
                                        <div class="text-sm font-medium">In Person</div>
                                    </div>
                                </label>
                            </div>
                        </div>

                        <!-- Notes -->
                        <div class="mb-6">
                            <label class="block text-sm font-medium text-gray-700 mb-2">Additional Notes</label>
                            <textarea name="notes" rows="4" 
                                placeholder="Please describe your legal matter or any specific questions you'd like to discuss..."
                                class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"></textarea>
                        </div>

                        <!-- Submit Button -->
                        <button type="submit" id="submitBtn" disabled 
                            class="w-full bg-gray-400 text-white py-3 px-4 rounded-lg font-medium transition-colors cursor-not-allowed">
                            Select Date and Time to Continue
                        </button>
                    </form>
                </div>
            </div>

            <!-- Sidebar -->
            <div class="space-y-6">
                <!-- Lawyer Info -->
                <div class="bg-white rounded-lg shadow-sm p-6">
                    <h3 class="text-lg font-semibold text-gray-900 mb-4">About This Lawyer</h3>
                    <% if (lawyer.Lawyer) { %>
                        <div class="space-y-3">
                            <% if (lawyer.Lawyer.specialization) { %>
                                <div>
                                    <div class="text-sm font-medium text-gray-700">Specialization</div>
                                    <div class="text-gray-600"><%= lawyer.Lawyer.specialization %></div>
                                </div>
                            <% } %>
                            <% if (lawyer.Lawyer.barNumber) { %>
                                <div>
                                    <div class="text-sm font-medium text-gray-700">Bar Number</div>
                                    <div class="text-gray-600"><%= lawyer.Lawyer.barNumber %></div>
                                </div>
                            <% } %>
                            <% if (lawyer.Lawyer.lawFirm) { %>
                                <div>
                                    <div class="text-sm font-medium text-gray-700">Law Firm</div>
                                    <div class="text-gray-600"><%= lawyer.Lawyer.lawFirm %></div>
                                </div>
                            <% } %>
                        </div>
                    <% } %>
                </div>

                <!-- Consultation Info -->
                <div class="bg-white rounded-lg shadow-sm p-6">
                    <h3 class="text-lg font-semibold text-gray-900 mb-4">Consultation Details</h3>
                    <div class="space-y-3">
                        <div class="flex items-center text-gray-600">
                            <i class="fas fa-clock text-blue-600 mr-3"></i>
                            <span>60 minutes duration</span>
                        </div>
                        <div class="flex items-center text-gray-600">
                            <i class="fas fa-shield-alt text-green-600 mr-3"></i>
                            <span>Confidential & Secure</span>
                        </div>
                        <div class="flex items-center text-gray-600">
                            <i class="fas fa-calendar-check text-purple-600 mr-3"></i>
                            <span>Easy Rescheduling</span>
                        </div>
                    </div>
                </div>

                <!-- Recent Reviews -->
                <% if (lawyer.Lawyer && lawyer.Lawyer.LawyerFeedbacks && lawyer.Lawyer.LawyerFeedbacks.length > 0) { %>
                    <div class="bg-white rounded-lg shadow-sm p-6">
                        <h3 class="text-lg font-semibold text-gray-900 mb-4">Recent Reviews</h3>
                        <div class="space-y-4">
                            <% lawyer.Lawyer.LawyerFeedbacks.slice(0, 2).forEach(feedback => { %>
                                <div class="border-b border-gray-200 pb-4 last:border-b-0">
                                    <div class="flex items-center mb-2">
                                        <div class="flex items-center">
                                            <% for (let i = 1; i <= 5; i++) { %>
                                                <i class="fas fa-star <%= i <= feedback.rating ? 'text-yellow-400' : 'text-gray-300' %> text-sm"></i>
                                            <% } %>
                                        </div>
                                        <span class="ml-2 text-sm text-gray-600">
                                            by <%= feedback.User.firstName %> <%= feedback.User.lastName.charAt(0) %>.
                                        </span>
                                    </div>
                                    <% if (feedback.review) { %>
                                        <p class="text-sm text-gray-600">"<%= feedback.review.substring(0, 100) %><%= feedback.review.length > 100 ? '...' : '' %>"</p>
                                    <% } %>
                                </div>
                            <% }); %>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</div>

<script>
let selectedDate = null;
let selectedTime = null;
let availability = <%- JSON.stringify(availability) %>;
const lawyerId = <%= lawyer.id %>;

document.addEventListener('DOMContentLoaded', function() {
    renderDateGrid();
    setupFormValidation();
});

function renderDateGrid() {
    const dateGrid = document.getElementById('dateGrid');
    const today = new Date();
    const currentMonth = today.getMonth();
    const currentYear = today.getFullYear();
    
    // Get first day of current month and number of days
    const firstDay = new Date(currentYear, currentMonth, 1).getDay();
    const daysInMonth = new Date(currentYear, currentMonth + 1, 0).getDate();
    
    dateGrid.innerHTML = '';
    
    // Add empty cells for days before month starts
    for (let i = 0; i < firstDay; i++) {
        const emptyDay = document.createElement('div');
        dateGrid.appendChild(emptyDay);
    }
    
    // Add days of the month
    for (let day = 1; day <= daysInMonth; day++) {
        const date = new Date(currentYear, currentMonth, day);
        const dateStr = date.toISOString().split('T')[0];
        const dayOfWeek = date.toLocaleDateString('en-US', { weekday: 'lowercase' });
        
        // Check if lawyer is available on this day
        const isAvailable = availability.some(slot => slot.day_of_week === dayOfWeek);
        const isPast = date < today;
        
        const dayElement = document.createElement('div');
        dayElement.className = `p-3 text-center border rounded-lg cursor-pointer transition-colors ${
            isPast ? 'text-gray-300 cursor-not-allowed' :
            isAvailable ? 'border-gray-300 hover:bg-blue-50 hover:border-blue-300' :
            'border-gray-200 text-gray-400 cursor-not-allowed'
        }`;
        
        dayElement.textContent = day;
        
        if (!isPast && isAvailable) {
            dayElement.onclick = () => selectDate(dateStr, dayElement);
        }
        
        dateGrid.appendChild(dayElement);
    }
}

function selectDate(dateStr, element) {
    // Remove previous selection
    document.querySelectorAll('#dateGrid > div').forEach(el => {
        el.classList.remove('bg-blue-600', 'text-white', 'border-blue-600');
    });
    
    // Add selection to clicked element
    element.classList.add('bg-blue-600', 'text-white', 'border-blue-600');
    
    selectedDate = dateStr;
    loadTimeSlots(dateStr);
    updateSubmitButton();
}

async function loadTimeSlots(date) {
    const timeSlotsContainer = document.getElementById('timeSlots');
    timeSlotsContainer.innerHTML = '<div class="col-span-3 text-center py-4"><i class="fas fa-spinner fa-spin text-2xl text-gray-400"></i></div>';
    
    try {
        const response = await fetch(`/appointments/lawyer/${lawyerId}/slots/${date}`);
        const data = await response.json();
        
        if (data.success && data.slots.length > 0) {
            timeSlotsContainer.innerHTML = '';
            
            data.slots.forEach(slot => {
                const timeButton = document.createElement('button');
                timeButton.type = 'button';
                timeButton.className = 'p-3 border border-gray-300 rounded-lg hover:bg-blue-50 hover:border-blue-300 transition-colors text-center';
                timeButton.innerHTML = `
                    <div class="font-medium">${formatTime(slot.startTime)}</div>
                    <div class="text-sm text-gray-500">${formatTime(slot.endTime)}</div>
                `;
                
                timeButton.onclick = () => selectTime(slot.startTime, timeButton);
                timeSlotsContainer.appendChild(timeButton);
            });
        } else {
            timeSlotsContainer.innerHTML = `
                <div class="col-span-3 text-center py-8 text-gray-500">
                    <i class="fas fa-calendar-times text-3xl mb-3"></i>
                    <p>No available times for this date</p>
                </div>
            `;
        }
    } catch (error) {
        console.error('Error loading time slots:', error);
        timeSlotsContainer.innerHTML = `
            <div class="col-span-3 text-center py-8 text-red-500">
                <i class="fas fa-exclamation-triangle text-3xl mb-3"></i>
                <p>Error loading available times</p>
            </div>
        `;
    }
}

function selectTime(time, element) {
    // Remove previous selection
    document.querySelectorAll('#timeSlots button').forEach(btn => {
        btn.classList.remove('bg-blue-600', 'text-white', 'border-blue-600');
    });
    
    // Add selection to clicked element
    element.classList.add('bg-blue-600', 'text-white', 'border-blue-600');
    
    selectedTime = time;
    updateSubmitButton();
}

function updateSubmitButton() {
    const submitBtn = document.getElementById('submitBtn');
    
    if (selectedDate && selectedTime) {
        submitBtn.disabled = false;
        submitBtn.className = 'w-full bg-blue-600 text-white py-3 px-4 rounded-lg font-medium hover:bg-blue-700 transition-colors';
        submitBtn.textContent = 'Book Consultation';
    } else {
        submitBtn.disabled = true;
        submitBtn.className = 'w-full bg-gray-400 text-white py-3 px-4 rounded-lg font-medium transition-colors cursor-not-allowed';
        submitBtn.textContent = 'Select Date and Time to Continue';
    }
}

function setupFormValidation() {
    document.getElementById('bookingForm').addEventListener('submit', async function(e) {
        e.preventDefault();
        
        if (!selectedDate || !selectedTime) {
            alert('Please select a date and time for your consultation.');
            return;
        }
        
        const formData = new FormData(this);
        const bookingData = {
            lawyerId: formData.get('lawyerId'),
            appointmentDate: selectedDate,
            startTime: selectedTime,
            consultationType: formData.get('consultationType'),
            meetingType: formData.get('meetingType'),
            notes: formData.get('notes')
        };
        
        if (!bookingData.consultationType) {
            alert('Please select a consultation type.');
            return;
        }
        
        const submitBtn = document.getElementById('submitBtn');
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>Booking...';
        
        try {
            const response = await fetch('/appointments/book', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(bookingData)
            });
            
            const result = await response.json();
            
            if (result.success) {
                alert('Consultation booked successfully! You will receive a confirmation email shortly.');
                window.location.href = '/appointments/my-appointments';
            } else {
                alert('Error booking consultation: ' + result.error);
                updateSubmitButton();
            }
        } catch (error) {
            console.error('Error:', error);
            alert('Error booking consultation. Please try again.');
            updateSubmitButton();
        }
    });
}

function formatTime(timeString) {
    const [hours, minutes] = timeString.split(':');
    const hour = parseInt(hours);
    const ampm = hour >= 12 ? 'PM' : 'AM';
    const displayHour = hour % 12 || 12;
    return `${displayHour}:${minutes} ${ampm}`;
}
</script>