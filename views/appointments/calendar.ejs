<div class="min-h-screen bg-gray-50 py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Header -->
        <div class="bg-white rounded-lg shadow-sm p-6 mb-8">
            <div class="flex items-center justify-between">
                <div>
                    <h1 class="text-3xl font-bold text-gray-900">My Calendar</h1>
                    <p class="text-gray-600 mt-2">Manage your availability and appointments</p>
                </div>
                <div class="flex space-x-4">
                    <button onclick="openAvailabilityModal()" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition-colors">
                        <i class="fas fa-clock mr-2"></i>Set Availability
                    </button>
                    <a href="/appointments/my-appointments" class="bg-gray-600 text-white px-4 py-2 rounded-lg hover:bg-gray-700 transition-colors">
                        <i class="fas fa-list mr-2"></i>View All Appointments
                    </a>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <!-- Calendar Section -->
            <div class="lg:col-span-2">
                <div class="bg-white rounded-lg shadow-sm p-6">
                    <div class="flex items-center justify-between mb-6">
                        <h2 class="text-xl font-semibold text-gray-900">Calendar View</h2>
                        <div class="flex items-center space-x-4">
                            <button onclick="previousMonth()" class="p-2 text-gray-600 hover:text-gray-900">
                                <i class="fas fa-chevron-left"></i>
                            </button>
                            <span id="currentMonth" class="text-lg font-medium text-gray-900"></span>
                            <button onclick="nextMonth()" class="p-2 text-gray-600 hover:text-gray-900">
                                <i class="fas fa-chevron-right"></i>
                            </button>
                        </div>
                    </div>
                    
                    <!-- Calendar Grid -->
                    <div class="grid grid-cols-7 gap-1 mb-4">
                        <div class="p-3 text-center text-sm font-medium text-gray-500">Sun</div>
                        <div class="p-3 text-center text-sm font-medium text-gray-500">Mon</div>
                        <div class="p-3 text-center text-sm font-medium text-gray-500">Tue</div>
                        <div class="p-3 text-center text-sm font-medium text-gray-500">Wed</div>
                        <div class="p-3 text-center text-sm font-medium text-gray-500">Thu</div>
                        <div class="p-3 text-center text-sm font-medium text-gray-500">Fri</div>
                        <div class="p-3 text-center text-sm font-medium text-gray-500">Sat</div>
                    </div>
                    
                    <div id="calendarGrid" class="grid grid-cols-7 gap-1">
                        <!-- Calendar days will be populated by JavaScript -->
                    </div>
                </div>
            </div>

            <!-- Sidebar -->
            <div class="space-y-6">
                <!-- Current Availability -->
                <div class="bg-white rounded-lg shadow-sm p-6">
                    <h3 class="text-lg font-semibold text-gray-900 mb-4">Weekly Availability</h3>
                    <div id="availabilityDisplay" class="space-y-3">
                        <% if (availability && availability.length > 0) { %>
                            <% availability.forEach(slot => { %>
                                <div class="flex justify-between items-center p-3 bg-gray-50 rounded-lg">
                                    <div>
                                        <div class="font-medium text-gray-900 capitalize"><%= slot.day_of_week %></div>
                                        <div class="text-sm text-gray-600"><%= slot.start_time %> - <%= slot.end_time %></div>
                                    </div>
                                    <div class="text-sm text-green-600">
                                        <i class="fas fa-check-circle"></i>
                                    </div>
                                </div>
                            <% }); %>
                        <% } else { %>
                            <div class="text-center py-8 text-gray-500">
                                <i class="fas fa-calendar-times text-3xl mb-3"></i>
                                <p>No availability set</p>
                                <button onclick="openAvailabilityModal()" class="mt-2 text-blue-600 hover:text-blue-700">
                                    Set your availability
                                </button>
                            </div>
                        <% } %>
                    </div>
                </div>

                <!-- Today's Appointments -->
                <div class="bg-white rounded-lg shadow-sm p-6">
                    <h3 class="text-lg font-semibold text-gray-900 mb-4">Today's Appointments</h3>
                    <div id="todayAppointments" class="space-y-3">
                        <% 
                        const today = new Date().toISOString().split('T')[0];
                        const todayAppointments = appointments.filter(apt => apt.appointment_date.toISOString().split('T')[0] === today);
                        %>
                        <% if (todayAppointments.length > 0) { %>
                            <% todayAppointments.forEach(appointment => { %>
                                <div class="p-3 border border-gray-200 rounded-lg">
                                    <div class="flex justify-between items-start">
                                        <div>
                                            <div class="font-medium text-gray-900">
                                                <%= appointment.Client.firstName %> <%= appointment.Client.lastName %>
                                            </div>
                                            <div class="text-sm text-gray-600">
                                                <%= appointment.start_time %> - <%= appointment.end_time %>
                                            </div>
                                            <div class="text-xs text-gray-500 mt-1">
                                                <%= appointment.consultation_type.replace('_', ' ').toUpperCase() %>
                                            </div>
                                        </div>
                                        <span class="px-2 py-1 text-xs rounded-full 
                                            <% if (appointment.status === 'confirmed') { %>bg-green-100 text-green-800<% } %>
                                            <% if (appointment.status === 'pending') { %>bg-yellow-100 text-yellow-800<% } %>
                                            <% if (appointment.status === 'cancelled') { %>bg-red-100 text-red-800<% } %>">
                                            <%= appointment.status.toUpperCase() %>
                                        </span>
                                    </div>
                                </div>
                            <% }); %>
                        <% } else { %>
                            <div class="text-center py-6 text-gray-500">
                                <i class="fas fa-calendar-check text-2xl mb-2"></i>
                                <p>No appointments today</p>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Availability Modal -->
<div id="availabilityModal" class="fixed inset-0 bg-black bg-opacity-50 hidden z-50">
    <div class="flex items-center justify-center min-h-screen p-4">
        <div class="bg-white rounded-lg shadow-xl max-w-2xl w-full max-h-screen overflow-y-auto">
            <div class="p-6">
                <div class="flex justify-between items-center mb-6">
                    <h3 class="text-xl font-semibold text-gray-900">Set Weekly Availability</h3>
                    <button onclick="closeAvailabilityModal()" class="text-gray-400 hover:text-gray-600">
                        <i class="fas fa-times text-xl"></i>
                    </button>
                </div>

                <form id="availabilityForm">
                    <div class="space-y-4">
                        <% const days = ['monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday', 'sunday']; %>
                        <% days.forEach(day => { %>
                            <div class="border border-gray-200 rounded-lg p-4">
                                <div class="flex items-center justify-between mb-3">
                                    <label class="text-lg font-medium text-gray-900 capitalize"><%= day %></label>
                                    <label class="relative inline-flex items-center cursor-pointer">
                                        <input type="checkbox" class="sr-only peer" name="<%= day %>_enabled" id="<%= day %>_enabled">
                                        <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-blue-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600"></div>
                                    </label>
                                </div>
                                <div id="<%= day %>_times" class="grid grid-cols-2 gap-4 hidden">
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">Start Time</label>
                                        <input type="time" name="<%= day %>_start" class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">End Time</label>
                                        <input type="time" name="<%= day %>_end" class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    </div>

                    <div class="mt-6 grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Consultation Duration (minutes)</label>
                            <select name="duration" class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
                                <option value="30">30 minutes</option>
                                <option value="60" selected>60 minutes</option>
                                <option value="90">90 minutes</option>
                                <option value="120">120 minutes</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Break Between Appointments (minutes)</label>
                            <select name="breakTime" class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
                                <option value="0">No break</option>
                                <option value="15" selected>15 minutes</option>
                                <option value="30">30 minutes</option>
                                <option value="45">45 minutes</option>
                            </select>
                        </div>
                    </div>

                    <div class="mt-8 flex justify-end space-x-4">
                        <button type="button" onclick="closeAvailabilityModal()" class="px-4 py-2 text-gray-700 bg-gray-200 rounded-lg hover:bg-gray-300 transition-colors">
                            Cancel
                        </button>
                        <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
                            Save Availability
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
let currentDate = new Date();
let appointments = <%- JSON.stringify(appointments) %>;
let availability = <%- JSON.stringify(availability) %>;

// Initialize calendar
document.addEventListener('DOMContentLoaded', function() {
    renderCalendar();
    setupAvailabilityForm();
});

function renderCalendar() {
    const year = currentDate.getFullYear();
    const month = currentDate.getMonth();
    
    // Update month display
    document.getElementById('currentMonth').textContent = 
        new Date(year, month).toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
    
    // Get first day of month and number of days
    const firstDay = new Date(year, month, 1).getDay();
    const daysInMonth = new Date(year, month + 1, 0).getDate();
    
    const calendarGrid = document.getElementById('calendarGrid');
    calendarGrid.innerHTML = '';
    
    // Add empty cells for days before month starts
    for (let i = 0; i < firstDay; i++) {
        const emptyDay = document.createElement('div');
        emptyDay.className = 'p-3 text-center text-gray-300';
        calendarGrid.appendChild(emptyDay);
    }
    
    // Add days of the month
    for (let day = 1; day <= daysInMonth; day++) {
        const dayElement = document.createElement('div');
        const dateStr = `${year}-${String(month + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
        
        // Check if this day has appointments
        const dayAppointments = appointments.filter(apt => 
            apt.appointment_date.split('T')[0] === dateStr
        );
        
        dayElement.className = 'p-3 text-center border border-gray-200 hover:bg-gray-50 cursor-pointer min-h-[80px] relative';
        
        if (dayAppointments.length > 0) {
            dayElement.classList.add('bg-blue-50', 'border-blue-200');
        }
        
        dayElement.innerHTML = `
            <div class="font-medium text-gray-900">${day}</div>
            ${dayAppointments.length > 0 ? `<div class="text-xs text-blue-600 mt-1">${dayAppointments.length} apt${dayAppointments.length > 1 ? 's' : ''}</div>` : ''}
        `;
        
        dayElement.onclick = () => showDayDetails(dateStr, dayAppointments);
        calendarGrid.appendChild(dayElement);
    }
}

function previousMonth() {
    currentDate.setMonth(currentDate.getMonth() - 1);
    renderCalendar();
}

function nextMonth() {
    currentDate.setMonth(currentDate.getMonth() + 1);
    renderCalendar();
}

function showDayDetails(date, dayAppointments) {
    // You can implement a day detail modal here
    console.log('Day details for:', date, dayAppointments);
}

function openAvailabilityModal() {
    document.getElementById('availabilityModal').classList.remove('hidden');
}

function closeAvailabilityModal() {
    document.getElementById('availabilityModal').classList.add('hidden');
}

function setupAvailabilityForm() {
    const days = ['monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday', 'sunday'];
    
    days.forEach(day => {
        const checkbox = document.getElementById(`${day}_enabled`);
        const timesDiv = document.getElementById(`${day}_times`);
        
        checkbox.addEventListener('change', function() {
            if (this.checked) {
                timesDiv.classList.remove('hidden');
            } else {
                timesDiv.classList.add('hidden');
            }
        });
        
        // Pre-populate with existing availability
        const existingAvailability = availability.find(a => a.day_of_week === day);
        if (existingAvailability) {
            checkbox.checked = true;
            timesDiv.classList.remove('hidden');
            document.querySelector(`input[name="${day}_start"]`).value = existingAvailability.start_time;
            document.querySelector(`input[name="${day}_end"]`).value = existingAvailability.end_time;
        }
    });
    
    // Handle form submission
    document.getElementById('availabilityForm').addEventListener('submit', async function(e) {
        e.preventDefault();
        
        const formData = new FormData(this);
        const availabilityData = [];
        
        days.forEach(day => {
            const enabled = formData.get(`${day}_enabled`);
            if (enabled) {
                availabilityData.push({
                    day: day,
                    startTime: formData.get(`${day}_start`),
                    endTime: formData.get(`${day}_end`),
                    isAvailable: true,
                    duration: parseInt(formData.get('duration')),
                    breakTime: parseInt(formData.get('breakTime'))
                });
            }
        });
        
        try {
            const response = await fetch('/appointments/availability', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ availability: availabilityData })
            });
            
            const result = await response.json();
            
            if (result.success) {
                alert('Availability updated successfully!');
                location.reload();
            } else {
                alert('Error updating availability: ' + result.error);
            }
        } catch (error) {
            console.error('Error:', error);
            alert('Error updating availability');
        }
    });
}
</script>