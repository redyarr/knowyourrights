<div class="row">
    <div class="col-md-8 mx-auto">
        <div class="card blog-post">
            <div class="card-body">
                <div class="d-flex mb-4">
                    <img src="https://via.placeholder.com/150" alt="Profile" class="rounded-circle me-3"
                        style="width: 48px; height: 48px; object-fit: cover;">
                    <div>
                        <h6 class="mb-0">
                            <%= blog.User ? blog.User.name : 'Unknown' %>
                        </h6>
                        <p class="text-muted small mb-0">
                            <%= new Date(blog.createdAt).toLocaleDateString() %>
                        </p>
                    </div>
                </div>

                <h1 class="mb-4">
                    <%= blog.title %>
                </h1>

                <% if (blog.image) { %>
                    <img src="<%= blog.image %>" class="img-fluid rounded mb-4" alt="<%= blog.title %>">
                    <% } %>

                        <div class="blog-content mb-4">
                            <%= blog.content %>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div class="d-flex align-items-center">
                                <button class="btn btn-sm btn-outline-primary me-2">
                                    <i class="far fa-thumbs-up me-1"></i> Like
                                </button>
                                <span class="text-muted small">42 likes</span>
                            </div>
                            <div>
                                <span class="text-muted small">15 comments</span>
                            </div>
                        </div>

                        <div class="d-flex mb-4">
                            <button class="btn btn-outline-secondary flex-grow-1 me-2">
                                <i class="far fa-thumbs-up me-1"></i> Like
                            </button>
                            <button class="btn btn-outline-secondary flex-grow-1 me-2">
                                <i class="far fa-comment me-1"></i> Comment
                            </button>
                            <button class="btn btn-outline-secondary flex-grow-1">
                                <i class="far fa-share-square me-1"></i> Share
                            </button>
                        </div>

                        <% if (locals.loggedInUserId && locals.loggedInUserId===blog.userId) { %>
                            <div class="d-flex gap-2 mt-4">
                                <a href="/blog/<%= blog.id %>/edit" class="btn btn-primary">Edit</a>

                                <form action="/blog/<%= blog.id %>?_method=DELETE" method="POST">
                                    <button type="submit" class="btn btn-danger"
                                        onclick="return confirm('Are you sure you want to delete this blog?')">Delete</button>
                                </form>
                            </div>
                            <% } %>

                                <hr class="my-4">

                                <!-- Comments Section -->
                                <h5 class="mb-3">Comments</h5>

                                <div class="d-flex mb-4">
                                    <img src="https://via.placeholder.com/150" alt="Profile" class="rounded-circle me-3"
                                        style="width: 40px; height: 40px; object-fit: cover;">
                                    <div class="flex-grow-1">
                                        <div class="form-floating">
                                            <textarea class="form-control" placeholder="Add a comment"
                                                id="commentTextarea" style="height: 100px"></textarea>
                                            <label for="commentTextarea">Add a comment</label>
                                        </div>
                                        <div class="d-flex justify-content-end mt-2">
                                            <button class="btn btn-primary">Post</button>
                                        </div>
                                    </div>
                                </div>

                                <!-- Sample Comments -->
                                <div class="d-flex mb-3">
                                    <img src="https://via.placeholder.com/150" alt="Profile" class="rounded-circle me-3"
                                        style="width: 40px; height: 40px; object-fit: cover;">
                                    <div>
                                        <div class="bg-light p-3 rounded">
                                            <h6 class="mb-1">Jane Smith</h6>
                                            <p class="mb-1">Great article! This is very insightful and helpful for my
                                                current case.</p>
                                            <div class="d-flex align-items-center">
                                                <button
                                                    class="btn btn-sm btn-link text-decoration-none p-0 me-3">Like</button>
                                                <button
                                                    class="btn btn-sm btn-link text-decoration-none p-0">Reply</button>
                                                <span class="text-muted small ms-auto">2 days ago</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="d-flex">
                                    <img src="https://via.placeholder.com/150" alt="Profile" class="rounded-circle me-3"
                                        style="width: 40px; height: 40px; object-fit: cover;">
                                    <div>
                                        <div class="bg-light p-3 rounded">
                                            <h6 class="mb-1">John Doe</h6>
                                            <p class="mb-1">I would love to see more content like this. The legal
                                                implications are fascinating.</p>
                                            <div class="d-flex align-items-center">
                                                <button
                                                    class="btn btn-sm btn-link text-decoration-none p-0 me-3">Like</button>
                                                <button
                                                    class="btn btn-sm btn-link text-decoration-none p-0">Reply</button>
                                                <span class="text-muted small ms-auto">1 day ago</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="mt-3">
                                    <a href="/blog" class="btn btn-outline-secondary">Back to Feed</a>
                                </div>
            </div>
        </div>
    </div>
</div>