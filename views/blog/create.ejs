<div class="row">
    <div class="col-md-8 mx-auto">
        <div class="card">
            <div class="card-header">
                <h2>Create Post</h2>
            </div>
            <div class="card-body">
                <% if (typeof error !=='undefined' ) { %>
                    <div class="alert alert-danger">
                        <%= error %>
                    </div>
                    <% } %>

                        <form action="/blog/create" method="POST">
                            <div class="mb-3">
                                <label for="title" class="form-label">Title</label>
                                <input type="text" class="form-control" id="title" name="title"
                                    placeholder="What's an engaging title for your post?" required>
                            </div>

                            <div class="mb-3">
                                <label for="content" class="form-label">Content</label>
                                <textarea class="form-control" id="content" name="content" rows="10"
                                    placeholder="Share your thoughts, insights, or questions..." required></textarea>
                            </div>

                            <div class="mb-3">
                                <label for="image" class="form-label">Image URL (optional)</label>
                                <input type="text" class="form-control" id="image" name="image"
                                    placeholder="https://example.com/image.jpg">
                                <div class="form-text">Add an image URL to include a visual with your post</div>
                            </div>

                            <div class="d-flex justify-content-between">
                                <button type="submit" class="btn btn-primary">Post</button>
                                <a href="/blog" class="btn btn-outline-secondary">Cancel</a>
                            </div>
                        </form>
            </div>
        </div>
    </div>
</div>