<div class="max-w-7xl mx-auto px-4 py-8 mt-16">
    <div class="max-w-2xl mx-auto">
        <!-- Header -->
        <div class="bg-white rounded-lg shadow-md p-6 mb-6">
            <h1 class="text-2xl font-bold text-gray-900 mb-2">Edit Profile</h1>
            <p class="text-gray-600">Update your personal information and professional details.</p>
        </div>

        <!-- Edit Profile Form -->
        <div class="bg-white rounded-lg shadow-md p-6">
            <form action="/in/<%= user.id %>/edit" method="POST" class="space-y-6">
                <!-- Basic Information -->
                <div class="border-b border-gray-200 pb-6">
                    <h2 class="text-lg font-semibold text-gray-900 mb-4">Basic Information</h2>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label for="firstName" class="block text-sm font-medium text-gray-700 mb-2">First Name</label>
                            <input type="text" id="firstName" name="firstName" value="<%= user.firstName %>" 
                                   class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" 
                                   required>
                        </div>
                        
                        <div>
                            <label for="lastName" class="block text-sm font-medium text-gray-700 mb-2">Last Name</label>
                            <input type="text" id="lastName" name="lastName" value="<%= user.lastName %>" 
                                   class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" 
                                   required>
                        </div>
                    </div>

                    <div class="mt-4">
                        <label for="email" class="block text-sm font-medium text-gray-700 mb-2">Email</label>
                        <input type="email" id="email" name="email" value="<%= user.email %>" 
                               class="w-full px-3 py-2 border border-gray-300 rounded-md bg-gray-50" 
                               readonly>
                        <p class="text-sm text-gray-500 mt-1">Email cannot be changed</p>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
                        <div>
                            <label for="country" class="block text-sm font-medium text-gray-700 mb-2">Country</label>
                            <input type="text" id="country" name="country" value="<%= user.country || '' %>" 
                                   class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                        </div>
                        
                        <div>
                            <label for="city" class="block text-sm font-medium text-gray-700 mb-2">City</label>
                            <input type="text" id="city" name="city" value="<%= user.city || '' %>" 
                                   class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                        </div>
                    </div>
                </div>

                <!-- Professional Information (for lawyers) -->
                <% if (user.role === 'lawyer' && user.lawyer) { %>
                <div class="border-b border-gray-200 pb-6">
                    <h2 class="text-lg font-semibold text-gray-900 mb-4">Professional Information</h2>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label for="lawFirm" class="block text-sm font-medium text-gray-700 mb-2">Law Firm</label>
                            <input type="text" id="lawFirm" name="lawFirm" value="<%= user.lawyer.lawFirm || '' %>" 
                                   class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                        </div>
                        
                        <div>
                            <label for="licenseNumber" class="block text-sm font-medium text-gray-700 mb-2">License Number</label>
                            <input type="text" id="licenseNumber" name="licenseNumber" value="<%= user.lawyer.licenseNumber || '' %>" 
                                   class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                        </div>
                    </div>

                    <div class="mt-4">
                        <label for="summary" class="block text-sm font-medium text-gray-700 mb-2">Professional Summary</label>
                        <textarea id="summary" name="summary" rows="4" 
                                  class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" 
                                  placeholder="Tell us about your legal expertise and experience..."><%= user.lawyer.summery || '' %></textarea>
                    </div>

                    <div class="mt-4">
                        <label for="legalAreas" class="block text-sm font-medium text-gray-700 mb-2">Legal Areas of Expertise</label>
                        <div class="space-y-3">
                            <!-- Predefined Legal Areas -->
                            <div class="grid grid-cols-2 md:grid-cols-3 gap-2">
                                <% 
                                const legalSpecialties = [
                                    'Family Law', 'Corporate Law', 'Criminal Defense', 'Employment Law', 
                                    'Personal Injury', 'Real Estate Law', 'Immigration Law', 'Tax Law',
                                    'Intellectual Property', 'Environmental Law', 'Healthcare Law', 'Bankruptcy Law',
                                    'Contract Law', 'Civil Rights', 'Consumer Protection', 'Estate Planning',
                                    'Labor Law', 'Securities Law', 'Administrative Law', 'Constitutional Law'
                                ];
                                const currentAreas = (user.lawyer.legalAreas || '').split(',').map(area => area.trim()).filter(area => area);
                                %>
                                <% legalSpecialties.forEach(specialty => { %>
                                <label class="flex items-center space-x-2 text-sm">
                                    <input type="checkbox" name="legalSpecialties" value="<%= specialty %>" 
                                           class="rounded border-gray-300 text-blue-600 focus:ring-blue-500"
                                           <%= currentAreas.includes(specialty) ? 'checked' : '' %>>
                                    <span class="text-gray-700"><%= specialty %></span>
                                </label>
                                <% }); %>
                            </div>
                            
                            <!-- Custom Legal Areas -->
                            <div>
                                <label for="customLegalAreas" class="block text-sm font-medium text-gray-700 mb-1">Additional/Custom Areas</label>
                                <textarea id="customLegalAreas" name="customLegalAreas" rows="2" 
                                          class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" 
                                          placeholder="Any other legal areas not listed above (separate with commas)"><%= currentAreas.filter(area => !legalSpecialties.includes(area)).join(', ') %></textarea>
                            </div>
                        </div>
                        <p class="text-sm text-gray-500 mt-1">Select up to 2 areas that best represent your primary expertise</p>
                    </div>
                </div>
                <% } %>

                <!-- Interests Section (for all users) -->
                <div class="border-b border-gray-200 pb-6">
                    <h2 class="text-lg font-semibold text-gray-900 mb-4">Interests & Areas of Focus</h2>
                    
                    <div class="mt-4">
                        <label for="interests" class="block text-sm font-medium text-gray-700 mb-2">
                            <% if (user.role === 'lawyer') { %>
                                Additional Legal Interests
                            <% } else { %>
                                Legal Areas of Interest
                            <% } %>
                        </label>
                        <textarea id="interests" name="interests" rows="3" 
                                  class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" 
                                  placeholder="<% if (user.role === 'lawyer') { %>e.g., Pro Bono Work, Legal Education, Community Outreach...<% } else { %>e.g., Family Law, Employment Rights, Consumer Protection...<% } %>"><%= user.interests || '' %></textarea>
                        <p class="text-sm text-gray-500 mt-1">Separate multiple interests with commas</p>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="flex justify-end space-x-4 pt-6">
                    <a href="/in" class="px-6 py-2 border border-gray-300 text-gray-700 rounded-md hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                        Cancel
                    </a>
                    <button type="submit" class="px-6 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
                        Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
// Limit legal specialty selection to 2 items
document.addEventListener('DOMContentLoaded', function() {
    const checkboxes = document.querySelectorAll('input[name="legalSpecialties"]');
    const maxSelections = 2;
    
    checkboxes.forEach(checkbox => {
        checkbox.addEventListener('change', function() {
            const checkedBoxes = document.querySelectorAll('input[name="legalSpecialties"]:checked');
            
            if (checkedBoxes.length > maxSelections) {
                this.checked = false;
                alert(`You can only select up to ${maxSelections} legal specialties.`);
            }
            
            // Disable unchecked boxes if max reached
            checkboxes.forEach(cb => {
                if (!cb.checked) {
                    cb.disabled = checkedBoxes.length >= maxSelections;
                }
            });
        });
    });
});
</script>

<%- include('../layouts/footer') %>