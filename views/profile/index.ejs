<div class="max-w-4xl mx-auto px-4 py-8 mt-16">
    <!-- LinkedIn-inspired Profile Header Card -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 mb-6 overflow-hidden">
        <!-- Cover Photo -->
        <div class="h-48 bg-gradient-to-r from-blue-600 to-blue-700 relative">
            <!-- Optional: Add cover photo upload for own profile -->
            <% if (loggedInUserId == profile.id) { %>
                <div class="absolute top-4 right-4">
                    <button class="bg-white/20 hover:bg-white/30 text-white p-2 rounded-lg transition-colors">
                        <i class="fas fa-camera text-sm"></i>
                    </button>
                </div>
            <% } %>
        </div>
        
        <!-- Profile Content -->
        <div class="px-6 pb-6">
            <!-- Profile Photo & Action Buttons -->
            <div class="flex justify-between items-start -mt-16 mb-4">
                <div class="relative">
                    <% if (profile.ProfileImage && profile.ProfileImage.imagePath) { %>
                        <img src="<%= profile.ProfileImage.imagePath %>" alt="Profile"
                            class="w-32 h-32 rounded-full border-4 border-white object-cover shadow-lg">
                    <% } else { %>
                        <img src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(profile.firstName + ' ' + profile.lastName) %>&size=128&background=0ea5e9&color=ffffff" alt="Profile"
                            class="w-32 h-32 rounded-full border-4 border-white object-cover shadow-lg">
                    <% } %>
                    <% if (loggedInUserId == profile.id) { %>
                        <button class="absolute bottom-2 right-2 bg-white border border-gray-300 rounded-full p-2 shadow-sm hover:bg-gray-50 transition-colors">
                            <i class="fas fa-camera text-gray-600 text-sm"></i>
                        </button>
                    <% } %>
                </div>
                
                <div class="mt-16">
                    <% if (loggedInUserId && loggedInUserId != profile.id) { %>
                        <div class="flex space-x-2">
                            <% if (!connectionStatus) { %>
                                <button type="button" id="connectBtn" data-user-id="<%= profile.id %>" data-action="connect"
                                    class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-full font-medium transition-colors flex items-center">
                                    <i class="fas fa-user-plus mr-2"></i>Connect
                                </button>
                            <% } else if (connectionStatus === 'pending') { %>
                                <button type="button" id="connectBtn" data-user-id="<%= profile.id %>" data-action="cancel"
                                    class="bg-gray-400 hover:bg-red-500 text-white px-4 py-2 rounded-full font-medium transition-colors flex items-center">
                                    <i class="fas fa-clock mr-2"></i>Pending
                                </button>
                            <% } else if (connectionStatus === 'accepted') { %>
                                <button type="button" id="connectBtn"
                                    class="bg-green-600 text-white px-4 py-2 rounded-full font-medium flex items-center">
                                    <i class="fas fa-check mr-2"></i>Connected
                                </button>
                            <% } %>
                            <a href="/messaging/<%= profile.id %>"
                                class="border border-blue-600 text-blue-600 hover:bg-blue-50 px-4 py-2 rounded-full font-medium transition-colors flex items-center">
                                <i class="fas fa-envelope mr-2"></i>Message
                            </a>
                            <button class="border border-gray-300 text-gray-700 hover:bg-gray-50 p-2 rounded-full transition-colors">
                                <i class="fas fa-ellipsis-h"></i>
                            </button>
                        </div>
                    <% } else if (loggedInUserId == profile.id) { %>
                        <div class="flex space-x-2">
                            <a href="/profile/edit"
                                class="border border-blue-600 text-blue-600 hover:bg-blue-50 px-4 py-2 rounded-full font-medium transition-colors flex items-center">
                                <i class="fas fa-edit mr-2"></i>Edit Profile
                            </a>
                            <button class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-full font-medium transition-colors">
                                Add section
                            </button>
                            <button class="border border-gray-300 text-gray-700 hover:bg-gray-50 p-2 rounded-full transition-colors">
                                <i class="fas fa-ellipsis-h"></i>
                            </button>
                        </div>
                    <% } %>
                </div>
            </div>
        
            <!-- Profile Info -->
            <div>
                <% if (profile?.role === 'lawyer') { %>
                    <% 
                      let authorityColor = 'yellow';
                      let authorityBadge = 'Pending Verification';
                      let authorityIcon = 'fas fa-clock';
                      let authorityBg = 'bg-yellow-50';
                      let authorityBorder = 'border-yellow-200';
                      let authorityText = 'text-yellow-800';
                      
                      if (profile?.lawyer?.verificationStatus === 'approved') {
                        authorityColor = 'emerald';
                        authorityBadge = 'Verified Lawyer';
                        authorityIcon = 'fas fa-certificate';
                        authorityBg = 'bg-emerald-50';
                        authorityBorder = 'border-emerald-200';
                        authorityText = 'text-emerald-800';
                      } else if (profile?.lawyer?.verificationStatus === 'rejected') {
                        authorityColor = 'red';
                        authorityBadge = 'Verification Rejected';
                        authorityIcon = 'fas fa-times-circle';
                        authorityBg = 'bg-red-50';
                        authorityBorder = 'border-red-200';
                        authorityText = 'text-red-800';
                      } else if (profile?.lawyer?.verificationStatus === 'pending') {
                        authorityColor = 'yellow';
                        authorityBadge = 'Pending Verification';
                        authorityIcon = 'fas fa-clock';
                        authorityBg = 'bg-yellow-50';
                        authorityBorder = 'border-yellow-200';
                        authorityText = 'text-yellow-800';
                      }
                    %>
                    <div class="mb-4">
                        <h1 class="text-2xl font-semibold text-gray-900 mb-1">
                            <%= profile.firstName %> <%= profile.lastName %>
                        </h1>
                        <div class="flex items-center mb-2">
                            <span class="<%= authorityText %> text-sm font-medium px-2 py-1 <%= authorityBg %> rounded-md border <%= authorityBorder %> flex items-center">
                                <i class="<%= authorityIcon %> mr-1 text-xs"></i>
                                <%= authorityBadge %>
                            </span>
                        </div>
                    </div>
                    <% if (profile?.lawyer?.verificationStatus === 'pending') { %>
                        <div class="mb-4 p-3 bg-yellow-50 border border-yellow-200 rounded-lg">
                            <p class="text-sm text-yellow-800 flex items-center">
                                <i class="fas fa-info-circle mr-2"></i>
                                Your lawyer verification is currently under review. You'll be notified once it's processed.
                            </p>
                        </div>
                    <% } else if (profile?.lawyer?.verificationStatus === 'rejected') { %>
                        <div class="mb-4 p-3 bg-red-50 border border-red-200 rounded-lg">
                            <p class="text-sm text-red-800 flex items-center">
                                <i class="fas fa-exclamation-triangle mr-2"></i>
                                Your lawyer verification was rejected.
                                <% if (profile?.lawyer?.rejectionReason) { %>
                                    Reason: <%= profile.lawyer.rejectionReason %>
                                <% } %>
                                Please update your information and resubmit.
                            </p>
                            <a href="/profile/edit" class="inline-block mt-2 text-red-600 hover:text-red-800 font-medium">
                                Update Profile →
                            </a>
                        </div>
                    <% } else if (profile?.lawyer?.verificationStatus === 'approved') { %>
                        <p class="text-emerald-600 text-lg font-medium flex items-center">
                            <i class="fas fa-certificate text-emerald-500 mr-2"></i>
                            Verified Legal Professional
                        </p>
                    <% } else { %>
                        <p class="text-gray-600 text-lg font-medium flex items-center">
                            <i class="fas fa-user-graduate text-gray-500 mr-2"></i>
                            Legal Professional
                        </p>
                    <% } %>
                <% } else { %>
                    <div class="mb-4">
                        <h1 class="text-2xl font-semibold text-gray-900 mb-1">
                            <%= profile.firstName %> <%= profile.lastName %>
                        </h1>
                    </div>
                    <p class="text-gray-600 text-lg">
                        <%= profile.role.charAt(0).toUpperCase() + profile.role.slice(1) %> at LegalNet
                    </p>
                <% } %>
                <p class="text-gray-500 text-sm flex items-center mt-2">
                    <i class="fas fa-map-marker-alt mr-2"></i>New York, United States
                </p>
            </div>
            
            <!-- Stats Row -->
            <div class="grid grid-cols-3 gap-4 mt-6">
                <div class="stats-card">
                    <div class="text-2xl font-bold"><%= connectionsCount || 0 %></div>
                    <div class="text-sm opacity-90">Connections</div>
                </div>
                <div class="stats-card">
                    <div class="text-2xl font-bold"><%= profile.Posts ? profile.Posts.length : 0 %></div>
                    <div class="text-sm opacity-90">Posts</div>
                </div>
                <div class="stats-card">
                    <div class="text-2xl font-bold">4.8</div>
                    <div class="text-sm opacity-90">Rating</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Profile Navigation -->
    <div class="profile-nav flex space-x-0 mb-6">
        <div class="profile-nav-item active" data-tab="about">
            <i class="fas fa-user mr-2"></i>About
        </div>
        <div class="profile-nav-item" data-tab="activity">
            <i class="fas fa-chart-line mr-2"></i>Activity
        </div>
        <div class="profile-nav-item" data-tab="posts">
            <i class="fas fa-newspaper mr-2"></i>Posts
        </div>
        <% if (profile?.role === 'lawyer') { %>
        <div class="profile-nav-item" data-tab="credentials">
            <i class="fas fa-certificate mr-2"></i>Credentials
        </div>
        <% } %>
    </div>

    <!-- Tab Content -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Main Content -->
        <div class="lg:col-span-2">
            <!-- About Tab -->
            <div id="about-tab" class="tab-content">
                <% if (profile?.role === 'lawyer' && profile.lawyer) { %>
                    <!-- About Card for Lawyers -->
                    <div class="glass-card rounded-2xl p-6 mb-6">
                        <h3 class="text-xl font-bold mb-4 flex items-center">
                            <i class="fas fa-info-circle mr-2 text-blue-600"></i>About
                        </h3>
                        <p class="text-gray-700 leading-relaxed mb-4">
                            <%= profile.lawyer.summary || 'Professional lawyer with extensive experience in various legal domains.' %>
                        </p>
                        
                        <!-- Legal Areas -->
                        <div class="mb-4">
                            <h4 class="font-semibold text-gray-800 mb-2">Legal Specializations</h4>
                            <div class="flex flex-wrap">
                                <% if (profile.lawyer.legalAreas) { %>
                                    <% profile.lawyer.legalAreas.split(',').forEach(area => { %>
                                        <span class="skill-tag"><%= area.trim() %></span>
                                    <% }); %>
                                <% } else { %>
                                    <span class="skill-tag">General Practice</span>
                                    <span class="skill-tag">Legal Consultation</span>
                                <% } %>
                            </div>
                        </div>
                        
                        <!-- Law Firm -->
                        <div class="flex items-center text-gray-600">
                            <i class="fas fa-building mr-2"></i>
                            <span><%= profile.lawyer.lawFirm || 'Independent Practice' %></span>
                        </div>
                    </div>
                <% } else { %>
                    <!-- About Card for Non-Lawyers -->
                    <div class="glass-card rounded-2xl p-6 mb-6">
                        <h3 class="text-xl font-bold mb-4 flex items-center">
                            <i class="fas fa-info-circle mr-2 text-blue-600"></i>About
                        </h3>
                        <p class="text-gray-700 leading-relaxed">
                            Welcome to my profile! I'm a <%= profile.role %> on LegalNet, connecting with legal professionals and seeking legal guidance.
                        </p>
                    </div>
                <% } %>
            </div>

            <!-- Activity Tab -->
            <div id="activity-tab" class="tab-content hidden">
                <div class="glass-card rounded-2xl p-6">
                    <h3 class="text-xl font-bold mb-4 flex items-center">
                        <i class="fas fa-chart-line mr-2 text-blue-600"></i>Recent Activity
                    </h3>
                    <div class="space-y-4">
                        <div class="activity-item">
                            <div class="flex items-center justify-between">
                                <div>
                                    <p class="font-medium">Posted a new article</p>
                                    <p class="text-sm text-gray-500">2 hours ago</p>
                                </div>
                                <i class="fas fa-newspaper text-blue-600"></i>
                            </div>
                        </div>
                        <div class="activity-item">
                            <div class="flex items-center justify-between">
                                <div>
                                    <p class="font-medium">Connected with 3 new professionals</p>
                                    <p class="text-sm text-gray-500">1 day ago</p>
                                </div>
                                <i class="fas fa-users text-green-600"></i>
                            </div>
                        </div>
                        <div class="activity-item">
                            <div class="flex items-center justify-between">
                                <div>
                                    <p class="font-medium">Updated profile information</p>
                                    <p class="text-sm text-gray-500">3 days ago</p>
                                </div>
                                <i class="fas fa-edit text-purple-600"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Posts Tab -->
            <div id="posts-tab" class="tab-content hidden">
                <div class="glass-card rounded-2xl p-6">
                    <h3 class="text-xl font-bold mb-4 flex items-center">
                        <i class="fas fa-newspaper mr-2 text-blue-600"></i>Recent Posts
                    </h3>
                    <% if (profile.Posts && profile.Posts.length > 0) { %>
                        <div class="space-y-4">
                            <% profile.Posts.slice(0, 3).forEach(post => { %>
                                <div class="border-l-4 border-blue-500 pl-4 py-2">
                                    <h4 class="font-semibold text-gray-800"><%= post.title %></h4>
                                    <p class="text-gray-600 text-sm mt-1"><%= post.content.substring(0, 100) %>...</p>
                                    <p class="text-xs text-gray-400 mt-2"><%= new Date(post.createdAt).toLocaleDateString() %></p>
                                </div>
                            <% }); %>
                        </div>
                    <% } else { %>
                        <p class="text-gray-500 text-center py-8">No posts yet.</p>
                    <% } %>
                </div>
            </div>

            <!-- Credentials Tab (Lawyers only) -->
            <% if (profile?.role === 'lawyer') { %>
            <div id="credentials-tab" class="tab-content hidden">
                <div class="glass-card rounded-2xl p-6">
                    <h3 class="text-xl font-bold mb-4 flex items-center">
                        <i class="fas fa-certificate mr-2 text-blue-600"></i>Credentials & Education
                    </h3>
                    
                    <!-- Professional Rank -->
                    <% 
                      let rankColor = 'blue';
                      let rankBadge = 'Training Lawyer';
                      let rankIcon = 'fas fa-user-graduate';
                      let rankBg = 'bg-blue-50';
                      let rankBorder = 'border-blue-200';
                      let rankText = 'text-blue-800';
                      let rankGradient = 'from-blue-500 to-blue-600';
                      let rankDescription = 'Currently in training phase with supervised practice';
                      
                      if (profile?.lawyer?.verificationStatus === 'approved') {
                        rankColor = 'emerald';
                        rankBadge = 'Verified Lawyer';
                        rankIcon = 'fas fa-certificate';
                        rankBg = 'bg-emerald-50';
                        rankBorder = 'border-emerald-200';
                        rankText = 'text-emerald-800';
                        rankGradient = 'from-emerald-500 to-emerald-600';
                        rankDescription = 'Fully verified and approved for independent practice';
                      } else if (profile?.lawyer?.verificationStatus === 'pending') {
                        rankColor = 'yellow';
                        rankBadge = 'Pending Verification';
                        rankIcon = 'fas fa-clock';
                        rankBg = 'bg-yellow-50';
                        rankBorder = 'border-yellow-200';
                        rankText = 'text-yellow-800';
                        rankGradient = 'from-yellow-500 to-yellow-600';
                        rankDescription = 'Verification currently under review by administrators';
                      } else if (profile?.lawyer?.verificationStatus === 'rejected') {
                        rankColor = 'red';
                        rankBadge = 'Verification Rejected';
                        rankIcon = 'fas fa-times-circle';
                        rankBg = 'bg-red-50';
                        rankBorder = 'border-red-200';
                        rankText = 'text-red-800';
                        rankGradient = 'from-red-500 to-red-600';
                        rankDescription = 'Verification was rejected - please update credentials and resubmit';
                      }
                    %>
                    <div class="<%= rankBg %> rounded-xl p-6 mb-6 <%= rankBorder %> border-2">
                        <div class="flex items-center mb-3">
                            <div class="w-12 h-12 rounded-full bg-gradient-to-r <%= rankGradient %> flex items-center justify-center mr-4">
                                <i class="<%= rankIcon %> text-white text-lg"></i>
                            </div>
                            <div>
                                <h4 class="font-bold <%= rankText %> text-lg"><%= rankBadge %></h4>
                                <p class="text-sm <%= rankText %> opacity-80">Professional Status</p>
                            </div>
                        </div>
                        <p class="text-sm <%= rankText %> opacity-90 leading-relaxed"><%= rankDescription %></p>
                    </div>
                    
                    <!-- Badge Information -->
                    <% if (profile.lawyer.badgeNumber) { %>
                        <div class="bg-gray-50 rounded-lg p-4 mb-4 border border-gray-200">
                            <h4 class="font-semibold text-gray-800 mb-2 flex items-center">
                                <i class="fas fa-id-badge mr-2 text-gray-600"></i>
                                Professional License
                            </h4>
                            <p class="text-sm text-gray-700">Badge Number: <span class="font-mono bg-gray-100 px-2 py-1 rounded"><%= profile.lawyer.badgeNumber %></span></p>
                            <% if (profile.lawyer.badgeIssueDate) { %>
                                <p class="text-sm text-gray-700 mt-1">Issued: <%= new Date(profile.lawyer.badgeIssueDate).toLocaleDateString() %></p>
                            <% } %>
                        </div>
                    <% } %>
                    
                    <!-- Education -->
                    <% if (profile.lawyer.Educations && profile.lawyer.Educations.length > 0) { %>
                        <div class="space-y-3">
                            <h4 class="font-semibold text-gray-800">Education</h4>
                            <% profile.lawyer.Educations.forEach(edu => { %>
                                <div class="border-l-4 border-green-500 pl-4">
                                    <p class="font-medium"><%= edu.degree %></p>
                                    <p class="text-gray-600"><%= edu.institution %></p>
                                    <% if (edu.year) { %>
                                        <p class="text-sm text-gray-500"><%= edu.year %></p>
                                    <% } %>
                                </div>
                            <% }); %>
                        </div>
                    <% } %>
                </div>
            </div>
            <% } %>
        </div>

        <!-- Sidebar -->
        <div class="lg:col-span-1">
            <!-- Contact Information -->
            <div class="glass-card rounded-2xl p-6 mb-6">
                <h3 class="text-lg font-bold mb-4 flex items-center">
                    <i class="fas fa-address-card mr-2 text-blue-600"></i>Contact Info
                </h3>
                <div class="space-y-3">
                    <div class="flex items-center">
                        <i class="fas fa-envelope text-gray-400 w-5"></i>
                        <span class="ml-3 text-sm"><%= profile.email %></span>
                    </div>
                    <% if (profile.Contact) { %>
                        <% if (profile.Contact.phone) { %>
                            <div class="flex items-center">
                                <i class="fas fa-phone text-gray-400 w-5"></i>
                                <span class="ml-3 text-sm"><%= profile.Contact.phone %></span>
                            </div>
                        <% } %>
                        <% if (profile.Contact.website) { %>
                            <div class="flex items-center">
                                <i class="fas fa-globe text-gray-400 w-5"></i>
                                <a href="<%= profile.Contact.website %>" class="ml-3 text-sm text-blue-600 hover:underline" target="_blank"><%= profile.Contact.website %></a>
                            </div>
                        <% } %>
                    <% } %>
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="glass-card rounded-2xl p-6">
                <h3 class="text-lg font-bold mb-4 flex items-center">
                    <i class="fas fa-bolt mr-2 text-blue-600"></i>Quick Actions
                </h3>
                <div class="space-y-3">
                    <a href="/feed" class="block w-full text-center bg-blue-600 text-white py-2 rounded-lg hover:bg-blue-700 transition">
                        <i class="fas fa-home mr-2"></i>View Feed
                    </a>
                    <a href="/mynetwork" class="block w-full text-center bg-green-600 text-white py-2 rounded-lg hover:bg-green-700 transition">
                        <i class="fas fa-users mr-2"></i>My Network
                    </a>
                    <a href="/search" class="block w-full text-center bg-purple-600 text-white py-2 rounded-lg hover:bg-purple-700 transition">
                        <i class="fas fa-search mr-2"></i>Find People
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Floating Action Button -->
<% if (loggedInUserId == profile.id) { %>
<a href="/feed" class="floating-action" title="Create Post">
    <i class="fas fa-plus text-xl"></i>
</a>
<% } %>

<style>
/* Enhanced responsive styles for profile page */
@media (max-width: 768px) {
    /* Profile header mobile adjustments */
    .glass-card {
        margin: 0.5rem;
        border-radius: 1rem;
    }
    
    .h-52 {
        height: 8rem !important;
    }
    
    .absolute.top-0.left-0.right-0 {
        position: relative !important;
        padding: 1rem;
        flex-direction: column;
        align-items: center;
        text-align: center;
    }
    
    .mt-28 {
        margin-top: 1rem !important;
    }
    
    .mt-20 {
        margin-top: 1rem !important;
    }
    
    .w-36.h-36 {
        width: 6rem !important;
        height: 6rem !important;
    }
    
    .flex.space-x-3 {
        flex-direction: column;
        align-items: stretch;
        width: 100%;
        margin-top: 1rem;
    }
    
    .flex.space-x-3 > * {
        margin-right: 0 !important;
        margin-bottom: 0.5rem;
        width: 100%;
        text-align: center;
    }
    
    .glass-button {
        width: 100% !important;
        justify-content: center;
    }
    
    /* Profile content mobile */
    .grid.grid-cols-1.lg\:grid-cols-3 {
        grid-template-columns: 1fr !important;
        gap: 1rem;
    }
    
    .lg\:col-span-2 {
        grid-column: span 1;
    }
    
    /* Profile stats mobile */
    .flex.justify-between {
        flex-direction: column;
        align-items: center;
        text-align: center;
    }
    
    .flex.justify-between > div {
        margin-bottom: 1rem;
    }
    
    /* Education and experience cards */
    .space-y-6 > * {
        margin-top: 1rem;
    }
    
    /* Skills tags */
    .flex.flex-wrap {
        justify-content: center;
    }
    
    .inline-flex {
        margin: 0.25rem;
    }
}

@media (max-width: 480px) {
    .h-52 {
        height: 6rem !important;
    }
    
    .w-36.h-36 {
        width: 4rem !important;
        height: 4rem !important;
    }
    
    .text-3xl {
        font-size: 1.5rem;
    }
    
    .text-2xl {
        font-size: 1.25rem;
    }
    
    .px-6 {
        padding-left: 1rem !important;
        padding-right: 1rem !important;
    }
    
    .py-6 {
        padding-top: 1rem !important;
        padding-bottom: 1rem !important;
    }
}

/* Tablet adjustments */
@media (min-width: 769px) and (max-width: 1024px) {
    .grid.grid-cols-1.lg\:grid-cols-3 {
        grid-template-columns: 1fr 2fr !important;
        gap: 1.5rem;
    }
    
    .w-36.h-36 {
        width: 8rem !important;
        height: 8rem !important;
    }
    
    .flex.space-x-3 {
        flex-direction: row;
        justify-content: center;
    }
    
    .flex.space-x-3 > * {
        width: auto;
        margin-right: 0.75rem;
        margin-bottom: 0;
    }
}
</style>

<style>
     .glass-card {
         background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.2);
    }
    
    .glass-button {
        backdrop-filter: blur(10px);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    
    .glass-button:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
    }
    
    .skill-tag {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 0.5rem 1rem;
        border-radius: 25px;
        font-size: 0.875rem;
        font-weight: 500;
        display: inline-block;
        margin: 0.25rem;
        transition: all 0.3s ease;
    }
    
    .skill-tag:hover {
        transform: scale(1.05);
        box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
    }
    
    .activity-item {
        border-left: 3px solid #3b82f6;
        padding-left: 1rem;
        margin-bottom: 1rem;
        transition: all 0.3s ease;
    }
    
    .activity-item:hover {
        border-left-color: #1d4ed8;
        background: rgba(59, 130, 246, 0.05);
        border-radius: 0.5rem;
        padding: 1rem;
        margin-left: -1rem;
    }
    
    .stats-card {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-radius: 1rem;
        padding: 1.5rem;
        text-align: center;
        transition: all 0.3s ease;
    }
    
    .stats-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 35px rgba(102, 126, 234, 0.3);
    }
    
    .profile-nav {
        border-bottom: 2px solid #e5e7eb;
        margin-bottom: 2rem;
    }
    
    .profile-nav-item {
        padding: 1rem 1.5rem;
        border-bottom: 3px solid transparent;
        transition: all 0.3s ease;
        cursor: pointer;
    }
    
    .profile-nav-item.active {
        border-bottom-color: #3b82f6;
        color: #3b82f6;
        font-weight: 600;
    }
    
    .profile-nav-item:hover {
        background: rgba(59, 130, 246, 0.05);
        color: #3b82f6;
    }
    
    .floating-action {
        position: fixed;
        bottom: 2rem;
        right: 2rem;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-radius: 50%;
        width: 60px;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 10px 25px rgba(102, 126, 234, 0.3);
        transition: all 0.3s ease;
        z-index: 1000;
    }
    
    .floating-action:hover {
        transform: scale(1.1) rotate(5deg);
        box-shadow: 0 15px 35px rgba(102, 126, 234, 0.4);
    }
</style>

// Tab switching functionality
document.querySelectorAll('.profile-nav-item').forEach(item => {
    item.addEventListener('click', function() {
        // Remove active class from all nav items
        document.querySelectorAll('.profile-nav-item').forEach(nav => nav.classList.remove('active'));
        // Add active class to clicked item
        this.classList.add('active');
        
        // Hide all tab content
        document.querySelectorAll('.tab-content').forEach(tab => tab.classList.add('hidden'));
        // Show selected tab content
        const tabId = this.dataset.tab + '-tab';
        document.getElementById(tabId).classList.remove('hidden');
    });
});

// Connection button functionality
if (document.getElementById('connectBtn')) {
    document.getElementById('connectBtn').addEventListener('click', function() {
        const userId = this.dataset.userId;
        const action = this.dataset.action;
        
        fetch('/mynetwork/connect', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({ userId, action })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                location.reload();
            } else {
                alert(data.message || 'An error occurred');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('An error occurred');
        });
    });
}
</script>

