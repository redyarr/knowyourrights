<div class="max-w-4xl mx-auto px-4">
    <!-- Profile Header Card -->
    <div class="bg-white rounded-lg shadow mb-5 relative">
        <!-- Background Gradient -->
        <div class="h-48 bg-gradient-to-r from-blue-700 to-blue-500 rounded-t-lg"></div>
        <!-- Profile Photo & Action Buttons -->
        <div class="absolute top-0 left-0 right-0 flex justify-between items-start px-6 pt-6">
            <div class="mt-24">
                <img src="https://ui-avatars.com/api/?size=160&background=random" alt="Profile"
                    class="w-32 h-32 rounded-full border-4 border-white object-cover">
            </div>
            <div class="mt-8">
                <% if (locals.loggedInUserId && locals.loggedInUserId===profile.id) { %>
                    <a href="/user/<%= profile.id %>/edit"
                        class="flex items-center px-4 py-2 border border-blue-600 text-blue-600 rounded-full hover:bg-blue-50">
                        <i class="fas fa-pencil-alt mr-1"></i> Edit Profile
                    </a>
                    <% } else { %>
                        <div class="flex space-x-2">
                            <button class="bg-blue-600 text-white px-4 py-2 rounded-full">Connect</button>
                            <button class="border border-blue-600 text-blue-600 px-4 py-2 rounded-full">Message</button>
                        </div>
                        <% } %>
            </div>
        </div>
        <!-- Profile Info -->
        <div class="mt-20 px-6 pb-6">
            <div>
                <h2 class="text-2xl font-bold">
                    <%= profile.firstName %>
                        <%= profile.lastName %>
                </h2>
                <p class="text-gray-600">
                    <%= profile.role.charAt(0).toUpperCase() + profile.role.slice(1) %> at LegalNet
                </p>
                <p class="text-gray-500 text-sm">New York, United States</p>
            </div>
            <div class="flex mt-3 space-x-4">
                <a href="#" class="text-blue-600 hover:underline text-sm">500+ connections</a>
                <a href="#" class="text-blue-600 hover:underline text-sm">Contact info</a>
            </div>
        </div>
    </div>

    <!-- About Card -->
    <div class="bg-white rounded-lg shadow mb-5">
        <div class="border-b px-6 py-3">
            <h3 class="text-xl font-bold">About</h3>
        </div>
        <div class="px-6 py-4">
            <p>
                <%= profile.about
                    || "Experienced legal professional with a passion for helping clients navigate complex legal matters. Specializing in corporate law and contract negotiations."
                    %>
            </p>
        </div>
    </div>

    <!-- Experience Card -->
    <% if (profile.experiences && profile.experiences.length> 0) { %>
        <div class="bg-white rounded-lg shadow mb-5">
            <div class="border-b px-6 py-3 flex justify-between items-center">
                <h3 class="text-xl font-bold">Experience</h3>
                <% if (locals.loggedInUserId && locals.loggedInUserId===profile.id) { %>
                    <button class="px-3 py-1 border border-gray-400 text-gray-600 rounded">
                        <i class="fas fa-plus"></i>
                    </button>
                    <% } %>
            </div>
            <div class="px-6 py-4 space-y-4">
                <% profile.experiences.forEach(exp=> { %>
                    <div class="flex space-x-4">
                        <div>
                            <img src="<%= exp.companyLogo || 'https://via.placeholder.com/60' %>" alt="Company Logo"
                                class="rounded" style="width: 60px; height: 60px; object-fit: cover;">
                        </div>
                        <div>
                            <h4 class="font-bold">
                                <%= exp.title %>
                            </h4>
                            <p class="text-gray-600">
                                <%= exp.company %>
                            </p>
                            <p class="text-gray-500 text-sm">
                                <%= exp.startDate %> - <%= exp.endDate || 'Present' %> · <%= exp.duration %>
                            </p>
                            <p class="text-gray-700">
                                <%= exp.description %>
                            </p>
                        </div>
                    </div>
                    <% }); %>
            </div>
        </div>
        <% } %>

            <!-- Education Card (for lawyers) -->
            <% if (profile.role==='lawyer' && profile.lawyer && profile.lawyer.educations &&
                profile.lawyer.educations.length> 0) { %>
                <div class="bg-white rounded-lg shadow mb-5">
                    <div class="border-b px-6 py-3 flex justify-between items-center">
                        <h3 class="text-xl font-bold">Education</h3>
                        <% if (locals.loggedInUserId && locals.loggedInUserId===profile.id) { %>
                            <button class="px-3 py-1 border border-gray-400 text-gray-600 rounded">
                                <i class="fas fa-plus"></i>
                            </button>
                            <% } %>
                    </div>
                    <div class="px-6 py-4 space-y-4">
                        <% profile.lawyer.educations.forEach(education=> { %>
                            <div class="flex space-x-4">
                                <div>
                                    <img src="<%= education.universityLogo || 'https://via.placeholder.com/60' %>"
                                        alt="University Logo" class="rounded"
                                        style="width: 60px; height: 60px; object-fit: cover;">
                                </div>
                                <div>
                                    <h4 class="font-bold">
                                        <%= education.university %>
                                    </h4>
                                    <p class="text-gray-600">
                                        <%= education.degree %> • <%= education.department %>
                                    </p>
                                    <p class="text-gray-500 text-sm">
                                        <%= education.college %>
                                    </p>
                                </div>
                            </div>
                            <% }); %>
                    </div>
                </div>
                <% } %>

                    <!-- Skills Card -->
                    <% if (profile.skills && profile.skills.length> 0) { %>
                        <div class="bg-white rounded-lg shadow mb-5">
                            <div class="border-b px-6 py-3 flex justify-between items-center">
                                <h3 class="text-xl font-bold">Skills</h3>
                                <% if (locals.loggedInUserId && locals.loggedInUserId===profile.id) { %>
                                    <button class="px-3 py-1 border border-gray-400 text-gray-600 rounded">
                                        <i class="fas fa-plus"></i>
                                    </button>
                                    <% } %>
                            </div>
                            <div class="px-6 py-4 space-y-4">
                                <% profile.skills.forEach(skill=> { %>
                                    <div>
                                        <h4 class="font-semibold">
                                            <%= skill.name %>
                                        </h4>
                                        <p class="text-gray-500 text-sm">Endorsed by <%= skill.endorsements %>
                                                colleagues</p>
                                    </div>
                                    <% }); %>
                            </div>
                        </div>
                        <% } %>

                            <!-- Logout Button (only for profile owner) -->
                            <% if (locals.loggedInUserId && locals.loggedInUserId===profile.id) { %>
                                <div class="mt-4 text-center">
                                    <form action="/signout" method="GET">
                                        <button type="submit"
                                            class="px-4 py-2 border border-gray-400 text-gray-600 rounded hover:bg-gray-100">Sign
                                            Out</button>
                                    </form>
                                </div>
                                <% } %>
</div>