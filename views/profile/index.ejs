<div class="max-w-4xl mx-auto px-4 py-8 mt-16">
    <!-- Enhanced Profile Header Card -->
    <div class="glass-card bg-white/90 backdrop-blur-lg rounded-2xl shadow-xl mb-6 relative border border-white/20 overflow-hidden">
        <!-- Enhanced Background Gradient -->
        <div class="h-52 bg-gradient-to-br from-blue-600 via-indigo-600 to-purple-600 rounded-t-2xl relative">
            <div class="absolute inset-0 bg-gradient-to-r from-black/10 to-transparent"></div>
            <div class="absolute top-4 right-4 flex space-x-2">
                <div class="w-3 h-3 bg-white/30 rounded-full animate-pulse"></div>
                <div class="w-3 h-3 bg-white/20 rounded-full animate-pulse" style="animation-delay: 0.5s;"></div>
                <div class="w-3 h-3 bg-white/25 rounded-full animate-pulse" style="animation-delay: 1s;"></div>
            </div>
        </div>
        <!-- Enhanced Profile Photo & Action Buttons -->
        <div class="absolute top-0 left-0 right-0 flex justify-between items-start px-6 pt-6">
            <div class="mt-28">
                <% if (profile.ProfileImage && profile.ProfileImage.imagePath) { %>
                    <img src="<%= profile.ProfileImage.imagePath %>" alt="Profile"
                        class="w-36 h-36 rounded-full border-4 border-white/90 object-cover shadow-xl ring-4 ring-white/50 backdrop-blur-sm">
                <% } else { %>
                    <img src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(profile.firstName + ' ' + profile.lastName) %>&size=160&background=3b82f6&color=ffffff" alt="Profile"
                        class="w-36 h-36 rounded-full border-4 border-white/90 object-cover shadow-xl ring-4 ring-white/50 backdrop-blur-sm">
                <% } %>
            </div>
            <div class="mt-8">
                <% if (loggedInUserId) { %>
                        <div class="flex space-x-3">
                            <% if (!connectionStatus) { %>
                                <button type="button" id="connectBtn" data-user-id="<%= profile.id %>" data-action="connect"
                                    class="glass-button bg-blue-600/90 backdrop-blur-sm text-white px-6 py-3 rounded-xl font-semibold shadow-lg hover:bg-blue-700/90 transition-all duration-300 transform hover:-translate-y-1 border border-white/20">Connect</button>
                                <% } else if (connectionStatus==='pending' ) { %>
                                    <button type="button" id="connectBtn" data-user-id="<%= profile.id %>" data-action="cancel"
                                        class="glass-button bg-gray-400/90 backdrop-blur-sm text-white px-6 py-3 rounded-xl font-semibold shadow-lg hover:bg-red-500/90 transition-all duration-300 transform hover:-translate-y-1 border border-white/20">Cancel</button>
                                    <% } else if (connectionStatus==='accepted' ) { %>
                                        <button type="button" id="connectBtn"
                                            class="glass-button bg-green-600/90 backdrop-blur-sm text-white px-6 py-3 rounded-xl font-semibold shadow-lg border border-white/20">Connected</button>
                                        <% } %>
                                            <a href="/messaging/<%= profile.id %>"
                                                class="glass-button bg-white/90 backdrop-blur-sm border-2 border-blue-600/50 text-blue-600 px-6 py-3 rounded-xl font-semibold text-center shadow-lg hover:bg-blue-50/90 transition-all duration-300 transform hover:-translate-y-1">Message</a>
                        </div>
                        <% } %>
            </div>
        </div>
        <!-- Profile Info -->
        <div class="mt-20 px-6 pb-6">
            <div>
                <% if (profile?.role === 'lawyer') { %>
                    <% 
                      let authorityColor = 'blue';
                      let authorityBadge = 'Training';
                      let authorityIcon = 'fas fa-graduation-cap';
                      
                      if (profile?.lawyer?.badgeIssuingAuthority === 'approved') {
                        authorityColor = 'green';
                        authorityBadge = 'Approved';
                        authorityIcon = 'fas fa-shield-alt';
                      } else if (profile?.lawyer?.badgeIssuingAuthority === 'consultant') {
                        authorityColor = 'purple';
                        authorityBadge = 'Consultant';
                        authorityIcon = 'fas fa-crown';
                      }
                    %>
                    <div class="flex items-center flex-wrap gap-3 mb-2">
                        <h2 class="text-2xl font-bold">
                            <%= profile.firstName %> <%= profile.lastName %>
                        </h2>
                        <div class="flex items-center bg-<%= authorityColor %>-100 text-<%= authorityColor %>-800 px-3 py-1 rounded-full border-2 border-<%= authorityColor %>-200">
                            <i class="<%= authorityIcon %> text-sm mr-2"></i>
                            <span class="text-sm font-bold"><%= authorityBadge %></span>
                        </div>
                    </div>
                    <p class="text-<%= authorityColor %>-600">
                        <%= profile.role.charAt(0).toUpperCase() + profile.role.slice(1) %> • <%= authorityBadge %> Level at LegalNet
                    </p>
                <% } else { %>
                    <h2 class="text-2xl font-bold">
                        <%= profile.firstName %> <%= profile.lastName %>
                    </h2>
                    <p class="text-gray-600">
                        <%= profile.role.charAt(0).toUpperCase() + profile.role.slice(1) %> at LegalNet
                    </p>
                <% } %>
                <p class="text-gray-500 text-sm">New York, United States</p>
            </div>
            <div class="flex mt-3 space-x-4">
                <a href="#" class="text-blue-600 hover:underline text-sm">
                    <%= connectionsCount || 0 %> connections
                </a>
                <a href="#" class="text-blue-600 hover:underline text-sm">Contact info</a>
            </div>
        </div>
    </div>

    <!-- About Card (Lawyers Only) -->
    <% if (profile?.role === 'lawyer') { %>
        <% 
          let authorityColor = 'blue';
          let authorityBadge = 'Training';
          let ribbonGradient = 'from-blue-400 to-blue-600';
          
          if (profile?.lawyer?.badgeIssuingAuthority === 'approved') {
            authorityColor = 'green';
            authorityBadge = 'Approved';
            ribbonGradient = 'from-green-400 to-green-600';
          } else if (profile?.lawyer?.badgeIssuingAuthority === 'consultant') {
            authorityColor = 'purple';
            authorityBadge = 'Consultant';
            ribbonGradient = 'from-purple-400 to-purple-600';
          }
        %>
        <div class="bg-white rounded-lg shadow mb-5 relative overflow-hidden">
            <!-- Authority Ribbon -->
            <div class="absolute top-0 right-0 bg-gradient-to-r <%= ribbonGradient %> text-white px-4 py-2 transform rotate-12 translate-x-4 -translate-y-2 shadow-lg">
                <span class="text-sm font-bold"><%= authorityBadge %></span>
            </div>
            
            <div class="border-b px-6 py-3">
                <div class="flex items-center justify-between">
                    <h3 class="text-xl font-bold">Professional Summary</h3>
                    <span class="bg-<%= authorityColor %>-100 text-<%= authorityColor %>-800 px-3 py-1 rounded-full text-sm font-semibold">
                        <%= authorityBadge %> Level
                    </span>
                </div>
            </div>
            <div class="px-6 py-4">
                <div class="border-l-4 border-<%= authorityColor %>-500 pl-4">
                    <p>
                        <%= profile?.lawyer?.summary || 'Experienced legal professional with a passion for helping clients navigate complex legal matters.' %>
                    </p>
                </div>
            </div>
        </div>
    <% } %>

    <!-- Experience Card -->
    <% if (profile.experiences && profile.experiences.length> 0) { %>
        <div class="bg-white rounded-lg shadow mb-5">
            <div class="border-b px-6 py-3 flex justify-between items-center">
                <h3 class="text-xl font-bold">Experience</h3>
                <% if (loggedInUserId && loggedInUserId===profile.id) { %>
                    <button class="px-3 py-1 border border-gray-400 text-gray-600 rounded">
                        <i class="fas fa-plus"></i>
                    </button>
                    <% } %>
            </div>
            <div class="px-6 py-4 space-y-4">
                <% profile.experiences.forEach(exp=> { %>
                    <div class="flex space-x-4">
                        <div>
                            <img src="<%= exp.companyLogo || 'https://via.placeholder.com/60' %>" alt="Company Logo"
                                class="rounded" style="width: 60px; height: 60px; object-fit: cover;">
                        </div>
                        <div>
                            <h4 class="font-bold">
                                <%= exp.title %>
                            </h4>
                            <p class="text-gray-600">
                                <%= exp.company %>
                            </p>
                            <p class="text-gray-500 text-sm">
                                <%= exp.startDate %> - <%= exp.endDate || 'Present' %> · <%= exp.duration %>
                            </p>
                            <p class="text-gray-700">
                                <%= exp.description %>
                            </p>
                        </div>
                    </div>
                    <% }); %>
            </div>
        </div>
        <% } %>

            <!-- Education Card (for lawyers) -->
            <% if (profile.role==='lawyer' && profile.lawyer && profile.lawyer.educations &&
                profile.lawyer.educations.length> 0) { %>
                <div class="bg-white rounded-lg shadow mb-5">
                    <div class="border-b px-6 py-3 flex justify-between items-center">
                        <h3 class="text-xl font-bold">Education</h3>
                        <% if (loggedInUserId && loggedInUserId===profile.id) { %>
                            <button class="px-3 py-1 border border-gray-400 text-gray-600 rounded">
                                <i class="fas fa-plus"></i>
                            </button>
                            <% } %>
                    </div>
                    <div class="px-6 py-4 space-y-4">
                        <% profile.lawyer.educations.forEach(education=> { %>
                            <div class="flex space-x-4">
                                <div>
                                    <img src="<%= education.universityLogo || 'https://via.placeholder.com/60' %>"
                                        alt="University Logo" class="rounded"
                                        style="width: 60px; height: 60px; object-fit: cover;">
                                </div>
                                <div>
                                    <h4 class="font-bold">
                                        <%= education.degree %>
                                    </h4>
                                    <p class="text-gray-600">
                                        <%= education.university %>
                                    </p>
                                    <p class="text-gray-500 text-sm">
                                        <%= education.startYear %> - <%= education.endYear || 'Present' %>
                                    </p>
                                    <p class="text-gray-700">
                                        <%= education.college %>
                                    </p>
                                </div>
                            </div>
                            <% }); %>
                    </div>
                </div>
                <% } %>

                    <!-- Skills Card -->
                    <% if (profile.skills && profile.skills.length> 0) { %>
                        <div class="bg-white rounded-lg shadow mb-5">
                            <div class="border-b px-6 py-3 flex justify-between items-center">
                                <h3 class="text-xl font-bold">Skills</h3>
                                <% if (loggedInUserId && loggedInUserId===profile.id) { %>
                                    <button class="px-3 py-1 border border-gray-400 text-gray-600 rounded">
                                        <i class="fas fa-plus"></i>
                                    </button>
                                    <% } %>
                            </div>
                            <div class="px-6 py-4 space-y-4">
                                <% profile.skills.forEach(skill=> { %>
                                    <div>
                                        <h4 class="font-bold">
                                            <%= skill.name %>
                                        </h4>
                                        <p class="text-gray-500 text-sm">Endorsed by <%= skill.endorsements %>
                                                colleagues</p>
                                    </div>
                                    <% }); %>
                            </div>
                        </div>
                        <% } %>

                            <!-- Logout Button (only for own profile) -->
                            <% if (loggedInUserId && loggedInUserId===profile.id) { %>
                                <div class="mt-5">
                                    <form action="/auth/logout" method="POST">
                                        <button type="submit"
                                            class="w-full bg-red-600 text-white py-2 rounded-lg hover:bg-red-700">Log
                                            Out</button>
                                    </form>
                                </div>
                                <% } %>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const connectBtn = document.getElementById('connectBtn');
        
        if (connectBtn) {
            connectBtn.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                
                const userId = this.getAttribute('data-user-id');
                const action = this.getAttribute('data-action');
                
                if (action === 'connect') {
                    connectWithUser(userId);
                } else if (action === 'cancel') {
                    cancelConnectionRequest(userId);
                }
            });
        }
    });

    function connectWithUser(userId) {
        const connectBtn = document.getElementById('connectBtn');
        
        // Disable button to prevent multiple clicks
        connectBtn.disabled = true;
        connectBtn.textContent = 'Connecting...';
        
        fetch(`/mynetwork/connect/${userId}`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            }
        })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    notifications.success('Connection request sent successfully!');
                    // Update button to show pending state
                    connectBtn.textContent = 'Cancel';
                    connectBtn.className = 'bg-gray-400 text-white px-4 py-2 rounded-full hover:bg-red-500 transition-colors';
                    connectBtn.setAttribute('data-action', 'cancel');
                    connectBtn.disabled = false;
                } else {
                    notifications.error(data.error || 'Failed to send connection request');
                    // Restore original button state
                    connectBtn.textContent = 'Connect';
                    connectBtn.disabled = false;
                }
            })
            .catch(error => {
                console.error('Error:', error);
                notifications.error('An error occurred while sending the connection request');
                // Restore original button state
                connectBtn.textContent = 'Connect';
                connectBtn.disabled = false;
            });
    }

    function cancelConnectionRequest(userId) {
        const connectBtn = document.getElementById('connectBtn');
        
        // Disable button to prevent multiple clicks
        connectBtn.disabled = true;
        connectBtn.textContent = 'Cancelling...';
        
        // Find the connection ID first
        fetch(`/mynetwork/connection-status/${userId}`)
            .then(response => response.json())
            .then(statusData => {
                if (statusData.connectionId) {
                    return fetch(`/mynetwork/cancel/${statusData.connectionId}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        }
                    });
                } else {
                    throw new Error('Connection not found');
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    notifications.success('Connection request cancelled successfully!');
                    // Update button back to connect state
                    connectBtn.textContent = 'Connect';
                    connectBtn.className = 'bg-blue-600 text-white px-4 py-2 rounded-full';
                    connectBtn.setAttribute('data-action', 'connect');
                    connectBtn.disabled = false;
                } else {
                    notifications.error(data.error || 'Failed to cancel connection request');
                    // Restore cancel button state
                    connectBtn.textContent = 'Cancel';
                    connectBtn.disabled = false;
                }
            })
            .catch(error => {
                console.error('Error:', error);
                notifications.error('An error occurred while cancelling the connection request');
                // Restore cancel button state
                connectBtn.textContent = 'Cancel';
                connectBtn.disabled = false;
            });
    }
</script>