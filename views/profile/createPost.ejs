<%- include('../layouts/header') %>
<div class="row">
    <% if (locals.userRole !== 'lawyer') { %>
        <div class="col-md-8 mx-auto">
            <div class="card">
                <div class="card-header">
                    <h2>Access Denied</h2>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <h4>Lawyers Only</h4>
                        <p>Only verified lawyers can create posts. If you're a lawyer, please ensure your account is properly verified.</p>
                        <a href="/feed" class="btn btn-primary">Return to Feed</a>
                    </div>
                </div>
            </div>
        </div>
    <% } else { %>
    <div class="col-md-8 mx-auto">
        <div class="card">
            <div class="card-header">
                <div class="d-flex justify-content-between align-items-center">
                    <h2>Share Legal Insights</h2>
                    <a href="/feed" class="glass-button bg-gray-600/90 backdrop-blur-sm text-white p-3 rounded-xl shadow-lg hover:bg-gray-700/90 transition-all duration-300 transform hover:-translate-y-1 border border-white/20" title="Back to Feed">
                        <i class="fas fa-arrow-left"></i>
                    </a>
                </div>
            </div>
            <div class="card-body">
                <% if (typeof error !=='undefined' ) { %>
                    <div class="alert alert-danger">
                        <%= error %>
                    </div>
                    <% } %>

                        <form action="/blog/create" method="POST">
                            <div class="mb-3">
                                <label for="title" class="form-label">Title</label>
                                <input type="text" class="form-control" id="title" name="title"
                                    placeholder="What's an engaging title for your post?" required>
                            </div>

                            <div class="mb-3">
                                <label for="content" class="form-label">Content</label>
                                <textarea class="form-control" id="content" name="content" rows="10"
                                    placeholder="Share your thoughts, insights, or questions..." required></textarea>
                            </div>

                            <div class="mb-3">
                                <label for="image" class="form-label">Image URL (optional)</label>
                                <input type="text" class="form-control" id="image" name="image"
                                    placeholder="https://example.com/image.jpg">
                                <div class="form-text">Add an image URL to include a visual with your post</div>
                            </div>

                            <div class="d-flex justify-content-between">
                                <button type="submit" class="btn btn-primary">Post</button>
                                <a href="/blog" class="btn btn-outline-secondary">Cancel</a>
                            </div>
                        </form>
            </div>
        </div>
    </div>
    <% } %>
</div>