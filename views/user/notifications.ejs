<div class="row">
    <div class="col-md-8 mx-auto">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Notifications</h5>
                <% if (unreadCount> 0) { %>
                    <form action="/user/<%= locals.loggedInUserId %>/notifications/read-all" method="POST">
                        <button type="submit" class="btn btn-sm btn-outline-primary">Mark all as read</button>
                    </form>
                    <% } %>
            </div>
            <div class="card-body p-0">
                <% if (notifications.length> 0) { %>
                    <% notifications.forEach(notification=> { %>
                        <div class="notification-item <%= !notification.isRead ? 'unread' : '' %>">
                            <div class="notification-icon">
                                <% if (notification.type==='connection_request' ) { %>
                                    <i class="fas fa-user-plus"></i>
                                    <% } else if (notification.type==='connection_accepted' ) { %>
                                        <i class="fas fa-handshake"></i>
                                        <% } else if (notification.type==='message' ) { %>
                                            <i class="fas fa-envelope"></i>
                                            <% } else if (notification.type==='blog_comment' ) { %>
                                                <i class="fas fa-comment"></i>
                                                <% } else if (notification.type==='blog_like' ) { %>
                                                    <i class="fas fa-thumbs-up"></i>
                                                    <% } %>
                            </div>
                            <div class="notification-content">
                                <p class="mb-1">
                                    <%= notification.content %>
                                </p>
                                <p class="notification-time mb-0">
                                    <%= new Date(notification.createdAt).toLocaleString() %>
                                </p>
                            </div>
                            <% if (!notification.isRead) { %>
                                <form
                                    action="/user/<%= locals.loggedInUserId %>/notifications/read/<%= notification.id %>"
                                    method="POST">
                                    <button type="submit" class="btn btn-sm btn-link text-primary">Mark as read</button>
                                </form>
                                <% } %>
                        </div>
                        <% }); %>
                            <% } else { %>
                                <div class="p-4 text-center">
                                    <p>No notifications yet.</p>
                                </div>
                                <% } %>
            </div>
        </div>
    </div>
</div>