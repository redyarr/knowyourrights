<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="text-center mb-4">
                <h1 class="h3 mb-3 fw-bold text-primary">
                    <i class="fab fa-linkedin me-2"></i> Join LegalNet
                </h1>
                <p class="text-muted">Connect with legal professionals and opportunities</p>
            </div>

            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <% if (typeof error !=='undefined' ) { %>
                        <div class="alert alert-danger">
                            <%= error %>
                        </div>
                        <% } %>

                            <ul class="nav nav-pills mb-4 justify-content-center" id="userTypeTab" role="tablist">
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link active" id="visitor-tab" data-bs-toggle="pill"
                                        data-bs-target="#visitor-content" type="button" role="tab"
                                        aria-controls="visitor-content" aria-selected="true">
                                        <i class="fas fa-user me-1"></i> Regular User
                                    </button>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link" id="lawyer-tab" data-bs-toggle="pill"
                                        data-bs-target="#lawyer-content" type="button" role="tab"
                                        aria-controls="lawyer-content" aria-selected="false">
                                        <i class="fas fa-gavel me-1"></i> Legal Professional
                                    </button>
                                </li>
                            </ul>

                            <div class="tab-content" id="userTypeTabContent">
                                <!-- Regular User Registration -->
                                <div class="tab-pane fade show active" id="visitor-content" role="tabpanel"
                                    aria-labelledby="visitor-tab">
                                    <form action="/user/create" method="POST">
                                        <input type="hidden" name="userType" value="visitor">

                                        <div class="mb-3">
                                            <label for="name" class="form-label">Full Name</label>
                                            <input type="text" class="form-control" id="name" name="name" required>
                                        </div>

                                        <div class="mb-3">
                                            <label for="email" class="form-label">Email</label>
                                            <input type="email" class="form-control" id="email" name="email" required>
                                        </div>

                                        <div class="mb-3">
                                            <label for="password" class="form-label">Password (6+ characters)</label>
                                            <input type="password" class="form-control" id="password" name="password"
                                                minlength="6" required>
                                        </div>

                                        <div class="d-grid mb-3">
                                            <button type="submit" class="btn btn-primary btn-lg">Join Now</button>
                                        </div>

                                        <div class="text-center mb-3">
                                            <span>or</span>
                                        </div>

                                        <div class="d-grid mb-3">
                                            <a href="#" class="btn btn-outline-secondary btn-lg">
                                                <img src="https://upload.wikimedia.org/wikipedia/commons/5/53/Google_%22G%22_Logo.svg"
                                                    alt="Google" style="height: 18px;" class="me-2">
                                                Join with Google
                                            </a>
                                        </div>
                                    </form>
                                </div>

                                <!-- Lawyer Registration -->
                                <div class="tab-pane fade" id="lawyer-content" role="tabpanel"
                                    aria-labelledby="lawyer-tab">
                                    <form action="/user/create-lawyer" method="POST">
                                        <input type="hidden" name="userType" value="lawyer">

                                        <div class="mb-3">
                                            <label for="lawyer-name" class="form-label">Full Name</label>
                                            <input type="text" class="form-control" id="lawyer-name" name="name"
                                                required>
                                        </div>

                                        <div class="mb-3">
                                            <label for="lawyer-email" class="form-label">Email</label>
                                            <input type="email" class="form-control" id="lawyer-email" name="email"
                                                required>
                                        </div>

                                        <div class="mb-3">
                                            <label for="lawyer-password" class="form-label">Password (6+
                                                characters)</label>
                                            <input type="password" class="form-control" id="lawyer-password"
                                                name="password" minlength="6" required>
                                        </div>

                                        <div class="mb-3">
                                            <label for="lawFirm" class="form-label">Law Firm</label>
                                            <input type="text" class="form-control" id="lawFirm" name="lawFirm"
                                                required>
                                        </div>

                                        <div class="mb-3">
                                            <label for="licenseNumber" class="form-label">License Number</label>
                                            <input type="text" class="form-control" id="licenseNumber"
                                                name="licenseNumber" required>
                                        </div>

                                        <div class="row mb-3">
                                            <div class="col-md-6">
                                                <label for="city" class="form-label">City</label>
                                                <input type="text" class="form-control" id="city" name="city" required>
                                            </div>
                                            <div class="col-md-6">
                                                <label for="country" class="form-label">Country</label>
                                                <input type="text" class="form-control" id="country" name="country"
                                                    required>
                                            </div>
                                        </div>

                                        <div class="mb-3">
                                            <label for="contactNumber" class="form-label">Contact Number</label>
                                            <input type="text" class="form-control" id="contactNumber"
                                                name="contactNumber" required>
                                        </div>

                                        <div class="d-grid mb-3">
                                            <button type="submit" class="btn btn-primary btn-lg">Join as Legal
                                                Professional</button>
                                        </div>

                                        <div class="text-center mb-3">
                                            <span>or</span>
                                        </div>

                                        <div class="d-grid mb-3">
                                            <a href="#" class="btn btn-outline-secondary btn-lg">
                                                <img src="https://upload.wikimedia.org/wikipedia/commons/5/53/Google_%22G%22_Logo.svg"
                                                    alt="Google" style="height: 18px;" class="me-2">
                                                Join with Google
                                            </a>
                                        </div>
                                    </form>
                                </div>
                            </div>

                            <div class="text-center mt-3">
                                <p>Already on LegalNet? <a href="/user/login" class="text-decoration-none fw-bold">Sign
                                        in</a></p>
                            </div>
                </div>
            </div>
        </div>
    </div>
</div>