<div class="row justify-content-center">
  <div class="col-md-6">
    <div class="card">
      <div class="card-header">
        <% if (typeof profileUser !== 'undefined' && typeof profileUser._id !== 'undefined' && typeof locals.loggedInUserId !== 'undefined' && profileUser._id.toString() !== locals.loggedInUserId.toString()) { %>
          <h2 class="text-center">
            <%= profileUser.name %>'s Profile
          </h2>
          <% } else { %>
            <h2 class="text-center">My Profile</h2>
            <% } %>
      </div>
      <div class="card-body">
        <% if (typeof profileUser !== 'undefined' && typeof profileUser._id !== 'undefined' && typeof locals.loggedInUserId !== 'undefined' && profileUser._id.toString() === locals.loggedInUserId.toString()) { %>
          <!-- User's own profile -->
          <div class="mb-3">
            <label for="name" class="form-label">Name</label>
            <input type="text" class="form-control" id="name" name="name" value="<%= profileUser.name %>" readonly>
          </div>

          <div class="mb-3">
            <label for="email" class="form-label">Email</label>
            <input type="email" class="form-control" id="email" name="email" value="<%= profileUser.email %>" readonly>
          </div>

          <div class="d-grid">
            <a href="/user/edit" class="btn btn-primary">Edit Profile</a>
          </div>
          <% } else { %>
            <!-- Visiting other user's profile -->
            <div class="mb-3">
              <label for="name" class="form-label">Name</label>
              <input type="text" class="form-control" id="name" name="name" value="<%= profileUser.name %>" readonly>
            </div>

            <div class="mb-3">
              <label for="email" class="form-label">Email</label>
              <input type="email" class="form-control" id="email" name="email" value="<%= profileUser.email %>"
                readonly>
            </div>
            <% } %>
      </div>
    </div>
  </div>
</div>