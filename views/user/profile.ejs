<link rel="stylesheet" href="/css/profile.css">



<div class="card">
    <div class="card-header">
      <h1 class="card-title">User Profile</h1>
    </div>
    <div class="card-body">
      <div class="profile-container">
        <div class="profile-header">
          <div class="profile-avatar">
            <i class="fas fa-user-circle"></i>
          </div>
          <div class="profile-info">
            <h2 class="profile-name"><%= user.name %></h2>
            <span class="role-badge <%= user.role.toLowerCase() %>"><%= user.role %></span>
          </div>
        </div>
        
        <div class="profile-details">
          <div class="detail-group">
            <div class="detail-label">
              <i class="fas fa-envelope"></i>
              <span>Email</span>
            </div>
            <div class="detail-value"><%= user.email %></div>
          </div>
          
          <% if (user.role === 'Lawyer') { %>
          <div class="lawyer-info">
            <h3><i class="fas fa-gavel"></i> Lawyer Information</h3>
            <div class="detail-group">
              <div class="detail-label">
                <i class="fas fa-briefcase"></i>
                <span>Specialization</span>
              </div>
              <div class="detail-value"><%= user.specialization || 'Corporate Law' %></div>
            </div>
            <div class="detail-group">
              <div class="detail-label">
                <i class="fas fa-building"></i>
                <span>Firm</span>
              </div>
              <div class="detail-value"><%= user.firm || 'Legal Associates LLP' %></div>
            </div>
            <div class="detail-group">
              <div class="detail-label">
                <i class="fas fa-star"></i>
                <span>Experience</span>
              </div>
              <div class="detail-value"><%= user.experience || '8 years' %></div>
            </div>
          </div>
          <% } %>
        </div>
        
        <div class="profile-actions">
          <a href="/user/users" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to Users
          </a>
          <% if (locals.loggedInUserId && locals.loggedInUserId === user.user_id) { %>
          <a href="/user/edit/<%= user.user_id %>" class="btn btn-primary">
            <i class="fas fa-edit"></i> Edit Profile
          </a>
          <% } %>
        </div>
      </div>
    </div>
  </div>