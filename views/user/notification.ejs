<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
    <header>
        <h1>Notifications</h1>
    </header>
    <main>
        <% if (profile.UserNotifications && profile.UserNotifications.length > 0) { %>
            <ul>
                <% profile.UserNotifications.forEach(notification => { %>
                    <li class="<%= notification.isRead ? 'read' : 'unread' %>">
                        <%= notification.message %>
                        <% if (!notification.isRead) { %>
                            <form action="/notifications/mark-as-read" method="POST">
                                <input type="hidden" name="notificationId" value="<%= notification.id %>">
                                <button type="submit">Mark as read</button>
                            </form>
                        <% } %>
                    </li>
                <% }) %>
            </ul>
        <% } else { %>
            <p>No notifications found.</p>
        <% } %>
    </main>
    <footer>
        <p>&copy; 2023 Legal Network</p>
    </footer>
</body>
</html>