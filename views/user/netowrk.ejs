<div class="row">
    <div class="col-md-3">
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Manage My Network</h5>
            </div>
            <div class="list-group list-group-flush">
                <a href="#connections"
                    class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                    Connections
                    <span class="badge bg-primary rounded-pill">
                        <%= connections.length %>
                    </span>
                </a>
                <a href="#pending"
                    class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                    Pending Invitations
                    <span class="badge bg-primary rounded-pill">
                        <%= pendingRequests.length %>
                    </span>
                </a>
                <a href="#sent"
                    class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                    Sent Invitations
                    <span class="badge bg-primary rounded-pill">
                        <%= sentPendingRequests.length %>
                    </span>
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-9">
        <!-- Connections Section -->
        <div class="card mb-4" id="connections">
            <div class="card-header">
                <h5 class="mb-0">Your Connections (<%= connections.length %>)</h5>
            </div>
            <div class="card-body p-0">
                <% if (connections.length> 0) { %>
                    <% connections.forEach(connection=> { %>
                        <% const connectionUser=connection.requesterId===userId ? connection.Receiver :
                            connection.Requester; %>
                            <div class="connection-card">
                                <img src="https://via.placeholder.com/150" alt="Profile" class="connection-photo">
                                <div class="connection-info">
                                    <h5 class="mb-1">
                                        <%= connectionUser.name %>
                                    </h5>
                                    <p class="text-muted mb-2">
                                        <%= connectionUser.role.charAt(0).toUpperCase() + connectionUser.role.slice(1)
                                            %>
                                    </p>
                                    <div class="d-flex">
                                        <a href="/user/<%= connectionUser.id %>"
                                            class="btn btn-sm btn-outline-primary me-2">View Profile</a>
                                        <a href="/user/<%= userId %>/messages/<%= connectionUser.id %>"
                                            class="btn btn-sm btn-outline-primary me-2">Message</a>
                                        <form action="/user/network/remove/<%= connection.id %>" method="POST">
                                            <button type="submit" class="btn btn-sm btn-outline-danger"
                                                onclick="return confirm('Are you sure you want to remove this connection?')">Remove
                                                Connection</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                            <% }); %>
                                <% } else { %>
                                    <div class="p-4 text-center">
                                        <p class="mb-3">You don't have any connections yet.</p>
                                        <p>Connect with other professionals to grow your network.</p>
                                    </div>
                                    <% } %>
            </div>
        </div>

        <!-- Pending Invitations Section -->
        <div class="card mb-4" id="pending">
            <div class="card-header">
                <h5 class="mb-0">Pending Invitations (<%= pendingRequests.length %>)</h5>
            </div>
            <div class="card-body p-0">
                <% if (pendingRequests.length> 0) { %>
                    <% pendingRequests.forEach(request=> { %>
                        <div class="connection-card">
                            <img src="https://via.placeholder.com/150" alt="Profile" class="connection-photo">
                            <div class="connection-info">
                                <h5 class="mb-1">
                                    <%= request.Requester.name %>
                                </h5>
                                <p class="text-muted mb-2">
                                    <%= request.Requester.role.charAt(0).toUpperCase() + request.Requester.role.slice(1)
                                        %>
                                </p>
                                <div class="d-flex">
                                    <form action="/user/network/accept/<%= request.id %>" method="POST" class="me-2">
                                        <button type="submit" class="btn btn-sm btn-primary">Accept</button>
                                    </form>
                                    <form action="/user/network/reject/<%= request.id %>" method="POST">
                                        <button type="submit" class="btn btn-sm btn-outline-secondary">Ignore</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                        <% }); %>
                            <% } else { %>
                                <div class="p-4 text-center">
                                    <p>You don't have any pending invitations.</p>
                                </div>
                                <% } %>
            </div>
        </div>

        <!-- Sent Invitations Section -->
        <div class="card mb-4" id="sent">
            <div class="card-header">
                <h5 class="mb-0">Sent Invitations (<%= sentPendingRequests.length %>)</h5>
            </div>
            <div class="card-body p-0">
                <% if (sentPendingRequests.length> 0) { %>
                    <% sentPendingRequests.forEach(request=> { %>
                        <div class="connection-card">
                            <img src="https://via.placeholder.com/150" alt="Profile" class="connection-photo">
                            <div class="connection-info">
                                <h5 class="mb-1">
                                    <%= request.Receiver.name %>
                                </h5>
                                <p class="text-muted mb-2">
                                    <%= request.Receiver.role.charAt(0).toUpperCase() + request.Receiver.role.slice(1)
                                        %>
                                </p>
                                <p class="text-muted small">Invitation sent</p>
                            </div>
                        </div>
                        <% }); %>
                            <% } else { %>
                                <div class="p-4 text-center">
                                    <p>You haven't sent any invitations.</p>
                                </div>
                                <% } %>
            </div>
        </div>

        <!-- People You May Know Section -->
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">People You May Know</h5>
            </div>
            <div class="card-body p-0">
                <% if (suggestedConnections.length> 0) { %>
                    <% suggestedConnections.forEach(user=> { %>
                        <div class="connection-card">
                            <img src="https://via.placeholder.com/150" alt="Profile" class="connection-photo">
                            <div class="connection-info">
                                <h5 class="mb-1">
                                    <%= user.name %>
                                </h5>
                                <p class="text-muted mb-2">
                                    <%= user.role.charAt(0).toUpperCase() + user.role.slice(1) %>
                                </p>
                                <div class="d-flex">
                                    <form action="/user/network/connect/<%= user.id %>" method="POST" class="me-2">
                                        <button type="submit" class="btn btn-sm btn-primary">Connect</button>
                                    </form>
                                    <a href="/user/<%= user.id %>" class="btn btn-sm btn-outline-secondary">View
                                        Profile</a>
                                </div>
                            </div>
                        </div>
                        <% }); %>
                            <% } else { %>
                                <div class="p-4 text-center">
                                    <p>No suggested connections at this time.</p>
                                </div>
                                <% } %>
            </div>
        </div>
    </div>
</div>