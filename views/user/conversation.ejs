<div class="row">
    <div class="col-md-12">
        <div class="messages-container">
            <div class="messages-sidebar">
                <div class="p-3 border-bottom">
                    <h5 class="mb-0">Messages</h5>
                </div>

                <% if (conversations.length> 0) { %>
                    <% conversations.forEach(conv=> { %>
                        <a href="/user/<%= userId %>/messages/<%= conv.user.id %>"
                            class="text-decoration-none text-dark">
                            <div
                                class="d-flex p-3 border-bottom <%= conv.unreadCount > 0 ? 'bg-light' : '' %> <%= activeConversation == conv.user.id ? 'bg-primary bg-opacity-10' : '' %>">
                                <img src="https://via.placeholder.com/150" alt="Profile" class="rounded-circle me-3"
                                    style="width: 48px; height: 48px; object-fit: cover;">
                                <div class="flex-grow-1">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <h6 class="mb-0">
                                            <%= conv.user.name %>
                                        </h6>
                                        <small class="text-muted">
                                            <%= new Date(conv.lastMessage.createdAt).toLocaleDateString() %>
                                        </small>
                                    </div>
                                    <p
                                        class="text-truncate mb-0 small <%= conv.unreadCount > 0 ? 'fw-bold' : 'text-muted' %>">
                                        <%= conv.lastMessage.content %>
                                    </p>
                                </div>
                                <% if (conv.unreadCount> 0) { %>
                                    <span class="badge bg-primary rounded-pill ms-2">
                                        <%= conv.unreadCount %>
                                    </span>
                                    <% } %>
                            </div>
                        </a>
                        <% }); %>
                            <% } else { %>
                                <div class="p-4 text-center">
                                    <p>No messages yet.</p>
                                    <p>Connect with other professionals to start messaging.</p>
                                </div>
                                <% } %>
            </div>

            <div class="messages-content">
                <div class="message-header d-flex align-items-center">
                    <img src="https://via.placeholder.com/150" alt="Profile" class="rounded-circle me-3"
                        style="width: 40px; height: 40px; object-fit: cover;">
                    <div>
                        <h6 class="mb-0">
                            <%= conversationPartner.name %>
                        </h6>
                        <small class="text-muted">Online</small>
                    </div>
                </div>

                <div class="message-list">
                    <% if (messages.length> 0) { %>
                        <% messages.forEach(message=> { %>
                            <div
                                class="message-item d-flex flex-column <%= message.senderId === userId ? 'align-items-end' : 'align-items-start' %>">
                                <div
                                    class="message-bubble <%= message.senderId === userId ? 'message-sent' : 'message-received' %>">
                                    <%= message.content %>
                                </div>
                                <small class="text-muted mt-1">
                                    <%= new Date(message.createdAt).toLocaleTimeString([], {hour: '2-digit' ,
                                        minute:'2-digit'}) %>
                                </small>
                            </div>
                            <% }); %>
                                <% } else { %>
                                    <div class="text-center my-5">
                                        <p class="text-muted">No messages yet. Start the conversation!</p>
                                    </div>
                                    <% } %>
                </div>

                <div class="message-composer">
                    <form action="/user/<%= userId %>/messages/send" method="POST">
                        <input type="hidden" name="receiverId" value="<%= conversationPartner.id %>">
                        <div class="input-group">
                            <input type="text" name="content" class="form-control" placeholder="Type a message..."
                                required>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-paper-plane"></i>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>