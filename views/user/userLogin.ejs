<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-5">
      <div class="text-center mb-4">
        <h1 class="h3 mb-3 fw-bold text-primary">
          <i class="fab fa-linkedin me-2"></i> Sign in to LegalNet
        </h1>
        <p class="text-muted">Stay updated on your professional network</p>
      </div>

      <div class="card shadow-sm">
        <div class="card-body p-4">
          <% if (typeof error !=='undefined' ) { %>
            <div class="alert alert-danger">
              <%= error %>
            </div>
            <% } %>

              <ul class="nav nav-pills mb-4 justify-content-center" id="userTypeTab" role="tablist">
                <li class="nav-item" role="presentation">
                  <button class="nav-link active" id="regular-tab" data-bs-toggle="pill"
                    data-bs-target="#regular-content" type="button" role="tab" aria-controls="regular-content"
                    aria-selected="true">
                    <i class="fas fa-user me-1"></i> Regular User
                  </button>
                </li>
                <li class="nav-item" role="presentation">
                  <button class="nav-link" id="legal-tab" data-bs-toggle="pill" data-bs-target="#legal-content"
                    type="button" role="tab" aria-controls="legal-content" aria-selected="false">
                    <i class="fas fa-gavel me-1"></i> Legal Professional
                  </button>
                </li>
              </ul>

              <div class="tab-content" id="userTypeTabContent">
                <!-- Regular User Login -->
                <div class="tab-pane fade show active" id="regular-content" role="tabpanel"
                  aria-labelledby="regular-tab">
                  <form action="/user/login" method="POST">
                    <input type="hidden" name="userType" value="visitor">

                    <div class="mb-3">
                      <label for="email" class="form-label">Email</label>
                      <input type="email" class="form-control" id="email" name="email" required>
                    </div>

                    <div class="mb-3">
                      <label for="password" class="form-label">Password</label>
                      <input type="password" class="form-control" id="password" name="password" required>
                    </div>

                    <div class="mb-3 form-check">
                      <input type="checkbox" class="form-check-input" id="rememberMe" name="rememberMe">
                      <label class="form-check-label" for="rememberMe">Remember me</label>
                      <a href="#" class="float-end text-decoration-none">Forgot password?</a>
                    </div>

                    <div class="d-grid mb-3">
                      <button type="submit" class="btn btn-primary btn-lg">Sign In</button>
                    </div>

                    <div class="text-center mb-3">
                      <span>or</span>
                    </div>

                    <div class="d-grid mb-3">
                      <a href="#" class="btn btn-outline-secondary btn-lg">
                        <img src="https://upload.wikimedia.org/wikipedia/commons/5/53/Google_%22G%22_Logo.svg"
                          alt="Google" style="height: 18px;" class="me-2">
                        Sign in with Google
                      </a>
                    </div>
                  </form>
                </div>

                <!-- Legal Professional Login -->
                <div class="tab-pane fade" id="legal-content" role="tabpanel" aria-labelledby="legal-tab">
                  <form action="/user/login" method="POST">
                    <input type="hidden" name="userType" value="lawyer">

                    <div class="mb-3">
                      <label for="lawyer-email" class="form-label">Email</label>
                      <input type="email" class="form-control" id="lawyer-email" name="email" required>
                    </div>

                    <div class="mb-3">
                      <label for="lawyer-password" class="form-label">Password</label>
                      <input type="password" class="form-control" id="lawyer-password" name="password" required>
                    </div>

                    <div class="mb-3 form-check">
                      <input type="checkbox" class="form-check-input" id="lawyer-rememberMe" name="rememberMe">
                      <label class="form-check-label" for="lawyer-rememberMe">Remember me</label>
                      <a href="#" class="float-end text-decoration-none">Forgot password?</a>
                    </div>

                    <div class="d-grid mb-3">
                      <button type="submit" class="btn btn-primary btn-lg">Sign In as Legal Professional</button>
                    </div>

                    <div class="text-center mb-3">
                      <span>or</span>
                    </div>

                    <div class="d-grid mb-3">
                      <a href="#" class="btn btn-outline-secondary btn-lg">
                        <img src="https://upload.wikimedia.org/wikipedia/commons/5/53/Google_%22G%22_Logo.svg"
                          alt="Google" style="height: 18px;" class="me-2">
                        Sign in with Google
                      </a>
                    </div>
                  </form>
                </div>
              </div>

              <div class="text-center mt-3">
                <p>New to LegalNet? <a href="/user/create" class="text-decoration-none fw-bold">Join now</a></p>
              </div>
        </div>
      </div>
    </div>
  </div>
</div>