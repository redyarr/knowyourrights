<div class="max-w-4xl mx-auto px-4">
  <!-- Profile Header -->
  <div class="relative bg-white shadow-lg rounded-lg overflow-hidden">
    <div class="h-48 bg-cover bg-center" style="background-image: url('<%= profile?.backgroundImage || "https://via.placeholder.com/800x200" %>');"></div>

    <div class="absolute top-32 left-6 flex items-end">
      <img src="<%= profile.dataValues.profile_image.dataValues.imagePath || 'https://via.placeholder.com/150' %>" 
        alt="Profile" class="w-32 h-32 rounded-full border-4 border-white object-cover">
    </div>

    <div class="absolute top-6 right-6">
      <% if (locals.loggedInUserId && locals.loggedInUserId === profile?.id) { %>
        <a href="/user/<%= profile.id %>/edit"
          class="flex items-center px-4 py-2 border border-blue-600 text-blue-600 rounded-full hover:bg-blue-50 transition">
          <i class="fas fa-pencil-alt mr-1"></i> Edit Profile
        </a>
      <% } else { %>
        <button class="bg-blue-600 text-white px-4 py-2 rounded-full hover:bg-blue-700 transition">Connect</button>
      <% } %>
    </div>

    <div class="pt-20 pb-6 px-6">
      <h2 class="text-2xl font-bold"><%= profile?.firstName %> <%= profile?.lastName %></h2>
      <p class="text-gray-600"><%= profile?.role?.charAt(0).toUpperCase() + profile?.role?.slice(1) %></p>
      <p class="text-gray-500 text-sm"><%= profile?.location || "New York, United States" %></p>
      <div class="flex mt-3 space-x-4">
        <a href="#" class="text-blue-600 hover:underline text-sm"><%= profile?.connections?.length || "500+" %> connections</a>
        <a href="#" class="text-blue-600 hover:underline text-sm">Contact info</a>
      </div>
    </div>
  </div>

  <!-- About Section -->
  <div class="bg-white shadow rounded-lg mb-5">
    <div class="border-b px-6 py-3">
      <h3 class="text-xl font-bold">About</h3>
    </div>
    <div class="px-6 py-4">
      <p class="text-gray-700"><%= profile?.about || "No description available." %></p>
    </div>
  </div>

  <!-- Education Section -->
  <% if (profile?.Lawyer?.Education?.length > 0) { %>
    <div class="bg-white shadow rounded-lg mb-5">
      <div class="border-b px-6 py-3 flex justify-between items-center">
        <h3 class="text-xl font-bold">Education</h3>
      </div>
      <div class="px-6 py-4 space-y-4">
        <% profile?.Lawyer?.Education?.forEach(edu => { %>
          <div class="border p-4 rounded-lg">
            <h4 class="font-semibold text-lg"><%= edu?.institution %></h4>
            <p class="text-gray-600"><%= edu?.degree %>, <%= edu?.fieldOfStudy %></p>
            <p class="text-gray-500 text-sm"><%= edu?.startYear %> - <%= edu?.endYear || 'Present' %></p>
          </div>
        <% }); %>
      </div>
    </div>
  <% } %>

  <!-- Posts Section -->
  <% if (profile?.Posts?.length > 0) { %>
    <div class="bg-white shadow rounded-lg mb-5">
      <div class="border-b px-6 py-3">
        <h3 class="text-xl font-bold">Posts</h3>
      </div>
      <div class="px-6 py-4 space-y-4">
        <% profile?.Posts?.forEach(post => { %>
          <div class="border p-4 rounded-lg">
            <h4 class="font-semibold text-lg"><%= post?.title %></h4>
            <p class="text-gray-700"><%= post?.content %></p>
          </div>
        <% }); %>
      </div>
    </div>
  <% } %>

  <!-- Logout Button -->
  <% if (locals.loggedInUserId === profile?.id) { %>
    <div class="mt-4 text-center">
      <form action="/user/logout" method="get">
        <button type="submit" class="px-4 py-2 border border-gray-400 rounded hover:bg-gray-100">
          Sign Out
        </button>
      </form>
    </div>
  <% } %>
</div>