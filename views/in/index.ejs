<div class="max-w-4xl mx-auto px-4 py-8">
  <!-- Profile Card -->
  <div class="relative bg-gradient-to-br from-blue-50 to-blue-100 shadow-2xl rounded-3xl overflow-hidden mb-8">
    <div class="h-48 bg-cover bg-center" style="background-image: url('<%= profile?.backgroundImage || 'https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=800&q=80' %>');"></div>
    <div class="absolute top-32 left-10 flex items-end">
      <img src="<%= (profile.ProfileImage && profile.ProfileImage.imagePath) ? profile.ProfileImage.imagePath : 'https://randomuser.me/api/portraits/men/32.jpg' %>" alt="Profile" class="w-36 h-36 rounded-full border-4 border-white shadow-lg object-cover">
    </div>
    <div class="absolute top-8 right-10 flex space-x-2">
      <% if (locals.loggedInUserId && locals.loggedInUserId === profile?.id) { %>
        <a href="/user/<%= profile.id %>/edit" class="flex items-center px-5 py-2 border border-blue-600 text-blue-600 bg-white rounded-full hover:bg-blue-50 shadow transition">
          <i class="fas fa-pencil-alt mr-2"></i> Edit Profile
        </a>
      <% } else { %>
        <button class="bg-blue-600 text-white px-5 py-2 rounded-full shadow hover:bg-blue-700 transition">Connect</button>
      <% } %>
    </div>
    <div class="pt-24 pb-8 px-10">
      <h2 class="text-3xl font-extrabold text-gray-900"><%= profile?.firstName %> <%= profile?.lastName %></h2>
      <p class="text-blue-700 font-semibold text-lg mt-1"><%= profile?.role?.charAt(0).toUpperCase() + profile?.role?.slice(1) %></p>
      <p class="text-gray-500 text-md mt-1"><i class="fas fa-map-marker-alt mr-1"></i> <%= profile?.location || 'New York, United States' %></p>
      <div class="flex mt-4 space-x-6">
        <span class="flex items-center text-blue-600 font-medium"><i class="fas fa-user-friends mr-2"></i> <%= profile?.connections?.length || '500+' %> connections</span>
        <span class="flex items-center text-blue-600 font-medium"><i class="fas fa-envelope mr-2"></i> Contact info</span>
      </div>
    </div>
  </div>

  <!-- About Section -->
  <div class="bg-white rounded-2xl shadow-lg mb-8 p-8">
    <div class="flex items-center mb-4">
      <i class="fas fa-user text-blue-500 text-xl mr-3"></i>
      <h3 class="text-2xl font-bold text-gray-800">About</h3>
    </div>
    <p class="text-gray-700 text-lg"><%= profile?.about || 'No description available.' %></p>
  </div>

  <!-- Education Section -->
  <% if (profile?.lawyer?.Educations?.length > 0) { %>
    <div class="bg-white rounded-2xl shadow-lg mb-8 p-8">
      <div class="flex items-center mb-4">
        <i class="fas fa-graduation-cap text-blue-500 text-xl mr-3"></i>
        <h3 class="text-2xl font-bold text-gray-800">Education</h3>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <% profile?.lawyer?.Educations?.forEach(edu => { %>
          <div class="border border-blue-100 p-5 rounded-xl bg-blue-50">
            <h4 class="font-semibold text-lg text-blue-800"><%= edu?.institution || edu?.university || edu?.college %></h4>
            <p class="text-gray-600 mt-1"><%= edu?.degree %><% if (edu?.fieldOfStudy) { %>, <%= edu?.fieldOfStudy %><% } %></p>
            <p class="text-gray-500 text-sm mt-1"><%= edu?.startYear %> - <%= edu?.endYear || 'Present' %></p>
          </div>
        <% }); %>
      </div>
    </div>
  <% } %>

  <!-- Posts Section -->
  <% if (profile?.posts?.length > 0) { %>
    <div class="bg-white rounded-2xl shadow-lg mb-8 p-8">
      <div class="flex items-center mb-4">
        <i class="fas fa-newspaper text-blue-500 text-xl mr-3"></i>
        <h3 class="text-2xl font-bold text-gray-800">Posts</h3>
      </div>
      <div class="space-y-6">
        <% profile?.posts?.forEach(post => { %>
          <div class="border border-blue-100 p-5 rounded-xl bg-blue-50">
            <h4 class="font-semibold text-lg text-blue-800"><%= post?.title %></h4>
            <p class="text-gray-700 mt-1"><%= post?.content %></p>
          </div>
        <% }); %>
      </div>
    </div>
  <% } %>

  <!-- Logout Button -->
  <% if (locals.loggedInUserId === profile?.id) { %>
    <div class="mt-8 text-center">
      <form action="/user/logout" method="get">
        <button type="submit" class="px-6 py-2 border border-gray-400 rounded-full bg-gray-50 hover:bg-gray-100 shadow">Sign Out</button>
      </form>
    </div>
  <% } %>
</div>
<!-- Font Awesome CDN for icons -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />