<div class="max-w-4xl mx-auto px-4 py-8">
  <!-- Profile Card -->
  <div class="relative bg-gradient-to-br from-blue-50 to-blue-100 shadow-2xl rounded-3xl overflow-hidden mb-8">
    <div class="h-48 bg-cover bg-center"
      style="background-image: url('<%= profile && profile.backgroundImage ? profile.backgroundImage : 'https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=800&q=80' %>');">
    </div>
    <div class="absolute top-32 left-10 flex items-end">
      <div class="relative">
        <img id="profileImage"
          src="<%= (profile.ProfileImage && profile.ProfileImage.imagePath) ? profile.ProfileImage.imagePath : 'https://ui-avatars.com/api/?name=' + encodeURIComponent(profile.firstName + ' ' + profile.lastName) + '&size=144&background=3b82f6&color=ffffff' %>"
          alt="Profile" class="w-36 h-36 rounded-full border-4 border-white shadow-lg object-cover">
        <% if (locals.loggedInUserId && locals.loggedInUserId === profile?.id) { %>
          <div class="absolute inset-0 bg-black bg-opacity-50 rounded-full flex items-center justify-center opacity-0 hover:opacity-100 transition-opacity cursor-pointer" onclick="document.getElementById('profileImageInput').click()">
            <i class="fas fa-camera text-white text-xl"></i>
          </div>
          <input type="file" id="profileImageInput" accept="image/*" style="display: none;" onchange="uploadProfileImage(this)">
        <% } %>
      </div>
    </div>
    <div class="absolute top-8 right-10 flex space-x-2">
      <% if (locals.loggedInUserId && locals.loggedInUserId===profile?.id) { %>
        <a href="/in/edit"
          class="flex items-center px-5 py-2 border border-blue-600 text-blue-600 bg-white rounded-full hover:bg-blue-50 shadow transition">
          <i class="fas fa-pencil-alt mr-2"></i> Edit Profile
        </a>
        <% } else { %>
          <form action="/mynetwork/connect/<%= profile.id %>" method="POST" class="inline">
            <button type="submit"
              class="inline-block bg-blue-600 text-white px-5 py-2 rounded-full shadow hover:bg-blue-700 transition">Connect</button>
          </form>
          <% } %>
    </div>
    <div class="pt-24 pb-8 px-10">
      <h2 class="text-3xl font-extrabold text-gray-900">
        <%= profile?.firstName %>
          <%= profile?.lastName %>
      </h2>
      <p class="text-blue-700 font-semibold text-lg mt-1">
        <%= profile?.role?.charAt(0).toUpperCase() + profile?.role?.slice(1) %>
      </p>
      <% if (profile?.city || profile?.country) { %>
        <p class="text-gray-600 font-medium text-base mt-2">
          <i class="fas fa-map-marker-alt mr-2"></i>
          <% if (profile?.city && profile?.country) { %>
            <%= profile.city %>, <%= profile.country %>
          <% } else if (profile?.city) { %>
            <%= profile.city %>
          <% } else if (profile?.country) { %>
            <%= profile.country %>
          <% } %>
        </p>
      <% } %>
      <div class="flex mt-4 space-x-6">
        <span class="flex items-center text-blue-600 font-medium"><i class="fas fa-user-friends mr-2"></i>
          <%= connectionsCount %> connections
        </span>
      </div>
    </div>
  </div>

  <!-- About Section -->
  <div class="bg-white rounded-2xl shadow-lg mb-8 p-8">
    <div class="flex items-center mb-4">
      <i class="fas fa-user text-blue-500 text-xl mr-3"></i>
      <h3 class="text-2xl font-bold text-gray-800">About</h3>
    </div>
    <p class="text-gray-700 text-lg">
      <%= profile?.about || 'No description available.' %>
    </p>
  </div>

  <!-- Profile Statistics -->
  <div class="bg-white rounded-2xl shadow-lg mb-8 p-8">
    <div class="flex items-center mb-6">
      <i class="fas fa-chart-bar text-blue-500 text-xl mr-3"></i>
      <% if (profile?.role === 'lawyer') { %>
        <h3 class="text-2xl font-bold text-gray-800">Professional Overview</h3>
      <% } else { %>
        <h3 class="text-2xl font-bold text-gray-800">Community Activity</h3>
      <% } %>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
      <% if (profile?.role === 'lawyer') { %>
        <div class="text-center p-4 bg-blue-50 rounded-xl border border-blue-100">
          <div class="text-2xl font-bold text-blue-600"><%= profile?.posts?.length || 0 %></div>
          <div class="text-sm text-gray-600 mt-1">Legal Articles</div>
        </div>
        <div class="text-center p-4 bg-green-50 rounded-xl border border-green-100">
          <div class="text-2xl font-bold text-green-600"><%= connectionsCount %></div>
          <div class="text-sm text-gray-600 mt-1">Professional Network</div>
        </div>
        <div class="text-center p-4 bg-purple-50 rounded-xl border border-purple-100">
          <div class="text-2xl font-bold text-purple-600"><%= profile?.lawyer?.Educations?.length || 0 %></div>
          <div class="text-sm text-gray-600 mt-1">Education</div>
        </div>
        <div class="text-center p-4 bg-orange-50 rounded-xl border border-orange-100">
          <div class="text-2xl font-bold text-orange-600"><%= new Date().getFullYear() - new Date(profile?.createdAt || new Date()).getFullYear() %></div>
          <div class="text-sm text-gray-600 mt-1">Years Practicing</div>
        </div>
      <% } else { %>
        <div class="text-center p-4 bg-blue-50 rounded-xl border border-blue-100">
          <div class="text-2xl font-bold text-blue-600"><%= profile?.posts?.length || 0 %></div>
          <div class="text-sm text-gray-600 mt-1">Posts & Questions</div>
        </div>
        <div class="text-center p-4 bg-green-50 rounded-xl border border-green-100">
          <div class="text-2xl font-bold text-green-600"><%= connectionsCount %></div>
          <div class="text-sm text-gray-600 mt-1">Helpful Connections</div>
        </div>
        <div class="text-center p-4 bg-purple-50 rounded-xl border border-purple-100">
          <div class="text-2xl font-bold text-purple-600"><%= connectionsCount %></div>
          <div class="text-sm text-gray-600 mt-1">Lawyer Connections</div>
        </div>
        <div class="text-center p-4 bg-orange-50 rounded-xl border border-orange-100">
          <div class="text-2xl font-bold text-orange-600"><%= Math.floor((new Date() - new Date(profile?.createdAt || new Date())) / (1000 * 60 * 60 * 24)) %></div>
          <div class="text-sm text-gray-600 mt-1">Days Active</div>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Interests & Areas Section -->
  <div class="bg-white rounded-2xl shadow-lg mb-8 p-8">
    <div class="flex items-center mb-6">
      <% if (profile?.role === 'lawyer') { %>
        <i class="fas fa-gavel text-blue-500 text-xl mr-3"></i>
        <h3 class="text-2xl font-bold text-gray-800">Legal Expertise</h3>
      <% } else { %>
        <i class="fas fa-heart text-blue-500 text-xl mr-3"></i>
        <h3 class="text-2xl font-bold text-gray-800">Interests & Legal Areas</h3>
      <% } %>
    </div>
    <div class="flex flex-wrap gap-3">
      <% if (profile?.role === 'lawyer') { %>
        <% if (profile?.lawyer?.legalAreas) { %>
          <% profile.lawyer.legalAreas.split(',').forEach(area => { %>
            <span class="px-4 py-2 bg-blue-100 text-blue-800 rounded-full text-sm font-medium">
              <i class="fas fa-gavel mr-1"></i><%= area.trim() %>
            </span>
          <% }); %>
        <% } else { %>
          <p class="text-gray-600 italic">No legal areas specified yet. <a href="/in/edit" class="text-blue-600 hover:underline">Add your expertise areas</a></p>
        <% } %>
      <% } else { %>
        <% if (profile?.interests) { %>
          <% profile.interests.split(',').forEach(interest => { %>
            <span class="px-4 py-2 bg-blue-100 text-blue-800 rounded-full text-sm font-medium">
              <i class="fas fa-star mr-1"></i><%= interest.trim() %>
            </span>
          <% }); %>
        <% } else { %>
          <p class="text-gray-600 italic">No interests specified yet. <a href="/in/edit" class="text-blue-600 hover:underline">Add your interests</a></p>
        <% } %>
      <% } %>
    </div>
    
    <!-- Additional Interests for Lawyers -->
    <% if (profile?.role === 'lawyer' && profile?.interests) { %>
      <div class="mt-6">
        <h4 class="text-lg font-semibold text-gray-800 mb-3 flex items-center">
          <i class="fas fa-heart text-green-500 mr-2"></i>
          Additional Interests
        </h4>
        <div class="flex flex-wrap gap-3">
          <% profile.interests.split(',').forEach(interest => { %>
            <span class="px-4 py-2 bg-green-100 text-green-800 rounded-full text-sm font-medium">
              <i class="fas fa-heart mr-1"></i><%= interest.trim() %>
            </span>
          <% }); %>
        </div>
      </div>
    <% } %>
  </div>

  <!-- Contact Information -->
  <% if (profile?.role === 'lawyer') { %>
    <div class="bg-white rounded-2xl shadow-lg mb-8 p-8">
      <div class="flex items-center mb-6">
        <i class="fas fa-address-card text-blue-500 text-xl mr-3"></i>
        <h3 class="text-2xl font-bold text-gray-800">Professional Contact</h3>
      </div>
      <div class="space-y-4">
        <div class="flex items-center p-4 bg-gray-50 rounded-xl">
          <i class="fas fa-envelope text-blue-500 text-lg mr-4"></i>
          <div>
            <div class="font-medium text-gray-800">Professional Email</div>
            <div class="text-gray-600"><%= profile?.email || 'Not provided' %></div>
          </div>
        </div>
        <% if (profile?.city || profile?.country) { %>
          <div class="flex items-center p-4 bg-gray-50 rounded-xl">
            <i class="fas fa-map-marker-alt text-blue-500 text-lg mr-4"></i>
            <div>
              <div class="font-medium text-gray-800">Practice Location</div>
              <div class="text-gray-600">
                <% if (profile?.city && profile?.country) { %>
                  <%= profile.city %>, <%= profile.country %>
                <% } else if (profile?.city) { %>
                  <%= profile.city %>
                <% } else if (profile?.country) { %>
                  <%= profile.country %>
                <% } %>
              </div>
            </div>
          </div>
        <% } %>
        <% if (profile?.lawyer?.badgeNumber) { %>
          <div class="flex items-center p-4 bg-gray-50 rounded-xl">
            <i class="fas fa-id-badge text-blue-500 text-lg mr-4"></i>
            <div>
              <div class="font-medium text-gray-800">Bar Registration Number</div>
              <div class="text-gray-600"><%= profile.lawyer.badgeNumber %></div>
            </div>
          </div>
        <% } %>
        <div class="flex items-center p-4 bg-blue-50 rounded-xl border-l-4 border-blue-500">
          <i class="fas fa-calendar-check text-blue-500 text-lg mr-4"></i>
          <div>
            <div class="font-medium text-gray-800">Available for Consultation</div>
            <div class="text-gray-600">Contact for legal advice and representation</div>
          </div>
        </div>
      </div>
    </div>
  <% } else { %>
    <div class="bg-white rounded-2xl shadow-lg mb-8 p-8">
      <div class="flex items-center mb-6">
        <i class="fas fa-user-circle text-blue-500 text-xl mr-3"></i>
        <h3 class="text-2xl font-bold text-gray-800">Member Information</h3>
      </div>
      <div class="space-y-4">
        <div class="flex items-center p-4 bg-gray-50 rounded-xl">
          <i class="fas fa-calendar-alt text-blue-500 text-lg mr-4"></i>
          <div>
            <div class="font-medium text-gray-800">Member Since</div>
            <div class="text-gray-600"><%= new Date(profile?.createdAt || new Date()).toLocaleDateString('en-US', { year: 'numeric', month: 'long' }) %></div>
          </div>
        </div>
        <% if (profile?.city || profile?.country) { %>
          <div class="flex items-center p-4 bg-gray-50 rounded-xl">
            <i class="fas fa-map-marker-alt text-blue-500 text-lg mr-4"></i>
            <div>
              <div class="font-medium text-gray-800">Location</div>
              <div class="text-gray-600">
                <% if (profile?.city && profile?.country) { %>
                  <%= profile.city %>, <%= profile.country %>
                <% } else if (profile?.city) { %>
                  <%= profile.city %>
                <% } else if (profile?.country) { %>
                  <%= profile.country %>
                <% } %>
              </div>
            </div>
          </div>
        <% } %>
        <div class="flex items-center p-4 bg-green-50 rounded-xl border-l-4 border-green-500">
          <i class="fas fa-comments text-green-500 text-lg mr-4"></i>
          <div>
            <div class="font-medium text-gray-800">Community Engagement</div>
            <div class="text-gray-600">Active in legal discussions and knowledge sharing</div>
          </div>
        </div>
      </div>
    </div>
  <% } %>

  <!-- Badge Information Section (For Lawyers) -->
  <% if (profile?.role === 'lawyer' && profile?.lawyer) { %>
    <div class="bg-white rounded-2xl shadow-lg mb-8 p-8">
      <div class="flex items-center mb-4">
        <i class="fas fa-certificate text-blue-500 text-xl mr-3"></i>
        <h3 class="text-2xl font-bold text-gray-800">Professional Credentials</h3>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="border border-blue-100 p-5 rounded-xl bg-blue-50">
          <h4 class="font-semibold text-lg text-blue-800">Badge Information</h4>
          <p class="text-gray-600 mt-1"><strong>Badge Number:</strong> <%= profile?.lawyer?.badgeNumber %></p>
          <p class="text-gray-600 mt-1"><strong>Issue Date:</strong> <%= profile?.lawyer?.badgeIssueDate ? new Date(profile?.lawyer?.badgeIssueDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : 'N/A' %></p>
          <p class="text-gray-600 mt-1"><strong>Authority Level:</strong> <%= profile?.lawyer?.badgeIssuingAuthority ? profile?.lawyer?.badgeIssuingAuthority.charAt(0).toUpperCase() + profile?.lawyer?.badgeIssuingAuthority.slice(1) : 'N/A' %></p>
        </div>
        <% if (profile?.lawyer?.lawyer_docs && profile?.lawyer?.lawyer_docs.length > 0) { %>
          <div class="border border-blue-100 p-5 rounded-xl bg-blue-50">
            <h4 class="font-semibold text-lg text-blue-800">Badge Document</h4>
            <div class="mt-3">
              <a href="<%= profile?.lawyer?.lawyer_docs[0]?.idPath %>" target="_blank" class="inline-flex items-center px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition">
                <i class="fas fa-file-pdf mr-2"></i> View Badge Document
              </a>
            </div>
          </div>
        <% } %>
      </div>
    </div>
  <% } %>

  <!-- Education Section (Lawyers Only) -->
  <% if (profile?.role === 'lawyer' && profile?.lawyer?.Educations?.length > 0) { %>
    <div class="bg-white rounded-2xl shadow-lg mb-8 p-8">
      <div class="flex items-center mb-4">
        <i class="fas fa-graduation-cap text-blue-500 text-xl mr-3"></i>
        <h3 class="text-2xl font-bold text-gray-800">Legal Education</h3>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <% profile?.lawyer?.Educations?.forEach(edu=> { %>
          <div class="border border-blue-100 p-5 rounded-xl bg-blue-50">
            <h4 class="font-semibold text-lg text-blue-800">
              <%= edu?.institution || edu?.university || edu?.college %>
            </h4>
            <p class="text-gray-600 mt-1">
              <%= edu?.degree %>
                <% if (edu?.fieldOfStudy) { %>, <%= edu?.fieldOfStudy %>
                    <% } %>
            </p>
            <p class="text-gray-500 text-sm mt-1">
              <%= edu?.startYear %> - <%= edu?.endYear || 'Present' %>
            </p>
          </div>
          <% }); %>
      </div>
    </div>
    <% } %>

      <!-- Recent Activity Section -->
      <div class="bg-white rounded-2xl shadow-lg mb-8 p-8">
        <div class="flex items-center mb-6">
          <i class="fas fa-clock text-blue-500 text-xl mr-3"></i>
          <h3 class="text-2xl font-bold text-gray-800">Recent Activity</h3>
        </div>
        <div class="space-y-4">
          <div class="flex items-center p-4 bg-blue-50 rounded-xl border-l-4 border-blue-500">
            <i class="fas fa-user-plus text-blue-500 mr-3"></i>
            <div>
              <div class="font-medium text-gray-800">Joined the platform</div>
              <div class="text-sm text-gray-600"><%= new Date(profile?.createdAt || new Date()).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></div>
            </div>
          </div>
          <% if (profile?.role === 'lawyer' && profile?.posts?.length > 0) { %>
            <div class="flex items-center p-4 bg-green-50 rounded-xl border-l-4 border-green-500">
              <i class="fas fa-edit text-green-500 mr-3"></i>
              <div>
                <div class="font-medium text-gray-800">Published <%= profile.posts.length %> legal article<%= profile.posts.length !== 1 ? 's' : '' %></div>
                <div class="text-sm text-gray-600">Latest: "<%= profile.posts[0]?.title || 'Untitled' %>"</div>
              </div>
            </div>
          <% } else if (profile?.role !== 'lawyer') { %>
            <div class="flex items-center p-4 bg-green-50 rounded-xl border-l-4 border-green-500">
              <i class="fas fa-book-open text-green-500 mr-3"></i>
              <div>
                <div class="font-medium text-gray-800">Exploring legal resources</div>
                <div class="text-sm text-gray-600">Learning about rights and legal processes</div>
              </div>
            </div>
          <% } %>
          <% if (connectionsCount > 0) { %>
            <div class="flex items-center p-4 bg-purple-50 rounded-xl border-l-4 border-purple-500">
              <i class="fas fa-handshake text-purple-500 mr-3"></i>
              <div>
                <div class="font-medium text-gray-800">Connected with <%= connectionsCount %> professional<%= connectionsCount !== 1 ? 's' : '' %></div>
                <div class="text-sm text-gray-600">Building a strong network</div>
              </div>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Achievements Section -->
      <div class="bg-white rounded-2xl shadow-lg mb-8 p-8">
        <div class="flex items-center mb-6">
          <i class="fas fa-trophy text-blue-500 text-xl mr-3"></i>
          <h3 class="text-2xl font-bold text-gray-800">Achievements</h3>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          <div class="flex items-center p-4 bg-yellow-50 rounded-xl border border-yellow-200">
            <i class="fas fa-medal text-yellow-500 text-2xl mr-3"></i>
            <div>
              <div class="font-semibold text-gray-800">Profile Complete</div>
              <div class="text-sm text-gray-600">Added profile information</div>
            </div>
          </div>
          <% if (connectionsCount >= 5) { %>
            <div class="flex items-center p-4 bg-blue-50 rounded-xl border border-blue-200">
              <i class="fas fa-users text-blue-500 text-2xl mr-3"></i>
              <div>
                <div class="font-semibold text-gray-800">Networker</div>
                <div class="text-sm text-gray-600">5+ connections</div>
              </div>
            </div>
          <% } %>
          <% if (profile?.role === 'lawyer' && profile?.posts?.length >= 3) { %>
            <div class="flex items-center p-4 bg-green-50 rounded-xl border border-green-200">
              <i class="fas fa-pen text-green-500 text-2xl mr-3"></i>
              <div>
                <div class="font-semibold text-gray-800">Legal Content Creator</div>
                <div class="text-sm text-gray-600">3+ legal articles published</div>
              </div>
            </div>
          <% } else if (profile?.role !== 'lawyer' && connectionsCount >= 3) { %>
            <div class="flex items-center p-4 bg-green-50 rounded-xl border border-green-200">
              <i class="fas fa-handshake text-green-500 text-2xl mr-3"></i>
              <div>
                <div class="font-semibold text-gray-800">Community Connector</div>
                <div class="text-sm text-gray-600">Connected with legal professionals</div>
              </div>
            </div>
          <% } %>
          <% if (profile?.role === 'lawyer' && profile?.lawyer?.Educations?.length > 0) { %>
            <div class="flex items-center p-4 bg-purple-50 rounded-xl border border-purple-200">
              <i class="fas fa-graduation-cap text-purple-500 text-2xl mr-3"></i>
              <div>
                <div class="font-semibold text-gray-800">Educated Professional</div>
                <div class="text-sm text-gray-600">Legal education verified</div>
              </div>
            </div>
          <% } %>
          <% if (profile?.role === 'lawyer' && profile?.lawyer?.badgeNumber) { %>
            <div class="flex items-center p-4 bg-red-50 rounded-xl border border-red-200">
              <i class="fas fa-certificate text-red-500 text-2xl mr-3"></i>
              <div>
                <div class="font-semibold text-gray-800">Certified Lawyer</div>
                <div class="text-sm text-gray-600">Badge verified</div>
              </div>
            </div>
          <% } %>
          <% if (new Date().getFullYear() - new Date(profile?.createdAt || new Date()).getFullYear() >= 1) { %>
            <div class="flex items-center p-4 bg-indigo-50 rounded-xl border border-indigo-200">
              <i class="fas fa-calendar-check text-indigo-500 text-2xl mr-3"></i>
              <div>
                <div class="font-semibold text-gray-800">Veteran Member</div>
                <div class="text-sm text-gray-600">1+ years active</div>
              </div>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Posts Section (Lawyers Only) -->
      <% if (profile?.role === 'lawyer' && profile?.posts?.length > 0) { %>
        <div class="bg-white rounded-2xl shadow-lg mb-8 p-8">
          <div class="flex items-center mb-4">
            <i class="fas fa-newspaper text-blue-500 text-xl mr-3"></i>
            <h3 class="text-2xl font-bold text-gray-800">Recent Legal Articles</h3>
          </div>
          <div class="space-y-6">
            <% profile?.posts?.slice(0, 3).forEach(post=> { %>
              <div class="border border-blue-100 p-5 rounded-xl bg-blue-50 hover:shadow-md transition-shadow">
                <div class="flex items-start justify-between mb-2">
                  <h4 class="font-semibold text-lg text-blue-800">
                    <%= post?.title %>
                  </h4>
                  <span class="text-xs text-gray-500 bg-white px-2 py-1 rounded-full">
                    <%= new Date(post?.createdAt || new Date()).toLocaleDateString() %>
                  </span>
                </div>
                <p class="text-gray-700 mt-1 line-clamp-3">
                  <%= post?.content?.length > 150 ? post.content.substring(0, 150) + '...' : post?.content %>
                </p>
                <div class="mt-3 flex items-center text-sm text-gray-500">
                  <i class="fas fa-eye mr-1"></i>
                  <span class="mr-4">View full article</span>
                  <i class="fas fa-heart mr-1"></i>
                  <span>Reactions</span>
                </div>
              </div>
              <% }); %>
            <% if (profile?.posts?.length > 3) { %>
              <div class="text-center">
                <a href="/feed" class="inline-flex items-center px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition">
                  <i class="fas fa-plus mr-2"></i>
                  View All Articles (<%= profile.posts.length %>)
                </a>
              </div>
            <% } %>
          </div>
        </div>
      <% } else if (profile?.role !== 'lawyer') { %>
        <!-- Legal Resources Section (Visitors Only) -->
        <div class="bg-white rounded-2xl shadow-lg mb-8 p-8">
          <div class="flex items-center mb-6">
            <i class="fas fa-book text-blue-500 text-xl mr-3"></i>
