<div class="min-h-screen flex flex-col items-center justify-center bg-[#f3f2ef] py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full">
    <div class="text-center">
      <h2 class="text-3xl font-bold mb-2">Join Legal Network</h2>
      <p class="text-gray-600 mb-8">Make the most of your professional life</p>
    </div>

    <div class="bg-white p-8 rounded-lg shadow-sm">
      <% if (error) { %>
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
          <%= error %>
        </div>
      <% } %>

      <form action="/register" method="POST" class="space-y-6" enctype="multipart/form-data">
        <!-- Basic Info -->
        <div>
          <label class="block text-gray-700 font-medium mb-2" for="role">I want to join as:</label>
          <select name="role" id="role" class="w-full border border-gray-300 rounded-lg p-3"
            onchange="toggleLawyerFields()">
            <option value="visitor">Regular User</option>
            <option value="lawyer">Lawyer</option>
          </select>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-gray-700 font-medium mb-2" for="firstName">First name</label>
            <input type="text" name="firstName" id="firstName" required
              class="w-full border border-gray-300 rounded-lg p-3">
          </div>
          <div>
            <label class="block text-gray-700 font-medium mb-2" for="lastName">Last name</label>
            <input type="text" name="lastName" id="lastName" required
              class="w-full border border-gray-300 rounded-lg p-3">
          </div>
        </div>

        <div>
          <label class="block text-gray-700 font-medium mb-2" for="email">Email</label>
          <input type="email" name="email" id="email" required
            class="w-full border border-gray-300 rounded-lg p-3">
        </div>

        <div>
          <label class="block text-gray-700 font-medium mb-2" for="password">Password (6 or more characters)</label>
          <input type="password" name="password" id="password" required minlength="6"
            class="w-full border border-gray-300 rounded-lg p-3">
        </div>

        <!-- Lawyer Specific Fields -->
        <div id="lawyerFields" class="hidden space-y-6">
          <!-- Law Firm Checkbox and Input -->
          <div>
            <div class="flex items-center mb-2">
              <input type="checkbox" id="inLawFirm" class="mr-2" onchange="toggleLawFirmField()">
              <label class="text-gray-700 font-medium" for="inLawFirm">I work in a law firm</label>
            </div>
            <div id="lawFirmInputContainer" class="hidden">
              <label class="block text-gray-700 font-medium mb-2" for="lawFirm">Law Firm</label>
              <input type="text" name="lawFirm" id="lawFirm" class="w-full border border-gray-300 rounded-lg p-3">
            </div>
          </div>

          <!-- Authority Level field removed as it's now combined with Issuing Authority -->

          <!-- Badge Information -->
          <div class="space-y-4">
            <h3 class="font-medium text-gray-900">Badge Information</h3>
            
            <div>
              <label class="block text-gray-700 font-medium mb-2" for="badgeNumber">Badge Number</label>
              <input type="text" name="badgeNumber" id="badgeNumber" required
                class="w-full border border-gray-300 rounded-lg p-3">
            </div>
            
            <div>
              <label class="block text-gray-700 font-medium mb-2" for="badgeIssueDate">Badge Issue Date</label>
              <input type="date" name="badgeIssueDate" id="badgeIssueDate" required
                class="w-full border border-gray-300 rounded-lg p-3">
            </div>
            
            <div>
              <label class="block text-gray-700 font-medium mb-2" for="badgeIssuingAuthority">Authority Level</label>
              <select name="badgeIssuingAuthority" id="badgeIssuingAuthority" required class="w-full border border-gray-300 rounded-lg p-3">
                <option value="">Select Authority Level</option>
                <option value="training">Training</option>
                <option value="approved">Approved</option>
                <option value="consultant">Consultant</option>
              </select>
            </div>
            
            <div>
              <label class="block text-gray-700 font-medium mb-2" for="badgeUpload">Upload Badge (Image/PDF)</label>
              <input type="file" name="badgeUpload" id="badgeUpload" accept="image/*,.pdf" required
                class="w-full border border-gray-300 rounded-lg p-3">
            </div>
          </div>

          <div>
            <label class="block text-gray-700 font-medium mb-2" for="summary">Professional Summary</label>
            <textarea name="summary" id="summary" rows="3"
              class="w-full border border-gray-300 rounded-lg p-3"></textarea>
          </div>

          <div>
            <label class="block text-gray-700 font-medium mb-2" for="contactNumber">Contact Number</label>
            <input type="tel" name="contactNumber" id="contactNumber" required
              class="w-full border border-gray-300 rounded-lg p-3">
          </div>

          <!-- Education Section -->
          <div class="space-y-4">
            <h3 class="font-medium text-gray-900">Education</h3>
            <!-- University -->
            <div>
              <label class="block text-gray-700 text-sm mb-1" for="universitySelect">University</label>
              <select name="universitySelect" id="universitySelect" class="w-full border border-gray-300 rounded-lg p-3" 
                      onchange="toggleInput('universitySelect', 'universityInput')" required>
                <% educations.forEach(function(edu) { %>
                  <option value="<%= edu.university %>"><%= edu.university %></option>
                <% }) %>
                <option value="other">Other</option>
              </select>
              <input type="text" name="university" id="universityInput" placeholder="Enter new university" 
                     class="w-full border border-gray-300 rounded-lg p-3 hidden">
            </div>

            <!-- Degree (Dropdown) -->
            <div>
              <label class="block text-gray-700 text-sm mb-1" for="degreeSelect">Degree</label>
              <select name="degree" id="degreeSelect" required class="w-full border border-gray-300 rounded-lg p-3">
                <option value="">Select Degree</option>
                <option value="Bachelor of Laws (LLB)">Bachelor of Laws (LLB)</option>
                <option value="Master of Laws (LLM)">Master of Laws (LLM)</option>
                <option value="Juris Doctor (JD)">Juris Doctor (JD)</option>
                <option value="Doctor of Juridical Science (SJD)">Doctor of Juridical Science (SJD)</option>
                <option value="Doctor of Laws (LLD)">Doctor of Laws (LLD)</option>
                <option value="Bachelor of Civil Law (BCL)">Bachelor of Civil Law (BCL)</option>
                <option value="Master of Legal Studies (MLS)">Master of Legal Studies (MLS)</option>
                <option value="Other">Other</option>
              </select>
            </div>
          </div>
        </div>

        <button type="submit"
                class="w-full bg-blue-600 text-white py-3 px-4 rounded-full hover:bg-blue-700 font-medium">
          Agree & Join
        </button>
      </form>

      <p class="mt-6 text-center text-gray-600">
        Already on Legal Network?
        <a href="/user/login" class="text-blue-600 hover:text-blue-700 font-medium">Sign in</a>
      </p>
    </div>
  </div>
</div>

<script>
  // Call toggleLawyerFields when the page loads
  document.addEventListener('DOMContentLoaded', function() {
    toggleLawyerFields();
  });

  function toggleLawyerFields() {
    const role = document.getElementById('role').value;
    const lawyerFields = document.getElementById('lawyerFields');
    const lawyerInputs = [
      'badgeNumber',
      'badgeIssueDate',
      'badgeIssuingAuthority',
      'badgeUpload',
      'summary',
      'contactNumber',
      'universitySelect',
      'universityInput',
      'degreeSelect'
    ];
  
    if (role === 'lawyer') {
      lawyerFields.classList.remove('hidden');
      lawyerInputs.forEach(fieldId => {
        const field = document.getElementById(fieldId);
        if (field) {
          field.disabled = false;
          // Restore the name attribute to ensure form submission includes these fields
          if (field.dataset.originalName) {
            field.name = field.dataset.originalName;
          }
          if (!field.id.endsWith('Input')) {
            field.required = true;
          }
        }
      });
      // Initialize law firm field state
      document.getElementById('inLawFirm').disabled = false;
      toggleLawFirmField();
    } else {
      lawyerFields.classList.add('hidden');
      lawyerInputs.forEach(fieldId => {
        const field = document.getElementById(fieldId);
        if (field) {
          // Store the original name attribute before removing it
          if (field.name) {
            field.dataset.originalName = field.name;
            field.name = ''; // Remove name attribute to prevent form submission
          }
          field.disabled = true;
          field.required = false;
          if (field.tagName === 'SELECT') {
            field.selectedIndex = 0;
          } else {
            field.value = '';
          }
        }
      });
      // Disable law firm checkbox and field
      const inLawFirmCheckbox = document.getElementById('inLawFirm');
      if (inLawFirmCheckbox) {
        inLawFirmCheckbox.disabled = true;
        inLawFirmCheckbox.checked = false;
      }
      const lawFirmField = document.getElementById('lawFirm');
      if (lawFirmField) {
        lawFirmField.disabled = true;
        lawFirmField.value = '';
        if (lawFirmField.name) {
          lawFirmField.dataset.originalName = lawFirmField.name;
          lawFirmField.name = '';
        }
      }
      document.getElementById('lawFirmInputContainer').classList.add('hidden');
    }
  }

  // Function to toggle law firm input field based on checkbox
  function toggleLawFirmField() {
    const inLawFirm = document.getElementById('inLawFirm');
    const lawFirmContainer = document.getElementById('lawFirmInputContainer');
    const lawFirmInput = document.getElementById('lawFirm');
    
    if (inLawFirm.checked) {
      lawFirmContainer.classList.remove('hidden');
      lawFirmInput.disabled = false;
      lawFirmInput.required = true;
      if (lawFirmInput.dataset.originalName) {
        lawFirmInput.name = lawFirmInput.dataset.originalName;
      }
    } else {
      lawFirmContainer.classList.add('hidden');
      lawFirmInput.disabled = true;
      lawFirmInput.required = false;
      lawFirmInput.value = '';
      // Store original name and remove it from form submission
      if (lawFirmInput.name) {
        lawFirmInput.dataset.originalName = lawFirmInput.name;
        lawFirmInput.name = '';
      }
    }
  }

  // Generic function to toggle text input visibility when "Other" is selected
  function toggleInput(selectId, inputId) {
    const selectElem = document.getElementById(selectId);
    const inputElem = document.getElementById(inputId);
    if (selectElem.value === 'other') {
      inputElem.classList.remove('hidden');
      inputElem.required = true;
    } else {
      inputElem.classList.add('hidden');
      inputElem.required = false;
    }
  }
</script>
