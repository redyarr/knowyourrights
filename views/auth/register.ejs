<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Join Legal Network - Register</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>
<div class="min-h-screen bg-gradient-to-br from-blue-50 via-white to-indigo-50 flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8 relative overflow-hidden">
    <!-- Animated background elements -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <div class="absolute -top-40 -right-40 w-80 h-80 bg-blue-100 rounded-full mix-blend-multiply filter blur-xl opacity-70 animate-blob"></div>
        <div class="absolute -bottom-40 -left-40 w-80 h-80 bg-purple-100 rounded-full mix-blend-multiply filter blur-xl opacity-70 animate-blob animation-delay-2000"></div>
        <div class="absolute top-40 left-40 w-80 h-80 bg-yellow-100 rounded-full mix-blend-multiply filter blur-xl opacity-70 animate-blob animation-delay-4000"></div>
    </div>

  <div class="max-w-lg w-full relative z-10">
    <!-- Logo and Header -->
    <div class="text-center mb-8">
      <div class="mx-auto h-16 w-16 bg-gradient-to-r from-blue-600 to-purple-600 rounded-xl flex items-center justify-center mb-4 shadow-lg transform hover:scale-105 transition-transform duration-200">
        <i class="fas fa-balance-scale text-white text-2xl"></i>
      </div>
      <h2 class="text-4xl font-bold bg-gradient-to-r from-gray-900 to-gray-600 bg-clip-text text-transparent mb-2">
        Join Legal Network
      </h2>
      <p class="text-gray-600 text-lg">Create your professional legal account</p>
    </div>

    <!-- Registration Form Card -->
    <div class="bg-white/80 backdrop-blur-sm p-8 rounded-2xl shadow-xl border border-white/20 hover:shadow-2xl transition-all duration-300">
      <% if (error) { %>
        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl mb-6 flex items-center">
          <i class="fas fa-exclamation-circle mr-2"></i>
          <%= error %>
        </div>
      <% } %>

      <form action="/register" method="POST" class="space-y-6" enctype="multipart/form-data">
        <!-- Basic Info -->
        <div class="space-y-2">
          <label class="block text-gray-700 font-semibold text-sm" for="role">
            <i class="fas fa-user-tag mr-2 text-gray-500"></i>I want to join as:
          </label>
          <select name="role" id="role" class="w-full border border-gray-300 rounded-xl p-4 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 bg-gray-50 hover:bg-white"
            onchange="toggleLawyerFields()">
            <option value="visitor">Regular User</option>
            <option value="lawyer">Lawyer</option>
          </select>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div class="space-y-2">
            <label class="block text-gray-700 font-semibold text-sm" for="firstName">
              <i class="fas fa-user mr-2 text-gray-500"></i>First name
            </label>
            <input type="text" name="firstName" id="firstName" required
              class="w-full border border-gray-300 rounded-xl p-4 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 bg-gray-50 hover:bg-white"
              placeholder="Enter first name">
          </div>
          <div class="space-y-2">
            <label class="block text-gray-700 font-semibold text-sm" for="lastName">
              <i class="fas fa-user mr-2 text-gray-500"></i>Last name
            </label>
            <input type="text" name="lastName" id="lastName" required
              class="w-full border border-gray-300 rounded-xl p-4 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 bg-gray-50 hover:bg-white"
              placeholder="Enter last name">
          </div>
        </div>

        <div class="space-y-2">
          <label class="block text-gray-700 font-semibold text-sm" for="email">
            <i class="fas fa-envelope mr-2 text-gray-500"></i>Email Address
          </label>
          <input type="email" name="email" id="email" required
            class="w-full border border-gray-300 rounded-xl p-4 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 bg-gray-50 hover:bg-white"
            placeholder="Enter your email">
        </div>

        <div class="space-y-2">
          <label class="block text-gray-700 font-semibold text-sm" for="password">
            <i class="fas fa-lock mr-2 text-gray-500"></i>Password (6 or more characters)
          </label>
          <input type="password" name="password" id="password" required minlength="6"
            class="w-full border border-gray-300 rounded-xl p-4 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 bg-gray-50 hover:bg-white"
            placeholder="Create a secure password">
        </div>

        <!-- Lawyer Specific Fields -->
        <div id="lawyerFields" class="hidden space-y-6">
          <!-- Law Firm Checkbox and Input -->
          <div class="bg-blue-50 p-4 rounded-xl border border-blue-200">
            <div class="flex items-center mb-3">
              <input type="checkbox" id="inLawFirm" class="mr-3 w-4 h-4 text-blue-600 rounded focus:ring-blue-500" onchange="toggleLawFirmField()">
              <label class="text-gray-700 font-semibold text-sm" for="inLawFirm">
                <i class="fas fa-building mr-2 text-gray-500"></i>I work in a law firm
              </label>
            </div>
            <div id="lawFirmInputContainer" class="hidden space-y-2">
              <label class="block text-gray-700 font-semibold text-sm" for="lawFirm">
                <i class="fas fa-briefcase mr-2 text-gray-500"></i>Law Firm Name
              </label>
              <input type="text" name="lawFirm" id="lawFirm" 
                class="w-full border border-gray-300 rounded-xl p-4 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 bg-white"
                placeholder="Enter law firm name">
            </div>
          </div>

          <!-- Badge Information -->
          <div class="bg-gradient-to-r from-purple-50 to-blue-50 p-6 rounded-xl border border-purple-200">
            <h3 class="font-bold text-gray-900 text-lg mb-4 flex items-center">
              <i class="fas fa-certificate mr-2 text-purple-600"></i>Professional Credentials
            </h3>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div class="space-y-2">
                <label class="block text-gray-700 font-semibold text-sm" for="badgeNumber">
                  <i class="fas fa-id-badge mr-2 text-gray-500"></i>Badge Number
                </label>
                <input type="text" name="badgeNumber" id="badgeNumber" required
                  class="w-full border border-gray-300 rounded-xl p-4 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 bg-white"
                  placeholder="Enter badge number">
              </div>
              
              <div class="space-y-2">
                <label class="block text-gray-700 font-semibold text-sm" for="badgeIssueDate">
                  <i class="fas fa-calendar mr-2 text-gray-500"></i>Badge Issue Date
                </label>
                <input type="date" name="badgeIssueDate" id="badgeIssueDate" required
                  class="w-full border border-gray-300 rounded-xl p-4 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 bg-white">
              </div>
            </div>
            
            <div class="space-y-2 mt-4">
              <label class="block text-gray-700 font-semibold text-sm" for="badgeIssuingAuthority">
                <i class="fas fa-shield-alt mr-2 text-gray-500"></i>Authority Level
              </label>
              <select name="badgeIssuingAuthority" id="badgeIssuingAuthority" required 
                class="w-full border border-gray-300 rounded-xl p-4 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 bg-white">
                <option value="">Select Authority Level</option>
                <option value="training">Training</option>
                <option value="approved">Approved</option>
                <option value="consultant">Consultant</option>
              </select>
            </div>
            
            <div class="space-y-2 mt-4">
              <label class="block text-gray-700 font-semibold text-sm" for="badgeUpload">
                <i class="fas fa-upload mr-2 text-gray-500"></i>Upload Badge (Image/PDF)
              </label>
              <input type="file" name="badgeUpload" id="badgeUpload" accept="image/*,.pdf" required
                class="w-full border border-gray-300 rounded-xl p-4 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 bg-white file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100">
            </div>
          </div>

          <div class="space-y-2">
            <label class="block text-gray-700 font-semibold text-sm" for="summary">
              <i class="fas fa-user-tie mr-2 text-gray-500"></i>Professional Summary
            </label>
            <textarea name="summary" id="summary" rows="3"
              class="w-full border border-gray-300 rounded-xl p-4 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 bg-gray-50 hover:bg-white resize-none"
              placeholder="Brief description of your legal expertise and experience"></textarea>
          </div>

          <div class="space-y-2">
            <label class="block text-gray-700 font-semibold text-sm" for="contactNumber">
              <i class="fas fa-phone mr-2 text-gray-500"></i>Contact Number
            </label>
            <input type="tel" name="contactNumber" id="contactNumber" required
              class="w-full border border-gray-300 rounded-xl p-4 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 bg-gray-50 hover:bg-white"
              placeholder="Enter your contact number">
          </div>

          <!-- Education Section -->
          <div class="bg-green-50 p-6 rounded-xl border border-green-200">
            <h3 class="font-bold text-gray-900 text-lg mb-4 flex items-center">
              <i class="fas fa-graduation-cap mr-2 text-green-600"></i>Education Background
            </h3>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <!-- University -->
              <div class="space-y-2">
                <label class="block text-gray-700 font-semibold text-sm" for="universitySelect">
                  <i class="fas fa-university mr-2 text-gray-500"></i>University
                </label>
                <select name="universitySelect" id="universitySelect" 
                        class="w-full border border-gray-300 rounded-xl p-4 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 bg-white" 
                        onchange="toggleInput('universitySelect', 'universityInput')" required>
                  <% educations.forEach(function(edu) { %>
                    <option value="<%= edu.university %>"><%= edu.university %></option>
                  <% }) %>
                  <option value="other">Other</option>
                </select>
                <input type="text" name="university" id="universityInput" placeholder="Enter new university" 
                       class="w-full border border-gray-300 rounded-xl p-4 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 bg-white hidden">
              </div>

              <!-- Degree (Dropdown) -->
              <div class="space-y-2">
                <label class="block text-gray-700 font-semibold text-sm" for="degreeSelect">
                  <i class="fas fa-certificate mr-2 text-gray-500"></i>Degree
                </label>
                <select name="degree" id="degreeSelect" required 
                        class="w-full border border-gray-300 rounded-xl p-4 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 bg-white">
                  <option value="">Select Degree</option>
                  <option value="Bachelor of Laws (LLB)">Bachelor of Laws (LLB)</option>
                  <option value="Master of Laws (LLM)">Master of Laws (LLM)</option>
                  <option value="Juris Doctor (JD)">Juris Doctor (JD)</option>
                  <option value="Doctor of Juridical Science (SJD)">Doctor of Juridical Science (SJD)</option>
                  <option value="Doctor of Laws (LLD)">Doctor of Laws (LLD)</option>
                  <option value="Bachelor of Civil Law (BCL)">Bachelor of Civil Law (BCL)</option>
                  <option value="Master of Legal Studies (MLS)">Master of Legal Studies (MLS)</option>
                  <option value="Other">Other</option>
                </select>
              </div>
            </div>
          </div>
        </div>

        <button type="submit"
                class="w-full bg-gradient-to-r from-blue-600 to-purple-600 text-white py-4 px-6 rounded-xl hover:from-blue-700 hover:to-purple-700 font-semibold text-lg shadow-lg hover:shadow-xl transform hover:scale-[1.02] transition-all duration-200 flex items-center justify-center">
          <i class="fas fa-user-plus mr-2"></i>
          Create Account & Join
        </button>
      </form>

      <!-- Divider -->
      <div class="my-6 flex items-center">
        <div class="flex-1 border-t border-gray-300"></div>
        <span class="px-4 text-gray-500 text-sm">or</span>
        <div class="flex-1 border-t border-gray-300"></div>
      </div>

      <!-- Login Link -->
      <div class="text-center">
        <p class="text-gray-600 mb-4">Already have an account?</p>
        <a href="/user/login" 
           class="inline-flex items-center px-6 py-3 border-2 border-blue-600 text-blue-600 rounded-xl hover:bg-blue-600 hover:text-white font-semibold transition-all duration-200 transform hover:scale-105">
          <i class="fas fa-sign-in-alt mr-2"></i>
          Sign In
        </a>
      </div>
    </div>

    <!-- Footer -->
    <div class="text-center mt-8 text-gray-500 text-sm">
      <p>&copy; 2024 Legal Network. Empowering legal professionals.</p>
    </div>
  </div>
</div>

<style>
@keyframes blob {
    0% {
        transform: translate(0px, 0px) scale(1);
    }
    33% {
        transform: translate(30px, -50px) scale(1.1);
    }
    66% {
        transform: translate(-20px, 20px) scale(0.9);
    }
    100% {
        transform: translate(0px, 0px) scale(1);
    }
}

.animate-blob {
    animation: blob 7s infinite;
}

.animation-delay-2000 {
    animation-delay: 2s;
}

.animation-delay-4000 {
    animation-delay: 4s;
}
</style>

<script>
  // Call toggleLawyerFields when the page loads
  document.addEventListener('DOMContentLoaded', function() {
    toggleLawyerFields();
  });

  function toggleLawyerFields() {
    const role = document.getElementById('role').value;
    const lawyerFields = document.getElementById('lawyerFields');
    const lawyerInputs = [
      'badgeNumber',
      'badgeIssueDate',
      'badgeIssuingAuthority',
      'badgeUpload',
      'summary',
      'contactNumber',
      'universitySelect',
      'universityInput',
      'degreeSelect'
    ];
  
    if (role === 'lawyer') {
      lawyerFields.classList.remove('hidden');
      lawyerInputs.forEach(fieldId => {
        const field = document.getElementById(fieldId);
        if (field) {
          field.disabled = false;
          // Restore the name attribute to ensure form submission includes these fields
          if (field.dataset.originalName) {
            field.name = field.dataset.originalName;
          }
          if (!field.id.endsWith('Input')) {
            field.required = true;
          }
        }
      });
      // Initialize law firm field state
      document.getElementById('inLawFirm').disabled = false;
      toggleLawFirmField();
    } else {
      lawyerFields.classList.add('hidden');
      lawyerInputs.forEach(fieldId => {
        const field = document.getElementById(fieldId);
        if (field) {
          // Store the original name attribute before removing it
          if (field.name) {
            field.dataset.originalName = field.name;
            field.name = ''; // Remove name attribute to prevent form submission
          }
          field.disabled = true;
          field.required = false;
          if (field.tagName === 'SELECT') {
            field.selectedIndex = 0;
          } else {
            field.value = '';
          }
        }
      });
      // Disable law firm checkbox and field
      const inLawFirmCheckbox = document.getElementById('inLawFirm');
      if (inLawFirmCheckbox) {
        inLawFirmCheckbox.disabled = true;
        inLawFirmCheckbox.checked = false;
      }
      const lawFirmField = document.getElementById('lawFirm');
      if (lawFirmField) {
        lawFirmField.disabled = true;
        lawFirmField.value = '';
        if (lawFirmField.name) {
          lawFirmField.dataset.originalName = lawFirmField.name;
          lawFirmField.name = '';
        }
      }
      document.getElementById('lawFirmInputContainer').classList.add('hidden');
    }
  }

  // Function to toggle law firm input field based on checkbox
  function toggleLawFirmField() {
    const inLawFirm = document.getElementById('inLawFirm');
    const lawFirmContainer = document.getElementById('lawFirmInputContainer');
    const lawFirmInput = document.getElementById('lawFirm');
    
    if (inLawFirm.checked) {
      lawFirmContainer.classList.remove('hidden');
      lawFirmInput.disabled = false;
      lawFirmInput.required = true;
      if (lawFirmInput.dataset.originalName) {
        lawFirmInput.name = lawFirmInput.dataset.originalName;
      }
    } else {
      lawFirmContainer.classList.add('hidden');
      lawFirmInput.disabled = true;
      lawFirmInput.required = false;
      lawFirmInput.value = '';
      // Store original name and remove it from form submission
      if (lawFirmInput.name) {
        lawFirmInput.dataset.originalName = lawFirmInput.name;
        lawFirmInput.name = '';
      }
    }
  }

  // Generic function to toggle text input visibility when "Other" is selected
  function toggleInput(selectId, inputId) {
    const selectElem = document.getElementById(selectId);
    const inputElem = document.getElementById(inputId);
    if (selectElem.value === 'other') {
      inputElem.classList.remove('hidden');
      inputElem.required = true;
    } else {
      inputElem.classList.add('hidden');
      inputElem.required = false;
    }
  }
</script>
</body>
</html>
