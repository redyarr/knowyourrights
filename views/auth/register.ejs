<div class="min-h-screen flex flex-col items-center justify-center bg-[#f3f2ef] py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full">
    <div class="text-center">
      <h2 class="text-3xl font-bold mb-2">Join Legal Network</h2>
      <p class="text-gray-600 mb-8">Make the most of your professional life</p>
    </div>

    <div class="bg-white p-8 rounded-lg shadow-sm">
      <% if (error) { %>
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
          <%= error %>
        </div>
      <% } %>

      <form action="/register" method="POST" class="space-y-6">
        <!-- Basic Info -->
        <div>
          <label class="block text-gray-700 font-medium mb-2" for="role">I want to join as:</label>
          <select name="role" id="role" class="w-full border border-gray-300 rounded-lg p-3"
            onchange="toggleLawyerFields()">
            <option value="visitor">Regular User</option>
            <option value="lawyer">Lawyer</option>
          </select>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-gray-700 font-medium mb-2" for="firstName">First name</label>
            <input type="text" name="firstName" id="firstName" required
              class="w-full border border-gray-300 rounded-lg p-3">
          </div>
          <div>
            <label class="block text-gray-700 font-medium mb-2" for="lastName">Last name</label>
            <input type="text" name="lastName" id="lastName" required
              class="w-full border border-gray-300 rounded-lg p-3">
          </div>
        </div>

        <div>
          <label class="block text-gray-700 font-medium mb-2" for="email">Email</label>
          <input type="email" name="email" id="email" required
            class="w-full border border-gray-300 rounded-lg p-3">
        </div>

        <div>
          <label class="block text-gray-700 font-medium mb-2" for="password">Password (6 or more characters)</label>
          <input type="password" name="password" id="password" required minlength="6"
            class="w-full border border-gray-300 rounded-lg p-3">
        </div>

        <!-- Lawyer Specific Fields -->
        <div id="lawyerFields" class="hidden space-y-6">
          <div>
            <label class="block text-gray-700 font-medium mb-2" for="lawFirm">Law Firm</label>
            <input type="text" name="lawFirm" id="lawFirm" class="w-full border border-gray-300 rounded-lg p-3">
          </div>

          <div>
            <label class="block text-gray-700 font-medium mb-2" for="licenseNumber">License Number</label>
            <input type="text" name="licenseNumber" id="licenseNumber" class="w-full border border-gray-300 rounded-lg p-3">
          </div>

          <div>
            <label class="block text-gray-700 font-medium mb-2" for="authority">Issuing Authority</label>
            <select name="authority" id="authority" class="w-full border border-gray-300 rounded-lg p-3" required>
              <option value="">Select Authority</option>
              <option value="Training">Training</option>
              <option value="Working">Working</option>
              <option value="Legal Consultant">Legal Consultant</option>
            </select>
          </div>

          <div>
            <label class="block text-gray-700 font-medium mb-2" for="summary">Professional Summary</label>
            <textarea name="summary" id="summary" rows="3" class="w-full border border-gray-300 rounded-lg p-3"></textarea>
          </div>

          <div>
            <label class="block text-gray-700 font-medium mb-2" for="badgeId">Badge ID</label>
            <input type="text" name="badgeId" id="badgeId" class="w-full border border-gray-300 rounded-lg p-3">
          </div>

          <div>
            <label class="block text-gray-700 font-medium mb-2" for="badgeIssueDate">Badge Issue Date</label>
            <input type="date" name="badgeIssueDate" id="badgeIssueDate" class="w-full border border-gray-300 rounded-lg p-3">
          </div>

          <div>
            <label class="block text-gray-700 font-medium mb-2" for="badgeExpiryDate">Badge Expiry Date</label>
            <input type="date" name="badgeExpiryDate" id="badgeExpiryDate" class="w-full border border-gray-300 rounded-lg p-3">
          </div>

          <div>
            <label class="block text-gray-700 font-medium mb-2" for="university">University</label>
            <input type="text" name="university" id="university" class="w-full border border-gray-300 rounded-lg p-3" required>
          </div>
          <div>
            <label class="block text-gray-700 font-medium mb-2" for="degreeLevel">Degree Level</label>
            <select name="degreeLevel" id="degreeLevel" class="w-full border border-gray-300 rounded-lg p-3" required>
              <option value="">Select Degree</option>
              <option value="LLB">LLB</option>
              <option value="LLM">LLM</option>
              <option value="JD">JD</option>
              <option value="PhD in Law">PhD in Law</option>
            </select>
          </div>
          <!-- Badge image upload is not included here since this is a general auth/register page. Add if needed. -->
        </div>

        <button type="submit" class="w-full bg-blue-600 text-white py-3 rounded-lg font-semibold">Register</button>
      </form>
    </div>
  </div>
</div>
<script>
function toggleLawyerFields() {
  var role = document.getElementById('role').value;
  var lawyerFields = document.getElementById('lawyerFields');
  if (role === 'lawyer') {
    lawyerFields.classList.remove('hidden');
  } else {
    lawyerFields.classList.add('hidden');
  }
}
</script>


