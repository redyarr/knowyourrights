<div class="min-h-screen bg-gradient-to-br from-blue-50 via-indigo-50 to-purple-50 flex items-center justify-center relative overflow-hidden">
    <!-- Enhanced background decorative elements -->
    <div class="absolute top-0 left-0 w-full h-full">
        <div class="absolute top-20 left-10 w-32 h-32 bg-gradient-to-r from-blue-200 to-indigo-200 rounded-full opacity-30 animate-pulse blur-sm"></div>
        <div class="absolute bottom-20 right-10 w-24 h-24 bg-gradient-to-r from-indigo-200 to-purple-200 rounded-full opacity-40 animate-pulse blur-sm" style="animation-delay: 1s;"></div>
        <div class="absolute top-1/2 left-1/4 w-16 h-16 bg-gradient-to-r from-purple-200 to-pink-200 rounded-full opacity-35 animate-pulse blur-sm" style="animation-delay: 2s;"></div>
        <div class="absolute top-1/3 right-1/4 w-20 h-20 bg-gradient-to-r from-cyan-200 to-blue-200 rounded-full opacity-25 animate-pulse blur-sm" style="animation-delay: 3s;"></div>
    </div>
    
    <div class="glass-card bg-white/80 backdrop-blur-lg shadow-2xl rounded-3xl p-12 max-w-xl w-full mx-4 relative z-10 border border-white/20">
        <!-- Logo/Icon -->
        <div class="text-center mb-6">
            <div class="inline-flex items-center justify-center w-20 h-20 bg-gradient-to-r from-blue-600 to-indigo-600 rounded-2xl mb-4 shadow-lg">
                <i class="fas fa-balance-scale text-white text-2xl"></i>
            </div>
        </div>
        
        <h1 class="text-5xl font-bold text-center mb-4 bg-gradient-to-r from-blue-600 to-indigo-600 bg-clip-text text-transparent">Know Your Rights</h1>
        <p class="text-gray-500 text-center mb-2 text-lg font-medium">Legal Network Platform</p>
        <p class="text-gray-600 text-center mb-8 leading-relaxed">Connect with qualified lawyers, access legal resources, and understand your rights in a professional legal community.</p>
        
        <div class="flex flex-col space-y-4">
            <% if (!locals.loggedInUserId) { %>
            <a href="/login" class="group flex items-center justify-center bg-gradient-to-r from-blue-500 to-blue-600 text-white py-4 px-6 rounded-xl shadow-lg hover:shadow-xl hover:from-blue-600 hover:to-blue-700 transition-all duration-300 transform hover:-translate-y-1">
                <i class="fas fa-sign-in-alt text-lg mr-3 group-hover:scale-110 transition-transform"></i>
                <span class="font-semibold text-lg">Log In</span>
            </a>
            <a href="/register" class="group flex items-center justify-center bg-gradient-to-r from-green-500 to-emerald-600 text-white py-4 px-6 rounded-xl shadow-lg hover:shadow-xl hover:from-green-600 hover:to-emerald-700 transition-all duration-300 transform hover:-translate-y-1">
                <i class="fas fa-user-plus text-lg mr-3 group-hover:scale-110 transition-transform"></i>
                <span class="font-semibold text-lg">Register</span>
            </a>
            <a href="/auth/google" class="group flex items-center justify-center bg-gradient-to-r from-red-500 to-red-600 text-white py-4 px-6 rounded-xl shadow-lg hover:shadow-xl hover:from-red-600 hover:to-red-700 transition-all duration-300 transform hover:-translate-y-1">
                <i class="fab fa-google text-lg mr-3 group-hover:scale-110 transition-transform"></i>
                <span class="font-semibold text-lg">Log In with Google</span>
            </a>
            
            <!-- Quick access section for non-logged users -->
            <div class="mt-8 pt-6 border-t border-gray-200">
                <p class="text-center text-gray-600 mb-4 font-medium">Explore without signing up:</p>
                <div class="grid grid-cols-2 gap-3">
                    <a href="/resources/consumer" class="flex flex-col items-center p-4 bg-purple-50 rounded-lg hover:bg-purple-100 transition group">
                        <i class="fas fa-shield-alt text-purple-600 text-xl mb-2 group-hover:scale-110 transition-transform"></i>
                        <span class="text-sm font-medium text-purple-700">Legal Guides</span>
                    </a>
                    <a href="/search" class="flex flex-col items-center p-4 bg-indigo-50 rounded-lg hover:bg-indigo-100 transition group">
                        <i class="fas fa-search text-indigo-600 text-xl mb-2 group-hover:scale-110 transition-transform"></i>
                        <span class="text-sm font-medium text-indigo-700">Find Lawyers</span>
                    </a>
                </div>
            </div>
            <% } else { %>
            <div class="text-center py-4">
                <div class="inline-flex items-center justify-center w-16 h-16 bg-green-100 rounded-full mb-4">
                    <i class="fas fa-check text-green-600 text-2xl"></i>
                </div>
                <p class="text-xl font-semibold text-gray-800 mb-2">Welcome back!</p>
                <p class="text-gray-600 mb-6">You are successfully logged in.</p>
                <a href="/feed" class="inline-flex items-center bg-gradient-to-r from-blue-600 to-indigo-600 text-white px-8 py-4 rounded-xl font-semibold hover:from-blue-700 hover:to-indigo-700 transition-all duration-300 transform hover:-translate-y-1 shadow-lg hover:shadow-xl">
                    <i class="fas fa-home mr-3"></i>
                    Go to Feed
                </a>
            </div>
            <% } %>
        </div>
        
        <!-- Footer info -->
        <div class="mt-8 pt-6 border-t border-gray-100 text-center">
            <p class="text-xs text-gray-500">Secure • Professional • Trusted Legal Network</p>
        </div>
    </div>
</div>