<div class="min-h-screen bg-gray-50 flex items-center justify-center px-4 py-8">
    <div class="bg-white shadow-lg rounded-lg p-8 max-w-md w-full">
        <!-- Logo/Icon -->
        <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center w-16 h-16 bg-blue-600 rounded-lg mb-4">
                <i class="fas fa-balance-scale text-white text-xl"></i>
            </div>
            <h1 class="text-3xl font-bold text-gray-900 mb-2">Know Your Rights</h1>
            <p class="text-gray-600">Legal Network Platform</p>
        </div>
        
        <div class="mb-8">
            <p class="text-gray-700 text-center leading-relaxed">Connect with qualified lawyers, access legal resources, and understand your rights in a professional legal community.</p>
        </div>
        
        <div class="space-y-4">
            <% if (!locals.loggedInUserId) { %>
            <a href="/login" class="w-full flex items-center justify-center bg-blue-600 text-white py-3 px-4 rounded-md hover:bg-blue-700 transition font-medium">
                <i class="fas fa-sign-in-alt mr-2"></i>
                Sign In
            </a>
            <a href="/register" class="w-full flex items-center justify-center border border-blue-600 text-blue-600 py-3 px-4 rounded-md hover:bg-blue-50 transition font-medium">
                <i class="fas fa-user-plus mr-2"></i>
                Join Now
            </a>
            
            <div class="relative my-6">
                <div class="absolute inset-0 flex items-center">
                    <div class="w-full border-t border-gray-300"></div>
                </div>
                <div class="relative flex justify-center text-sm">
                    <span class="px-2 bg-white text-gray-500">or</span>
                </div>
            </div>
            
            <a href="/auth/google" class="w-full flex items-center justify-center border border-gray-300 text-gray-700 py-3 px-4 rounded-md hover:bg-gray-50 transition font-medium">
                <svg class="w-5 h-5 mr-2" viewBox="0 0 24 24">
                    <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                    <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                    <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                    <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                </svg>
                Continue with Google
            </a>
            
            <!-- Quick access section -->
            <div class="mt-8 pt-6 border-t border-gray-200">
                <p class="text-center text-gray-600 mb-4 text-sm">Explore without signing up:</p>
                <div class="grid grid-cols-2 gap-3">
                    <a href="/resources/consumer" class="flex flex-col items-center p-3 border border-gray-200 rounded-md hover:bg-gray-50 transition">
                        <i class="fas fa-shield-alt text-blue-600 text-lg mb-1"></i>
                        <span class="text-xs font-medium text-gray-700">Legal Guides</span>
                    </a>
                    <a href="/search" class="flex flex-col items-center p-3 border border-gray-200 rounded-md hover:bg-gray-50 transition">
                        <i class="fas fa-search text-blue-600 text-lg mb-1"></i>
                        <span class="text-xs font-medium text-gray-700">Find Lawyers</span>
                    </a>
                </div>
            </div>
            <% } else { %>
            <div class="text-center py-6">
                <div class="inline-flex items-center justify-center w-12 h-12 bg-green-100 rounded-full mb-4">
                    <i class="fas fa-check text-green-600 text-lg"></i>
                </div>
                <p class="text-lg font-semibold text-gray-900 mb-2">Welcome back!</p>
                <p class="text-gray-600 mb-6">You are successfully logged in.</p>
                <a href="/feed" class="inline-flex items-center bg-blue-600 text-white px-6 py-3 rounded-md font-medium hover:bg-blue-700 transition">
                    <i class="fas fa-home mr-2"></i>
                    Go to Feed
                </a>
            </div>
            <% } %>
        </div>
        
        <!-- Footer info -->
        <div class="mt-8 pt-6 border-t border-gray-100 text-center">
            <p class="text-xs text-gray-500">Secure • Professional • Trusted Legal Network</p>
        </div>
    </div>
</div>