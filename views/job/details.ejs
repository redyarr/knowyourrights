<div class="max-w-4xl mx-auto py-8">
    <div class="bg-white rounded-lg shadow-md p-6 mb-6">
        <div class="flex justify-between items-start">
            <div>
                <h1 class="text-2xl font-bold text-blue-800 mb-2">Job Details</h1>
                <div class="flex items-center mb-4">
                    <% if (job.user.ProfileImage && job.user.ProfileImage.imagePath) { %>
                        <img src="<%= job.user.ProfileImage.imagePath %>" alt="<%= job.user.firstName %>'s profile image" class="w-10 h-10 rounded-full object-cover mr-3">
                    <% } else { %>
                        <img src="https://ui-avatars.com/api/?name=<%= job.user.firstName %>+<%= job.user.lastName %>" alt="Profile image" class="w-10 h-10 rounded-full object-cover mr-3">
                    <% } %>
                    <p class="text-sm text-gray-500">
                        Posted by <span class="font-medium"><%= job.user.firstName %> <%= job.user.lastName %></span> on
                        <%= new Date(job.createdAt).toLocaleDateString('en-US', { year: 'numeric' , month: 'long' ,
                            day: 'numeric' }) %>
                    </p>
                </div>
            </div>
            <div class="flex items-center space-x-2">
                <% if (isAuthor) { %>
                    <button onclick="confirmDelete()"
                        class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition duration-300 flex items-center">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16">
                            </path>
                        </svg>
                        Delete Job
                    </button>
                    <% } %>
                        <a href="/jobs" class="text-blue-600 hover:text-blue-800">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                            </svg>
                        </a>
            </div>
        </div>

        <div class="mt-4">
            <div class="flex items-center mb-2">
                <svg class="w-5 h-5 text-gray-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
                <span class="text-gray-700">
                    <%= job.city %>, <%= job.country %>
                </span>
            </div>

            <div class="prose max-w-none mt-4">
                <p class="text-gray-700">
                    <%= job.summary %>
                </p>
            </div>
        </div>

        <% if (locals.user && user.role==='lawyer' && !isAuthor && !hasApplied) { %>
            <div class="mt-6 border-t pt-4">
                <h3 class="text-lg font-semibold mb-2">Apply for this Job</h3>
                <form action="/jobs/<%= job.id %>/apply" method="POST" class="space-y-4">
                    <div>
                        <label for="message" class="block text-gray-700 font-medium mb-2">Message to Client</label>
                        <textarea id="message" name="message" rows="3" required
                            class="w-full border border-gray-300 rounded-lg p-3 focus:outline-none focus:ring-2 focus:ring-blue-500"
                            placeholder="Explain why you're a good fit for this job..."></textarea>
                    </div>

                    <div class="flex justify-end">
                        <button type="submit"
                            class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition duration-300">
                            Request This Job
                        </button>
                    </div>
                </form>
            </div>
            <% } else if (locals.user && user.role==='lawyer' && hasApplied) { %>
                <div class="mt-6 border-t pt-4">
                    <div class="bg-blue-50 text-blue-700 p-4 rounded-lg">
                        <p>You have already applied for this job. The client will contact you if they're interested.</p>
                    </div>
                </div>
                <% } %>
    </div>

    <% if (isAuthor && applicants && applicants.length > 0) { %>
        <div class="bg-white rounded-lg shadow-md p-6">
            <h2 class="text-xl font-bold text-blue-800 mb-4">Lawyer Applications</h2>

            <div class="space-y-4">
                <% applicants.forEach(application => { %>
                    <div class="border rounded-lg p-4 <%= application.status === 'accepted' ? 'border-green-500 bg-green-50' : (application.status === 'rejected' ? 'border-red-300 bg-red-50' : 'border-gray-200') %>">
                        <div class="flex justify-between items-start">
                            <div>
                                <h3 class="font-semibold text-lg">
                                    <%= application.user.firstName %> <%= application.user.lastName %>
                                </h3>
                                <p class="text-sm text-gray-600 mt-1">
                                    <% if (application.user.lawyer.lawFirm) { %>
                                        <%= application.user.lawyer.lawFirm %> • 
                                    <% } %>
                                    Badge: <%= application.user.lawyer.badgeNumber %> 
                                    (<%= application.user.lawyer.badgeIssuingAuthority %>)
                                </p>
                                <div class="mt-2">
                                    <p class="text-gray-700">
                                        <%= application.message %>
                                    </p>
                                </div>
                                <div class="mt-2">
                                    <p class="text-sm text-gray-500">
                                        Applied on <%= new Date(application.createdAt).toLocaleDateString() %>
                                    </p>
                                </div>
                            </div>

                            <div>
                                <% if (application.status==='pending' ) { %>
                                    <form action="/jobs/<%= job.id %>/accept/<%= application.id %>" method="POST">
                                        <button type="submit"
                                            class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition duration-300">
                                            Accept Lawyer
                                        </button>
                                    </form>
                                    <% } else if (application.status==='accepted' ) { %>
                                        <span
                                            class="inline-block px-3 py-1 bg-green-100 text-green-800 rounded-full font-medium">
                                            Accepted
                                        </span>
                                        <% } else { %>
                                            <span
                                                class="inline-block px-3 py-1 bg-red-100 text-red-800 rounded-full font-medium">
                                                Rejected
                                            </span>
                                            <% } %>
                            </div>
                        </div>
                    </div>
                    <% }); %>
            </div>
        </div>
        <% } else if (isAuthor) { %>
            <div class="bg-white rounded-lg shadow-md p-6 text-center">
                <p class="text-gray-500">No lawyers have applied for this job yet.</p>
            </div>
            <% } %>
</div>

<!-- Delete Confirmation Modal -->
<% if (isAuthor) { %>
    <div id="deleteModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 hidden z-50">
        <div class="flex items-center justify-center min-h-screen">
            <div class="bg-white rounded-lg p-6 max-w-md w-full mx-4">
                <h3 class="text-lg font-semibold text-gray-900 mb-4">Confirm Delete</h3>
                <p class="text-gray-600 mb-6">Are you sure you want to delete this job? This action cannot be undone and
                    will also remove all applications.</p>
                <div class="flex justify-end space-x-3">
                    <button onclick="closeDeleteModal()"
                        class="px-4 py-2 bg-gray-300 text-gray-700 rounded-lg hover:bg-gray-400 transition duration-300">
                        Cancel
                    </button>
                    <form action="/jobs/<%= job.id %>?_method=DELETE" method="POST" class="inline">
                        <button type="submit"
                            class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition duration-300">
                            Delete
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script>
        function confirmDelete() {
            document.getElementById('deleteModal').classList.remove('hidden');
        }

        function closeDeleteModal() {
            document.getElementById('deleteModal').classList.add('hidden');
        }
    </script>
    <% } %>