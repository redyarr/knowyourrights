<div class="max-w-2xl mx-auto p-4">
    <% if (jobs && jobs.length > 0) { %>
        <ul class="space-y-4">
            <% jobs.forEach(job => { %>
                <li class="bg-white rounded-lg shadow-sm p-6 hover:shadow-md transition-shadow duration-200">
                    <div class="space-y-3">
                        <div class="flex items-start justify-between">
                            <h2 class="text-lg font-semibold text-gray-900"><%=// job.authorId %></h2>
                            <span class="text-sm text-gray-500">
                                <%= new Date(job.createdAt).toLocaleDateString() %>
                            </span>
                        </div>
                        <p class="text-gray-700 text-base leading-relaxed">
                            <%= job.summary %>
                        </p>
                    </div>
                </li>
            <% }); %>
        </ul>
    <% } else { %>
        <div class="text-center py-12">
            <p class="text-gray-600">No jobs available at the moment. Please check back later.</p>
        </div>
    <% } %>
</div>
