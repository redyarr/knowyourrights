<div class="min-h-screen bg-gradient-to-br from-blue-50 via-indigo-50 to-purple-50">
    <!-- Background decorative elements -->
    <div class="fixed inset-0 overflow-hidden pointer-events-none">
        <div class="absolute top-20 left-10 w-72 h-72 bg-gradient-to-r from-blue-400/30 to-purple-400/30 rounded-full blur-3xl opacity-70"></div>
        <div class="absolute bottom-20 right-10 w-96 h-96 bg-gradient-to-r from-indigo-400/30 to-pink-400/30 rounded-full blur-3xl opacity-70"></div>
        <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-80 h-80 bg-gradient-to-r from-purple-400/20 to-blue-400/20 rounded-full blur-3xl opacity-60"></div>
    </div>
    
    <div class="container mx-auto px-4 py-8 relative z-10">
    <div class="glass-card p-8 mb-8">
        <div class="flex justify-between items-center">
            <div class="flex items-center">
                <div class="w-16 h-16 bg-gradient-to-r from-blue-600 to-indigo-700 rounded-xl flex items-center justify-center mr-6 shadow-lg">
                    <i class="fas fa-briefcase text-white text-2xl"></i>
                </div>
                <h1 class="text-4xl font-bold bg-gradient-to-r from-blue-800 to-indigo-700 bg-clip-text text-transparent">Job Opportunities</h1>
            </div>
            <% if (locals.user && user.role !=='lawyer' ) { %>
                <a href="/jobs/create"
                    class="glass-button px-8 py-4 bg-gradient-to-r from-blue-600 to-indigo-600 text-white rounded-xl hover:from-blue-700 hover:to-indigo-700 transition-all duration-300 transform hover:-translate-y-1 shadow-lg hover:shadow-xl font-semibold">
                    <svg class="w-5 h-5 mr-2 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                    </svg>
                    Post a Job
                </a>
                <% } %>
        </div>
    </div>

    <% if (jobs && jobs.length> 0) { %>
        <div class="max-w-4xl mx-auto">
            <ul class="space-y-6">
                <% jobs.forEach(job=> { %>
                    <li class="glass-card p-8 hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1">
                        <div class="flex items-start justify-between">
                            <div class="flex-1">
                                <div class="flex items-center space-x-6 mb-6">
                                    <% if (job.user && job.user.ProfileImage && job.user.ProfileImage.imagePath) { %>
                                        <img src="<%= job.user.ProfileImage.imagePath %>" alt="<%= job.user.firstName %>'s profile image" class="w-16 h-16 rounded-full object-cover shadow-lg ring-2 ring-white/50">
                                    <% } else if (job.user) { %>
                                        <img src="https://ui-avatars.com/api/?name=<%= job.user.firstName %>+<%= job.user.lastName %>" alt="Profile image" class="w-16 h-16 rounded-full object-cover shadow-lg ring-2 ring-white/50">
                                    <% } else { %>
                                        <div class="w-16 h-16 bg-gradient-to-r from-gray-400 to-gray-500 rounded-full flex items-center justify-center shadow-lg ring-2 ring-white/50">
                                            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor"
                                                viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                    d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2-2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z">
                                                </path>
                                            </svg>
                                        </div>
                                    <% } %>
                                    <div>
                                        <h2 class="text-2xl font-bold text-gray-800">
                                            <% if (job.user) { %>
                                                <%= job.user.firstName %> <%= job.user.lastName %>
                                            <% } else { %>
                                                Unknown User
                                            <% } %>
                                        </h2>
                                        <p class="text-sm text-gray-500 font-medium mt-1">
                                            Posted on <%= new Date(job.createdAt).toLocaleDateString('en-US', {
                                                year: 'numeric' , month: 'long' , day: 'numeric' }) %>
                                        </p>
                                        <p class="text-sm text-gray-500 mt-2">
                                            <span class="inline-flex items-center bg-blue-100 text-blue-800 px-3 py-1 rounded-full font-medium">
                                                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor"
                                                    viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round"
                                                        stroke-width="2"
                                                        d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z">
                                                    </path>
                                                    <path stroke-linecap="round" stroke-linejoin="round"
                                                        stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                                </svg>
                                                <%= job.city %>, <%= job.country %>
                                            </span>
                                        </p>
                                    </div>
                                </div>
                                <div class="prose max-w-none">
                                    <p class="text-gray-700 leading-relaxed">
                                        <%= job.summary %>
                                    </p>
                                </div>
                                <div class="mt-4 flex items-center space-x-4">
                                    <a href="/jobs/<%= job.id %>"
                                        class="inline-flex items-center px-4 py-2 bg-blue-600 text-white rounded-full hover:bg-blue-700 transition duration-300">
                                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z">
                                            </path>
                                        </svg>
                                        View Details
                                    </a>
                                    <button
                                        class="inline-flex items-center px-4 py-2 border border-gray-300 text-gray-700 rounded-full hover:bg-gray-50 transition duration-300">
                                        Share
                                    </button>
                                </div>
                            </div>
                        </div>
                    </li>
                    <% }); %>
            </ul>
        </div>
        <% } else { %>
            <div class="max-w-4xl mx-auto text-center py-12">
                <div class="rounded-lg bg-white p-8 shadow-sm">
                    <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z">
                        </path>
                    </svg>
                    <p class="mt-4 text-lg text-gray-500">No jobs available at the moment.</p>
                    <% if (locals.user && user.role !=='lawyer' ) { %>
                        <div class="mt-6">
                            <a href="/jobs/create"
                                class="inline-flex items-center px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition duration-300">
                                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M12 4v16m8-8H4"></path>
                                </svg>
                                Post Your First Job
                            </a>
                        </div>
                        <% } %>
                </div>
            </div>
            <% } %>
</div>

<% if (typeof req !=='undefined' && req.query && req.query.deleted==='true' ) { %>
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
        Job deleted successfully.
    </div>
    <% } %>

<style>
/* Enhanced responsive styles for jobs page */
@media (max-width: 768px) {
    /* Background elements mobile */
    .fixed.inset-0 {
        display: none; /* Hide decorative backgrounds on mobile for performance */
    }
    
    .container {
        padding: 0.5rem;
    }
    
    .glass-card {
        margin: 0.5rem 0;
        padding: 1rem !important;
        border-radius: 1rem;
    }
    
    /* Header mobile */
    .flex.justify-between.items-center {
        flex-direction: column;
        align-items: flex-start;
        gap: 1rem;
        text-align: center;
    }
    
    .flex.items-center {
        flex-direction: column;
        text-align: center;
    }
    
    .w-16.h-16 {
        width: 3rem !important;
        height: 3rem !important;
        margin-right: 0 !important;
        margin-bottom: 1rem;
    }
    
    .text-4xl {
        font-size: 1.5rem;
        text-align: center;
    }
    
    .glass-button {
        width: 100%;
        justify-content: center;
        margin-top: 1rem;
    }
    
    /* Job cards mobile */
    .max-w-4xl {
        max-width: 100%;
    }
    
    .space-y-6 {
        gap: 1rem;
    }
    
    .flex.items-start.justify-between {
        flex-direction: column;
        align-items: flex-start;
    }
    
    .flex.items-center.space-x-6 {
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 1rem;
        margin-bottom: 1rem;
    }
    
    .flex.items-center.space-x-6 > * {
        margin-right: 0 !important;
    }
    
    .text-2xl {
        font-size: 1.25rem;
        text-align: center;
    }
    
    .prose {
        max-width: 100%;
        text-align: left;
    }
    
    .flex.items-center.space-x-4 {
        flex-direction: column;
        align-items: stretch;
        gap: 0.5rem;
    }
    
    .flex.items-center.space-x-4 > * {
        margin-right: 0 !important;
        width: 100%;
        text-align: center;
    }
    
    .inline-flex {
        justify-content: center;
    }
}

@media (max-width: 480px) {
    .container {
        padding: 0.25rem;
    }
    
    .glass-card {
        padding: 0.75rem !important;
        margin: 0.25rem 0;
    }
    
    .text-4xl {
        font-size: 1.25rem;
    }
    
    .text-2xl {
        font-size: 1.125rem;
    }
    
    .w-16.h-16 {
        width: 2.5rem !important;
        height: 2.5rem !important;
    }
    
    .px-8 {
        padding-left: 0.75rem !important;
        padding-right: 0.75rem !important;
    }
    
    .py-4 {
        padding-top: 0.75rem !important;
        padding-bottom: 0.75rem !important;
    }
    
    .glass-button {
        padding: 0.5rem 1rem;
        font-size: 0.875rem;
    }
}

/* Tablet adjustments */
@media (min-width: 769px) and (max-width: 1024px) {
    .container {
        padding: 1rem;
    }
    
    .max-w-4xl {
        max-width: 90%;
    }
    
    .flex.justify-between.items-center {
        flex-direction: row;
        align-items: center;
    }
    
    .flex.items-center.space-x-6 {
        flex-direction: row;
        align-items: center;
        gap: 1.5rem;
    }
    
    .w-16.h-16 {
        width: 4rem !important;
        height: 4rem !important;
    }
}
</style>