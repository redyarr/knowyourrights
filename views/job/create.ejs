<div class="max-w-4xl mx-auto py-8">
    <div class="bg-white rounded-2xl shadow-lg overflow-hidden">
        <div class="px-6 py-4 bg-blue-50 border-b">
            <div class="flex items-center justify-between">
                <h1 class="text-2xl font-bold text-blue-800">Create a Job Posting</h1>
                <a href="/jobs" class="glass-button bg-gray-600/90 backdrop-blur-sm text-white p-3 rounded-xl shadow-lg hover:bg-gray-700/90 transition-all duration-300 transform hover:-translate-y-1 border border-white/20" title="Back to Jobs">
                    <i class="fas fa-arrow-left"></i>
                </a>
            </div>
        </div>
        
        <div class="p-6">
            <% if (locals.error) { %>
                <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
                    <%= error %>
                </div>
            <% } %>
            
            <form action="/jobs/create" method="POST" class="space-y-6">
                <div>
                    <label for="summary" class="block text-gray-700 font-medium mb-2">Job Summary</label>
                    <textarea 
                        id="summary" 
                        name="summary" 
                        rows="4" 
                        required 
                        class="w-full border border-gray-300 rounded-lg p-3 focus:outline-none focus:ring-2 focus:ring-blue-500"
                        placeholder="Describe the job opportunity..."
                    ></textarea>
                </div>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label for="country" class="block text-gray-700 font-medium mb-2">Country</label>
                        <input 
                            type="text" 
                            id="country" 
                            name="country" 
                            required 
                            class="w-full border border-gray-300 rounded-lg p-3 focus:outline-none focus:ring-2 focus:ring-blue-500"
                            placeholder="Country"
                        >
                    </div>
                    
                    <div>
                        <label for="city" class="block text-gray-700 font-medium mb-2">City</label>
                        <input 
                            type="text" 
                            id="city" 
                            name="city" 
                            required 
                            class="w-full border border-gray-300 rounded-lg p-3 focus:outline-none focus:ring-2 focus:ring-blue-500"
                            placeholder="City"
                        >
                    </div>
                </div>
                
                <div class="flex justify-end">
                    <a href="/jobs" class="px-6 py-3 border border-gray-300 text-gray-700 rounded-lg mr-4 hover:bg-gray-50 transition duration-300">Cancel</a>
                    <button type="submit" class="px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition duration-300">Post Job</button>
                </div>
            </form>
        </div>
    </div>
</div>