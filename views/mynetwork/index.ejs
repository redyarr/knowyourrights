<style>
    .glass-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.2);
    }
    
    .glass-button {
        backdrop-filter: blur(10px);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    
    .glass-button:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
    }
    
    .network-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 1rem;
        padding: 1.5rem;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }
    
    .network-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
        background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
        transform: scaleX(0);
        transition: transform 0.3s ease;
    }
    
    .network-card:hover::before {
        transform: scaleX(1);
    }
    
    .network-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 35px rgba(102, 126, 234, 0.2);
    }
    
    .network-nav {
        border-bottom: 2px solid #e5e7eb;
        margin-bottom: 2rem;
    }
    
    .network-nav-item {
        padding: 1rem 1.5rem;
        border-bottom: 3px solid transparent;
        transition: all 0.3s ease;
        cursor: pointer;
        position: relative;
    }
    
    .network-nav-item.active {
        border-bottom-color: #3b82f6;
        color: #3b82f6;
        font-weight: 600;
    }
    
    .network-nav-item:hover {
        background: rgba(59, 130, 246, 0.05);
        color: #3b82f6;
    }
    
    .network-nav-item .badge {
        position: absolute;
        top: 0.5rem;
        right: 0.5rem;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-radius: 50%;
        width: 1.5rem;
        height: 1.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.75rem;
        font-weight: bold;
    }
    
    .status-badge {
        padding: 0.25rem 0.75rem;
        border-radius: 1rem;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }
    
    .status-pending {
        background: rgba(251, 191, 36, 0.1);
        color: #d97706;
        border: 1px solid rgba(251, 191, 36, 0.3);
    }
    
    .status-connected {
        background: rgba(34, 197, 94, 0.1);
        color: #059669;
        border: 1px solid rgba(34, 197, 94, 0.3);
    }
    
    .action-button {
        padding: 0.5rem 1rem;
        border-radius: 0.5rem;
        font-size: 0.875rem;
        font-weight: 500;
        transition: all 0.3s ease;
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }
    
    .action-accept {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        color: white;
    }
    
    .action-accept:hover {
        transform: translateY(-1px);
        box-shadow: 0 5px 15px rgba(16, 185, 129, 0.4);
    }
    
    .action-decline {
        background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        color: white;
    }
    
    .action-decline:hover {
        transform: translateY(-1px);
        box-shadow: 0 5px 15px rgba(239, 68, 68, 0.4);
    }
    
    .action-message {
        background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
        color: white;
    }
    
    .action-message:hover {
        transform: translateY(-1px);
        box-shadow: 0 5px 15px rgba(59, 130, 246, 0.4);
    }
    
    .action-cancel {
        background: linear-gradient(135deg, #6b7280 0%, #4b5563 100%);
        color: white;
    }
    
    .action-cancel:hover {
        transform: translateY(-1px);
        box-shadow: 0 5px 15px rgba(107, 114, 128, 0.4);
    }
    
    .empty-state {
        text-align: center;
        padding: 3rem;
        color: #6b7280;
    }
    
    .empty-state-icon {
        font-size: 3rem;
        margin-bottom: 1rem;
        opacity: 0.5;
    }
    
    .search-box {
        position: relative;
        margin-bottom: 2rem;
    }
    
    .search-input {
        width: 100%;
        padding: 1rem 1rem 1rem 3rem;
        border: 2px solid #e5e7eb;
        border-radius: 1rem;
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(10px);
        transition: all 0.3s ease;
    }
    
    .search-input:focus {
        outline: none;
        border-color: #3b82f6;
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
    }
    
    .search-icon {
        position: absolute;
        left: 1rem;
        top: 50%;
        transform: translateY(-50%);
        color: #6b7280;
    }
    
    .floating-add {
        position: fixed;
        bottom: 2rem;
        right: 2rem;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-radius: 50%;
        width: 60px;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 10px 25px rgba(102, 126, 234, 0.3);
        transition: all 0.3s ease;
        z-index: 1000;
        text-decoration: none;
    }
    
    .floating-add:hover {
        transform: scale(1.1) rotate(5deg);
        box-shadow: 0 15px 35px rgba(102, 126, 234, 0.4);
    }
</style>

<div class="min-h-screen bg-gray-50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
        <!-- Header -->
        <div class="mb-6">
            <h1 class="text-2xl font-semibold text-gray-900 mb-2">
                My Network
            </h1>
            <p class="text-gray-600 text-sm">
                Manage your professional relationships
            </p>
        </div>

        <!-- Navigation Tabs -->
        <div class="bg-white rounded-lg border border-gray-200 mb-6">
            <div class="flex border-b border-gray-200">
                <button onclick="showTab('requests')" id="requests-tab" class="network-nav-item active flex-1 px-4 py-3 text-sm font-medium text-center border-b-2 border-blue-600 text-blue-600" data-tab="requests">
                    Requests
                    <% if (connectionRequests && connectionRequests.length > 0) { %>
                        <span class="ml-2 bg-gray-100 text-gray-600 px-2 py-1 rounded-full text-xs"><%= connectionRequests.length %></span>
                    <% } %>
                </button>
                <button onclick="showTab('pending')" id="pending-tab" class="network-nav-item flex-1 px-4 py-3 text-sm font-medium text-center border-b-2 border-transparent text-gray-500 hover:text-gray-700" data-tab="pending">
                    Pending
                    <% if (pendingRequests && pendingRequests.length > 0) { %>
                        <span class="ml-2 bg-gray-100 text-gray-600 px-2 py-1 rounded-full text-xs"><%= pendingRequests.length %></span>
                    <% } %>
                </button>
                <button onclick="showTab('connections')" id="connections-tab" class="network-nav-item flex-1 px-4 py-3 text-sm font-medium text-center border-b-2 border-transparent text-gray-500 hover:text-gray-700" data-tab="connections">
                    Connections
                    <% if (friends && friends.length > 0) { %>
                        <span class="ml-2 bg-gray-100 text-gray-600 px-2 py-1 rounded-full text-xs"><%= friends.length %></span>
                    <% } %>
                </button>
            </div>
        </div>

        <!-- Search Box -->
        <div class="search-box">
            <div class="search-icon">
                <i class="fas fa-search"></i>
            </div>
            <input type="text" class="search-input" placeholder="Search your network..." id="networkSearch">
        </div>

    <!-- Tab Content -->
    <div class="tab-content-container">
        <!-- Connection Requests Tab -->
        <div id="requests-tab" class="tab-content">
            <% if (connectionRequests && connectionRequests.length > 0) { %>
                <div class="space-y-4">
                    <% connectionRequests.forEach(request => { %>
                        <div class="bg-white border border-gray-200 rounded-lg p-4 searchable-item" data-name="<%= request.requester.firstName %> <%= request.requester.lastName %>">
                            <div class="flex items-start space-x-4">
                                <!-- Profile Image -->
                                <div class="flex-shrink-0">
                                    <% if (request.requester.ProfileImage && request.requester.ProfileImage.imagePath) { %>
                                        <img src="<%= request.requester.ProfileImage.imagePath %>" alt="Profile"
                                            class="w-12 h-12 rounded-full object-cover">
                                    <% } else { %>
                                        <img src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(request.requester.firstName + ' ' + request.requester.lastName) %>&size=48&background=3b82f6&color=ffffff" alt="Profile"
                                            class="w-12 h-12 rounded-full object-cover">
                                    <% } %>
                                </div>
                                
                                <!-- User Info -->
                                <div class="flex-1 min-w-0">
                                    <h3 class="font-medium text-gray-900">
                                        <%= request.requester.firstName %> <%= request.requester.lastName %>
                                    </h3>
                                    <p class="text-sm text-gray-600">
                                        <%= request.requester.role %>
                                        <% if (request.requester.role === 'lawyer' && request.requester.Lawyer) { %>
                                            • <%= request.requester.Lawyer.lawFirm || 'Independent Practice' %>
                                        <% } %>
                                    </p>
                                    <p class="text-xs text-gray-500 mt-1">Wants to connect</p>
                                </div>
                                
                                <!-- Action Buttons -->
                                <div class="flex space-x-2">
                                    <button class="px-4 py-2 text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 rounded-md" onclick="acceptRequest('<%= request.id %>')">
                                        Accept
                                    </button>
                                    <button class="px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 hover:bg-gray-200 rounded-md" onclick="declineRequest('<%= request.id %>')">
                                        Decline
                                    </button>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } else { %>
                <div class="bg-white border border-gray-200 rounded-lg p-8 text-center">
                    <div class="text-gray-400 mb-4">
                        <i class="fas fa-user-clock text-4xl"></i>
                    </div>
                    <h3 class="text-lg font-medium text-gray-900 mb-2">No Connection Requests</h3>
                    <p class="text-gray-600">You don't have any pending connection requests at the moment.</p>
                </div>
            <% } %>
        </div>

        <!-- Pending Requests Tab -->
        <div id="pending-tab" class="tab-content hidden">
            <% if (pendingRequests && pendingRequests.length > 0) { %>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    <% pendingRequests.forEach(request => { %>
                        <div class="network-card searchable-item" data-name="<%= request.receiver.firstName %> <%= request.receiver.lastName %>">
                            <div class="flex items-start space-x-4">
                                <!-- Profile Image -->
                                <div class="flex-shrink-0">
                                    <% if (request.receiver.ProfileImage && request.receiver.ProfileImage.imagePath) { %>
                                        <img src="<%= request.receiver.ProfileImage.imagePath %>" alt="Profile"
                                            class="w-16 h-16 rounded-full object-cover border-2 border-white shadow-lg">
                                    <% } else { %>
                                        <img src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(request.receiver.firstName + ' ' + request.receiver.lastName) %>&size=64&background=3b82f6&color=ffffff" alt="Profile"
                                            class="w-16 h-16 rounded-full object-cover border-2 border-white shadow-lg">
                                    <% } %>
                                </div>
                                
                                <!-- User Info -->
                                <div class="flex-1 min-w-0">
                                    <h3 class="font-semibold text-gray-800 truncate">
                                        <%= request.receiver.firstName %> <%= request.receiver.lastName %>
                                    </h3>
                                    <p class="text-sm text-gray-600 capitalize">
                                        <%= request.receiver.role %>
                                        <% if (request.receiver.role === 'lawyer' && request.receiver.Lawyer) { %>
                                            • <%= request.receiver.Lawyer.lawFirm || 'Independent Practice' %>
                                        <% } %>
                                    </p>
                                    <div class="status-badge status-pending mt-2">
                                        <i class="fas fa-hourglass-half mr-1"></i>Awaiting Response
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Action Buttons -->
                            <div class="flex space-x-2 mt-4">
                                <button class="action-button action-cancel flex-1" onclick="cancelRequest('<%= request.id %>')">
                                    <i class="fas fa-times"></i>Cancel Request
                                </button>
                            </div>
                            
                            <!-- View Profile Link -->
                            <div class="mt-3">
                                <a href="/profile/<%= request.receiver.id %>" class="text-blue-600 hover:text-blue-800 text-sm font-medium">
                                    <i class="fas fa-user mr-1"></i>View Profile
                                </a>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <div class="empty-state-icon">
                        <i class="fas fa-clock"></i>
                    </div>
                    <h3 class="text-lg font-semibold mb-2">No Pending Requests</h3>
                    <p>You haven't sent any connection requests that are waiting for a response.</p>
                </div>
            <% } %>
        </div>

        <!-- Connections Tab -->
        <div id="connections-tab" class="tab-content hidden">
            <% if (friends && friends.length > 0) { %>
                 <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                     <% friends.forEach(friend => { %>
                         <% 
                             // Get the connected user from the friend object
                             const connectedUser = friend.connectedUser;
                         %>
                        <div class="network-card searchable-item" data-name="<%= connectedUser.firstName %> <%= connectedUser.lastName %>">
                            <div class="flex items-start space-x-4">
                                <!-- Profile Image -->
                                <div class="flex-shrink-0">
                                    <% if (connectedUser.ProfileImage && connectedUser.ProfileImage.imagePath) { %>
                                        <img src="<%= connectedUser.ProfileImage.imagePath %>" alt="Profile"
                                            class="w-16 h-16 rounded-full object-cover border-2 border-white shadow-lg">
                                    <% } else { %>
                                        <img src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(connectedUser.firstName + ' ' + connectedUser.lastName) %>&size=64&background=3b82f6&color=ffffff" alt="Profile"
                                            class="w-16 h-16 rounded-full object-cover border-2 border-white shadow-lg">
                                    <% } %>
                                </div>
                                
                                <!-- User Info -->
                                <div class="flex-1 min-w-0">
                                    <h3 class="font-semibold text-gray-800 truncate">
                                        <%= connectedUser.firstName %> <%= connectedUser.lastName %>
                                    </h3>
                                    <p class="text-sm text-gray-600 capitalize">
                                        <%= connectedUser.role %>
                                        <% if (connectedUser.role === 'lawyer' && connectedUser.Lawyer) { %>
                                            • <%= connectedUser.Lawyer.lawFirm || 'Independent Practice' %>
                                        <% } %>
                                    </p>
                                    <div class="status-badge status-connected mt-2">
                                        <i class="fas fa-check-circle mr-1"></i>Connected
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Action Buttons -->
                            <div class="flex space-x-2 mt-4">
                                <a href="/messaging/<%= connectedUser.id %>" class="action-button action-message flex-1 text-center text-decoration-none">
                                    <i class="fas fa-envelope"></i>Message
                                </a>
                            </div>
                            
                            <!-- View Profile Link -->
                            <div class="mt-3">
                                <a href="/profile/<%= connectedUser.id %>" class="text-blue-600 hover:text-blue-800 text-sm font-medium">
                                    <i class="fas fa-user mr-1"></i>View Profile
                                </a>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <div class="empty-state-icon">
                        <i class="fas fa-users"></i>
                    </div>
                    <h3 class="text-lg font-semibold mb-2">No Connections Yet</h3>
                    <p>Start building your professional network by connecting with other users.</p>
                    <a href="/search" class="inline-block mt-4 bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700 transition">
                        <i class="fas fa-search mr-2"></i>Find People
                    </a>
                </div>
            <% } %>
        </div>
    </div>
    </div>
</div>

