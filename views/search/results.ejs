<div class="min-h-screen bg-gray-50">
  
  <div class="max-w-7xl mx-auto px-4 py-8">
    <div class="mb-8">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-3xl font-bold text-gray-900 mb-2">Search Results for "<%= query %>"</h1>
          <p class="text-gray-600">
            <% const totalResults = lawyers.length + users.length; %>
            <%= totalResults %> results found
            <% if (searchType !== 'all') { %>
              in <%= searchType %>
            <% } %>
          </p>
        </div>
        <a href="/search" class="glass-button bg-gray-600/90 backdrop-blur-sm text-white p-3 rounded-xl shadow-lg hover:bg-gray-700/90 transition-all duration-300 transform hover:-translate-y-1 border border-white/20" title="Back to Search">
          <i class="fas fa-arrow-left"></i>
        </a>
      </div>
    </div>

    <% if (lawyers.length === 0 && users.length === 0) { %>
      <div class="text-center py-12">
        <div class="text-gray-400 text-6xl mb-4">
          <i class="fas fa-search"></i>
        </div>
        <h3 class="text-xl font-medium text-gray-900 mb-2">No results found</h3>
        <p class="text-gray-500">Try adjusting your search terms or browse our categories.</p>
      </div>
    <% } else { %>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        
        <!-- Lawyers Section -->
        <% if (searchType === 'all' || searchType === 'lawyers') { %>
          <div class="bg-white rounded-xl shadow-lg overflow-hidden">
            <div class="bg-gradient-to-r from-blue-600 to-blue-700 px-6 py-4">
              <h2 class="text-xl font-bold text-white flex items-center">
                <i class="fas fa-balance-scale mr-3"></i>
                Lawyers (<%= lawyers.length %>)
              </h2>
            </div>
            
            <div class="max-h-96 overflow-y-auto">
              <% if (lawyers.length === 0) { %>
                <div class="p-6 text-center text-gray-500">
                  <i class="fas fa-user-tie text-3xl mb-2"></i>
                  <p>No lawyers found matching your search.</p>
                </div>
              <% } else { %>
                <% lawyers.forEach((lawyer, index) => { %>
                  <div class="p-4 <%= index !== lawyers.length - 1 ? 'border-b border-gray-100' : '' %> hover:bg-gray-50 transition-colors duration-200">
                    <div class="flex items-center">
                      <div class="relative">
                        <img src="<%= lawyer.profileImage %>" 
                             alt="<%= lawyer.title %>" 
                             class="w-14 h-14 rounded-full object-cover ring-2 ring-<%= lawyer.authorityColor %>-500">
                        <div class="absolute -bottom-1 -right-1 bg-<%= lawyer.authorityColor %>-600 text-white rounded-full w-5 h-5 flex items-center justify-center text-xs border-2 border-white">
                          <%= lawyer.authorityIcon %>
                        </div>
                      </div>
                      
                      <div class="ml-4 flex-1">
                        <h3 class="font-semibold text-gray-900 mb-1"><%= lawyer.title %></h3>
                        <span class="inline-block bg-<%= lawyer.authorityColor %>-100 text-<%= lawyer.authorityColor %>-800 px-2 py-1 rounded-full text-xs font-medium mb-1">
                          <%= lawyer.authorityBadge %>
                        </span>
                        <p class="text-gray-600 text-sm"><%= lawyer.summary %></p>
                      </div>
                      
                      <div class="ml-4 flex flex-col space-y-2">
                        <a href="<%= lawyer.link %>" 
                           class="bg-blue-600 text-white text-center py-1.5 px-3 rounded-md hover:bg-blue-700 transition-colors duration-200 text-xs font-medium">
                          View Profile
                        </a>
                        <button class="bg-gray-100 text-gray-700 py-1.5 px-3 rounded-md hover:bg-gray-200 transition-colors duration-200 text-xs font-medium">
                          Connect
                        </button>
                      </div>
                    </div>
                  </div>
                <% }); %>
              <% } %>
            </div>
          </div>
        <% } %>
        
        <!-- Users Section -->
        <% if (searchType === 'all' || searchType === 'users') { %>
          <div class="bg-white rounded-xl shadow-lg overflow-hidden">
            <div class="bg-gradient-to-r from-gray-600 to-gray-700 px-6 py-4">
              <h2 class="text-xl font-bold text-white flex items-center">
                <i class="fas fa-users mr-3"></i>
                Users (<%= users.length %>)
              </h2>
            </div>
            
            <div class="max-h-96 overflow-y-auto">
              <% if (users.length === 0) { %>
                <div class="p-6 text-center text-gray-500">
                  <i class="fas fa-user text-3xl mb-2"></i>
                  <p>No users found matching your search.</p>
                </div>
              <% } else { %>
                <% users.forEach((user, index) => { %>
                  <div class="p-4 <%= index !== users.length - 1 ? 'border-b border-gray-100' : '' %> hover:bg-gray-50 transition-colors duration-200">
                    <div class="flex items-center">
                      <div class="relative">
                        <img src="<%= user.profileImage %>" 
                             alt="<%= user.title %>" 
                             class="w-14 h-14 rounded-full object-cover">
                      </div>
                      
                      <div class="ml-4 flex-1">
                        <h3 class="font-semibold text-gray-900 mb-1"><%= user.title %></h3>
                        <p class="text-gray-600 text-sm"><%= user.summary %></p>
                      </div>
                      
                      <div class="ml-4 flex flex-col space-y-2">
                        <a href="<%= user.link %>" 
                           class="bg-gray-600 text-white text-center py-1.5 px-3 rounded-md hover:bg-gray-700 transition-colors duration-200 text-xs font-medium">
                          View Profile
                        </a>
                        <button class="bg-gray-100 text-gray-700 py-1.5 px-3 rounded-md hover:bg-gray-200 transition-colors duration-200 text-xs font-medium">
                          Connect
                        </button>
                      </div>
                    </div>
                  </div>
                <% }); %>
              <% } %>
            </div>
          </div>
        <% } %>
        
      </div>
    <% } %>
  </div>
</div>