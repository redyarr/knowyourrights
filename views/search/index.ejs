<%- include('../layouts/main') %>
<div class="min-h-screen bg-gray-50 py-8">
    <div class="max-w-6xl mx-auto px-4">
        <!-- Header -->
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 mb-6">
            <div class="flex items-center">
                <div class="w-10 h-10 bg-blue-600 rounded-lg flex items-center justify-center mr-4">
                    <i class="fas fa-search text-white"></i>
                </div>
                <div>
                    <h1 class="text-2xl font-bold text-gray-900">Search Results</h1>
                    <p class="text-gray-600 mt-1">Found results for "<%= query %>"</p>
                </div>
            </div>
        </div>
        
        <% if (users.length === 0) { %>
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-12 text-center">
                <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
                    <i class="fas fa-search text-gray-400 text-xl"></i>
                </div>
                <h3 class="text-lg font-semibold text-gray-900 mb-2">No Results Found</h3>
                <p class="text-gray-600">No users found matching your search criteria. Try different keywords.</p>
            </div>
        <% } else { %>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <% users.forEach(user => { %>
                    <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden hover:shadow-md transition-shadow">
                        <div class="p-6">
                            <div class="flex items-center mb-4">
                                <% if (user.profileImage && user.profileImage.imagePath) { %>
                                    <img src="<%= user.profileImage.imagePath %>" 
                                        alt="<%= user.firstName %> <%= user.lastName %>" 
                                        class="w-14 h-14 rounded-full mr-4 object-cover">
                                <% } else { %>
                                    <img src="https://ui-avatars.com/api/?name=<%= user.firstName %>+<%= user.lastName %>" 
                                        alt="<%= user.firstName %> <%= user.lastName %>" 
                                        class="w-14 h-14 rounded-full mr-4">
                                <% } %>
                                <div class="flex-1">
                                    <h2 class="text-lg font-semibold text-gray-900"><%= user.firstName %> <%= user.lastName %></h2>
                                    <p class="text-gray-600 text-sm">
                                        <% if (user.role === 'lawyer' && user.lawyer) { %>
                                            <i class="fas fa-balance-scale text-blue-600 mr-1"></i>
                                            Lawyer at <%= user.lawyer.lawFirm %>
                                        <% } else { %>
                                            <i class="fas fa-user text-gray-500 mr-1"></i>
                                            User
                                        <% } %>
                                    </p>
                                </div>
                            </div>
                            
                            <div class="flex space-x-2">
                                <a href="/in/<%= user.id %>" class="flex-1 bg-blue-600 text-white py-2 px-3 rounded-md font-medium text-center text-sm hover:bg-blue-700 transition no-underline">
                                    <i class="fas fa-eye mr-1"></i>View Profile
                                </a>
                                <% if (user.id !== loggedInUserId) { %>
                                    <button onclick="connectWithUser(<%= user.id %>)" class="border border-blue-600 text-blue-600 py-2 px-3 rounded-md font-medium text-sm hover:bg-blue-50 transition">
                                        <i class="fas fa-user-plus mr-1"></i>Connect
                                    </button>
                                <% } %>
                            </div>
                        </div>
                    </div>
            <% }); %>
        </div>
    <% } %>
</div>

<script>
    function connectWithUser(userId) {
        fetch(`/mynetwork/connect/${userId}`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                            notifications.success('Connection request sent successfully!');
                        } else {
                            notifications.error(data.error || 'Failed to send connection request');
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        notifications.error('An error occurred while sending the connection request');
        });
    }
</script>